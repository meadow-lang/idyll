cabal-version: 3.0
name: idyll
version: 0.1.0.0
synopsis: The Idyll programming language
license: BSD-3-Clause
license-file: LICENSE
author: Chris McDearman
maintainer: mcdearmanchris@gmail.com
category: Language
build-type: Simple
extra-doc-files: CHANGELOG.md

common warnings
  ghc-options:
    -Wall
    -Werror=missing-signatures
    -Werror=incomplete-patterns
    -Werror=incomplete-uni-patterns
    -Wno-unused-do-bind

--   -fllvm
--   -haddock
--   -ddump-simpl -ddump-cmm -ddump-stg-final -ddump-to-file -dsuppress-all
executable idyllic
  import: warnings
  main-is: Main.hs
  other-modules:
    Idyllic.AST
    Idyllic.Builtin
    Idyllic.Core
    Idyllic.Effect
    Idyllic.Lexer
    Idyllic.Parsec
    Idyllic.Parser
    Idyllic.Pipeline
    Idyllic.Rename
    Idyllic.Scc
    Idyllic.Token
    Idyllic.TypeCheck
    Idyllic.Utils

  default-extensions:
    BangPatterns
    FlexibleInstances
    FunctionalDependencies
    LambdaCase
    MagicHash
    MultiWayIf
    MultilineStrings
    OrPatterns
    OverloadedStrings
    PatternSynonyms
    RecordWildCards
    ScopedTypeVariables
    StrictData
    TupleSections
    TypeFamilies
    TypeSynonymInstances
    ViewPatterns
    TypeOperators
    TypeApplications
    DeriveFunctor
    RequiredTypeArguments

  build-depends:
    array,
    base,
    bytestring,
    containers,
    diagnose,
    hashable,
    mtl,
    megaparsec,
    parser-combinators,
    pretty-simple,
    primitive,
    stm,
    text,
    transformers,
    unordered-containers,
    vector,
    wcwidth,

  hs-source-dirs: compiler
  default-language: Haskell2010
