build : (n : [] Int) -> List Int -> List Int ! Div
build n acc = if n == 0 then acc else build (n - 1) (n :: acc)

sum : List Int -> Int -> Int
sum xs acc = case xs of
  Nil -> acc
  y :: ys -> sum ys (acc + y)

rounds : (r : [] Int) -> Int -> Int ! Div
rounds r total = if r == 0 then total else rounds (r - 1) (total + sum (build (1000000 + r) Nil) 0)

rounds 20 0
