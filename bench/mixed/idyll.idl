-- `fib 32` beside a coin tossed with an operation resumed twice: the
-- program has an `@many` effect, but `fib` cannot perform it.
effect Choose where
  @many flip : () -> Bool

fib : (n : [] Int) -> Int ! {Div}
fib n = if n < 2 then n else fib (n - 1) + fib (n - 2)

coin : () -> Int ! {Choose}
coin u = if flip () then 1 else 0

handle coin () + fib 32 with
  flip u k -> k True + k False
