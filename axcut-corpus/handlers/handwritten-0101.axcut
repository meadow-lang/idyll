-- |   add2 a b k -> k (a + b)
-- expect: value 44

define main : () =
  new f_0 = (){
    apply(a_1, k_2) ⇒
      substitute [k_2 ↦ k_2, a_1 ↦ a_1];
      new f_3 = (a_1){
        apply(b_4, k_5) ⇒
          substitute [a_1 ↦ a_1, b_4 ↦ b_4, k_5 ↦ k_5];
          perform add2(a_1, b_4) k_5 };
      substitute [f_3 ↦ f_3, k_2 ↦ k_2];
      invoke k_2 ret };
  new k_26 = (){
    ret(r_27) ⇒
      extern halt(r_27) {} };
  new h_6 = (){
    return(x_8, k_9) ⇒
      invoke k_9 ret,
    add2(a_10, b_11, k_12, k_13) ⇒
      extern add(a_10, b_11) { (r_14) ⇒
      substitute [r_14 ↦ r_14, k_13 ↦ k_13, k_12 ↦ k_12];
      invoke k_12 apply } };
  substitute [f_0 ↦ f_0, h_6 ↦ h_6, k_26 ↦ k_26];
  handle h_6 k_26 as ret_7;
  extern lit 40 { (n_15) ⇒
  substitute [f_0 ↦ f_0, n_15 ↦ n_15, ret_7 ↦ ret_7];
  new k_16 = (ret_7){
    ret(r_17) ⇒
      extern lit 2 { (n_18) ⇒
      substitute [r_17 ↦ r_17, n_18 ↦ n_18, ret_7 ↦ ret_7];
      new k_19 = (ret_7){
        ret(r_20) ⇒
          extern lit 1 { (n_21) ⇒
          extern lit 1 { (n_22) ⇒
          substitute [n_21 ↦ n_21, n_22 ↦ n_22, r_20 ↦ r_20, ret_7 ↦ ret_7];
          new k_23 = (r_20, ret_7){
            ret(r_24) ⇒
              extern add(r_20, r_24) { (r_25) ⇒
              substitute [r_25 ↦ r_25, ret_7 ↦ ret_7];
              invoke ret_7 ret } };
          perform add2(n_21, n_22) k_23 } } };
      substitute [n_18 ↦ n_18, k_19 ↦ k_19, r_17 ↦ r_17];
      invoke r_17 apply } };
  substitute [n_15 ↦ n_15, k_16 ↦ k_16, f_0 ↦ f_0];
  invoke f_0 apply }
