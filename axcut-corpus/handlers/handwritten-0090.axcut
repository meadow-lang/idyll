-- | effect Fail where
-- |   fail : Unit -> Int
-- | 
-- | safeDiv : (a : [] Int) -> (b : [] Int) -> Int ! Fail
-- | safeDiv a b = if b == 0 then fail () else a / b
-- | 
-- | handle safeDiv 7 0 with
-- |   return x -> x + 1
-- |   fail _ k -> 0
-- expect: value 0

define main : () =
  new f_0 = (){
    apply(a_1, k_2) ⇒
      substitute [k_2 ↦ k_2, a_1 ↦ a_1];
      new f_3 = (a_1){
        apply(b_4, k_5) ⇒
          extern lit 0 { (n_6) ⇒
          extern eq(b_4, n_6) { (r_7) ⇒
          substitute [b_4 ↦ b_4, k_5 ↦ k_5, a_1 ↦ a_1, r_7 ↦ r_7];
          switch r_7 {
            true() ⇒
              substitute [k_5 ↦ k_5];
              let u_8 = unit();
              substitute [u_8 ↦ u_8, k_5 ↦ k_5];
              perform fail(u_8) k_5,
            false() ⇒
              extern div(a_1, b_4) { (r_9) ⇒
              substitute [r_9 ↦ r_9, k_5 ↦ k_5];
              invoke k_5 ret } } } } };
      substitute [f_3 ↦ f_3, k_2 ↦ k_2];
      invoke k_2 ret };
  new k_24 = (){
    ret(r_25) ⇒
      extern halt(r_25) {} };
  new h_10 = (){
    return(x_12, k_13) ⇒
      extern lit 1 { (n_14) ⇒
      extern add(x_12, n_14) { (r_15) ⇒
      substitute [r_15 ↦ r_15, k_13 ↦ k_13];
      invoke k_13 ret } },
    fail(x_16, k_17, k_18) ⇒
      extern lit 0 { (n_19) ⇒
      substitute [n_19 ↦ n_19, k_18 ↦ k_18];
      invoke k_18 ret } };
  substitute [f_0 ↦ f_0, h_10 ↦ h_10, k_24 ↦ k_24];
  handle h_10 k_24 as ret_11;
  extern lit 7 { (n_20) ⇒
  substitute [f_0 ↦ f_0, n_20 ↦ n_20, ret_11 ↦ ret_11];
  new k_21 = (ret_11){
    ret(r_22) ⇒
      extern lit 0 { (n_23) ⇒
      substitute [n_23 ↦ n_23, ret_11 ↦ ret_11, r_22 ↦ r_22];
      invoke r_22 apply } };
  substitute [n_20 ↦ n_20, k_21 ↦ k_21, f_0 ↦ f_0];
  invoke f_0 apply }
