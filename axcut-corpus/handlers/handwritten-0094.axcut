-- | effect Log where
-- |   log : Int -> Unit
-- | 
-- | applyTo : (f : Int -> Unit ! e) -> Unit ! e
-- | applyTo f = f 3
-- | 
-- | handle applyTo log with
-- |   return u -> 0
-- |   log n k -> n
-- expect: value 3

define main : () =
  new f_0 = (){
    apply(e_1, k_2) ⇒
      substitute [k_2 ↦ k_2];
      new f_3 = (){
        apply(f_4, k_5) ⇒
          extern lit 3 { (n_6) ⇒
          substitute [n_6 ↦ n_6, k_5 ↦ k_5, f_4 ↦ f_4];
          invoke f_4 apply } };
      substitute [f_3 ↦ f_3, k_2 ↦ k_2];
      invoke k_2 ret };
  new k_21 = (){
    ret(r_22) ⇒
      extern halt(r_22) {} };
  new h_7 = (){
    return(u_9, k_10) ⇒
      extern lit 0 { (n_11) ⇒
      substitute [n_11 ↦ n_11, k_10 ↦ k_10];
      invoke k_10 ret },
    log(n_12, k_13, k_14) ⇒
      substitute [n_12 ↦ n_12, k_14 ↦ k_14];
      invoke k_14 ret };
  substitute [f_0 ↦ f_0, h_7 ↦ h_7, k_21 ↦ k_21];
  handle h_7 k_21 as ret_8;
  let t_15 = erased();
  substitute [f_0 ↦ f_0, t_15 ↦ t_15, ret_8 ↦ ret_8];
  new k_16 = (ret_8){
    ret(r_17) ⇒
      new f_18 = (){
        apply(x_19, k_20) ⇒
          perform log(x_19) k_20 };
      substitute [f_18 ↦ f_18, ret_8 ↦ ret_8, r_17 ↦ r_17];
      invoke r_17 apply };
  substitute [t_15 ↦ t_15, k_16 ↦ k_16, f_0 ↦ f_0];
  invoke f_0 apply
