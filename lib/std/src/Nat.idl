-- The natural numbers, counted out: `S (S Z)` is two. Slower than `Int` by
-- far, but a recursion that takes a `Nat` apart is seen to end, so a `Nat`
-- can compute inside a type: the length of a `Vec`, the bound of a `Fin`.

use Std.Eq (Eq, sym, trans, cong)
use Std.Eq.Eq.*
use Std.Dec (Dec)
use Std.Dec.Dec.*
use Std.Void (Void)
use Std.Ordering (Ordering)
use Std.Ordering.Ordering.*

@pub data Nat = Z | S Nat

use Nat.*

@pub plus : Nat -> Nat -> Nat
plus Z m = m
plus (S n) m = S (plus n m)

@pub times : Nat -> (m : [] Nat) -> Nat
times Z m = Z
times (S n) m = plus m (times n m)

-- Subtraction that stops at zero: `minus 2 5` is `Z`.
@pub minus : Nat -> (m : [0..1] Nat) -> Nat
minus n Z = n
minus Z (S m) = Z
minus (S n) (S m) = minus n m

@pub pred : Nat -> Nat
pred Z = Z
pred (S n) = n

@pub double : Nat -> Nat
double Z = Z
double (S n) = S (S (double n))

@pub isZero : (n : [0..1] Nat) -> Bool
isZero Z = True
isZero (S n) = False

@pub equal : (n : [0..1] Nat) -> (m : [0..1] Nat) -> Bool
equal Z Z = True
equal Z (S m) = False
equal (S n) Z = False
equal (S n) (S m) = equal n m

@pub compare : (n : [0..1] Nat) -> (m : [0..1] Nat) -> Ordering
compare Z Z = Equal
compare Z (S m) = Less
compare (S n) Z = Greater
compare (S n) (S m) = compare n m

@pub lessThan : (n : [0..1] Nat) -> (m : [0..1] Nat) -> Bool
lessThan n Z = False
lessThan Z (S m) = True
lessThan (S n) (S m) = lessThan n m

@pub max : Nat -> Nat -> Nat
max Z m = m
max (S n) Z = S n
max (S n) (S m) = S (max n m)

@pub min : (n : [0..1] Nat) -> (m : [0..1] Nat) -> Nat
min Z m = Z
min (S n) Z = Z
min (S n) (S m) = S (min n m)

@pub toInt : Nat -> Int
toInt Z = 0
toInt (S n) = 1 + toInt n

-- The `Nat` an `Int` counts, or `Z` for a negative one. Made a bit at a
-- time, the bits of a 64-bit `Int` being few enough to count: a recursion
-- on an `Int` itself would not be seen to end.
@pub fromInt : (n : [] Int) -> Nat
fromInt n = bits sixtyFour n

bits : (fuel : [0..1] Nat) -> (n : [] Int) -> Nat
bits Z n = Z
bits (S fuel) n = if n < 1 then Z else plus (if n % 2 == 1 then S Z else Z) (double (bits fuel (n / 2)))

sixtyFour : Nat
sixtyFour = double (double (double (double (double (double (S Z))))))

@pub show : (n : [] Nat) -> String
show n = showInt (toInt n)

-- Proofs. Each is a function from naturals to an equality, by induction:
-- the case for `S n` uses the proof for `n`.

-- `Z` on the right changes nothing (on the left, `plus` says so itself).
@pub plusZero : (n : Nat) -> Eq (plus n Z) n
plusZero Z = Refl
plusZero (S n) = cong S (plusZero n)

@pub plusSucc : (n : Nat) -> (m : [0] Nat) -> Eq (plus n (S m)) (S (plus n m))
plusSucc Z m = Refl
plusSucc (S n) m = cong S (plusSucc n m)

@pub plusComm : (n : [] Nat) -> (m : [] Nat) -> Eq (plus n m) (plus m n)
plusComm Z m = sym (plusZero m)
plusComm (S n) m = trans (cong S (plusComm n m)) (sym (plusSucc m n))

@pub plusAssoc : (n : Nat) -> (m : [0] Nat) -> (k : [0] Nat) -> Eq (plus (plus n m) k) (plus n (plus m k))
plusAssoc Z m k = Refl
plusAssoc (S n) m k = cong S (plusAssoc n m k)

-- `Z` is no successor.
@pub zeroNotSucc : {m : Nat} -> Eq Z (S m) -> Void
zeroNotSucc r impossible

-- Equal successors have equal predecessors.
@pub succInjective : {n m : Nat} -> Eq (S n) (S m) -> Eq n m
succInjective Refl = Refl

-- Whether two naturals are equal, with the proof either way.
@pub decEq : (n : [] Nat) -> (m : [] Nat) -> Dec (Eq n m)
decEq Z Z = Yes Refl
decEq Z (S m) = No zeroNotSucc
decEq (S n) Z = No (\(r : Eq (S n) Z) -> zeroNotSucc (sym r))
decEq (S n) (S m) = case decEq n m of
  Yes p -> Yes (cong S p)
  No f -> No (\(q : Eq (S n) (S m)) -> f (succInjective q))
