-- `Maybe a`, which the prelude declares: `Nothing`, or `Just` an `a`.
--
-- A function that is given a function to call on what is there may not
-- call it, so takes it with [0..1]; what is not there to use, likewise.

@pub isJust : {a : Type} -> (m : [0..1] Maybe a) -> Bool
isJust Nothing = False
isJust (Just x) = True

@pub isNothing : {a : Type} -> (m : [0..1] Maybe a) -> Bool
isNothing Nothing = True
isNothing (Just x) = False

-- What is there, or `default`.
@pub withDefault : {a : Type} -> (default : [0..1] a) -> Maybe a -> a
withDefault d Nothing = d
withDefault d (Just x) = x

@pub map : {a b : Type} -> (f : [0..1] (a -> b ! e)) -> Maybe a -> Maybe b ! e
map f Nothing = Nothing
map f (Just x) = Just (f x)

-- `f` of what is there, which may itself be nothing.
@pub andThen : {a b : Type} -> (f : [0..1] (a -> Maybe b ! e)) -> Maybe a -> Maybe b ! e
andThen f Nothing = Nothing
andThen f (Just x) = f x

-- The first, if it is there, and otherwise the second.
@pub orElse : {a : Type} -> (m : Maybe a) -> (fallback : [0..1] Maybe a) -> Maybe a
orElse Nothing fallback = fallback
orElse (Just x) fallback = Just x

-- `onNothing`, or `onJust` of what is there.
@pub maybe : {a b : Type} -> (onNothing : [0..1] b) -> (onJust : [0..1] (a -> b ! e)) -> Maybe a -> b ! e
maybe d f Nothing = d
maybe d f (Just x) = f x

@pub toList : {a : Type} -> Maybe a -> List a
toList Nothing = Nil
toList (Just x) = x :: Nil

-- What is there, or `err`.
@pub toResult : {e a : Type} -> (err : [0..1] e) -> Maybe a -> Result e a
toResult err Nothing = Err err
toResult err (Just x) = Ok x
