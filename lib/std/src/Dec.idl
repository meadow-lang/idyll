-- Decidable propositions: either a proof of `p`, or a proof that there is
-- none. Better than a `Bool`, which says which, but not why; see
-- `Nat.decEq`.

use Std.Void (Void)

@pub data Dec (p : Type) = Yes p | No (p -> Void)

use Dec.*

@pub isYes : {p : Type} -> (d : [0..1] Dec p) -> Bool
isYes (Yes x) = True
isYes (No f) = False

@pub isNo : {p : Type} -> (d : [0..1] Dec p) -> Bool
isNo (Yes x) = False
isNo (No f) = True

-- The proof, if there is one.
@pub toMaybe : {p : Type} -> (d : [0..1] Dec p) -> Maybe p
toMaybe (Yes x) = Just x
toMaybe (No f) = Nothing
