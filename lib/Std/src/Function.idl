-- Functions on functions.

@linear

use Std.Num.Nat (Nat)

-- The function that gives back what it is given.
@pub
id : {a : Type} -> a -> a
id x = x

-- The first of two arguments; the second is never computed.
@pub
const : {a b : Type} -> a -> (y : [0] b) -> a
const x y = x

-- A function of two arguments, taking them the other way round.
@pub
flip : {a b c : Type} -> {r s : Grade} -> (f : (x : [r] a) -> (y : [s] b) -> c ! e) -> (y : [s] b) -> (x : [r] a) -> c ! e
flip f y x = f x y

-- `g`, then `f`.
@pub
compose : {a b c : Type} -> {r s : Grade} -> (f : (y : [s] b) -> c ! e) -> (g : [s] ((x : [r] a) -> b ! e)) -> (x : [s * r] a) -> c ! e
compose f g x = f (g x)

-- `f x`, as a function: for passing application itself on.
@pub
apply : {a b : Type} -> {r : Grade} -> (f : (x : [r] a) -> b ! e) -> (x : [r] a) -> b ! e
apply f x = f x

-- `f (f x)`.
@pub
twice : {a : Type} -> {r : Grade} -> (f : [1 + r] ((x : [r] a) -> a ! e)) -> (x : [r * r] a) -> a ! e
twice f x = f (f x)

-- `f` applied `n` times.
@pub
iterate : {a : Type} -> (n : Nat) -> (f : [] ((x : [] a) -> a ! e)) -> (x : [] a) -> a ! e
iterate Nat.Z f x = x
iterate (Nat.S n) f x = iterate n f (f x)
