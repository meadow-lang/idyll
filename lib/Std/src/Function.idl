-- Functions on functions.

use Std.Num.Nat (Nat)

-- The function that gives back what it is given.
@pub
id : {a : Type} -> a -> a
id x = x

-- The first of two arguments; the second is never computed.
@pub
const : {a b : Type} -> a -> (y : [0] b) -> a
const x y = x

-- A function of two arguments, taking them the other way round.
@pub
flip : {a b c : Type} -> (f : a -> b -> c ! e) -> b -> a -> c ! e
flip f y x = f x y

-- `g`, then `f`.
@pub
compose : {a b c : Type} -> (f : b -> c ! e) -> (g : a -> b ! e) -> a -> c ! e
compose f g x = f (g x)

-- `f x`, as a function: for passing application itself on.
@pub
apply : {a b : Type} -> (f : a -> b ! e) -> a -> b ! e
apply f x = f x

-- `f (f x)`.
@pub
twice : {a : Type} -> (f : [2] (a -> a ! e)) -> a -> a ! e
twice f x = f (f x)

-- `f` applied `n` times.
@pub
iterate : {a : Type} -> (n : Nat) -> (f : [] (a -> a ! e)) -> a -> a ! e
iterate Nat.Z f x = x
iterate (Nat.S n) f x = iterate n f (f x)
