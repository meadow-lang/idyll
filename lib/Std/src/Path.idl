-- Filesystem paths as strings, as Meadow's `Std.Path`.
--
-- `Std.Fs` takes and gives paths as plain `String`s; this module is the
-- string handling that goes with them. It is pure: nothing here touches the
-- disk, so `parent "a/b"` is `Just "a"` whether or not either exists.
--
-- Separators: `/` always works, and `\` is taken on input too, as Windows
-- writes it. Output always uses `/`, which every Windows API also takes.
-- There is no attempt at UNC paths, drive-relative paths, or the other
-- corners of Windows path semantics.

use Std.Bool (not)
use Std.String as S
use Std.Collections.List as L

-- The separator paths are written with.
@pub
separator : String
separator = "/"

-- Whether a byte is a separator, `/` or `\`.
@pub
isSeparator : (b : Int) -> Bool
isSeparator b = if b == 47 then True else b == 92

-- The byte at `i`, or 0 (never a separator or a dot) if there is none.
byteAt : String -> Int -> Int
byteAt p i = if i < 0 then 0 else if i < S.byteLength p then stringByteAt p i else 0

-- ---------------------------------------------------------------------------
-- Joining
-- ---------------------------------------------------------------------------

-- `join "a" "b"` is `"a/b"`. An absolute `b` wins outright, as it does in
-- Rust's `Path::join`: joining onto it would make a path nobody meant.
@pub
join : (a : String) -> (b : String) -> String
join a b =
  if S.isEmpty a then b
  else if S.isEmpty b then a
  else if isAbsolute b then b
  else if endsWithSeparator a then a ++ b
  else a ++ separator ++ b

-- Every part joined, in order.
@pub
joinAll : (parts : List String) -> String
joinAll parts = L.foldl (\(acc : String) (p : String) -> join acc p) "" parts

-- ---------------------------------------------------------------------------
-- Splitting
-- ---------------------------------------------------------------------------

-- Everything before the last separator: `parent "a/b/c"` is `"a/b"`.
-- `Nothing` when there is nothing above: a bare name, or the root itself.
@pub
parent : (p : String) -> Maybe String
parent p =
  let n = lastSeparator p in
  if n < 0 then Nothing
  else if n == 0 then (if S.byteLength p == 1 then Nothing else Just separator)
  else Just (S.slice p 0 n)

-- The last component: `fileName "a/b/c.txt"` is `"c.txt"`.
@pub
fileName : (p : String) -> String
fileName p = let n = lastSeparator p in if n < 0 then p else S.drop p (n + 1)

-- The last component without its extension.
@pub
fileStem : (p : String) -> String
fileStem p =
  let name = fileName p in
  let d = lastDot name in
  if d <= 0 then name else S.slice name 0 d

-- The extension, without its dot, or `""` if there is none. A leading dot
-- does not count: `.gitignore` has no extension, it is a name.
@pub
extension : (p : String) -> String
extension p =
  let name = fileName p in
  let d = lastDot name in
  if d <= 0 then "" else S.drop name (d + 1)

@pub
hasExtension : (p : String) -> Bool
hasExtension p = not (S.isEmpty (extension p))

-- The extension replaced (given without a dot); an empty `ext` removes it.
@pub
withExtension : (p : String) -> (ext : String) -> String
withExtension p ext =
  let base = withFileName p (fileStem p) in
  if S.isEmpty ext then base else base ++ "." ++ ext

-- The last component replaced.
@pub
withFileName : (p : String) -> (name : String) -> String
withFileName p name = case parent p of
  Nothing -> name
  Just d -> join d name

-- Every component that is not empty, the separators dropped.
@pub
components : (p : String) -> List String
components p = L.filter (\(c : String) -> not (S.isEmpty c)) (splitAny p)

-- ---------------------------------------------------------------------------
-- Classifying
-- ---------------------------------------------------------------------------

@pub
isAbsolute : (p : String) -> Bool
isAbsolute p = if S.isEmpty p then False else if isSeparator (byteAt p 0) then True else hasDrive p

@pub
isRelative : (p : String) -> Bool
isRelative p = not (isAbsolute p)

-- `C:` and the like: only the shape is looked at, not the letter.
hasDrive : String -> Bool
hasDrive p = if S.byteLength p < 2 then False else byteAt p 1 == 58

-- ---------------------------------------------------------------------------
-- Normalising
-- ---------------------------------------------------------------------------

-- `.` and `..` resolved by the text, and repeated separators made one. It
-- never looks at the disk, so it cannot follow links: `normalize "a/../b"`
-- is `"b"` even if `a` is a link somewhere else. A path with a drive keeps
-- it first: `C:\a\..\b` is `C:/b`.
@pub
normalize : (p : String) -> String
normalize p =
  let abs = isAbsolute p in
  let parts = L.reverse (L.foldl (\(acc : List String) (c : String) -> pushPart abs acc c) Nil (components p)) in
  let body = S.join separator parts in
  if hasDrive p then body
  else if abs then separator ++ body
  else if S.isEmpty body then "."
  else body

-- A component onto what came before it, innermost first.
pushPart : (abs : Bool) -> List String -> String -> List String
pushPart abs acc c =
  if c == "." then acc
  else if not (c == "..") then c :: acc
  else case acc of
    -- nothing is above a drive, or the root
    Nil -> if abs then Nil else c :: Nil
    prev :: rest -> if prev == ".." then c :: acc else if hasDrive prev then (if L.isEmpty rest then acc else rest) else rest

-- ---------------------------------------------------------------------------
-- Bytes
-- ---------------------------------------------------------------------------

endsWithSeparator : String -> Bool
endsWithSeparator p = let n = S.byteLength p in if n == 0 then False else isSeparator (byteAt p (n - 1))

-- Cut at either separator.
splitAny : String -> List String
splitAny p = L.reverse (splitFrom p 0 0 Nil)

@terminating
splitFrom : String -> (start : Int) -> (i : Int) -> List String -> List String
splitFrom p start i acc =
  if i >= S.byteLength p then S.slice p start i :: acc
  else if isSeparator (byteAt p i) then splitFrom p (i + 1) (i + 1) (S.slice p start i :: acc)
  else splitFrom p start (i + 1) acc

lastSeparator : String -> Int
lastSeparator p = lastSeparatorFrom p (S.byteLength p - 1)

@terminating
lastSeparatorFrom : String -> (i : Int) -> Int
lastSeparatorFrom p i = if i < 0 then 0 - 1 else if isSeparator (byteAt p i) then i else lastSeparatorFrom p (i - 1)

lastDot : String -> Int
lastDot name = lastDotFrom name (S.byteLength name - 1)

@terminating
lastDotFrom : String -> (i : Int) -> Int
lastDotFrom name i = if i < 0 then 0 - 1 else if byteAt name i == 46 then i else lastDotFrom name (i - 1)
