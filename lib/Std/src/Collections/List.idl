-- Lists, which the prelude declares: `Nil`, and `x :: xs`.
--
-- A list, and what a function is given of it, may be used as often as
-- wanted, as anything in Std may: these say nothing about grades.

use Std.Num.Nat (Nat)
use Std.Num.Nat.Nat.*
use Std.Num.Fin (Fin)
use Std.Num.Fin.Fin.*
use Std.Ordering (Ordering)
use Std.Ordering.Ordering.*

-- How many elements, as an `Int`.
@pub
length : {a : Type} -> (xs : List a) -> Int
length Nil = 0
length (x :: rest) = 1 + length rest

-- How many elements, as a `Nat`, which a type can compute with: see `nth`.
@pub
size : {a : Type} -> (xs : List a) -> Nat
size Nil = Z
size (x :: rest) = S (size rest)

@pub
isEmpty : {a : Type} -> (xs : List a) -> Bool
isEmpty Nil = True
isEmpty (x :: rest) = False

@pub
head : {a : Type} -> (xs : List a) -> Maybe a
head Nil = Nothing
head (x :: rest) = Just x

@pub
tail : {a : Type} -> (xs : List a) -> Maybe (List a)
tail Nil = Nothing
tail (x :: rest) = Just rest

@pub
last : {a : Type} -> (xs : List a) -> Maybe a
last Nil = Nothing
last (x :: rest) = Just (lastOf x rest)

-- The last of `x` and then `xs`.
lastOf : {a : Type} -> (x : a) -> (xs : List a) -> a
lastOf x Nil = x
lastOf x (y :: ys) = lastOf y ys

-- The element at index `i`, counting from zero, if there is one.
@pub
index : {a : Type} -> (i : Nat) -> (xs : List a) -> Maybe a
index i Nil = Nothing
index Z (x :: rest) = Just x
index (S i) (x :: rest) = index i rest

-- The element at an index the type says is in range: `Fin (size xs)` has
-- an index for each element and no more, so there is nothing to fail.
@pub
nth : {a : Type} -> (xs : List a) -> Fin (size xs) -> a
nth Nil i impossible
nth (x :: rest) FZ = x
nth (x :: rest) (FS i) = nth rest i

@pub
append : {a : Type} -> List a -> List a -> List a
append Nil ys = ys
append (x :: xs) ys = x :: append xs ys

@pub
reverse : {a : Type} -> List a -> List a
reverse xs = onto xs Nil

-- `xs`, reversed, in front of `acc`.
onto : {a : Type} -> List a -> List a -> List a
onto Nil acc = acc
onto (x :: xs) acc = onto xs (x :: acc)

@pub
concat : {a : Type} -> List (List a) -> List a
concat Nil = Nil
concat (xs :: xss) = append xs (concat xss)

@pub
map : {a b : Type} -> (f : a -> b ! e) -> (xs : List a) -> List b ! e
map f Nil = Nil
map f (x :: xs) = f x :: map f xs

@pub
concatMap : {a b : Type} -> (f : a -> List b ! e) -> (xs : List a) -> List b ! e
concatMap f Nil = Nil
concatMap f (x :: xs) = append (f x) (concatMap f xs)

-- `f x1 (f x2 (.. (f xn z)))`: the list, with `f` for `::` and `z` for `Nil`.
-- What `f` makes is handed to it again, so it and `z` are unrestricted.
@pub
foldr : {a b : Type} -> (f : ((x : a) -> (acc : b) -> b ! e)) -> (z : b) -> (xs : List a) -> b ! e
foldr f z Nil = z
foldr f z (x :: xs) = f x (foldr f z xs)

-- `f (.. (f (f z x1) x2) ..) xn`, from the left, in constant space.
@pub
foldl : {a b : Type} -> (f : ((acc : b) -> (x : a) -> b ! e)) -> (z : b) -> (xs : List a) -> b ! e
foldl f z Nil = z
foldl f z (x :: xs) = foldl f (f z x) xs

-- What `f` keeps of each element: `filter` for when the test can give the
-- element back, which takes each element once.
@pub
filterMap : {a b : Type} -> (f : a -> Maybe b ! e) -> (xs : List a) -> List b ! e
filterMap f Nil = Nil
filterMap f (x :: xs) = case f x of
  Nothing -> filterMap f xs
  Just y -> y :: filterMap f xs

-- The elements that pass the test, which looks at each and then keeps it.
@pub
filter : {a : Type} -> (p : ((x : a) -> Bool ! e)) -> (xs : List a) -> List a ! e
filter p Nil = Nil
filter p (x :: xs) = if p x then x :: filter p xs else filter p xs

-- Those that pass, and those that do not.
@pub
partition : {a : Type} -> (p : ((x : a) -> Bool ! e)) -> (xs : List a) -> (List a, List a) ! e
partition p Nil = (Nil, Nil)
partition p (x :: xs) = case partition p xs of
  (yes, no) -> if p x then (x :: yes, no) else (yes, x :: no)

-- The first element that passes the test.
@pub
find : {a : Type} -> (p : ((x : a) -> Bool ! e)) -> (xs : List a) -> Maybe a ! e
find p Nil = Nothing
find p (x :: xs) = if p x then Just x else find p xs

-- Whether every element passes; it stops at the first that fails.
@pub
all : {a : Type} -> (p : a -> Bool ! e) -> (xs : List a) -> Bool ! e
all p Nil = True
all p (x :: xs) = if p x then all p xs else False

-- Whether some element passes; it stops at the first that does.
@pub
any : {a : Type} -> (p : a -> Bool ! e) -> (xs : List a) -> Bool ! e
any p Nil = False
any p (x :: xs) = if p x then True else any p xs

@pub
sum : List Int -> Int
sum Nil = 0
sum (x :: xs) = x + sum xs

@pub
product : List Int -> Int
product Nil = 1
product (x :: xs) = x * product xs

@pub
maximum : (xs : List Int) -> Maybe Int
maximum Nil = Nothing
maximum (x :: xs) = Just (largest x xs)

largest : (best : Int) -> (xs : List Int) -> Int
largest best Nil = best
largest best (x :: xs) = largest (if x < best then best else x) xs

@pub
minimum : (xs : List Int) -> Maybe Int
minimum Nil = Nothing
minimum (x :: xs) = Just (smallest x xs)

smallest : (best : Int) -> (xs : List Int) -> Int
smallest best Nil = best
smallest best (x :: xs) = smallest (if x < best then x else best) xs

-- The first `n` elements, or all of them if there are fewer.
@pub
take : {a : Type} -> (n : Nat) -> (xs : List a) -> List a
take Z xs = Nil
take (S n) Nil = Nil
take (S n) (x :: xs) = x :: take n xs

-- All but the first `n` elements.
@pub
drop : {a : Type} -> (n : Nat) -> (xs : List a) -> List a
drop Z xs = xs
drop (S n) Nil = Nil
drop (S n) (x :: xs) = drop n xs

-- `n` copies of `x`.
@pub
replicate : {a : Type} -> (n : Nat) -> (x : a) -> List a
replicate Z x = Nil
replicate (S n) x = x :: replicate n x

-- `count` integers, counting up from `from`: `range 1 (Std.Num.Nat.fromInt 3)`
-- is `#[1, 2, 3]`. (Counted with a `Nat`, so that it is seen to end.)
@pub
range : (from : Int) -> (count : Nat) -> List Int
range from Z = Nil
range from (S n) = from :: range (from + 1) n

-- Pairs of elements in the same places, as many as the shorter list has.
@pub
zip : {a b : Type} -> (xs : List a) -> (ys : List b) -> List (a, b)
zip Nil ys = Nil
zip (x :: xs) Nil = Nil
zip (x :: xs) (y :: ys) = (x, y) :: zip xs ys

@pub
zipWith : {a b c : Type} -> (f : a -> b -> c ! e) -> (xs : List a) -> (ys : List b) -> List c ! e
zipWith f Nil ys = Nil
zipWith f (x :: xs) Nil = Nil
zipWith f (x :: xs) (y :: ys) = f x y :: zipWith f xs ys

@pub
unzip : {a b : Type} -> List (a, b) -> (List a, List b)
unzip Nil = (Nil, Nil)
unzip ((x, y) :: rest) = case unzip rest of
  (xs, ys) -> (x :: xs, y :: ys)

-- `sep` between each two elements.
@pub
intersperse : {a : Type} -> (sep : a) -> List a -> List a
intersperse sep Nil = Nil
intersperse sep (x :: xs) = x :: between sep xs

-- `sep` in front of each element.
between : {a : Type} -> (sep : a) -> List a -> List a
between sep Nil = Nil
between sep (x :: xs) = sep :: x :: between sep xs

-- The value for the first key equal to `key`, as `eq` says.
@pub
lookup : {k v : Type} -> (eq : ((x : k) -> (y : k) -> Bool)) -> (key : k) -> (pairs : List (k, v)) -> Maybe v
lookup eq key Nil = Nothing
lookup eq key ((k, v) :: rest) = if eq key k then Just v else lookup eq key rest

-- The list in order, as `cmp` compares: an insertion sort, stable, and seen
-- to end, as it only ever takes lists apart.
@pub
sortBy : {a : Type} -> (cmp : ((x : a) -> (y : a) -> Ordering)) -> (xs : List a) -> List a
sortBy cmp Nil = Nil
sortBy cmp (x :: xs) = insertBy cmp x (sortBy cmp xs)

-- `x` in a list already in order, where it goes.
@pub
insertBy : {a : Type} -> (cmp : ((x : a) -> (y : a) -> Ordering)) -> (x : a) -> (xs : List a) -> List a
insertBy cmp x Nil = x :: Nil
insertBy cmp x (y :: ys) = case cmp x y of
  Greater -> y :: insertBy cmp x ys
  Less -> x :: y :: ys
  Equal -> x :: y :: ys

-- The integers in increasing order.
@pub
sort : (xs : List Int) -> List Int
sort xs = sortBy Std.Num.Int.compare xs
