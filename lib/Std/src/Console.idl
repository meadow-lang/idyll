-- More than a line at a time. The prelude has the `Console` effect itself
-- (`putStr`, `putErr`, `readLine`) and `putStrLn` and `printInt`.

-- Each string on a line of its own.
@pub
printLines : List String -> () ! Console
printLines Nil = ()
printLines (s :: rest) = let u = putStrLn s in printLines rest

-- A list, as `String.fromList` writes it, on a line.
@pub
printList : {a : Type} -> (show : [] ((x : [] a) -> String)) -> (xs : [] List a) -> () ! Console
printList show xs = putStrLn (Std.String.fromList show xs)

@pub
printBool : Bool -> () ! Console
printBool b = putStrLn (if b then "True" else "False")

-- Every line until the input ends. Nothing says when that will be, so it
-- may not end, as far as the checker can see: hence `Div`.
@pub
readLines : () -> List String ! {Console, Div}
readLines u = case readLine () of
  Nothing -> Nil
  Just line -> line :: readLines ()
