-- Booleans. `and` and `or` are built in, and short-circuit: `a and b` is
-- `if a then b else False`, and looks at `b` only if it has to. What is
-- here is ordinary functions, each of which uses both its arguments.

@pub
not : Bool -> Bool
not b = if b then False else True

@pub
xor : Bool -> Bool -> Bool
xor a b = if a then not b else b

@pub
implies : Bool -> Bool -> Bool
-- (A Bool not needed is still taken apart, which uses it.)
implies a b = if a then b else (if b then True else True)

@pub
show : Bool -> String
show b = if b then "True" else "False"
