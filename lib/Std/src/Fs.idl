-- The file system, beyond the prelude's `Fs` effect (`readToString`,
-- `writeString`, `listDir`, `readDir`, `exists`, ...): the shapes a program
-- usually wants.

-- The file's text, or `fallback` if it cannot be read.
@pub
readToStringOr : (fallback : String) -> (path : String) -> String ! Fs
readToStringOr fallback path = Std.Result.withDefault fallback (readToString path)

-- The names in a directory, or none if it cannot be read.
@pub
tryReadDir : (path : String) -> List String ! Fs
tryReadDir path = Std.Result.withDefault Nil (readDir path)

-- The lines, each followed by a newline, as the file's text.
@pub
writeLines : String -> List String -> Result String () ! Fs
writeLines path lines = writeString path (Std.String.unlines lines)

-- Whether every path exists; it stops at the first that does not.
@pub
existsAll : (paths : List String) -> Bool ! Fs
existsAll Nil = True
existsAll (p :: rest) = if exists p then existsAll rest else False

-- Whether some path exists; it stops at the first that does.
@pub
existsAny : (paths : List String) -> Bool ! Fs
existsAny Nil = False
existsAny (p :: rest) = if exists p then True else existsAny rest
