-- Comparing: `Ord`, as Meadow's `Std.Cmp` has it, and comparing by a
-- function passed along, to an `Ordering`, as `Std.Num.Int.compare` is.
--
-- `==` and `<` are the prelude's `PartialEq` and `PartialOrd`. `Ord` says
-- every two values are ordered, and `compare` says how: a type with a
-- `PartialOrd` has it from its `<` unless it says better. (Meadow's `Eq`,
-- a promise with no methods, is not here: `Eq` is propositional equality.)

use Std.Ordering (Ordering)
use Std.Ordering.Ordering.*

@pub
trait PartialOrd a => Ord (a : Type) where
  compare : (x : [] a) -> (y : [] a) -> Ordering
  compare x y = if x < y then Less else if y < x then Greater else Equal

instance Ord Int where

instance Ord Char where

instance Ord String where

-- The smaller of two; the first, if they are equal.
@pub
min : {a : Type} -> Ord a => (x : [] a) -> (y : [] a) -> a
min x y = if y < x then y else x

-- The larger of two; the second, if they are equal.
@pub
max : {a : Type} -> Ord a => (x : [] a) -> (y : [] a) -> a
max x y = if y < x then x else y

-- `x`, kept between `lo` and `hi`.
@pub
clamp : {a : Type} -> Ord a => (lo : [] a) -> (hi : [] a) -> (x : [] a) -> a
clamp lo hi x = min hi (max lo x)

-- The smaller of two, by `cmp`; the first, if they are equal.
@pub
minBy : {a : Type} -> (cmp : ((x : a) -> (y : a) -> Ordering)) -> (x : a) -> (y : a) -> a
minBy cmp x y = case cmp y x of
  Less -> y
  Equal -> x
  Greater -> x

-- The larger of two, by `cmp`; the second, if they are equal.
@pub
maxBy : {a : Type} -> (cmp : ((x : a) -> (y : a) -> Ordering)) -> (x : a) -> (y : a) -> a
maxBy cmp x y = case cmp y x of
  Less -> x
  Equal -> y
  Greater -> y

-- `x`, kept between `lo` and `hi`.
@pub
clampBy : {a : Type} -> (cmp : ((x : a) -> (y : a) -> Ordering)) -> (lo : a) -> (hi : a) -> (x : a) -> a
clampBy cmp lo hi x = minBy cmp hi (maxBy cmp lo x)

-- Comparing by a key: `comparing length Std.Num.Int.compare` compares
-- lists by how long they are.
@pub
comparing : {a b : Type} -> (key : ((x : a) -> b)) -> (cmp : ((x : b) -> (y : b) -> Ordering)) -> (x : a) -> (y : a) -> Ordering
comparing key cmp x y = cmp (key x) (key y)

-- The other way round: largest first.
@pub
reversed : {a : Type} -> (cmp : ((x : a) -> (y : a) -> Ordering)) -> (x : a) -> (y : a) -> Ordering
reversed cmp x y = cmp y x

-- By `first`, and where that finds them equal, by `second`.
@pub
thenBy : {a : Type} -> (first : ((x : a) -> (y : a) -> Ordering)) -> (second : ((x : a) -> (y : a) -> Ordering)) -> (x : a) -> (y : a) -> Ordering
thenBy first second x y = case first x y of
  Less -> Less
  Equal -> second x y
  Greater -> Greater

-- Whether `cmp` finds them equal.
@pub
equalBy : {a : Type} -> (cmp : ((x : a) -> (y : a) -> Ordering)) -> (x : a) -> (y : a) -> Bool
equalBy cmp x y = Std.Ordering.isEqual (cmp x y)

-- Whether `x` comes before `y`.
@pub
lessBy : {a : Type} -> (cmp : ((x : a) -> (y : a) -> Ordering)) -> (x : a) -> (y : a) -> Bool
lessBy cmp x y = Std.Ordering.isLess (cmp x y)

-- Two lists, element by element: the first that differs decides, and a
-- list that runs out first is the smaller.
@pub
lexicographic : {a : Type} -> (cmp : ((x : a) -> (y : a) -> Ordering)) -> (xs : List a) -> (ys : List a) -> Ordering
lexicographic cmp Nil Nil = Equal
lexicographic cmp Nil (y :: ys) = Less
lexicographic cmp (x :: xs) Nil = Greater
lexicographic cmp (x :: xs) (y :: ys) = case cmp x y of
  Less -> Less
  Equal -> lexicographic cmp xs ys
  Greater -> Greater

@pub
compareBool : (x : Bool) -> (y : Bool) -> Ordering
compareBool x y = if x then (if y then Equal else Greater) else (if y then Less else Equal)
