-- `Result a b`, which the prelude declares: an error `Err a`, or `Ok` a
-- `b`. What the world's operations give back.

@pub
isOk : {a b : Type} -> (r : Result a b) -> Bool
isOk (Err err) = False
isOk (Ok x) = True

@pub
isErr : {a b : Type} -> (r : Result a b) -> Bool
isErr (Err err) = True
isErr (Ok x) = False

-- What it is if it is `Ok`, or `default`; the error is dropped.
@pub
withDefault : {a b : Type} -> (default : b) -> (r : Result a b) -> b
withDefault d (Err err) = d
withDefault d (Ok x) = x

@pub
map : {a b c : Type} -> (f : ((x : b) -> c ! e)) -> (v : Result a b) -> Result a c ! e
map f (Err err) = Err err
map f (Ok x) = Ok (f x)

@pub
mapErr : {a d b : Type} -> (f : ((err : a) -> d ! e)) -> (v : Result a b) -> Result d b ! e
mapErr f (Err err) = Err (f err)
mapErr f (Ok x) = Ok x

-- `f` of the value, if there is one, which may itself fail.
@pub
andThen : {a b c : Type} -> (f : ((x : b) -> Result a c ! e)) -> (v : Result a b) -> Result a c ! e
andThen f (Err err) = Err err
andThen f (Ok x) = f x

-- Either way, one answer: `onErr` of the error or `onOk` of the value.
@pub
fold : {a b c : Type} -> (onErr : a -> c ! e) -> (onOk : b -> c ! e) -> (v : Result a b) -> c ! e
fold f g (Err err) = f err
fold f g (Ok x) = g x

@pub
toMaybe : {a b : Type} -> (r : Result a b) -> Maybe b
toMaybe (Err err) = Nothing
toMaybe (Ok x) = Just x
