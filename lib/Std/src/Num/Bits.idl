-- A single-bit mask: `bit n` is `1` shifted left `n`.
@pub
bit : (n : [] Int) -> Int
bit n = shl 1 n

-- The mask with the low `n` bits set (`lowMask 8` is 255).
@pub
lowMask : (n : [] Int) -> Int
lowMask n = bit n - 1

-- Is bit `n` of `x` set?
@pub
testBit : (x : [] Int) -> (n : [] Int) -> Bool
testBit x n = bitAnd (shr x n) 1 == 1

@pub
setBit : (x : [] Int) -> (n : [] Int) -> Int
setBit x n = bitOr x (bit n)

@pub
clearBit : (x : [] Int) -> (n : [] Int) -> Int
clearBit x n = bitAnd x (bitNot (bit n))

@pub
flipBit : (x : [] Int) -> (n : [] Int) -> Int
flipBit x n = bitXor x (bit n)
