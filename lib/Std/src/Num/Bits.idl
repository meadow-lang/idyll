-- Bit twiddling, as Meadow's `Std.Num.Bits` has it, on `Int` and the sized
-- integers: `bitAnd`, `bitOr`, `bitXor`, `bitNot`, the shifts `shl`, `shr`
-- and `ushr`, and `popCount`, each one of Meadow's primitives at the type's
-- width. A shift amount, like every bit position here, is an `Int` whatever
-- is shifted, taken modulo the width; `shr` is arithmetic on a signed type
-- and logical on an unsigned one, and `ushr` is logical on both.

@pub
trait Bits (a : Type) where
  bitAnd : (x : [] a) -> (y : [] a) -> a
  bitOr : (x : [] a) -> (y : [] a) -> a
  bitXor : (x : [] a) -> (y : [] a) -> a
  bitNot : (x : [] a) -> a
  shl : (x : [] a) -> (n : [] Int) -> a
  shr : (x : [] a) -> (n : [] Int) -> a
  ushr : (x : [] a) -> (n : [] Int) -> a
  popCount : (x : [] a) -> Int

instance Bits Int where
  bitAnd = intBitAnd
  bitOr = intBitOr
  bitXor = intBitXor
  bitNot = intBitNot
  shl = intShl
  shr = intShr
  ushr = intUshr
  popCount = intPopCount

@native
intBitAnd : (x : [] Int) -> (y : [] Int) -> Int

@native
intBitOr : (x : [] Int) -> (y : [] Int) -> Int

@native
intBitXor : (x : [] Int) -> (y : [] Int) -> Int

@native
intBitNot : (x : [] Int) -> Int

@native
intShl : (x : [] Int) -> (n : [] Int) -> Int

@native
intShr : (x : [] Int) -> (n : [] Int) -> Int

@native
intUshr : (x : [] Int) -> (n : [] Int) -> Int

@native
intPopCount : (x : [] Int) -> Int

