-- Generators, as an effect: `yield` hands out a value and carries on, and
-- `collect` gathers every value a computation yields into a list.

@pub
effect Yield (a : Type) where
  yield : a -> ()

-- Every value `body` yields, in order.
@pub
collect : {a : Type} -> (body : (u : ()) -> () ! {Yield a | r}) -> List a ! r
collect body = handle body () with
  return u -> Nil
  yield x k -> x :: k ()

-- Each element of a list, yielded in turn.
@pub
each : {a : Type} -> List a -> () ! Yield a
each Nil = ()
each (x :: rest) = let u = yield x in each rest
