-- The clock, as Meadow's `Std.Time`: the prelude's `Time` effect, which
-- with no handler the runtime answers from the real clock; and with
-- `withClock`, from whatever time you say, which is the point: code that
-- looks at the time is usually the hardest to test, and here it is a
-- two-line handler.
--
-- All times are `Int`s. `now` is milliseconds since the Unix epoch
-- (1970-01-01 UTC) and can jump backwards if the system clock is changed;
-- `monotonic` is nanoseconds from an origin of its own that only ever moves
-- forward, which is what a duration should be measured with. Durations and
-- dates are written the way a person reads them (`formatNanos`,
-- `formatTimestamp`).
--
-- Meadow's `utc` gives an anonymous record; Idyll's records are declared, so
-- here it is a `DateTime`.

use Std.String as S
use Std.Num.Int (abs)
use Std.Collections.Vector (Vector)
use Std.Collections.Vector as V

-- --- units -------------------------------------------------------------------

@pub
millisPerSecond : Int
millisPerSecond = 1000

@pub
millisPerMinute : Int
millisPerMinute = 60000

@pub
millisPerHour : Int
millisPerHour = 3600000

@pub
millisPerDay : Int
millisPerDay = 86400000

@pub
nanosPerMicro : Int
nanosPerMicro = 1000

@pub
nanosPerMilli : Int
nanosPerMilli = 1000000

@pub
nanosPerSecond : Int
nanosPerSecond = 1000000000

@pub
seconds : (n : Int) -> Int
seconds n = n * millisPerSecond

@pub
minutes : (n : Int) -> Int
minutes n = n * millisPerMinute

@pub
hours : (n : Int) -> Int
hours n = n * millisPerHour

@pub
days : (n : Int) -> Int
days n = n * millisPerDay

@pub
toSeconds : (ms : Int) -> Int
toSeconds ms = ms / millisPerSecond

@pub
nanosToMicros : (ns : Int) -> Int
nanosToMicros ns = ns / nanosPerMicro

@pub
nanosToMillis : (ns : Int) -> Int
nanosToMillis ns = ns / nanosPerMilli

@pub
millisToNanos : (ms : Int) -> Int
millisToNanos ms = ms * nanosPerMilli

-- --- measuring ---------------------------------------------------------------

-- What `act` gives, and how many nanoseconds it took, by the monotonic
-- clock, so that a change to the system clock part-way through cannot make
-- a duration negative.
@pub
timed : {a : Type} -> (act : (u : ()) -> a ! {Time | e}) -> (a, Int) ! {Time | e}
timed act =
  let start = monotonic () in
  let result = act () in
  let stop = monotonic () in
  (result, stop - start)

-- How long `act` took, alone.
@pub
elapsed : {a : Type} -> (act : (u : ()) -> a ! {Time | e}) -> Int ! {Time | e}
elapsed act = case timed act of
  (result, ns) -> ns

-- Run `act`, print how long it took as `label: 1.23ms`, and give what it gave.
@pub
time : {a : Type} -> (label : String) -> (act : (u : ()) -> a ! {Time, Console | e}) -> a ! {Time, Console | e}
time label act = case timed act of
  (result, ns) -> let u = putStrLn (label ++ ": " ++ formatNanos ns) in result

-- Run `act` `n` times and print the total and the time a run, as `label:
-- 1.23s for 1_000 runs, 1.23ms each`; give what the last run gave. For
-- something too quick to time once.
@pub
timeRuns : {a : Type} -> (label : String) -> (n : Int) -> (act : (u : ()) -> a ! {Time, Console | e}) -> a ! {Time, Console | e}
timeRuns label n act =
  let runs = if n < 1 then 1 else n in
  case timed (\(u : ()) -> repeatRuns runs act) of
    (result, ns) ->
      let line = label ++ ": " ++ formatNanos ns ++ " for " ++ groupDigits runs ++ " runs, " ++ formatNanos (ns / runs) ++ " each" in
      let u = putStrLn line in
      result

@terminating
repeatRuns : {a : Type} -> (n : Int) -> (act : (u : ()) -> a ! e) -> a ! e
repeatRuns n act = if n <= 1 then act () else let x = act () in repeatRuns (n - 1) act

-- --- handling ----------------------------------------------------------------

-- Run `act` with the clock stopped at `t`: every `now` is `t`, `monotonic`
-- is 0, and `sleep` returns at once.
@pub
withClock : {a : Type} -> (t : Int) -> (act : (u : ()) -> a ! {Time | e}) -> a ! e
withClock t act = handle act () with
  return x -> x
  now u k -> k t
  monotonic u k -> k 0
  sleep ms k -> k ()

-- Run `act` with a clock that starts at `t` and moves on by `tick` at every
-- reading: enough to test code that compares two `now`s, and to have `sleep`
-- move the clock without waiting.
@pub
withTickingClock : {a : Type} -> (t : Int) -> (tick : Int) -> (act : (u : ()) -> a ! {Time | e}) -> a ! e
withTickingClock t tick act = ticking tick act t

ticking : {a : Type} -> (tick : Int) -> (act : (u : ()) -> a ! {Time | e}) -> ((s : Int) -> a ! e) ! e
ticking tick act = handle act () with
  return x -> \(s : Int) -> x
  now u k -> \(s : Int) -> k s (s + tick)
  monotonic u k -> \(s : Int) -> k (s * 1000000) (s + tick)
  sleep ms k -> \(s : Int) -> k () (s + ms)

-- --- durations ---------------------------------------------------------------

maxInt : Int
maxInt = 9223372036854775807

minInt : Int
minInt = 0 - maxInt - 1

-- A duration in nanoseconds, in the unit that reads best, to three
-- significant figures: `742ns`, `1.23µs`, `45.6ms`, `3.21s`, then `2m
-- 05.3s`, `1h 02m 03s` and `3d 04h 05m`. Rounded, not cut short (`999.6µs` is
-- `1.00ms`), and a negative one keeps its sign.
@pub
@terminating
formatNanos : (ns : Int) -> String
formatNanos ns =
  if ns < 0 then "-" ++ formatNanos (if ns == minInt then maxInt else 0 - ns)
  else if ns < 1000 then S.fromInt ns ++ "ns"
  else if ns < 999500 then threeFigures ns nanosPerMicro ++ "µs"
  else if ns < 999500000 then threeFigures ns nanosPerMilli ++ "ms"
  else if ns < 59950000000 then threeFigures ns nanosPerSecond ++ "s"
  else if ns < 3599950000000 then
    let tenths = (ns + 50000000) / 100000000 in
    S.fromInt (tenths / 600) ++ "m " ++ pad2 (tenths % 600 / 10) ++ "." ++ S.fromInt (tenths % 10) ++ "s"
  else if ns < 86399500000000 then
    let secs = (ns + 500000000) / nanosPerSecond in
    S.fromInt (secs / 3600) ++ "h " ++ pad2 (secs % 3600 / 60) ++ "m " ++ pad2 (secs % 60) ++ "s"
  else formatMinutes (roundDiv ns 60000000000)

-- A duration in milliseconds, as `formatNanos` writes it: for any duration a
-- clock can show, counting in minutes past about 292 years, where
-- nanoseconds no longer fit an `Int`.
@pub
@terminating
formatMillis : (ms : Int) -> String
formatMillis ms =
  if ms < 0 then "-" ++ formatMillis (if ms == minInt then maxInt else 0 - ms)
  else if ms < 9223372036854 then formatNanos (ms * nanosPerMilli)
  else formatMinutes (roundDiv ms 60000)

-- `3d 04h 05m`.
formatMinutes : (mins : Int) -> String
formatMinutes mins = groupDigits (mins / 1440) ++ "d " ++ pad2 (mins % 1440 / 60) ++ "h " ++ pad2 (mins % 60) ++ "m"

-- `ns` in `unit`s, rounded to three significant figures: `1.23`, `12.3` or
-- `123`, below `999.5` of them.
threeFigures : (ns : Int) -> (unit : Int) -> String
threeFigures ns unit =
  let hundredths = (ns * 100 + unit / 2) / unit in
  if hundredths < 1000 then S.fromInt (hundredths / 100) ++ "." ++ pad2 (hundredths % 100)
  else
    let tenths = (ns * 10 + unit / 2) / unit in
    if tenths < 1000 then S.fromInt (tenths / 10) ++ "." ++ S.fromInt (tenths % 10)
    else S.fromInt ((ns + unit / 2) / unit)

-- `hh:mm:ss.mmm` of a duration in milliseconds, as a stopwatch shows one;
-- the hours go on counting past a day.
@pub
formatDuration : (ms : Int) -> String
formatDuration ms =
  let n = abs ms in
  let body = pad2 (n / millisPerHour) ++ ":" ++ pad2 (n % millisPerHour / millisPerMinute) ++ ":" ++ pad2 (n % millisPerMinute / millisPerSecond) ++ "." ++ pad3 (n % millisPerSecond) in
  if ms < 0 then "-" ++ body else body

-- --- dates -------------------------------------------------------------------
--
-- Dates and times in UTC, from a count of milliseconds since the Unix epoch,
-- as `now` gives. Proleptic Gregorian, so right for any day an `Int`
-- reaches, before 1970 as well as after. There are no time zones: the
-- runtime has no zone data to read, and a date that quietly used the wrong
-- one would be worse than one that says it is UTC.

-- A date and time taken apart: `month` and `day` count from 1, and
-- `weekday` is ISO's, 1 Monday and 7 Sunday.
@pub
record DateTime = {
  year : Int,
  month : Int,
  day : Int,
  hour : Int,
  minute : Int,
  second : Int,
  millis : Int,
  weekday : Int
}

-- The UTC date and time `ms` milliseconds after the Unix epoch.
@pub
utc : (ms : Int) -> DateTime
utc ms =
  let d = floorDiv ms millisPerDay in
  let inDay = ms - d * millisPerDay in
  -- Howard Hinnant's `civil_from_days`: counting in 400-year eras from
  -- 1 March, so that the leap day is at the end of a year
  let z = d + 719468 in
  let era = floorDiv z 146097 in
  let doe = z - era * 146097 in
  let yoe = (doe - doe / 1460 + doe / 36524 - doe / 146096) / 365 in
  let doy = doe - (365 * yoe + yoe / 4 - yoe / 100) in
  let mp = (5 * doy + 2) / 153 in
  let mo = if mp < 10 then mp + 3 else mp - 9 in
  DateTime {
    year = yoe + era * 400 + (if mo <= 2 then 1 else 0),
    month = mo,
    day = doy - (153 * mp + 2) / 5 + 1,
    hour = inDay / millisPerHour,
    minute = inDay % millisPerHour / millisPerMinute,
    second = inDay % millisPerMinute / millisPerSecond,
    millis = inDay % millisPerSecond,
    -- (1970-01-01 was a Thursday)
    weekday = floorMod (d + 3) 7 + 1
  }

-- ISO 8601, in UTC: `2026-09-14T17:04:05.123Z`.
@pub
formatTimestamp : (ms : Int) -> String
formatTimestamp ms = let t = utc ms in dateOf t ++ "T" ++ clockOf t ++ "Z"

-- The UTC date alone: `2026-09-14`.
@pub
formatDate : (ms : Int) -> String
formatDate ms = dateOf (utc ms)

-- The UTC time of day alone: `17:04:05.123`.
@pub
formatTimeOfDay : (ms : Int) -> String
formatTimeOfDay ms = clockOf (utc ms)

-- For people rather than parsers: `Mon 14 Sep 2026 17:04:05 UTC`.
@pub
formatReadable : (ms : Int) -> String
formatReadable ms =
  let t = utc ms in
  S.slice (weekdayName t.weekday) 0 3 ++ " " ++ S.fromInt t.day ++ " " ++ S.slice (monthName t.month) 0 3 ++ " " ++ yearOf t.year
    ++ " " ++ pad2 t.hour ++ ":" ++ pad2 t.minute ++ ":" ++ pad2 t.second ++ " UTC"

-- How long ago `past` was, as of `at` (both from `now`), in the unit that
-- matters: `just now`, `42s ago`, `5m ago`, `3h ago`, `2d ago`, or `in 5m`
-- for a moment still to come.
@pub
formatAgo : (at : Int) -> (past : Int) -> String
formatAgo at past =
  let d = at - past in
  if abs d < millisPerSecond then "just now"
  else if d > 0 then coarse d ++ " ago"
  else "in " ++ coarse (0 - d)

-- The largest whole unit of a positive duration in milliseconds.
coarse : (ms : Int) -> String
coarse ms =
  if ms < millisPerMinute then S.fromInt (ms / millisPerSecond) ++ "s"
  else if ms < millisPerHour then S.fromInt (ms / millisPerMinute) ++ "m"
  else if ms < millisPerDay then S.fromInt (ms / millisPerHour) ++ "h"
  else groupDigits (ms / millisPerDay) ++ "d"

@pub
monthName : (m : Int) -> String
monthName m = V.getOr "?" monthNames (m - 1)

monthNames : Vector String
monthNames = V.fromList #["January", "February", "March", "April", "May", "June", "July", "August", "September", "October", "November", "December"]

-- The name of ISO weekday `w`: 1 is Monday.
@pub
weekdayName : (w : Int) -> String
weekdayName w = V.getOr "?" weekdayNames (w - 1)

weekdayNames : Vector String
weekdayNames = V.fromList #["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday"]

dateOf : (t : DateTime) -> String
dateOf t = yearOf t.year ++ "-" ++ pad2 t.month ++ "-" ++ pad2 t.day

clockOf : (t : DateTime) -> String
clockOf t = pad2 t.hour ++ ":" ++ pad2 t.minute ++ ":" ++ pad2 t.second ++ "." ++ pad3 t.millis

-- Four digits at least, and a sign before the year 0.
yearOf : (y : Int) -> String
yearOf y = if y < 0 then "-" ++ padTo 4 (0 - y) else padTo 4 y

-- --- arithmetic and digits ---------------------------------------------------

-- Division rounding down, where `/` rounds towards zero: what a date before
-- 1970 needs.
floorDiv : (a : Int) -> (b : Int) -> Int
floorDiv a b =
  let q = a / b in
  if a % b != 0 then (if a < 0 then (if b > 0 then q - 1 else q) else (if b < 0 then q - 1 else q)) else q

-- `n / d` rounded to the nearest, for `n` and `d` above zero, without the
-- overflow of adding half of `d` first.
roundDiv : (n : Int) -> (d : Int) -> Int
roundDiv n d = n / d + (if n % d >= d - n % d then 1 else 0)

floorMod : (a : Int) -> (b : Int) -> Int
floorMod a b = a - floorDiv a b * b

pad2 : (n : Int) -> String
pad2 n = padTo 2 n

pad3 : (n : Int) -> String
pad3 n = padTo 3 n

-- `n`, with zeros before it to at least `width` digits.
padTo : (width : Int) -> (n : Int) -> String
padTo width n =
  let s = S.fromInt n in
  let short = width - S.byteLength s in
  if short > 0 then S.repeat "0" short ++ s else s

-- `1_234_567`, so that a big count reads at a glance.
@terminating
groupDigits : (n : Int) -> String
groupDigits n =
  if n < 0 then "-" ++ groupDigits (0 - n)
  else if n < 1000 then S.fromInt n
  else groupDigits (n / 1000) ++ "_" ++ pad3 (n % 1000)
