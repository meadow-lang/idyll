-- Exceptions, as an effect: `throw` gives up with an error of type `e`,
-- and a handler decides what giving up comes to: `toResult` makes it an
-- `Err`, `catch` a value of its own. Nothing after a `throw` runs: these
-- handlers never resume it.
--
-- A computation that may throw is a function of `()`, as a handler runs
-- one: `toResult (\(u : ()) -> safeDiv 7 0)`.

@pub
effect Exn (e : Type) where
  throw : {a : Type} -> e -> a

-- Run `body`: `Ok` what it gives, or `Err` what it threw.
@pub
toResult : {a b : Type} -> (body : (u : ()) -> b ! {Exn a | e}) -> Result a b ! e
toResult body = handle body () with
  return x -> Ok x
  throw err k -> Err err

-- What `body` gives, or `recover` of what it threw.
@pub
catch : {a b : Type} -> (recover : a -> b ! e) -> (body : (u : ()) -> b ! {Exn a | e}) -> b ! e
catch recover body = handle body () with
  return x -> x
  throw err k -> recover err

-- What `body` gives, or `fallback` if it threw.
@pub
withDefault : {a b : Type} -> (fallback : b) -> (body : ((u : ()) -> b ! {Exn a | e})) -> b ! e
withDefault fallback body = Std.Result.withDefault fallback (toResult body)

-- `Just` what `body` gives, or `Nothing` if it threw.
@pub
toMaybe : {a b : Type} -> (body : ((u : ()) -> b ! {Exn a | e})) -> Maybe b ! e
toMaybe body = Std.Result.toMaybe (toResult body)

-- Whether `body` threw.
@pub
threw : {a b : Type} -> (body : ((u : ()) -> b ! {Exn a | e})) -> Bool ! e
threw body = Std.Result.isErr (toResult body)

-- The value of a `Result`, or its error, thrown.
@pub
ofResult : {a b : Type} -> Result a b -> b ! Exn a
ofResult (Err err) = throw err
ofResult (Ok x) = x

-- The value of a `Maybe`, or `err`, thrown.
@pub
ofMaybe : {a b : Type} -> (err : a) -> Maybe b -> b ! Exn a
ofMaybe err Nothing = throw err
ofMaybe err (Just x) = x

-- Nothing, if `cond` holds; otherwise `err`, thrown.
@pub
ensure : {a : Type} -> Bool -> (err : a) -> () ! Exn a
ensure cond err = if cond then () else throw err

-- Nothing, unless `cond` holds; then `err`, thrown.
@pub
refute : {a : Type} -> Bool -> (err : a) -> () ! Exn a
refute cond err = if cond then throw err else ()
