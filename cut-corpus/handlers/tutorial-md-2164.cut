                                          <idyll:Prelude/DigitFuel.More(v_1) | halt>>>>>>>>>>>>>>>>>>>>>

def idyll:Prelude/digitString (d_22: i64; k_23: ptr) =
  prim eq(d_22, 0; μ̃ v__24: bool.
    prim if(v__24; μ̃ u_49: unit.
      prim eq(d_22, 1; μ̃ v__25: bool.
        prim if(v__25; μ̃ u_47: unit.
          prim eq(d_22, 2; μ̃ v__26: bool.
            prim if(v__26; μ̃ u_45: unit.
              prim eq(d_22, 3; μ̃ v__27: bool.
                prim if(v__27; μ̃ u_43: unit.
                  prim eq(d_22, 4; μ̃ v__28: bool.
                    prim if(v__28; μ̃ u_41: unit.
                      prim eq(d_22, 5; μ̃ v__29: bool.
                        prim if(v__29; μ̃ u_39: unit.
                          prim eq(d_22, 6; μ̃ v__30: bool.
                            prim if(v__30; μ̃ u_37: unit.
                              prim eq(d_22, 7; μ̃ v__31: bool.
                                prim if(v__31; μ̃ u_35: unit.
                                  prim eq(d_22, 8; μ̃ v__32: bool.
                                    prim if(v__32; μ̃ u_33: unit.
                                      <"9" | k_23>, μ̃ u_34: unit.
                                      <"8" | k_23>)), μ̃ u_36: unit.
                                  <"7" | k_23>)), μ̃ u_38: unit.
                              <"6" | k_23>)), μ̃ u_40: unit.
                          <"5" | k_23>)), μ̃ u_42: unit.
                      <"4" | k_23>)), μ̃ u_44: unit.
                  <"3" | k_23>)), μ̃ u_46: unit.
              <"2" | k_23>)), μ̃ u_48: unit.
          <"1" | k_23>)), μ̃ u_50: unit.
      <"0" | k_23>))

def idyll:Prelude/showInt (n_52: i64; k_53: ptr) =
  prim lt(n_52, 0; μ̃ v__54: bool.
    prim if(v__54; μ̃ u_59: unit.
      prim sub(0, n_52; μ̃ v_57: i64.
        idyll:Prelude/negativeDigits(idyll:Prelude/digitFuel, v_57; k_53)), μ̃ u_60: unit.
      idyll:Prelude/negativeDigits(idyll:Prelude/digitFuel, n_52; μ̃ v_58: str.
        prim concatStrings(["-", v_58]; k_53))))

def idyll:Main/dice (x_61: unit; k_62: ptr) =
  perform idyll:Prelude/Random.intBetween(1, 7; k_62)

def idyll:Prelude/negativeDigits (fuel_63: ptr, n_64: i64; k_65: ptr) =
  <fuel_63 | case {
    idyll:Prelude/DigitFuel.Spent =>
      <"" | k_65>;
    idyll:Prelude/DigitFuel.More(fuel_66: ptr) =>
      prim sub(0, 10; μ̃ v_76: i64.
        prim lt(v_76, n_64; μ̃ v__67: bool.
          prim if(v__67; μ̃ u_74: unit.
            prim div(n_64, 10; μ̃ v_72: i64.
              idyll:Prelude/negativeDigits(fuel_66, v_72; μ̃ v_68: str.
                prim mod(n_64, 10; μ̃ v_71: i64.
                  prim sub(0, v_71; μ̃ v_70: i64.
                    idyll:Prelude/digitString(v_70; μ̃ v_69: str.
                      prim concatStrings([v_68, v_69]; k_65)))))), μ̃ u_75: unit.
            prim sub(0, n_64; μ̃ v_73: i64.
              idyll:Prelude/digitString(v_73; k_65)))))
  }>

def idyll:Main/"#entry" (; k_77: ptr) =
  handle {
    idyll:Prelude/Random.nextInt(v__79: unit; r_80: ptr, k_81: ptr) =>
      <r_80 | resume(4; k_81)>;
    idyll:Prelude/Random.intBetween(lo_82: i64, hi_83: i64; r_84: ptr, k_85: ptr) =>
      prim add(lo_82, hi_83; μ̃ v_87: i64.
