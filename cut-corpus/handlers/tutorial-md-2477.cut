def idyll:Prelude/digitString (d_22: i64; k_23: ptr) =
  prim eq(d_22, 0; μ̃ v__24: bool.
    prim if(v__24; μ̃ u_49: unit.
      prim eq(d_22, 1; μ̃ v__25: bool.
