def idyll:Main/compose <'b_79 = d_b_78, 'c_81 = d_c_80, 'a_84 = d_a_83; e_82: Effect> (d_b_78: desc, d_c_80: desc, d_a_83: desc, f_85: ptr, g_86: ptr, x_87: 'a_84; k_88: ptr) =
  <g_86 | apply(x_87; μ̃ v_89: 'b_79.
    <f_85 | apply(v_89; k_88)>)>

def idyll:Main/both (n_91: i64; k_92: ptr) =
  <cocase {
    apply(a_97: i64; k_98: ptr) =>
      idyll:Main/logged(a_97; k_98)
  } | μ̃ v_93: ptr.
    <cocase {
      apply(a_95: i64; k_96: ptr) =>
        idyll:Main/addAsk(a_95; k_96)
    } | μ̃ v_94: ptr.
      idyll:Main/compose(desc(i64), desc(i64), desc(i64), v_93, v_94, n_91; k_92)>>

def idyll:Prelude/negativeDigits (fuel_99: ptr, n_100: i64; k_101: ptr) =
  <fuel_99 | case {
    idyll:Prelude/DigitFuel.Spent =>
      <"" | k_101>;
    idyll:Prelude/DigitFuel.More(fuel_102: ptr) =>
      prim sub(0, 10; μ̃ v_112: i64.
        prim lt(v_112, n_100; μ̃ v__103: bool.
          prim if(v__103; μ̃ u_110: unit.
            prim div(n_100, 10; μ̃ v_108: i64.
              idyll:Prelude/negativeDigits(fuel_102, v_108; μ̃ v_104: str.
                prim mod(n_100, 10; μ̃ v_107: i64.
                  prim sub(0, v_107; μ̃ v_106: i64.
                    idyll:Prelude/digitString(v_106; μ̃ v_105: str.
                      prim concatStrings([v_104, v_105]; k_101)))))), μ̃ u_111: unit.
            prim sub(0, n_100; μ̃ v_109: i64.
              idyll:Prelude/digitString(v_109; k_101)))))
  }>

def idyll:Main/"#entry" (; k_113: ptr) =
  handle {
    idyll:Main/Log.log(v__115: i64; r_116: ptr, k_117: ptr) =>
      <r_116 | resume(unit; k_117)>;
    return(x_118: i64; k_119: ptr) =>
      <x_118 | k_119>
  } in μ b_121.
    handle {
      idyll:Main/Ask.ask(v__122: unit; r_123: ptr, k_124: ptr) =>
        <r_123 | resume(10; k_124)>;
      return(x_125: i64; k_126: ptr) =>
        <x_125 | k_126>
    } in μ b_128.
      idyll:Main/both(1; b_128)
    ; b_121
  ; μ̃ answer_114: i64.
