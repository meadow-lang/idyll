cut 0
entry idyll:Main/"#entry"
answer str

data idyll:Prelude/DigitFuel { Spent; More(ptr) }

data idyll:Prelude/"#Box" <'a0> { Box('a0) }

effect idyll:Main/State { get(unit) -> any; put(any) -> unit }

val idyll:Prelude/digitFuel : ptr =
  <idyll:Prelude/DigitFuel.Spent | μ̃ v_20: ptr.
    <idyll:Prelude/DigitFuel.More(v_20) | μ̃ v_19: ptr.
      <idyll:Prelude/DigitFuel.More(v_19) | μ̃ v_18: ptr.
        <idyll:Prelude/DigitFuel.More(v_18) | μ̃ v_17: ptr.
          <idyll:Prelude/DigitFuel.More(v_17) | μ̃ v_16: ptr.
            <idyll:Prelude/DigitFuel.More(v_16) | μ̃ v_15: ptr.
              <idyll:Prelude/DigitFuel.More(v_15) | μ̃ v_14: ptr.
                <idyll:Prelude/DigitFuel.More(v_14) | μ̃ v_13: ptr.
                  <idyll:Prelude/DigitFuel.More(v_13) | μ̃ v_12: ptr.
                    <idyll:Prelude/DigitFuel.More(v_12) | μ̃ v_11: ptr.
                      <idyll:Prelude/DigitFuel.More(v_11) | μ̃ v_10: ptr.
                        <idyll:Prelude/DigitFuel.More(v_10) | μ̃ v_9: ptr.
                          <idyll:Prelude/DigitFuel.More(v_9) | μ̃ v_8: ptr.
                            <idyll:Prelude/DigitFuel.More(v_8) | μ̃ v_7: ptr.
                              <idyll:Prelude/DigitFuel.More(v_7) | μ̃ v_6: ptr.
                                <idyll:Prelude/DigitFuel.More(v_6) | μ̃ v_5: ptr.
                                  <idyll:Prelude/DigitFuel.More(v_5) | μ̃ v_4: ptr.
                                    <idyll:Prelude/DigitFuel.More(v_4) | μ̃ v_3: ptr.
                                      <idyll:Prelude/DigitFuel.More(v_3) | μ̃ v_2: ptr.
                                        <idyll:Prelude/DigitFuel.More(v_2) | μ̃ v_1: ptr.
                                          <idyll:Prelude/DigitFuel.More(v_1) | halt>>>>>>>>>>>>>>>>>>>>>

val idyll:Main/run : ptr =
  handle {
    idyll:Main/State.get(v__72: unit; r_73: ptr, k_74: ptr) =>
      <cocase {
        apply(s_75: i64; k_76: ptr) =>
          <r_73 | apply(idyll:Prelude/"#Box".Box(s_75); μ̃ g_77: ptr.
            <g_77 | apply(s_75; k_76)>)>
      } | k_74>;
    idyll:Main/State.put(b_79: ptr; r_80: ptr, k_81: ptr) =>
      <b_79 | case {
        idyll:Prelude/"#Box".Box(s2_78: i64) =>
          <cocase {
            apply(s_82: i64; k_83: ptr) =>
              <r_80 | apply(unit; μ̃ g_84: ptr.
                <g_84 | apply(s2_78; k_83)>)>
          } | k_81>
      }>;
    return(x_85: i64; k_86: ptr) =>
      <cocase {
        apply(s_87: i64; k_88: ptr) =>
          <x_85 | k_88>
      } | k_86>
  } in μ b_90.
    idyll:Main/counter(unit; b_90)
  ; halt

def idyll:Prelude/digitString (d_22: i64; k_23: ptr) =
  prim eq(d_22, 0; μ̃ v__24: bool.
    prim if(v__24; μ̃ u_49: unit.
      prim eq(d_22, 1; μ̃ v__25: bool.
        prim if(v__25; μ̃ u_47: unit.
          prim eq(d_22, 2; μ̃ v__26: bool.
            prim if(v__26; μ̃ u_45: unit.
              prim eq(d_22, 3; μ̃ v__27: bool.
                prim if(v__27; μ̃ u_43: unit.
                  prim eq(d_22, 4; μ̃ v__28: bool.
                    prim if(v__28; μ̃ u_41: unit.
                      prim eq(d_22, 5; μ̃ v__29: bool.
                        prim if(v__29; μ̃ u_39: unit.
                          prim eq(d_22, 6; μ̃ v__30: bool.
                            prim if(v__30; μ̃ u_37: unit.
                              prim eq(d_22, 7; μ̃ v__31: bool.
                                prim if(v__31; μ̃ u_35: unit.
                                  prim eq(d_22, 8; μ̃ v__32: bool.
                                    prim if(v__32; μ̃ u_33: unit.
                                      <"9" | k_23>, μ̃ u_34: unit.
                                      <"8" | k_23>)), μ̃ u_36: unit.
                                  <"7" | k_23>)), μ̃ u_38: unit.
                              <"6" | k_23>)), μ̃ u_40: unit.
                          <"5" | k_23>)), μ̃ u_42: unit.
                      <"4" | k_23>)), μ̃ u_44: unit.
                  <"3" | k_23>)), μ̃ u_46: unit.
              <"2" | k_23>)), μ̃ u_48: unit.
          <"1" | k_23>)), μ̃ u_50: unit.
      <"0" | k_23>))

def idyll:Prelude/showInt (n_52: i64; k_53: ptr) =
  prim lt(n_52, 0; μ̃ v__54: bool.
    prim if(v__54; μ̃ u_59: unit.
      prim sub(0, n_52; μ̃ v_57: i64.
        idyll:Prelude/negativeDigits(idyll:Prelude/digitFuel, v_57; k_53)), μ̃ u_60: unit.
      idyll:Prelude/negativeDigits(idyll:Prelude/digitFuel, n_52; μ̃ v_58: str.
        prim concatStrings(["-", v_58]; k_53))))

def idyll:Main/counter (u_62: unit; k_63: ptr) =
  perform idyll:Main/State.get(unit; μ̃ b_70: ptr.
    <b_70 | case {
      idyll:Prelude/"#Box".Box(v_71: i64) =>
        <v_71 | μ̃ a_64: i64.
          prim add(a_64, 1; μ̃ v_69: i64.
            perform idyll:Main/State.put(idyll:Prelude/"#Box".Box(v_69); μ̃ b_65: unit.
              perform idyll:Main/State.get(unit; μ̃ b_67: ptr.
                <b_67 | case {
                  idyll:Prelude/"#Box".Box(v_68: i64) =>
                    <v_68 | μ̃ c_66: i64.
                      prim mul(c_66, 10; k_63)>
                }>)))>
    }>)

def idyll:Prelude/negativeDigits (fuel_91: ptr, n_92: i64; k_93: ptr) =
  <fuel_91 | case {
    idyll:Prelude/DigitFuel.Spent =>
      <"" | k_93>;
    idyll:Prelude/DigitFuel.More(fuel_94: ptr) =>
      prim sub(0, 10; μ̃ v_104: i64.
        prim lt(v_104, n_92; μ̃ v__95: bool.
          prim if(v__95; μ̃ u_102: unit.
            prim div(n_92, 10; μ̃ v_100: i64.
              idyll:Prelude/negativeDigits(fuel_94, v_100; μ̃ v_96: str.
                prim mod(n_92, 10; μ̃ v_99: i64.
                  prim sub(0, v_99; μ̃ v_98: i64.
                    idyll:Prelude/digitString(v_98; μ̃ v_97: str.
                      prim concatStrings([v_96, v_97]; k_93)))))), μ̃ u_103: unit.
            prim sub(0, n_92; μ̃ v_101: i64.
              idyll:Prelude/digitString(v_101; k_93)))))
  }>

def idyll:Main/"#entry" (; k_105: ptr) =
  <idyll:Main/run | apply(4; μ̃ answer_106: i64.
    idyll:Prelude/showInt(answer_106; k_105))>
