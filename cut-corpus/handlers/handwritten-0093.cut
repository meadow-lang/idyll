                                <idyll:Prelude/DigitFuel.More(v_6) | μ̃ v_5: ptr.
                                  <idyll:Prelude/DigitFuel.More(v_5) | μ̃ v_4: ptr.
                                    <idyll:Prelude/DigitFuel.More(v_4) | μ̃ v_3: ptr.
                                      <idyll:Prelude/DigitFuel.More(v_3) | μ̃ v_2: ptr.
                                        <idyll:Prelude/DigitFuel.More(v_2) | μ̃ v_1: ptr.
                                          <idyll:Prelude/DigitFuel.More(v_1) | halt>>>>>>>>>>>>>>>>>>>>>

def idyll:Prelude/digitString (d_22: i64; k_23: ptr) =
  prim eq(d_22, 0; μ̃ v__24: bool.
    prim if(v__24; μ̃ u_49: unit.
      prim eq(d_22, 1; μ̃ v__25: bool.
        prim if(v__25; μ̃ u_47: unit.
          prim eq(d_22, 2; μ̃ v__26: bool.
            prim if(v__26; μ̃ u_45: unit.
              prim eq(d_22, 3; μ̃ v__27: bool.
                prim if(v__27; μ̃ u_43: unit.
                  prim eq(d_22, 4; μ̃ v__28: bool.
                    prim if(v__28; μ̃ u_41: unit.
                      prim eq(d_22, 5; μ̃ v__29: bool.
                        prim if(v__29; μ̃ u_39: unit.
                          prim eq(d_22, 6; μ̃ v__30: bool.
                            prim if(v__30; μ̃ u_37: unit.
                              prim eq(d_22, 7; μ̃ v__31: bool.
                                prim if(v__31; μ̃ u_35: unit.
                                  prim eq(d_22, 8; μ̃ v__32: bool.
                                    prim if(v__32; μ̃ u_33: unit.
                                      <"9" | k_23>, μ̃ u_34: unit.
                                      <"8" | k_23>)), μ̃ u_36: unit.
                                  <"7" | k_23>)), μ̃ u_38: unit.
                              <"6" | k_23>)), μ̃ u_40: unit.
                          <"5" | k_23>)), μ̃ u_42: unit.
                      <"4" | k_23>)), μ̃ u_44: unit.
                  <"3" | k_23>)), μ̃ u_46: unit.
              <"2" | k_23>)), μ̃ u_48: unit.
          <"1" | k_23>)), μ̃ u_50: unit.
      <"0" | k_23>))

def idyll:Prelude/showInt (n_52: i64; k_53: ptr) =
  prim lt(n_52, 0; μ̃ v__54: bool.
    prim if(v__54; μ̃ u_59: unit.
      prim sub(0, n_52; μ̃ v_57: i64.
        idyll:Prelude/negativeDigits(idyll:Prelude/digitFuel, v_57; k_53)), μ̃ u_60: unit.
      idyll:Prelude/negativeDigits(idyll:Prelude/digitFuel, n_52; μ̃ v_58: str.
        prim concatStrings(["-", v_58]; k_53))))

def idyll:Main/twice <e_62: Effect> (f_63: ptr; k_64: ptr) =
  <f_63 | apply(unit; μ̃ v_65: i64.
    <f_63 | apply(unit; μ̃ v_66: i64.
      prim add(v_65, v_66; k_64))>)>

def idyll:Main/logged (u_68: unit; k_69: ptr) =
  perform idyll:Main/Log.log(1; μ̃ x_70: unit.
    perform idyll:Main/Ask.ask(unit; k_69))

def idyll:Main/inner (u_72: unit; k_73: ptr) =
  handle {
    idyll:Main/Ask.ask(v__74: unit; r_75: ptr, k_76: ptr) =>
      perform idyll:Main/Log.log(100; μ̃ y_77: unit.
        <r_75 | resume(5; k_76)>);
    return(x_78: i64; k_79: ptr) =>
      <x_78 | k_79>
  } in μ b_81.
    <cocase {
      apply(a_83: unit; k_84: ptr) =>
        idyll:Main/logged(a_83; k_84)
    } | μ̃ v_82: ptr.
      idyll:Main/twice(v_82; b_81)>
  ; k_73

def idyll:Prelude/negativeDigits (fuel_85: ptr, n_86: i64; k_87: ptr) =
  <fuel_85 | case {
    idyll:Prelude/DigitFuel.Spent =>
      <"" | k_87>;
    idyll:Prelude/DigitFuel.More(fuel_88: ptr) =>
      prim sub(0, 10; μ̃ v_98: i64.
        prim lt(v_98, n_86; μ̃ v__89: bool.
          prim if(v__89; μ̃ u_96: unit.
            prim div(n_86, 10; μ̃ v_94: i64.
              idyll:Prelude/negativeDigits(fuel_88, v_94; μ̃ v_90: str.
                prim mod(n_86, 10; μ̃ v_93: i64.
                  prim sub(0, v_93; μ̃ v_92: i64.
                    idyll:Prelude/digitString(v_92; μ̃ v_91: str.
                      prim concatStrings([v_90, v_91]; k_87)))))), μ̃ u_97: unit.
            prim sub(0, n_86; μ̃ v_95: i64.
              idyll:Prelude/digitString(v_95; k_87)))))
  }>

def idyll:Main/"#entry" (; k_99: ptr) =
  handle {
    idyll:Main/Log.log(n_101: i64; r_102: ptr, k_103: ptr) =>
      <r_102 | resume(unit; μ̃ v_104: i64.
        prim add(n_101, v_104; k_103))>;
    return(x_105: i64; k_106: ptr) =>
      <x_105 | k_106>
  } in μ b_108.
    idyll:Main/inner(unit; b_108)
  ; μ̃ answer_100: i64.
