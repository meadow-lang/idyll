-- | orZero : Maybe Int -> Int
-- | orZero (Just n) = n
-- | orZero Nothing = 0
-- | 
-- | (unbox (Just 3), orZero (Just 4), let b = Just 7 in unbox b)
answer: (3, 4, 7)
exit: 0
