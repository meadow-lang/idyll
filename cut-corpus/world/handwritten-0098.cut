effect idyll:Prelude/Console { putStr(str) -> unit; putErr(str) -> unit; readLine(unit) -> ptr }

val idyll:Prelude/digitFuel : ptr =
  <idyll:Prelude/DigitFuel.Spent | μ̃ v_24: ptr.
    <idyll:Prelude/DigitFuel.More(v_24) | μ̃ v_23: ptr.
      <idyll:Prelude/DigitFuel.More(v_23) | μ̃ v_22: ptr.
        <idyll:Prelude/DigitFuel.More(v_22) | μ̃ v_21: ptr.
          <idyll:Prelude/DigitFuel.More(v_21) | μ̃ v_20: ptr.
            <idyll:Prelude/DigitFuel.More(v_20) | μ̃ v_19: ptr.
              <idyll:Prelude/DigitFuel.More(v_19) | μ̃ v_18: ptr.
                <idyll:Prelude/DigitFuel.More(v_18) | μ̃ v_17: ptr.
                  <idyll:Prelude/DigitFuel.More(v_17) | μ̃ v_16: ptr.
                    <idyll:Prelude/DigitFuel.More(v_16) | μ̃ v_15: ptr.
                      <idyll:Prelude/DigitFuel.More(v_15) | μ̃ v_14: ptr.
                        <idyll:Prelude/DigitFuel.More(v_14) | μ̃ v_13: ptr.
                          <idyll:Prelude/DigitFuel.More(v_13) | μ̃ v_12: ptr.
                            <idyll:Prelude/DigitFuel.More(v_12) | μ̃ v_11: ptr.
                              <idyll:Prelude/DigitFuel.More(v_11) | μ̃ v_10: ptr.
                                <idyll:Prelude/DigitFuel.More(v_10) | μ̃ v_9: ptr.
                                  <idyll:Prelude/DigitFuel.More(v_9) | μ̃ v_8: ptr.
                                    <idyll:Prelude/DigitFuel.More(v_8) | μ̃ v_7: ptr.
                                      <idyll:Prelude/DigitFuel.More(v_7) | μ̃ v_6: ptr.
                                        <idyll:Prelude/DigitFuel.More(v_6) | μ̃ v_5: ptr.
                                          <idyll:Prelude/DigitFuel.More(v_5) | halt>>>>>>>>>>>>>>>>>>>>>

def idyll:Prelude/putStrLn (s_2: str; k_3: ptr) =
  prim concatStrings([s_2, "\n"]; μ̃ v_4: str.
    perform idyll:Prelude/Console.putStr(v_4; k_3))

def idyll:Prelude/digitString (d_26: i64; k_27: ptr) =
  prim eq(d_26, 0; μ̃ v__28: bool.
    prim if(v__28; μ̃ u_53: unit.
      prim eq(d_26, 1; μ̃ v__29: bool.
        prim if(v__29; μ̃ u_51: unit.
          prim eq(d_26, 2; μ̃ v__30: bool.
            prim if(v__30; μ̃ u_49: unit.
              prim eq(d_26, 3; μ̃ v__31: bool.
                prim if(v__31; μ̃ u_47: unit.
                  prim eq(d_26, 4; μ̃ v__32: bool.
                    prim if(v__32; μ̃ u_45: unit.
                      prim eq(d_26, 5; μ̃ v__33: bool.
                        prim if(v__33; μ̃ u_43: unit.
                          prim eq(d_26, 6; μ̃ v__34: bool.
                            prim if(v__34; μ̃ u_41: unit.
                              prim eq(d_26, 7; μ̃ v__35: bool.
                                prim if(v__35; μ̃ u_39: unit.
                                  prim eq(d_26, 8; μ̃ v__36: bool.
                                    prim if(v__36; μ̃ u_37: unit.
                                      <"9" | k_27>, μ̃ u_38: unit.
                                      <"8" | k_27>)), μ̃ u_40: unit.
                                  <"7" | k_27>)), μ̃ u_42: unit.
                              <"6" | k_27>)), μ̃ u_44: unit.
                          <"5" | k_27>)), μ̃ u_46: unit.
                      <"4" | k_27>)), μ̃ u_48: unit.
                  <"3" | k_27>)), μ̃ u_50: unit.
              <"2" | k_27>)), μ̃ u_52: unit.
          <"1" | k_27>)), μ̃ u_54: unit.
      <"0" | k_27>))

def idyll:Prelude/showInt (n_56: i64; k_57: ptr) =
  prim lt(n_56, 0; μ̃ v__58: bool.
    prim if(v__58; μ̃ u_63: unit.
      prim sub(0, n_56; μ̃ v_61: i64.
        idyll:Prelude/negativeDigits(idyll:Prelude/digitFuel, v_61; k_57)), μ̃ u_64: unit.
      idyll:Prelude/negativeDigits(idyll:Prelude/digitFuel, n_56; μ̃ v_62: str.
        prim concatStrings(["-", v_62]; k_57))))

def idyll:Prelude/printInt (n_66: i64; k_67: ptr) =
  idyll:Prelude/showInt(n_66; μ̃ v_68: str.
    idyll:Prelude/putStrLn(v_68; k_67))

def idyll:Main/main (x_70: unit; k_71: ptr) =
  perform idyll:Prelude/Console.putStr("counting: "; μ̃ u_72: unit.
    idyll:Main/count(3; k_71))

def idyll:Prelude/negativeDigits (fuel_74: ptr, n_75: i64; k_76: ptr) =
  <fuel_74 | case {
    idyll:Prelude/DigitFuel.Spent =>
      <"" | k_76>;
    idyll:Prelude/DigitFuel.More(fuel_77: ptr) =>
      prim sub(0, 10; μ̃ v_87: i64.
        prim lt(v_87, n_75; μ̃ v__78: bool.
          prim if(v__78; μ̃ u_85: unit.
            prim div(n_75, 10; μ̃ v_83: i64.
              idyll:Prelude/negativeDigits(fuel_77, v_83; μ̃ v_79: str.
                prim mod(n_75, 10; μ̃ v_82: i64.
                  prim sub(0, v_82; μ̃ v_81: i64.
                    idyll:Prelude/digitString(v_81; μ̃ v_80: str.
                      prim concatStrings([v_79, v_80]; k_76)))))), μ̃ u_86: unit.
            prim sub(0, n_75; μ̃ v_84: i64.
              idyll:Prelude/digitString(v_84; k_76)))))
  }>

def idyll:Main/count (n_88: i64; k_89: ptr) =
  prim eq(n_88, 0; μ̃ v__90: bool.
    prim if(v__90; μ̃ u_93: unit.
      idyll:Prelude/printInt(n_88; μ̃ u_91: unit.
        prim sub(n_88, 1; μ̃ v_92: i64.
          idyll:Main/count(v_92; k_89))), μ̃ u_94: unit.
      idyll:Prelude/putStrLn("liftoff"; k_89)))

def idyll:Main/"#entry" (; k_95: ptr) =
  idyll:Main/main(unit; k_95)
