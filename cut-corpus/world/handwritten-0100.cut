                                        <idyll:Prelude/DigitFuel.More(v_6) | μ̃ v_5: ptr.
                                          <idyll:Prelude/DigitFuel.More(v_5) | halt>>>>>>>>>>>>>>>>>>>>>

def idyll:Prelude/putStrLn (s_2: str; k_3: ptr) =
  prim concatStrings([s_2, "\n"]; μ̃ v_4: str.
    perform idyll:Prelude/Console.putStr(v_4; k_3))

def idyll:Prelude/digitString (d_26: i64; k_27: ptr) =
  prim eq(d_26, 0; μ̃ v__28: bool.
    prim if(v__28; μ̃ u_53: unit.
      prim eq(d_26, 1; μ̃ v__29: bool.
        prim if(v__29; μ̃ u_51: unit.
          prim eq(d_26, 2; μ̃ v__30: bool.
            prim if(v__30; μ̃ u_49: unit.
              prim eq(d_26, 3; μ̃ v__31: bool.
                prim if(v__31; μ̃ u_47: unit.
                  prim eq(d_26, 4; μ̃ v__32: bool.
                    prim if(v__32; μ̃ u_45: unit.
                      prim eq(d_26, 5; μ̃ v__33: bool.
                        prim if(v__33; μ̃ u_43: unit.
                          prim eq(d_26, 6; μ̃ v__34: bool.
                            prim if(v__34; μ̃ u_41: unit.
                              prim eq(d_26, 7; μ̃ v__35: bool.
                                prim if(v__35; μ̃ u_39: unit.
                                  prim eq(d_26, 8; μ̃ v__36: bool.
                                    prim if(v__36; μ̃ u_37: unit.
                                      <"9" | k_27>, μ̃ u_38: unit.
                                      <"8" | k_27>)), μ̃ u_40: unit.
                                  <"7" | k_27>)), μ̃ u_42: unit.
                              <"6" | k_27>)), μ̃ u_44: unit.
                          <"5" | k_27>)), μ̃ u_46: unit.
                      <"4" | k_27>)), μ̃ u_48: unit.
                  <"3" | k_27>)), μ̃ u_50: unit.
              <"2" | k_27>)), μ̃ u_52: unit.
          <"1" | k_27>)), μ̃ u_54: unit.
