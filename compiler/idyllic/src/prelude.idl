@native
stringIndexOf : (s : [0..1] String) -> (needle : [0..1] String) -> Int -> Int

@native
stringToChars : (s : [0..1] String) -> Array Char

@native
charsToString : (cs : [0..1] Array Char) -> String

@native
charCode : Char -> Int

@native
charFromCode : Int -> Char

-- Sized integers and floats, as Meadow has them: each wraps at its width,
-- or is an IEEE float, and its operations are natives (one for each type:
-- `int8Add`) that the instances below are made of. A number literal is read
-- at the type wanted, an `Int` or a `Float` if nothing says which. Mixing
-- two types is a type error: a conversion says which is meant, `toInt x`,
-- `toFloat n`, `toInt8 n`, `floor f`. A conversion to a sized integer keeps
-- the low bits.

Int64 : Type
Int64 = Int

Float64 : Type
Float64 = Float

-- An integer type: what its conversions go through; and what an integer
-- literal is read through at a type variable (`fromInt`).
trait Integer (a : Type) where
  toInt : a -> Int
  toFloat : a -> Float
  fromInt : Int -> a

-- A float type; and what a literal with a point is read through at a type
-- variable (`fromFloat`).
trait Floating (a : Type) where
  toFloat64 : a -> Float
  toFloat32 : a -> Float32
  floor : a -> Int
  fromFloat : Float -> a

instance Integer Int where
  toInt n = n
  toFloat = intToFloat
  fromInt n = n

@native
intToFloat : Int -> Float

