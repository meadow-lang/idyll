instance Sub Int8 where
  (-) = int8Sub

instance Mul Int8 where
  (*) = int8Mul

instance Divide Int8 where
  (/) = int8Div

instance Rem Int8 where
  (%) = int8Mod

instance PartialEq Int8 where
  (==) = int8Eq

instance PartialOrd Int8 where
  (<) = int8Lt

instance Display Int8 where
  display = int8Show

instance Debug Int8 where
  debug = int8Show

instance Integer Int8 where
  toInt = int8ToInt
  toFloat = int8ToFloat
  fromInt = int8FromInt

toInt64 : {a : Type} -> Integer a => a -> Int64
toInt64 x = toInt x

toInt8 : {a : Type} -> Integer a => a -> Int8
toInt8 x = int8FromInt (toInt x)

