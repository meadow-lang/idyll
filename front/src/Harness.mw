-- The agent harness's operations: what an agent asks of a program to do
-- type-driven development and proofs as a person does at the prompt, each
-- answered as JSON (`Std.Json`), so that what it reads back has structure.
-- They are the prompt's and the language server's own functions (`Session`,
-- `Find`, `Prove`, `Tactic`), reached a third way: the protocol around them,
-- Lingua's `mcp!`, is to come. Each takes a file's text and answers of it;
-- one that changes the program answers the program changed, and the agent
-- keeps it (or its history, to undo).
--
--   check      what is wrong with a file, each where, and its goals
--   goals      the goals, `?name`, each with its type, place and context
--   typeAt     the type of the term at a line and column
--   search     the finder: names, or what fits a type
--   prove      proof search on a goal, or for a type
--   tactic     one step of tactic mode on a goal
--   fill       a goal given a term, if the checker takes it

use Idyll.Session (problemsOf, typeAt, goalFacts, goalsIn, catalogOf, GoalFacts, Proof)
use Idyll.Find as Find
use Idyll.Prove as Prove
use Idyll.Tactic as Tactic
use Idyll.Core as C
use Lingua.Diagnostic (Diagnostic, Severity, severity, message, whereAt)
use Lingua.Lang (Meta)
use Lingua.Repl (Hit)
use Std.Json (Json)
use Std.Json as Js
use Std.Collections.Vector as V
use Std.String as S
use Std.Maybe as M
use Std.Maybe.Maybe.*
use Std.Result.Result.*

-- What is wrong with `text`, each with its severity and where, and how many
-- goals are left.
@pub fun check (text : String) prelude std : Json =
  let ds = problemsOf text prelude std in
  Json.Object [
    ("diagnostics", Json.Array (V.map (\d -> diagnosticJson text d) ds)),
    ("errors", Json.Int (V.len (V.filter (\d -> severity d == Severity.Error) ds))),
    ("goals", Json.Int (V.len (goalsIn text prelude std)))
  ]

fun diagnosticJson (text : String) (d : Diagnostic) : Json =
  let (from, to) = match whereAt d with | Meta.Meta a b -> (a, b) in
  Json.Object [
    ("severity", Json.String (match severity d with | Severity.Error -> "error" | Severity.Warning -> "warning" | Severity.Advice -> "advice")),
    ("message", Json.String (message d)),
    ("start", placeJson text from),
    ("end", placeJson text to)
  ]

-- A byte offset of `text` as a line and a column, each from 1.
fun placeJson (text : String) (at : Int) : Json =
  let (line, column) = lineColumn text at in
  Json.Object [("line", Json.Int line), ("column", Json.Int column)]

fun lineColumn (text : String) (at : Int) : (Int, Int) = counted text (if at > stringByteLength text then stringByteLength text else at) 0 1 1

fun counted (text : String) (at : Int) (i : Int) (line : Int) (column : Int) : (Int, Int) =
  if i >= at then (line, column)
  else if toInt (stringByteAt text i) == 10 then counted text at (i + 1) (line + 1) 1
  else counted text at (i + 1) line (column + 1)

-- A line and a column, each from 1, as a byte offset of `text`.
fun offsetOf (text : String) (line : Int) (column : Int) : Int = offsetFrom text line column 0 1

fun offsetFrom (text : String) (line : Int) (column : Int) (i : Int) (l : Int) : Int =
  if l >= line or i >= stringByteLength text then i + column - 1
  else offsetFrom text line column (i + 1) (if toInt (stringByteAt text i) == 10 then l + 1 else l)

-- The goals of `text`, each its name, type, where it is, and the variables
-- in scope there with their types.
@pub fun goals (text : String) prelude std : Json =
  Json.Array (V.concatMap (\name -> M.unwrapOr [] (M.map (\f -> [goalJson text name f]) (goalFacts text prelude std name))) (goalNames text prelude std))

fun goalJson (text : String) (name : String) (f : GoalFacts) : Json =
  Json.Object [
    ("name", Json.String name),
    ("type", Json.String (C.shown False f.want)),
    ("at", placeJson text (M.unwrapOr 0 (S.indexOf ("?" ++ name) text))),
    ("context", Json.Array (V.map (\l -> match l with | (x, t) -> Json.Object [("name", Json.String x), ("type", Json.String (C.shown False t))]) f.locals))
  ]

fun goalNames (text : String) prelude std : [String] =
  V.map (\g -> S.drop (M.unwrapOr g (M.map (\at -> S.slice g 0 at) (S.indexOf " :" g))) 1) (goalsIn text prelude std)

-- The type of the term at `line` and `column`, and the span it covers.
@pub fun typeAtPlace (text : String) (line : Int) (column : Int) prelude std : Json =
  match typeAt text prelude std (offsetOf text line column) with
  | None -> Json.Null
  | Just (Meta.Meta a b, ty) -> Json.Object [("type", Json.String ty), ("start", placeJson text a), ("end", placeJson text b)]

-- The finder's hits for `query`, a name or a type, among what `text` and
-- the prelude declare.
@pub fun search (text : String) (query : String) prelude std : Json =
  Json.Array
    (V.map
      (\h -> match h with | Hit.Hit name kind from doc insert before -> Json.Object [("name", Json.String name), ("type", Json.String kind), ("from", Json.String from)])
      (Find.found query (catalogOf text prelude std)))

-- Terms for the goal `?name` (or of the type `goal` written out), at most
-- `limit`, each one the checker takes.
@pub fun prove (text : String) (goal : String) (limit : Int) prelude std : Json =
  let catalog = catalogOf text prelude std in
  let found =
    if S.startsWith "?" goal then Prove.provedAt text (S.drop goal 1) catalog prelude std limit
    else Prove.proved text goal catalog prelude std limit
  in
  match found with
  | Ok terms -> Json.Object [("terms", Json.Array (V.map (\t -> Json.String t) terms))]
  | Err why -> Json.Object [("error", Json.String why)]

-- One step of tactic mode on the goal `?name` of `text`: the program with
-- the step taken, and the goals the step made, the first to work on next;
-- or why the step is not taken.
@pub fun tactic (text : String) (goal : String) (step : String) prelude std : Json =
  match Tactic.begin text goal prelude std with
  | Err why -> Json.Object [("error", Json.String why)]
  | Ok p ->
      match Tactic.step p step prelude std (catalogOf text prelude std) with
      | Err why -> Json.Object [("error", Json.String why)]
      | Ok p2 -> Json.Object [("source", Json.String p2.source), ("goals", Json.Array (V.map (\g -> Json.String g) p2.goals))]

-- The goal `?name` of `text` given `term`: the program, if the checker
-- takes it, with the goals left.
@pub fun fill (text : String) (goal : String) (term : String) prelude std : Json = tactic text goal ("exact " ++ term) prelude std

-- --- tests ---------------------------------------------------------------------------

use Std.Test (assertEq)
use Idyll.Session (batchSession, sessionPrelude, sessionStd)

-- `act` given the prelude and Std, as a session has them.
fun withSession act =
  let db = batchSession () in
  let std = sessionStd db 0 in
  act (sessionPrelude db 0) (\u -> std)

@test fun aGoalIsSaidWithItsTypePlaceAndContext () =
  withSession (\prelude std ->
    assertEq
      (goals "half : Int -> Int\nhalf n = ?todo\n" prelude std)
      (Json.Array [Json.Object [
        ("name", Json.String "todo"),
        ("type", Json.String "Int"),
        ("at", Json.Object [("line", Json.Int 2), ("column", Json.Int 10)]),
        ("context", Json.Array [Json.Object [("name", Json.String "n"), ("type", Json.String "Int")]])
      ]])
      "one goal")

@test fun whatIsWrongIsSaidWhere () =
  withSession (\prelude std ->
    let said = check "x : Int\nx = True\n" prelude std in
    let a = assertEq (Js.get "errors" said) (Just (Json.Int 1)) "one error" in
    match Js.get "diagnostics" said with
    | Just (Json.Array ds) ->
        assertEq (M.andThen (\d -> M.andThen (\s -> Js.get "line" s) (Js.get "start" d)) (V.head ds)) (Just (Json.Int 2)) "on the second line"
    | _ -> assertEq True False "diagnostics")

@test fun aTacticStepGivesTheProgramAndItsNewGoals () =
  withSession (\prelude std ->
    let said = tactic "data N = Z | S N\n\nplus : N -> N -> N\nplus m n = ?todo\n" "todo" "cases m" prelude std in
    assertEq (Js.get "goals" said) (Just (Json.Array [Json.String "todo1", Json.String "todo2"])) "a goal for each constructor")

@test fun aTermTheCheckerRefusesIsNoFill () =
  withSession (\prelude std ->
    assertEq (M.isSome (Js.get "error" (fill "x : Int\nx = ?g\n" "g" "True" prelude std))) True "a Bool is no Int")
