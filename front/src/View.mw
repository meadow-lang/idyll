-- The program as Idyll means it, read straight off the lossless tree.
--
-- `syntax!` (`Syntax`) makes a typed view of each of the grammar's rules,
-- named by its labels: a `Lam` node is an `IdyllLam`, whose binders are
-- `idyllLamBinders` and whose body is `idyllLamBody`; a `Term` is an
-- `IdyllTerm`, one of `Lam`, `LetE`, `CaseE`, `IfE`, `HandleE` and `Op`.
-- Those nodes are the syntax: nothing is built from them up front, and
-- everything read from them still knows where it was written.
--
-- What a node means is a function of it. `term` says what an `Expr` is one
-- level down -- an application, a lambda, a `case` -- whose parts are
-- `Expr`s again, read when someone looks at them; `pat` says the same of a
-- pattern. An `Expr` is a node of the tree, or a part of one (a chain's
-- operands, an annotation past its grades), or a term made of others: what
-- the Rust parser (`idyllic-parser`) makes as it goes is made here too --
-- telescopes and lambdas curried, `if` a `case`, a tuple pairs, a record its
-- data type and projections, an effect's alias a definition, attributes on
-- what they go on.
--
-- Where the grammar reads one form for several (it is LL, and chumsky, the
-- Rust parser's, takes things back), what the Rust parser would have made of
-- it is worked out here, in the order it tries them:
--
-- * an item is a declaration -- an equation, `f p = e` or `l + r = e`; a
--   signature, `f : a`; or `f p impossible` -- before it is an expression;
-- * a term read where a pattern is meant is read again as the pattern;
-- * in parentheses, `(x y : [2] a)` is binders where binders may be;
-- * before an arrow, binders and nothing else make a dependent function;
-- * operator chains are grouped by the Rust parser's levels: `*` `/` `%`,
--   then `+` `-` (both to the left), `::` `++` (to the right), then `<` `==`
--   and `..`, which do not chain.
--
-- What is wrong is said where it is found, a `Diagnostic` at the node it is
-- about. `parsed` reads every part of a program once -- writing it out, as
-- `dumped` does -- so that a program the Rust parser does not read is not
-- read here either, before anything is renamed.
--
-- `dumped` is what the parse test compares with the Rust parser's tree, an
-- S-expression a line for each part of the program; the Rust side is in
-- `compiler/idyllic/tests/front.rs`, and the two must stay alike.

use Idyll.Syntax
use Idyll.Syntax.Idyll.*
use Idyll.Hir (Icit, Literal, Visibility, literal)
use Idyll.Layout (layout)
use Lingua.Red as R
use Lingua.Red (Syntax)
use Lingua.Lang (Meta)
use Lingua.Lang.Meta.*
use Lingua.Diagnostic (Diagnostic, errorAt, parseErrors)
use Std.Collections.Vector as V
use Std.String as S
use Std.Char as C
use Std.Maybe as M
use Std.Maybe.Maybe.*
use Std.Result.Result.*

-- --- what a program is ------------------------------------------------------

-- A term or a pattern: where the tree has it, or made of others.
@pub data Expr
  -- a term as written
  = Term IdyllTerm
  -- a chain and its annotation or arrow, its first atoms grades read already
  | Op IdyllOp Int
  -- an operator chain, the same
  | Chain IdyllChain Int
  -- atoms applied to each other, the same
  | App IdyllApp Int
  | Atom IdyllAtom
  -- an effect row
  | Row IdyllRow
  -- `substitute`: the first with the free name replaced by the second
  | Subst Expr String Expr
  | Made Term
  | MadePat Pat

-- The grades on a binder, `[s]` or `(s, r)`: how often the function uses it,
-- and how often the rest of its type mentions it.
@pub data Grade = Grade Expr (Maybe Expr)

-- What a term is, one level down.
@pub data Term
  = Type
  | Var String
  | Lit Literal
  | Pi (Maybe String) Icit (Maybe Grade) Expr Expr
  | Lam Param Expr
  | App Expr Expr
  | Ann Expr Expr
  | Hole
  | BoxIntro Expr
  | Inf
  | Range Expr Expr
  | LetBox String Expr Expr
  | Let [Decl] Expr
  | Case Expr [Alt]
  | Eff Expr Expr
  | Row [Expr] (Maybe Expr)
  | Handle Expr [Clause]
  | Seq [Expr]
  | ArrayLit [Expr]
  | RecordLit String [(String, Expr)]
  | Proj Expr String
  | Update Expr [(String, Expr)]

-- A binder: its name, whether it unboxes (`[x]`), its grades and its type.
@pub data Param = Param String Bool (Maybe Grade) (Maybe Expr)

-- What a pattern is, one level down.
@pub data Pat
  = Bind Param
  | Wild
  | Lit Literal
  | Con String [Expr]
  | As String Expr
  | Dot Expr
  | Seq [Expr]
  | Record String [(String, Expr)]

@pub data Rhs = Plain Expr | Guarded [(Expr, Expr)] | Impossible

-- A pattern, and what it gives.
@pub data Alt = Alt Expr Rhs

-- `op x k -> e`: the operation, the names it binds, and the body.
@pub data Clause = Clause String [String] Expr

@pub data Decl
  = Sig String Expr
  -- the name, its patterns, a type written inline, and what it is
  | Def String [Expr] (Maybe Expr) Rhs
  | Native String Expr

@pub data Ctor = Fields [Expr] | Sig Expr

@pub record Data = {
  name : String,
  params : [(String, Maybe Expr)],
  kind : Maybe Expr,
  ctors : [(String, Ctor)],
  seq : Maybe (String, String),
  visibility : Visibility,
  fields : Maybe [String]
}

-- An operation of an effect: its name, its type, and whether `@many`.
@pub data OpSig = OpSig String Expr Bool

@pub record Effect = {
  name : String,
  params : [(String, Maybe Expr)],
  ops : [OpSig],
  visibility : Visibility
}

@pub record Use = {
  public : Bool,
  path : [String],
  glob : Bool,
  alias : Maybe String,
  names : Maybe [String]
}

@pub record Program = {
  datas : [Data],
  effects : [Effect],
  decls : [Decl],
  uses : [Use],
  visibility : [(String, Visibility)],
  terminating : [String],
  linear : Bool,
  body : Maybe Expr
}

-- --- reading a program --------------------------------------------------------

-- `input`'s program, every part of it read once, or what is wrong with it.
@pub fun parsed (input : String) : Result [Diagnostic] Program ! { Mut | e } =
  let laid = layout input in
  if not (V.isEmpty laid.problems) then
    Err (V.map (\pr -> match pr with | (at, m) -> errorAt (Meta at at) m) laid.problems)
  else
    match parseIdyll input with
    | (g, errs) ->
        if not (V.isEmpty errs) then Err (parseErrors g errs)
        else
          match astIdyll g with
          | None -> Err [errorAt (Meta 0 0) "not a program"]
          | Just file ->
              let p = newRef [] in
              let prog = program p file in
              let all = programText p prog in
              -- a node read twice says what is wrong with it twice
              let wrong = V.foldl (\acc d -> if V.elem d acc then acc else V.pushBack acc d) [] (getRef p) in
              if V.isEmpty wrong then Ok prog else Err wrong

-- What the parse test compares: the program, or `(error)`.
@pub fun dumped (input : String) : String ! { Mut | e } =
  match parsed input with
  | Ok prog -> programText (newRef []) prog
  | Err _ -> "(error)"

-- What `e` is, for a reader that knows it was read once already
-- (`parsed`), and so that nothing in it is wrong.
@pub fun termOf (e : Expr) : Term ! { Mut | e } = term (newRef []) e

@pub fun patOf (e : Expr) : Pat ! { Mut | e } = pat (newRef []) e

-- --- what is wrong --------------------------------------------------------------

type Syn = Syntax Idyll

type Said = Ref [Diagnostic]

fun metaOf (s : Syn) : Meta = match R.textRange s with | (from, to) -> Meta from to

fun bad (p : Said) (at : Syn) (why : String) : () ! { Mut | e } =
  setRef p (V.pushBack (getRef p) (errorAt (metaOf at) why))

-- Whether `f` runs without finding anything wrong, and what it made: to try
-- reading a form as one thing before another.
fun tried f =
  let q = newRef [] in
  let x = f q in
  (V.isEmpty (getRef q), x)

-- The node an `Expr` was read from, if it was.
fun nodeOf (e : Expr) : Maybe Syn =
  match e with
  | Expr.Term t -> Just (syntaxIdyllTerm t)
  | Expr.Op op _ -> Just (syntaxIdyllOp op)
  | Expr.Chain c _ -> Just (syntaxIdyllChain c)
  | Expr.App a _ -> Just (syntaxIdyllApp a)
  | Expr.Atom a -> Just (syntaxIdyllAtom a)
  | Expr.Row r -> Just (syntaxIdyllRow r)
  | Expr.Subst x _ _ -> nodeOf x
  | _ -> None

-- What is wrong with `e`, at its node.
fun badIn (p : Said) (e : Expr) (why : String) : () ! { Mut | e } =
  match nodeOf e with
  | Just s -> bad p s why
  | None -> setRef p (V.pushBack (getRef p) (errorAt (Meta 0 0) why))

-- Items and separators, `entries` (`None` a separator), as the Rust parser
-- takes them: separators first if `leading`, then items a separator apart,
-- and perhaps one after.
fun separated (p : Said) (at : Syn) (entries : [Maybe a]) (leading : Bool) (atLeastOne : Bool) : [a] ! { Mut | e } =
  let seps = \s -> M.isNone s in
  let rest = if leading then V.dropWhile seps entries else entries in
  let starts = match V.head rest with | Just s -> seps s | None -> False in
  let pairs = V.zip rest (V.drop rest 1) in
  let adjacent = V.any (\pr -> match pr with | (a, b) -> seps a == seps b) pairs in
  let items = V.concatMap (\s -> match s with | Just x -> [x] | None -> []) entries in
  let u1 = if starts or adjacent then bad p at "items are a separator apart" else () in
  let u2 = if atLeastOne and V.isEmpty items then bad p at "expected an item" else () in
  items

-- Whether a block's braces, `open` and `close`, are both written or both
-- laid out.
fun braced (p : Said) (at : Syn) (open : Maybe Syn) (close : Maybe Syn) : () ! { Mut | e } =
  let written = isKind TokenLBrace open in
  let closed = isKind TokenRBrace close in
  if written != closed then bad p at "a block's braces do not match" else ()

-- --- the tree -------------------------------------------------------------------

fun isKind (k : Idyll) (t : Maybe Syn) : Bool =
  match t with
  | Just s -> R.kindOf s == k
  | None -> False

fun textOf (t : Maybe Syn) : String =
  match t with
  | Just s -> R.text s
  | None -> ""

-- `xs`'s one element, if it has just one.
fun only (xs : [a]) : Maybe a = if V.len xs == 1 then V.head xs else None

-- A term the grammar says is there.
fun termOr (t : Maybe IdyllTerm) : Expr =
  match t with
  | Just x -> Expr.Term x
  | None -> Expr.Made Term.Hole

fun nameKind (n : IdyllName) : Idyll =
  match idyllNameName n with
  | Just t -> R.kindOf t
  | None -> Unknown

fun nameText (n : IdyllName) : String = textOf (idyllNameName n)

-- A `Name` with nothing after it, of kind `k`.
fun plainName (k : Idyll) (a : IdyllAtom) : Bool =
  match a with
  | IdyllAtom.Name n -> nameKind n == k and M.isNone (idyllNameAs n)
  | _ -> False

fun atomText (a : IdyllAtom) : String =
  match a with
  | IdyllAtom.Name n -> nameText n
  | _ -> ""

fun isHole (a : IdyllAtom) : Bool =
  match a with
  | IdyllAtom.Hole _ -> True
  | _ -> False

-- A chain's first operand's atoms, and its links.
fun firstOf (c : IdyllChain) : [IdyllAtom] =
  match idyllChainFirst c with
  | Just app -> idyllAppAtoms app
  | None -> []

fun linksOf (c : IdyllChain) : [IdyllLink] = idyllChainLinks c

fun opText (l : IdyllLink) : String = textOf (idyllLinkOp l)

fun annotOf (op : IdyllOp) : Maybe IdyllAnnot =
  match idyllOpTail op with
  | Just (IdyllOpTail.Annot a) -> Just a
  | _ -> None

fun hasTail (op : IdyllOp) : Bool = M.isSome (idyllOpTail op)

fun hasArrow (op : IdyllOp) : Bool =
  match idyllOpTail op with
  | Just (IdyllOpTail.Arrow _) -> True
  | _ -> False

-- An `Op`'s chain, as an `Expr` that skips `skip` atoms.
fun chainExpr (op : IdyllOp) (skip : Int) : Expr =
  match idyllOpChain op with
  | Just c -> Expr.Chain c skip
  | None -> Expr.Made Term.Hole

fun appExpr (a : Maybe IdyllApp) : Expr =
  match a with
  | Just x -> Expr.App x 0
  | None -> Expr.Made Term.Hole

-- --- literals --------------------------------------------------------------------

def maxInt = 9223372036854775807

fun digitValue (b : Int) : Int =
  if b >= 48 and b <= 57 then b - 48 else if b >= 97 then b - 87 else b - 55

-- A number, which an `Int` must hold: 64 bits.
fun intLit (p : Said) (num : IdyllNumber) : Int ! { Mut | e } =
  let tok = idyllNumberValue num in
  let k = match tok with | Just t -> R.kindOf t | None -> Unknown in
  let text = textOf tok in
  let radix = if k == TokenHexadecimal then 16 else if k == TokenOctal then 8 else if k == TokenBinary then 2 else 10 in
  let from = if radix == 10 then 0 else 2 in
  let n =
    V.foldl
      (\acc i ->
        match acc with
        | None -> None
        | Just m ->
            let d = digitValue (toInt (stringByteAt text i)) in
            if m > (maxInt - d) / radix then None else Just (m * radix + d))
      (Just 0)
      (V.range from (stringByteLength text))
  in
  match n with
  | Just m -> m
  | None ->
      let u = bad p (syntaxIdyllNumber num) "${text} does not fit in an Int, which is 64 bits" in
      0

-- A string literal's text, its escapes resolved as the Rust lexer resolves
-- them.
fun strLit (p : Said) (lit : IdyllStrLit) : String ! { Mut | e } =
  let text = textOf (idyllStrLitStrToken lit) in
  let inner = stringSlice text 1 (stringByteLength text - 1) in
  S.join "" (unescape p (syntaxIdyllStrLit lit) (S.chars inner) 0 [])

fun unescape (p : Said) (at : Syn) (cs : [Char]) (i : Int) (out : [String]) : [String] ! { Mut | e } =
  match V.get cs i with
  | None -> out
  | Just c ->
      if C.code c != 92 then unescape p at cs (i + 1) (V.pushBack out (C.toString c))
      else
        match V.get cs (i + 1) with
        | None ->
            let u = bad p at "trailing backslash in literal" in
            out
        | Just e ->
            let k = C.code e in
            let simple = escapeOf k in
            if simple >= 0 then unescape p at cs (i + 2) (V.pushBack out (C.toString (C.fromCode simple)))
            else if k == 120 or k == 117 or k == 85 then
              let most = if k == 120 then 2 else if k == 117 then 4 else 8 in
              hexEscape p at cs (i + 2) most 0 0 out
            else
              let u = bad p at "unknown escape sequence" in
              unescape p at cs (i + 2) (V.pushBack out (C.toString e))

fun escapeOf (k : Int) : Int =
  if k == 110 then 10
  else if k == 116 then 9
  else if k == 114 then 13
  else if k == 92 then 92
  else if k == 39 then 39
  else if k == 34 then 34
  else if k == 48 then 0
  else if k == 97 then 7
  else if k == 98 then 8
  else if k == 102 then 12
  else if k == 118 then 11
  else 0 - 1

-- `\x`, `\u`, `\U`: up to `most` hexadecimal digits from `i`.
fun hexEscape (p : Said) (at : Syn) (cs : [Char]) (i : Int) (most : Int) (n : Int) (value : Int) (out : [String]) : [String] ! { Mut | e } =
  let digit = match V.get cs i with | Just d -> C.hexDigitToInt d | None -> None in
  match digit with
  | Just d if n < most -> hexEscape p at cs (i + 1) most (n + 1) (value * 16 + d) out
  | _ ->
      if n == 0 then
        let u = bad p at "an escape needs at least one hexadecimal digit" in
        unescape p at cs i out
      else
        match C.fromCodeSafe value with
        | Just ch -> unescape p at cs i (V.pushBack out (C.toString ch))
        | None ->
            let u = bad p at "invalid Unicode scalar value" in
            unescape p at cs i (V.pushBack out "\u{FFFD}")

-- --- terms -----------------------------------------------------------------------

fun made (t : Term) : Expr = Expr.Made t

fun var (x : String) : Expr = made (Term.Var x)

fun binary (op : String) (l : Expr) (r : Expr) : Expr = made (Term.App (made (Term.App (var op) l)) r)

-- `[]`, any number of uses: `[0..∞]`.
def anyGrade = made (Term.Range (made (Term.Lit (Literal.Int 0))) (made Term.Inf))

-- What `e` is, one level down.
@pub fun term (p : Said) (e : Expr) : Term ! { Mut | e } =
  match e with
  | Expr.Term t -> termNode p t
  | Expr.Op op skip -> opTerm p op skip
  | Expr.Chain c skip -> chainTerm p c skip
  | Expr.App a skip -> appTerm p a skip
  | Expr.Atom a -> atomTerm p a
  | Expr.Row r -> rowOf p r
  | Expr.Subst x name by -> substituted p x name by
  | Expr.Made t -> t
  | Expr.MadePat _ ->
      let u = badIn p e "a pattern is not a term" in
      Term.Hole

fun termNode (p : Said) (t : IdyllTerm) : Term ! { Mut | e } =
  match t with
  | IdyllTerm.Op op -> opTerm p op 0
  | IdyllTerm.Lam l -> lam p l
  | IdyllTerm.LetE l -> letE p l
  | IdyllTerm.CaseE c -> caseE p c
  | IdyllTerm.IfE i -> ifE i
  | IdyllTerm.HandleE h -> handleE p h

-- A chain and what follows it: an annotation, or an arrow -- a dependent one
-- when what is before it is binders. `skip` atoms at its start are grades,
-- read already.
fun opTerm (p : Said) (op : IdyllOp) (skip : Int) : Term ! { Mut | e } =
  match idyllOpTail op with
  | Just (IdyllOpTail.Annot a) -> Term.Ann (chainExpr op skip) (termOr (idyllAnnotTy a))
  | Just (IdyllOpTail.Arrow ar) ->
      let result = comp (idyllArrowResult ar) (idyllArrowEff ar) in
      (match M.andThen (\c -> telescope c skip) (idyllOpChain op) with
       | Just doms ->
           let binders =
             V.concatMap
               (\d ->
                 match d with
                 | (names, icit, annot) ->
                     (match annotation annot with
                      | (g, ty) -> V.map (\x -> (x, icit, g, ty)) names))
               doms
           in
           term p (V.foldr (\b acc -> match b with | (x, icit, g, ty) -> made (Term.Pi (Just x) icit g ty acc)) result binders)
       | None -> Term.Pi None Icit.Explicit None (chainExpr op skip) result)
  | None ->
      (match idyllOpChain op with
       | Just c -> chainTerm p c skip
       | None -> Term.Hole)

-- `t ! row`, or `t`.
fun comp (t : Maybe IdyllTerm) (effects : Maybe IdyllEffects) : Expr =
  match effects with
  | Just e -> made (Term.Eff (termOr t) (rowExpr e))
  | None -> termOr t

fun rowExpr (e : IdyllEffects) : Expr =
  match idyllEffectsRow e with
  | Just r -> Expr.Row r
  | None -> made (Term.Row [] None)

-- Binders and nothing else, before an arrow: `(x y : a) {b : Type}`, each
-- its names, whether it is implicit, and its annotation.
fun telescope (chain : IdyllChain) (skip : Int) : Maybe [([String], Icit, IdyllAnnot)] =
  if not (V.isEmpty (linksOf chain)) then None
  else
    let atoms = V.drop (firstOf chain) skip in
    let doms = V.map domain atoms in
    if not (V.isEmpty atoms) and V.all M.isSome doms then
      Just (V.concatMap (\d -> match d with | Just x -> [x] | None -> []) doms)
    else None

fun domain (a : IdyllAtom) : Maybe ([String], Icit, IdyllAnnot) =
  match a with
  | IdyllAtom.Paren q ->
      M.map
        (\na -> match na with | (ns, an) -> (ns, Icit.Explicit, an))
        (M.andThen (\t -> annotatedNames t False) (only (idyllParenItems q)))
  | IdyllAtom.Braced b if M.isNone (idyllBracedRest b) ->
      M.map
        (\na -> match na with | (ns, an) -> (ns, Icit.Implicit, an))
        (M.andThen (\t -> annotatedNames t False) (only (idyllBracedItems b)))
  | _ -> None

-- `x y : a` in parentheses: the names, and the annotation.
fun annotatedNames (t : IdyllTerm) (wild : Bool) : Maybe ([String], IdyllAnnot) =
  match t with
  | IdyllTerm.Op op ->
      (match (annotOf op, M.andThen (\c -> names c wild) (idyllOpChain op)) with
       | (Just an, Just ns) -> Just (ns, an)
       | _ -> None)
  | _ -> None

-- A chain of names alone, `x y z` (and `_`, if `wild`).
fun names (chain : IdyllChain) (wild : Bool) : Maybe [String] =
  if not (V.isEmpty (linksOf chain)) then None
  else
    let atoms = firstOf chain in
    if V.all (\a -> plainName TokenLowerIdent a or (wild and isHole a)) atoms then
      Just (V.map (\a -> if isHole a then "_" else atomText a) atoms)
    else None

-- What follows a binder's `:`: grades, if it starts with them and goes on,
-- and its type.
fun annotation (annot : IdyllAnnot) : (Maybe Grade, Expr) =
  match idyllAnnotTy annot with
  | Just (IdyllTerm.Op ty) ->
      let atoms = match idyllOpChain ty with | Just c -> firstOf c | None -> [] in
      (match V.get atoms 0 with
       | Just g if V.len atoms >= 2 and isGrade g -> (Just (gradeOf g), Expr.Op ty 1)
       | _ -> (None, Expr.Op ty 0))
  | t -> (None, termOr t)

-- `[s]`, or `(s, r)`.
fun isGrade (a : IdyllAtom) : Bool =
  match a with
  | IdyllAtom.BoxA _ -> True
  | IdyllAtom.Paren q -> V.len (idyllParenItems q) == 2
  | _ -> False

fun gradeOf (g : IdyllAtom) : Grade =
  match g with
  | IdyllAtom.BoxA b ->
      (match idyllBoxAInner b with
       | Just t -> Grade.Grade (Expr.Term t) None
       | None -> Grade.Grade anyGrade None)
  | IdyllAtom.Paren q ->
      let items = idyllParenItems q in
      Grade.Grade (termOr (V.get items 0)) (Just (termOr (V.get items 1)))
  | _ -> Grade.Grade anyGrade None

-- An operator chain, grouped by levels.
fun chainTerm (p : Said) (chain : IdyllChain) (skip : Int) : Term ! { Mut | e } =
  let links = linksOf chain in
  let operands =
    V.append
      [match idyllChainFirst chain with | Just a -> Expr.App a skip | None -> made Term.Hole]
      (V.map (\l -> appExpr (idyllLinkOperand l)) links)
  in
  let ops = V.map opText links in
  let u =
    V.foldl
      (\acc l -> if levelOf (opText l) == 0 then bad p (syntaxIdyllLink l) "not an operator here: ${opText l}" else acc)
      ()
      links
  in
  term p (grouped p (syntaxIdyllChain chain) operands ops 0 (V.len operands - 1) 5)

fun levelOf (op : String) : Int =
  if op == "*" or op == "/" or op == "%" then 1
  else if op == "+" or op == "-" then 2
  else if op == "::" or op == "++" then 3
  else if op == "<" or op == "==" then 4
  else if op == ".." then 5
  else 0

-- Operands `lo` to `hi` and the operators between (operator `i` is after
-- operand `i`), grouped at `level` and tighter.
fun grouped (p : Said) (at : Syn) (xs : [Expr]) (ops : [String]) (lo : Int) (hi : Int) (level : Int) : Expr ! { Mut | e } =
  if level == 0 then V.getOr (made Term.Hole) xs lo
  else
    let here = V.filter (\i -> levelOf (V.getOr "" ops i) == level) (V.range lo hi) in
    if V.isEmpty here then grouped p at xs ops lo hi (level - 1)
    else
      let starts = V.append [lo] (V.map (\i -> i + 1) here) in
      let ends = V.append here [hi] in
      let parts = V.map (\b -> match b with | (s, e) -> grouped p at xs ops s e (level - 1)) (V.zip starts ends) in
      let opNames = V.map (\i -> V.getOr "" ops i) here in
      let n = V.len here in
      let part = \i -> V.getOr (made Term.Hole) parts i in
      if level >= 4 then
        let u = if n > 1 then bad p at "comparisons and intervals do not chain" else () in
        if level == 5 then made (Term.Range (part 0) (part 1)) else binary (V.getOr "" opNames 0) (part 0) (part 1)
      else if level == 3 then
        V.foldr (\i acc -> binary (V.getOr "" opNames i) (part i) acc) (part n) (V.range 0 n)
      else
        V.foldl (\acc i -> binary (V.getOr "" opNames i) acc (part (i + 1))) (part 0) (V.range 0 n)

-- Atoms applied to each other, each with the fields read off it: `f x.y` is
-- `f (x.y)`.
fun appTerm (p : Said) (app : IdyllApp) (skip : Int) : Term ! { Mut | e } =
  let atoms = V.drop (idyllAppAtoms app) skip in
  let terms =
    V.foldl
      (\acc a ->
        match a with
        | IdyllAtom.DotA d ->
            (match V.last acc with
             | Just e -> V.pushBack (V.popBack acc) (made (Term.Proj e (fieldName p d)))
             | None ->
                 let u = bad p (syntaxIdyllDotA d) "a field of nothing" in
                 acc)
        | _ -> V.pushBack acc (Expr.Atom a))
      []
      atoms
  in
  match V.head terms with
  | Just f -> term p (V.foldl (\acc a -> made (Term.App acc a)) f (V.drop terms 1))
  | None -> Term.Hole

fun fieldName (p : Said) (dot : IdyllDotA) : String ! { Mut | e } =
  match idyllDotATarget dot with
  | Just n if plainName TokenLowerIdent n -> atomText n
  | _ ->
      let u = bad p (syntaxIdyllDotA dot) "a field is a lower-case name" in
      "_"

fun atomTerm (p : Said) (a : IdyllAtom) : Term ! { Mut | e } =
  match a with
  | IdyllAtom.Name n ->
      let x = nameText n in
      let u = if M.isSome (idyllNameAs n) then bad p (syntaxIdyllName n) "x@p is a pattern" else () in
      if nameKind n == TokenUpperIdent and x == "True" then Term.Lit (Literal.Bool True)
      else if nameKind n == TokenUpperIdent and x == "False" then Term.Lit (Literal.Bool False)
      else Term.Var x
  | IdyllAtom.Number num -> Term.Lit (Literal.Int (intLit p num))
  | IdyllAtom.StrLit s -> Term.Lit (Literal.Str (strLit p s))
  | IdyllAtom.Hole _ -> Term.Hole
  | IdyllAtom.TypeA _ -> Term.Type
  | IdyllAtom.InfA _ -> Term.Inf
  | IdyllAtom.OpName o ->
      let u =
        if isKind TokenConOpIdent (idyllOpNameOp o) then
          bad p (syntaxIdyllOpName o) "a constructor operator is not a term on its own"
        else ()
      in
      Term.Var (textOf (idyllOpNameOp o))
  | IdyllAtom.Paren q ->
      let items = idyllParenItems q in
      if V.isEmpty items then Term.Lit Literal.Unit else term p (tuple (V.map Expr.Term items))
  | IdyllAtom.BoxA b ->
      (match idyllBoxAInner b with
       | Just t -> Term.BoxIntro (Expr.Term t)
       | None -> Term.BoxIntro anyGrade)
  | IdyllAtom.SeqA s ->
      (match seqShape p s with
       | (items, array) -> if array then Term.ArrayLit items else Term.Seq items)
  | IdyllAtom.Braced b ->
      (match (only (idyllBracedItems b), M.andThen idyllBraceRestFields (idyllBracedRest b)) with
       | (Just e, Just fs) -> Term.Update (Expr.Term e) (fieldVals fs)
       | _ ->
           let u = bad p (syntaxIdyllBraced b) "braces in a term are a record update, { r | x = e }" in
           Term.Hole)
  | IdyllAtom.RecordLit r ->
      Term.RecordLit
        (textOf (idyllRecordLitName r))
        (match idyllRecordLitFields r with | Just fs -> fieldVals fs | None -> [])
  | _ ->
      let u = bad p (syntaxIdyllAtom a) "not a term" in
      Term.Hole

fun fieldVals (fs : IdyllFieldVals) : [(String, Expr)] =
  V.map (\f -> (textOf (idyllFieldValName f), termOr (idyllFieldValValue f))) (idyllFieldValsFields fs)

-- `(a, b, c)`: `(,) a ((,) b c)`; `(a)` is `a`.
fun tuple (items : [Expr]) : Expr =
  let n = V.len items in
  V.foldr (\x acc -> binary "(,)" x acc) (V.getOr (made Term.Hole) items (n - 1)) (V.take items (n - 1))

-- `#[a, b]` or `#[a; b]`: its items, and whether it is an array, as the Rust
-- parser checks them: an array's last `;` may end it, and `#[;]` is empty.
fun seqShape (p : Said) (s : IdyllSeqA) : ([Expr], Bool) ! { Mut | e } =
  let first = idyllSeqAFirst s in
  let rest = V.map (\r -> (isKind TokenSemi (idyllSeqRestSep r), idyllSeqRestItem r)) (idyllSeqARest s) in
  let array = V.any (\r -> match r with | (semi, _) -> semi) rest in
  let n = V.len rest in
  let at = syntaxIdyllSeqA s in
  let u =
    if array then
      let empty = M.isNone first and n == 1 and (match V.get rest 0 with | Just (_, None) -> True | _ -> False) in
      let filled =
        M.isSome first
          and V.all (\i -> match V.get rest i with | Just (_, Just _) -> True | _ -> i + 1 == n) (V.range 0 n)
      in
      if V.any (\r -> match r with | (semi, _) -> not semi) rest then bad p at "an array's elements are separated by ;"
      else if not empty and not filled then bad p at "an array's elements are separated by single semicolons"
      else ()
    else if (M.isNone first and n > 0) or V.any (\r -> match r with | (_, item) -> M.isNone item) rest then
      bad p at "a sequence's elements are separated by single commas"
    else ()
  in
  let items =
    V.append
      (match first with | Just f -> [Expr.Term f] | None -> [])
      (V.concatMap (\r -> match r with | (_, Just t) -> [Expr.Term t] | _ -> []) rest)
  in
  (items, array)

-- A row of effects: `{Log, Div | e}`, `{}`, or one effect, `State Int`.
fun rowOf (p : Said) (r : IdyllRow) : Term ! { Mut | e } =
  match r with
  | IdyllRow.EmptyRow _ -> Term.Row [] None
  | IdyllRow.App app ->
      let atoms = idyllAppAtoms app in
      (match only atoms with
       | Just (IdyllAtom.Braced b) ->
           let labels = V.map Expr.Term (idyllBracedItems b) in
           (match idyllBracedRest b with
            | None -> Term.Row labels None
            | Just rest ->
                if M.isSome (idyllBraceRestFields rest) then
                  let u = bad p (syntaxIdyllBraceRest rest) "a row's tail is an effect" in
                  Term.Row labels None
                else Term.Row labels (Just (termOr (idyllBraceRestTail rest))))
       | _ ->
           let one =
             V.map
               (\a ->
                 match a with
                 | IdyllAtom.Name n if M.isNone (idyllNameAs n) -> var (nameText n)
                 | IdyllAtom.Paren q if V.len (idyllParenItems q) == 1 -> termOr (V.head (idyllParenItems q))
                 | _ ->
                     let u = bad p (syntaxIdyllAtom a) "an effect is a name applied to names" in
                     made Term.Hole)
               atoms
           in
           (match V.head one with
            | Just f -> term p (V.foldl (\acc a -> made (Term.App acc a)) f (V.drop one 1))
            | None -> Term.Hole))

fun lam (p : Said) (l : IdyllLam) : Term ! { Mut | e } =
  let params = V.concatMap (binder p) (idyllLamBinders l) in
  term p (V.foldr (\x acc -> made (Term.Lam x acc)) (termOr (idyllLamBody l)) params)

-- A lambda's binder: `x`, `_`, `[x]`, `(x y)` or `(x y : [2] a)`.
fun binder (p : Said) (a : IdyllAtom) : [Param] ! { Mut | e } =
  let unboxed = match a with | IdyllAtom.BoxA b -> unboxName b | _ -> None in
  if plainName TokenLowerIdent a then [Param.Param (atomText a) False None None]
  else if isHole a then [Param.Param "_" False None None]
  else if M.isSome unboxed then [Param.Param (M.unwrapOr "" unboxed) True None None]
  else
    match a with
    | IdyllAtom.Paren q ->
        (match only (idyllParenItems q) with
         | Just (IdyllTerm.Op op) if not (hasArrow op) ->
             (match (M.andThen (\c -> names c True) (idyllOpChain op), annotOf op) with
              | (Just ns, Just an) ->
                  (match annotation an with
                   | (g, ty) -> V.map (\x -> Param.Param x False g (Just ty)) ns)
              | (Just ns, None) -> V.map (\x -> Param.Param x False None None) ns
              | _ -> badBinder p a)
         | _ -> badBinder p a)
    | _ -> badBinder p a

fun badBinder (p : Said) (a : IdyllAtom) : [Param] ! { Mut | e } =
  let u = bad p (syntaxIdyllAtom a) "not a binder" in
  []

-- `[x]`'s name.
fun unboxName (b : IdyllBoxA) : Maybe String =
  match idyllBoxAInner b with
  | Just (IdyllTerm.Op op) if not (hasTail op) ->
      (match M.andThen (\c -> names c False) (idyllOpChain op) with
       | Just ns if V.len ns == 1 -> V.head ns
       | _ -> None)
  | _ -> None

fun letE (p : Said) (l : IdyllLetE) : Term ! { Mut | e } =
  let at = syntaxIdyllLetE l in
  let u = braced p at (idyllLetEOpen l) (idyllLetEClose l) in
  let entries = V.map (\x -> match x with | IdyllLetEntry.Line y -> Just y | IdyllLetEntry.Sep _ -> None) (idyllLetEEntries l) in
  let lines = separated p at entries False True in
  let body = termOr (idyllLetEBody l) in
  match M.andThen unboxLine (only lines) with
  | Just (x, e) -> Term.LetBox x (Expr.Term e) body
  | None ->
      let decls =
        V.concatMap
          (\ln ->
            match lineItem p ln with
            | Item.Decl d -> [d]
            | _ ->
                let v = bad p (syntaxIdyllLine ln) "expected a declaration" in
                [])
          lines
      in
      Term.Let decls body

-- `[x] = e`, a `let`'s unboxing.
fun unboxLine (l : IdyllLine) : Maybe (String, IdyllTerm) =
  match (idyllLineLhs l, idyllLineRhs l) with
  | (Just (IdyllTerm.Op op), Just (IdyllRhs.Plain plain)) if not (hasTail op) and M.isNone (idyllLineEff l) ->
      (match idyllOpChain op with
       | Just chain if V.isEmpty (linksOf chain) ->
           (match only (firstOf chain) with
            | Just (IdyllAtom.BoxA b) ->
                (match (unboxName b, idyllPlainBody plain) with
                 | (Just x, Just e) -> Just (x, e)
                 | _ -> None)
            | _ -> None)
       | _ -> None)
  | _ -> None

fun caseE (p : Said) (c : IdyllCaseE) : Term ! { Mut | e } =
  let at = syntaxIdyllCaseE c in
  let u = braced p at (idyllCaseEOpen c) (idyllCaseEClose c) in
  let entries = V.map (\x -> match x with | IdyllAltEntry.Alt y -> Just y | IdyllAltEntry.Sep _ -> None) (idyllCaseEEntries c) in
  let alts = separated p at entries False True in
  Term.Case (termOr (idyllCaseEScrutinee c)) (V.map (alt p) alts)

fun chainOr (c : Maybe IdyllChain) : Expr =
  match c with
  | Just x -> Expr.Chain x 0
  | None -> made Term.Hole

fun alt (p : Said) (a : IdyllAlt) : Alt ! { Mut | e } =
  let lhs = chainOr (idyllAltPat a) in
  match idyllAltRhs a with
  | Just (IdyllAltRhs.AltPlain plain) -> Alt.Alt lhs (Rhs.Plain (termOr (idyllAltPlainBody plain)))
  | Just (IdyllAltRhs.AltGuards gs) ->
      Alt.Alt
        lhs
        (Rhs.Guarded (V.map (\g -> (chainOr (idyllAltGuardCond g), termOr (idyllAltGuardBody g))) (idyllAltGuardsGuards gs)))
  | None ->
      (match impossibleCon (pat p lhs) with
       | Just q -> Alt.Alt q Rhs.Impossible
       | None ->
           let u = bad p (syntaxIdyllAlt a) "expected -> or a guard" in
           Alt.Alt lhs Rhs.Impossible)

-- `C x impossible`'s pattern, `C x`.
fun impossibleCon (q : Pat) : Maybe Expr ! { Mut | e } =
  match q with
  | Pat.Con c args ->
      (match V.last args with
       | Just last if isImpossible (patOf last) -> Just (Expr.MadePat (Pat.Con c (V.popBack args)))
       | _ -> None)
  | _ -> None

fun isImpossible (q : Pat) : Bool =
  match q with
  | Pat.Bind (Param.Param x False None None) -> x == "impossible"
  | _ -> False

-- `if c then a else b` is `case c of True -> a; False -> b`.
fun ifE (i : IdyllIfE) : Term =
  Term.Case
    (termOr (idyllIfECond i))
    [
      Alt.Alt (Expr.MadePat (Pat.Lit (Literal.Bool True))) (Rhs.Plain (termOr (idyllIfEYes i))),
      Alt.Alt (Expr.MadePat (Pat.Lit (Literal.Bool False))) (Rhs.Plain (termOr (idyllIfENo i)))
    ]

fun handleE (p : Said) (h : IdyllHandleE) : Term ! { Mut | e } =
  let at = syntaxIdyllHandleE h in
  let u = braced p at (idyllHandleEOpen h) (idyllHandleEClose h) in
  let entries = V.map (\x -> match x with | IdyllClauseEntry.Clause y -> Just y | IdyllClauseEntry.Sep _ -> None) (idyllHandleEEntries h) in
  let clauses = separated p at entries False True in
  Term.Handle
    (termOr (idyllHandleEBody h))
    (V.map
       (\c ->
         Clause.Clause
           (textOf (idyllClauseOp c))
           (V.map
              (\x -> if isKind TokenUnderscore (idyllClauseParamName x) then "_" else textOf (idyllClauseParamName x))
              (idyllClauseParams c))
           (termOr (idyllClauseBody c)))
       clauses)

-- `substitute`: what a record's field type becomes when an earlier field is
-- read off the record. A binder of the same name hides it. Inside a `let`, a
-- `case`, a handler or a record update nothing is replaced, as in
-- `idyllic_ast::substitute`.
fun substituted (p : Said) (x : Expr) (name : String) (by : Expr) : Term ! { Mut | e } =
  let go = \u -> Expr.Subst u name by in
  match term p x with
  | Term.Var y -> if y == name then term p by else Term.Var y
  | Term.Pi y icit g dom cod ->
      let hidden = match y with | Just z -> z == name | None -> False in
      Term.Pi y icit g (go dom) (if hidden then cod else go cod)
  | Term.Lam (Param.Param y unbox g ty) body ->
      Term.Lam (Param.Param y unbox g (M.map go ty)) (if y == name then body else go body)
  | Term.App f a -> Term.App (go f) (go a)
  | Term.Ann e ty -> Term.Ann (go e) (go ty)
  | Term.BoxIntro e -> Term.BoxIntro (go e)
  | Term.Range a b -> Term.Range (go a) (go b)
  | Term.Eff a b -> Term.Eff (go a) (go b)
  | Term.Row ls tail -> Term.Row (V.map go ls) (M.map go tail)
  | Term.Seq es -> Term.Seq (V.map go es)
  | Term.ArrayLit es -> Term.ArrayLit (V.map go es)
  | Term.RecordLit r fs -> Term.RecordLit r (V.map (\f -> match f with | (y, e) -> (y, go e)) fs)
  | Term.Proj e f -> Term.Proj (go e) f
  | t -> t

-- --- patterns --------------------------------------------------------------------

-- What `e`, read as a pattern, is one level down.
@pub fun pat (p : Said) (e : Expr) : Pat ! { Mut | e } =
  match e with
  | Expr.Chain c _ -> patChain p c
  | Expr.App a _ -> patOperand p a
  | Expr.Atom a -> apat p a
  | Expr.Term t -> patOfTerm p t
  | Expr.MadePat q -> q
  | Expr.Subst x _ _ -> pat p x
  | _ ->
      let u = badIn p e "not a pattern" in
      Pat.Wild

-- Patterns joined by `::`, to the right.
fun patChain (p : Said) (chain : IdyllChain) : Pat ! { Mut | e } =
  let links = linksOf chain in
  let operands =
    V.append
      [appExpr (idyllChainFirst chain)]
      (V.map (\l -> appExpr (idyllLinkOperand l)) links)
  in
  let u = V.foldl (\acc l -> if opText l != "::" then bad p (syntaxIdyllLink l) "only :: joins patterns" else acc) () links in
  let n = V.len operands in
  pat
    p
    (V.foldr
       (\l acc -> Expr.MadePat (Pat.Con "::" [l, acc]))
       (V.getOr (Expr.MadePat Pat.Wild) operands (n - 1))
       (V.take operands (n - 1)))

-- A constructor applied to patterns, or one pattern.
fun patOperand (p : Said) (app : IdyllApp) : Pat ! { Mut | e } =
  let atoms = idyllAppAtoms app in
  match V.get atoms 0 with
  | Just c if V.len atoms >= 2 ->
      if plainName TokenUpperIdent c or plainName TokenQualUpper c then
        Pat.Con (atomText c) (V.map Expr.Atom (V.drop atoms 1))
      else
        let u = bad p (syntaxIdyllApp app) "only a constructor is applied in a pattern" in
        Pat.Wild
  | Just a -> apat p a
  | None -> Pat.Wild

-- A term read again as the pattern it is.
fun patOfTerm (p : Said) (t : IdyllTerm) : Pat ! { Mut | e } =
  match t with
  | IdyllTerm.Op op if not (hasTail op) ->
      (match idyllOpChain op with
       | Just c -> patChain p c
       | None -> Pat.Wild)
  | _ ->
      let u = bad p (syntaxIdyllTerm t) "not a pattern" in
      Pat.Wild

fun apat (p : Said) (a : IdyllAtom) : Pat ! { Mut | e } =
  let at = syntaxIdyllAtom a in
  match a with
  | IdyllAtom.Name n ->
      let x = nameText n in
      let nk = nameKind n in
      if nk == TokenLowerIdent then
        match idyllNameAs n with
        | Just tail ->
            (match idyllAsTailPat tail with
             | Just q -> Pat.As x (Expr.Atom q)
             | None -> Pat.As x (Expr.MadePat Pat.Wild))
        | None -> Pat.Bind (Param.Param x False None None)
      else if M.isSome (idyllNameAs n) or nk == TokenQualLower then
        let u = bad p at "not a pattern" in
        Pat.Wild
      else if nk == TokenUpperIdent and x == "True" then Pat.Lit (Literal.Bool True)
      else if nk == TokenUpperIdent and x == "False" then Pat.Lit (Literal.Bool False)
      else Pat.Con x []
  | IdyllAtom.Number num -> Pat.Lit (Literal.Int (intLit p num))
  | IdyllAtom.StrLit s -> Pat.Lit (Literal.Str (strLit p s))
  | IdyllAtom.Hole _ -> Pat.Wild
  | IdyllAtom.Paren q ->
      let items = idyllParenItems q in
      if V.isEmpty items then Pat.Lit Literal.Unit else pat p (tuplePat (V.map Expr.Term items))
  | IdyllAtom.RecordLit r ->
      Pat.Record
        (textOf (idyllRecordLitName r))
        (match idyllRecordLitFields r with
         | Just fs -> fieldVals fs
         | None -> [])
  | IdyllAtom.DotA d ->
      (match idyllDotATarget d with
       | Just (IdyllAtom.Name n) if M.isNone (idyllNameAs n) and nameKind n != TokenQualLower -> Pat.Dot (var (nameText n))
       | Just (IdyllAtom.Paren q) if V.len (idyllParenItems q) == 1 -> Pat.Dot (termOr (V.head (idyllParenItems q)))
       | _ ->
           let u = bad p at "a dot pattern is .x or .(e)" in
           Pat.Wild)
  | IdyllAtom.BoxA b ->
      (match unboxName b with
       | Just x -> Pat.Bind (Param.Param x True None None)
       | None ->
           let u = bad p at "an unboxing pattern is [x]" in
           Pat.Wild)
  | IdyllAtom.SeqA s ->
      (match seqShape p s with
       | (items, array) ->
           let u = if array then bad p at "array patterns are not supported yet" else () in
           Pat.Seq items)
  | _ ->
      let u = bad p at "not a pattern" in
      Pat.Wild

fun tuplePat (items : [Expr]) : Expr =
  let n = V.len items in
  V.foldr
    (\x acc -> Expr.MadePat (Pat.Con "(,)" [x, acc]))
    (V.getOr (Expr.MadePat Pat.Wild) items (n - 1))
    (V.take items (n - 1))

-- An equation's parameters: `(x y : [2] a)` gives each name the annotation;
-- anything else is a pattern.
fun params (atoms : [IdyllAtom]) : [Expr] =
  V.concatMap
    (\a ->
      let group =
        match a with
        | IdyllAtom.Paren q -> M.andThen (\t -> annotatedNames t True) (only (idyllParenItems q))
        | _ -> None
      in
      match group with
      | Just (ns, an) ->
          (match annotation an with
           | (g, ty) -> V.map (\x -> Expr.MadePat (Pat.Bind (Param.Param x False g (Just ty)))) ns)
      | None -> [Expr.Atom a])
    atoms

-- --- declarations ----------------------------------------------------------------

data Item
  = Data Data
  | Record Data [Decl]
  | Effect Effect
  | Decl Decl
  | Use Use
  | Expr Expr
  | Nothing

-- A name an equation or a signature can be for: `f` or `(+)`.
fun declName (a : IdyllAtom) : Maybe String =
  match a with
  | IdyllAtom.OpName o if isKind TokenOpIdent (idyllOpNameOp o) -> Just (textOf (idyllOpNameOp o))
  | _ -> if plainName TokenLowerIdent a then Just (atomText a) else None

fun rhsOf (line : IdyllLine) : Maybe Rhs =
  match idyllLineRhs line with
  | Just (IdyllRhs.Plain plain) -> Just (Rhs.Plain (termOr (idyllPlainBody plain)))
  | Just (IdyllRhs.Guards gs) ->
      Just (Rhs.Guarded (V.map (\g -> (termOr (idyllGuardCond g), termOr (idyllGuardBody g))) (idyllGuardsGuards gs)))
  | None -> None

-- An item's line: an equation, a signature, an operator's equation, an
-- equation with nothing to say -- or else the program's expression.
fun lineItem (p : Said) (line : IdyllLine) : Item ! { Mut | e } =
  let at = syntaxIdyllLine line in
  let effects = idyllLineEff line in
  let rhs = rhsOf line in
  let noEffects = \u -> if M.isSome effects then bad p at "effects go on a type" else () in
  let notEquation = \u -> let v = bad p at "an equation is f x = e or l + r = e" in Item.Nothing in
  match idyllLineLhs line with
  | Just (IdyllTerm.Op op) ->
      let chain = idyllOpChain op in
      let links = match chain with | Just c -> linksOf c | None -> [] in
      let atoms = match chain with | Just c -> firstOf c | None -> [] in
      let named = M.andThen declName (V.head atoms) in
      (match named with
       | Just f if V.isEmpty links and not (hasArrow op) ->
           (match (annotOf op, rhs) with
            | (Just an, Just r) -> Item.Decl (Decl.Def f (params (V.drop atoms 1)) (Just (comp (idyllAnnotTy an) effects)) r)
            | (Just an, None) ->
                if V.len atoms == 1 then Item.Decl (Decl.Sig f (comp (idyllAnnotTy an) effects))
                else expr p at (idyllLineLhs line) effects
            | (None, Just r) ->
                let u = noEffects () in
                Item.Decl (Decl.Def f (params (V.drop atoms 1)) None r)
            | (None, None) ->
                (match impossible atoms with
                 | Just ps if M.isNone effects -> Item.Decl (Decl.Def f ps None Rhs.Impossible)
                 | _ -> expr p at (idyllLineLhs line) effects))
       | _ ->
           (match (only links, rhs) with
            | (Just l, Just r) if isKind TokenOpIdent (idyllLinkOp l) and not (hasTail op) ->
                let u = noEffects () in
                Item.Decl
                  (Decl.Def (opText l) [appExpr (M.andThen idyllChainFirst chain), appExpr (idyllLinkOperand l)] None r)
            | (_, Just _) -> notEquation ()
            | _ -> expr p at (idyllLineLhs line) effects))
  | lhs ->
      (match rhs with
       | Just _ -> notEquation ()
       | None -> expr p at lhs effects)

fun expr (p : Said) (at : Syn) (lhs : Maybe IdyllTerm) (effects : Maybe IdyllEffects) : Item ! { Mut | e } =
  let u = if M.isSome effects then bad p at "effects go on a type" else () in
  Item.Expr (termOr lhs)

-- `f p q impossible`'s patterns, `p q`, if they are patterns.
fun impossible (atoms : [IdyllAtom]) : Maybe [Expr] ! { Mut | e } =
  match V.last atoms with
  | Just last if V.len atoms >= 3 and plainName TokenLowerIdent last and atomText last == "impossible" ->
      let ps = params (V.slice atoms 1 (V.len atoms - 1)) in
      (match tried (\q -> V.map (\x -> patText q x) ps) with
       | (True, _) -> Just ps
       | _ -> None)
  | _ -> None

-- A data type's or an effect's parameter: `a`, or `(a : k)`.
fun typeParam (p : Said) (a : IdyllAtom) : (String, Maybe Expr) ! { Mut | e } =
  if plainName TokenLowerIdent a then (atomText a, None)
  else
    match a with
    | IdyllAtom.Paren q ->
        (match only (idyllParenItems q) with
         | Just (IdyllTerm.Op op) ->
             (match (annotOf op, M.andThen (\c -> names c False) (idyllOpChain op)) with
              | (Just an, Just ns) if V.len ns == 1 -> (V.getOr "" ns 0, Just (termOr (idyllAnnotTy an)))
              | _ -> badParam p a)
         | _ -> badParam p a)
    | _ -> badParam p a

fun badParam (p : Said) (a : IdyllAtom) : (String, Maybe Expr) ! { Mut | e } =
  let u = bad p (syntaxIdyllAtom a) "a parameter is a or (a : k)" in
  ("_", None)

fun ctorName (c : Maybe IdyllCtorName) : String =
  match c with
  | Just (IdyllCtorName.PlainCtor x) -> textOf (idyllPlainCtorName x)
  | Just (IdyllCtorName.ParenCtor x) -> textOf (idyllParenCtorName x)
  | None -> ""

-- A constructor's field: a name, `Type`, or a term in parentheses.
fun fieldTerm (p : Said) (a : IdyllAtom) : Expr ! { Mut | e } =
  match a with
  | IdyllAtom.TypeA _ -> made Term.Type
  | IdyllAtom.Paren q if V.len (idyllParenItems q) == 1 -> termOr (V.head (idyllParenItems q))
  | _ ->
      if plainName TokenUpperIdent a or plainName TokenLowerIdent a then var (atomText a)
      else
        let u = bad p (syntaxIdyllAtom a) "a field is a name, Type or a term in parentheses" in
        made Term.Hole

fun dataDecl (p : Said) (d : IdyllDataDecl) : Data ! { Mut | e } =
  let ctors =
    match idyllDataDeclBody d with
    | Just (IdyllDataBody.Ctors cs) ->
        V.map
          (\c -> (ctorName (idyllCtorName c), Ctor.Fields (V.map (fieldTerm p) (idyllCtorFields c))))
          (idyllCtorsCtors cs)
    | Just (IdyllDataBody.CtorSigs sigs) ->
        let at = syntaxIdyllCtorSigs sigs in
        let u = braced p at (idyllCtorSigsOpen sigs) (idyllCtorSigsClose sigs) in
        let entries =
          V.map (\x -> match x with | IdyllSigEntry.CtorSig y -> Just y | IdyllSigEntry.Sep _ -> None) (idyllCtorSigsEntries sigs)
        in
        V.map
          (\c -> (ctorName (idyllCtorSigName c), Ctor.Sig (termOr (idyllCtorSigTy c))))
          (separated p at entries True False)
    | None -> []
  in
  Data {
    name = textOf (idyllDataDeclName d),
    params = V.map (typeParam p) (idyllDataDeclParams d),
    kind = M.map (\k -> termOr (idyllKindTy k)) (idyllDataDeclKind d),
    ctors,
    seq = None,
    visibility = Visibility.Private,
    fields = None
  }

-- `record Point = { x : Int, y : Int }`: a data type with one constructor,
-- named for the type, and its fields' projections, `Point.x`.
fun recordDecl (p : Said) (d : IdyllRecordDecl) : Item ! { Mut | e } =
  let name = textOf (idyllRecordDeclName d) in
  let ps = V.map (typeParam p) (idyllRecordDeclParams d) in
  let fields = V.map (\f -> (textOf (idyllFieldDeclName f), termOr (idyllFieldDeclTy f))) (idyllRecordDeclFields d) in
  let whole = V.foldl (\acc q -> match q with | (x, _) -> made (Term.App acc (var x))) (var name) ps in
  let ctorTy = V.foldr (\f acc -> match f with | (x, ty) -> made (Term.Pi (Just x) Icit.Explicit None ty acc)) whole fields in
  let decl =
    Data {
      name,
      params = ps,
      kind = None,
      ctors = [(name, Ctor.Sig ctorTy)],
      seq = None,
      visibility = Visibility.Private,
      fields = Just (V.map fst fields)
    }
  in
  let droppable = Grade.Grade (made (Term.Range (made (Term.Lit (Literal.Int 0))) (made (Term.Lit (Literal.Int 1))))) None in
  let projections =
    V.concatMap
      (\i ->
        match V.get fields i with
        | Just (f, ty) ->
            let projection = "${name}.${f}" in
            let ty2 =
              V.foldl
                (\t g -> match g with | (x, _) -> Expr.Subst t x (made (Term.App (var "${name}.${x}") (var "self"))))
                ty
                (V.take fields i)
            in
            let sig = made (Term.Pi (Just "self") Icit.Explicit (Just droppable) whole ty2) in
            let pats =
              V.map
                (\j -> if j == i then Expr.MadePat (Pat.Bind (Param.Param f False None None)) else Expr.MadePat Pat.Wild)
                (V.range 0 (V.len fields))
            in
            [Decl.Sig projection sig, Decl.Def projection [Expr.MadePat (Pat.Con name pats)] None (Rhs.Plain (var f))]
        | None -> [])
      (V.range 0 (V.len fields))
  in
  Item.Record decl projections

-- `effect State (s : Type) where get : () -> s`, or `effect App = {Log, Ask}`,
-- a name for a row: a definition, `App = {Log, Ask}`, its parameters
-- lambdas, each used as often as the row mentions it.
fun effectDecl (p : Said) (d : IdyllEffectDecl) : Item ! { Mut | e } =
  let name = textOf (idyllEffectDeclName d) in
  let ps = V.map (typeParam p) (idyllEffectDeclParams d) in
  match idyllEffectDeclBody d with
  | Just (IdyllEffectBody.OpBlock block) ->
      let at = syntaxIdyllOpBlock block in
      let u = braced p at (idyllOpBlockOpen block) (idyllOpBlockClose block) in
      let entries = V.map (\x -> match x with | IdyllOpEntry.OpSig y -> Just y | IdyllOpEntry.Sep _ -> None) (idyllOpBlockEntries block) in
      let ops =
        V.map
          (\o ->
            let many = M.isSome (idyllOpSigAttr o) in
            let v =
              match idyllOpSigAttr o with
              | Just a -> if textOf (idyllOpAttrName a) != "many" then bad p (syntaxIdyllOpAttr a) "an operation may be @many" else ()
              | None -> ()
            in
            OpSig.OpSig (textOf (idyllOpSigName o)) (termOr (idyllOpSigTy o)) many)
          (separated p at entries True False)
      in
      Item.Effect (Effect { name, params = ps, ops, visibility = Visibility.Private })
  | Just (IdyllEffectBody.EffectAlias alias) ->
      let row = match idyllEffectAliasRow alias with | Just r -> Expr.Row r | None -> made (Term.Row [] None) in
      let body =
        V.foldr
          (\q acc ->
            match q with
            | (x, kind) -> made (Term.Lam (Param.Param x False (Just (Grade.Grade anyGrade None)) (Just (M.unwrapOr (made Term.Type) kind))) acc))
          row
          ps
      in
      Item.Decl (Decl.Def name [] None (Rhs.Plain body))
  | None -> Item.Nothing

fun useDecl (p : Said) (d : IdyllUseDecl) : Use ! { Mut | e } =
  let at = syntaxIdyllUseDecl d in
  let pathTok = idyllUseDeclPath d in
  let path = if isKind TokenQualUpper pathTok then S.split "." (textOf pathTok) else [textOf pathTok] in
  let glob = M.isSome (idyllUseDeclGlob d) in
  let u1 = if glob and textOf (idyllUseDeclGlob d) != ".*" then bad p at "use M.* brings in everything" else () in
  let alias =
    M.map
      (\a ->
        let v = if textOf (idyllUseAliasLowerIdentToken a) != "as" then bad p (syntaxIdyllUseAlias a) "expected as" else () in
        textOf (idyllUseAliasName a))
      (idyllUseDeclAlias d)
  in
  let useNames =
    M.map
      (\ns ->
        let items = idyllUseNamesNames ns in
        let v = if V.isEmpty items then bad p (syntaxIdyllUseNames ns) "a use names something in its parentheses" else () in
        V.map (\n -> match idyllUseNameName n with | Just t -> R.text t | None -> textOf (idyllUseNameOp n)) items)
      (idyllUseDeclNames d)
  in
  let u2 = if glob and (M.isSome alias or M.isSome useNames) then bad p at "use M.* takes no names and no alias" else () in
  Use { public = False, path, glob, alias, names = useNames }

-- --- attributes ------------------------------------------------------------------

data Attribute = Seq String String | Vis Visibility | Native | Terminating | Linear

fun attribute (p : Said) (line : IdyllAttrLine) : Maybe Attribute ! { Mut | e } =
  let name = textOf (idyllAttrLineName line) in
  let args =
    M.map
      (\a ->
        V.map
          (\x -> (textOf (idyllAttrArgKey x), M.map (\v -> ctorName (idyllAttrValueName v)) (idyllAttrArgValue x)))
          (idyllAttrArgsArgs a))
      (idyllAttrLineArgs line)
  in
  let arg = \i -> match args with | Just xs -> V.get xs i | None -> None in
  let count = match args with | Just xs -> V.len xs + 1 | None -> 0 in
  match (name, count, arg 0, arg 1) with
  | ("seq", 3, Just ("nil", Just nil), Just ("cons", Just cons)) -> Just (Attribute.Seq nil cons)
  | ("pub", 0, _, _) -> Just (Attribute.Vis Visibility.Public)
  | ("pub", 2, Just ("pkg", None), _) -> Just (Attribute.Vis Visibility.Package)
  | ("pub", 2, Just ("super", None), _) -> Just (Attribute.Vis Visibility.Super)
  | ("native", 0, _, _) -> Just Attribute.Native
  | ("terminating", 0, _, _) -> Just Attribute.Terminating
  | ("linear", 0, _, _) -> Just Attribute.Linear
  | _ ->
      let u = bad p (syntaxIdyllAttrLine line) "not an attribute: @${name}" in
      None

record Attrs = {
  seq : Maybe (String, String),
  vis : Maybe Visibility,
  native : Bool,
  terminating : Bool,
  linear : Bool
}

-- An item with its attributes on it, as `idyllic-parser`'s `attributed`
-- puts them: the item, how visible it is, whether it is `@terminating`, and
-- whether `@linear` came before it.
fun attributed (p : Said) (at : Syn) (lines : [IdyllAttrLine]) (item : Item) : (Item, Maybe Visibility, Bool, Bool) ! { Mut | e } =
  let twice = \u -> bad p at "this attribute is given twice" in
  let a =
    V.foldl
      (\(acc : Attrs) line ->
        match attribute p line with
        | Just (Attribute.Seq nil cons) ->
            if M.isSome acc.seq then let u = twice () in acc else { acc | seq = Just (nil, cons) }
        | Just (Attribute.Vis v) -> if M.isSome acc.vis then let u = twice () in acc else { acc | vis = Just v }
        | Just Attribute.Native -> if acc.native then let u = twice () in acc else { acc | native = True }
        | Just Attribute.Terminating ->
            if acc.terminating then let u = twice () in acc else { acc | terminating = True }
        | Just Attribute.Linear -> { acc | linear = True }
        | None -> acc)
      (Attrs { seq = None, vis = None, native = False, terminating = False, linear = False })
      lines
  in
  let item =
    if not a.native then item
    else
      match item with
      | Item.Decl (Decl.Sig f ty) -> Item.Decl (Decl.Native f ty)
      | Item.Expr e ->
          (match termOf e with
           | Term.Ann x ty ->
               (match termOf x with
                | Term.Var y if not (S.contains "." y) -> Item.Decl (Decl.Native y ty)
                | _ ->
                    let u = bad p at "@native goes on a signature, f : a" in
                    item)
           | _ ->
               let u = bad p at "@native goes on a signature, f : a" in
               item)
      | _ ->
          let u = bad p at "@native goes on a signature, f : a" in
          item
  in
  let u1 =
    if a.terminating then
      match item with
      | Item.Decl (Decl.Sig _ _) -> ()
      | _ -> bad p at "@terminating goes on a definition's signature, f : a"
    else ()
  in
  let vis = M.unwrapOr Visibility.Private a.vis in
  let seqUsed = match item with | Item.Data _ -> True | _ -> False in
  let item =
    match item with
    | Item.Data (d : Data) -> Item.Data { d | seq = a.seq, visibility = vis }
    | Item.Effect (e : Effect) -> Item.Effect { e | visibility = vis }
    | Item.Record (d : Data) ps -> Item.Record { d | visibility = vis } ps
    | Item.Use (u : Use) ->
        let v =
          match a.vis with
          | Just Visibility.Public -> ()
          | Just _ -> bad p at "a use is given on with @pub, or not at all"
          | None -> ()
        in
        Item.Use { u | public = M.isSome a.vis }
    | Item.Expr e ->
        let v = if M.isSome a.vis or M.isSome a.seq then bad p at "an expression has no attributes" else () in
        item
    | other -> other
  in
  let u2 = if M.isSome a.seq and not seqUsed then bad p at "@seq goes on a data type" else () in
  (item, a.vis, a.terminating, a.linear)

-- --- the program -----------------------------------------------------------------

fun itemOf (p : Said) (it : IdyllItem) : Item ! { Mut | e } =
  match idyllItemBody it with
  | Just (IdyllItemBody.DataDecl d) -> Item.Data (dataDecl p d)
  | Just (IdyllItemBody.RecordDecl d) -> recordDecl p d
  | Just (IdyllItemBody.EffectDecl d) -> effectDecl p d
  | Just (IdyllItemBody.UseDecl d) -> Item.Use (useDecl p d)
  | Just (IdyllItemBody.Line l) -> lineItem p l
  | None -> Item.Nothing

-- The name a definition's visibility is for.
fun defined (d : Decl) : String =
  match d with
  | Decl.Sig x _ -> x
  | Decl.Def x _ _ _ -> x
  | Decl.Native x _ -> x

fun program (p : Said) (file : IdyllFile) : Program ! { Mut | e } =
  let root = syntaxIdyllFile file in
  let entries = V.map (\x -> match x with | IdyllEntry.Item y -> Just y | IdyllEntry.Sep _ -> None) (idyllFileEntries file) in
  let items = separated p root entries True False in
  let n = V.len items in
  V.foldl
    (\(prog : Program) i ->
      match V.get items i with
      | None -> prog
      | Just it ->
          let at = syntaxIdyllItem it in
          (match attributed p at (idyllItemAttrs it) (itemOf p it) with
           | (item, vis, terminating, linear) ->
               let prog = { prog | linear = prog.linear or linear } in
               (match item with
                | Item.Data d -> { prog | datas = V.pushBack prog.datas d }
                | Item.Record d ps ->
                    let shown =
                      if d.visibility == Visibility.Private then []
                      else V.concatMap (\q -> match q with | Decl.Sig x _ -> [(x, d.visibility)] | _ -> []) ps
                    in
                    {
                      prog |
                      decls = V.append prog.decls ps,
                      visibility = V.append prog.visibility shown,
                      datas = V.pushBack prog.datas d
                    }
                | Item.Effect e -> { prog | effects = V.pushBack prog.effects e }
                | Item.Decl d ->
                    {
                      prog |
                      visibility = (match vis with | Just v -> V.pushBack prog.visibility (defined d, v) | None -> prog.visibility),
                      terminating = if terminating then V.pushBack prog.terminating (defined d) else prog.terminating,
                      decls = V.pushBack prog.decls d
                    }
                | Item.Use u -> { prog | uses = V.pushBack prog.uses u }
                | Item.Expr e ->
                    if i + 1 == n then { prog | body = Just e }
                    else
                      let u = bad p at "an expression can only come last in a program" in
                      prog
                | Item.Nothing -> prog)))
    (Program {
       datas = [],
       effects = [],
       decls = [],
       uses = [],
       visibility = [],
       terminating = [],
       linear = False,
       body = None
     })
    (V.range 0 n)

-- --- writing ---------------------------------------------------------------------

-- `(a b c)`
fun sx (parts : [String]) : String = "(" ++ S.join " " parts ++ ")"

fun opt (f : a -> String ! e) (m : Maybe a) : String ! e =
  match m with
  | Just x -> f x
  | None -> "-"

fun flag (yes : String) (b : Bool) : String = if b then yes else "-"

fun gradeText (p : Said) (g : Grade) : String ! { Mut | e } =
  match g with
  | Grade.Grade s t -> sx ["grade", termText p s, opt (termText p) t]

fun paramText (p : Said) (x : Param) : String ! { Mut | e } =
  match x with
  | Param.Param name unbox g ty -> sx ["param", name, flag "unbox" unbox, opt (gradeText p) g, opt (termText p) ty]

fun fieldText (p : Said) (f : (String, Expr)) : String ! { Mut | e } = match f with | (x, e) -> sx [x, termText p e]

-- A term, all of it.
fun termText (p : Said) (e : Expr) : String ! { Mut | e } =
  let go = termText p in
  match term p e with
  | Term.Type -> "Type"
  | Term.Var x -> x
  | Term.Lit l -> literal l
  | Term.Pi x icit g dom cod ->
      sx ["pi", opt (\n -> n) x, (match icit with | Icit.Explicit -> "e" | Icit.Implicit -> "i"), opt (gradeText p) g, go dom, go cod]
  | Term.Lam x body -> sx ["lam", paramText p x, go body]
  | Term.App f a -> sx ["app", go f, go a]
  | Term.Ann x ty -> sx ["ann", go x, go ty]
  | Term.Hole -> "_"
  | Term.BoxIntro x -> sx ["box", go x]
  | Term.Inf -> "inf"
  | Term.Range a b -> sx ["range", go a, go b]
  | Term.LetBox x v body -> sx ["letbox", x, go v, go body]
  | Term.Let ds body -> sx ["let", sx (V.map (declText p) ds), go body]
  | Term.Case x alts -> sx (V.append ["case", go x] (V.map (altText p) alts))
  | Term.Eff b r -> sx ["eff", go b, go r]
  | Term.Row ls tail -> sx ["row", sx (V.map go ls), opt go tail]
  | Term.Handle x cs -> sx (V.append ["handle", go x] (V.map (clauseText p) cs))
  | Term.Seq es -> sx (V.append ["seq"] (V.map go es))
  | Term.ArrayLit es -> sx (V.append ["array"] (V.map go es))
  | Term.RecordLit r fs -> sx (V.append ["record", r] (V.map (fieldText p) fs))
  | Term.Proj x f -> sx ["proj", go x, f]
  | Term.Update x fs -> sx (V.append ["update", go x] (V.map (fieldText p) fs))

-- A pattern, all of it.
fun patText (p : Said) (e : Expr) : String ! { Mut | e } =
  let go = patText p in
  match pat p e with
  | Pat.Bind x -> paramText p x
  | Pat.Wild -> "_"
  | Pat.Lit l -> literal l
  | Pat.Con c ps -> sx (V.append ["con", c] (V.map go ps))
  | Pat.As x q -> sx ["as", x, go q]
  | Pat.Dot x -> sx ["dot", termText p x]
  | Pat.Seq ps -> sx (V.append ["pseq"] (V.map go ps))
  | Pat.Record r fs -> sx (V.append ["precord", r] (V.map (\f -> match f with | (x, q) -> sx [x, go q]) fs))

fun rhsText (p : Said) (r : Rhs) : String ! { Mut | e } =
  match r with
  | Rhs.Plain e -> sx ["=", termText p e]
  | Rhs.Guarded gs -> sx (V.append ["guards"] (V.map (\g -> match g with | (c, e) -> sx [termText p c, termText p e]) gs))
  | Rhs.Impossible -> "impossible"

fun altText (p : Said) (a : Alt) : String ! { Mut | e } =
  match a with
  | Alt.Alt q r -> sx ["alt", patText p q, rhsText p r]

fun clauseText (p : Said) (c : Clause) : String ! { Mut | e } =
  match c with
  | Clause.Clause op xs body -> sx ["clause", op, sx xs, termText p body]

fun declText (p : Said) (d : Decl) : String ! { Mut | e } =
  match d with
  | Decl.Sig f ty -> sx ["sig", f, termText p ty]
  | Decl.Def f ps ty r -> sx ["def", f, sx (V.map (patText p) ps), opt (termText p) ty, rhsText p r]
  | Decl.Native f ty -> sx ["native", f, termText p ty]

fun visibilityText (v : Visibility) : String =
  match v with
  | Visibility.Private -> "private"
  | Visibility.Super -> "super"
  | Visibility.Package -> "package"
  | Visibility.Public -> "public"

fun typeParamText (p : Said) (q : (String, Maybe Expr)) : String ! { Mut | e } =
  match q with | (x, k) -> sx [x, opt (termText p) k]

fun ctorText (p : Said) (c : (String, Ctor)) : String ! { Mut | e } =
  match c with
  | (name, Ctor.Fields ts) -> sx [name, sx (V.append ["fields"] (V.map (termText p) ts))]
  | (name, Ctor.Sig ty) -> sx [name, sx ["sig", termText p ty]]

fun dataText (p : Said) (d : Data) : String ! { Mut | e } =
  sx [
    "data",
    d.name,
    sx (V.map (typeParamText p) d.params),
    opt (termText p) d.kind,
    sx (V.map (ctorText p) d.ctors),
    opt (\s -> match s with | (nil, cons) -> sx ["seq", nil, cons]) d.seq,
    visibilityText d.visibility,
    opt sx d.fields
  ]

fun opSigText (p : Said) (o : OpSig) : String ! { Mut | e } =
  match o with
  | OpSig.OpSig x ty many -> sx ["op", x, flag "many" many, termText p ty]

fun effectText (p : Said) (e : Effect) : String ! { Mut | e } =
  sx ["effect", e.name, sx (V.map (typeParamText p) e.params), sx (V.map (opSigText p) e.ops), visibilityText e.visibility]

fun useText (u : Use) : String =
  sx ["use", flag "pub" u.public, sx u.path, flag "glob" u.glob, opt (\a -> a) u.alias, opt sx u.names]

-- A program, a line for each part: whether it is linear, then its uses, data
-- types, effects, declarations, visibilities, `@terminating`s and body.
fun programText (p : Said) (prog : Program) : String ! { Mut | e } =
  S.join
    "\n"
    (V.concat [
       [sx ["linear", if prog.linear then "true" else "false"]],
       V.map useText prog.uses,
       V.map (dataText p) prog.datas,
       V.map (effectText p) prog.effects,
       V.map (declText p) prog.decls,
       V.map (\v -> match v with | (x, w) -> sx ["vis", x, visibilityText w]) prog.visibility,
       V.map (\x -> sx ["terminating", x]) prog.terminating,
       (match prog.body with | Just e -> [sx ["body", termText p e]] | None -> [])
     ])

-- --- tests -----------------------------------------------------------------------

use Std.Test (assertEq)
use Lingua.Diagnostic (whereAt)

@test fun operatorsGroupByLevelAndIfIsACase () =
  assertEq
    (dumped "x = if 1 + 2 * 3 :: xs then a else b\n")
    "(linear false)\n(def x () - (= (case (app (app :: (app (app + (lit 1)) (app (app * (lit 2)) (lit 3)))) xs) (alt (lit True) (= a)) (alt (lit False) (= b)))))"
    "`*` before `+` before `::`, and `if` a `case` on Bool"

@test fun whatIsWrongIsAtItsNode () =
  assertEq
    (match parsed "f = 1\nh = 99999999999999999999\n" with
     | Err ds -> V.map whereAt ds
     | Ok _ -> [])
    [Meta 10 30]
    "the number, and nothing else"
