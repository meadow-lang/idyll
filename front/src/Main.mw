-- Idyll's compiler, in Meadow.
--
-- Its passes, each a module, each checked against the Rust compiler in
-- compiler/ on the same programs (`compiler/idyllic/tests/front.rs`):
--
--   Lex      the tokens, as the Rust lexer (`idyllic-lexer`) reads them
--   Layout   the offside rule: virtual braces and semicolons
--            (`idyllic-layout`)
--   Syntax   the grammar, and the lossless tree Lingua parses it into
--   View     what that tree means, read off its typed nodes as the Rust
--            parser reads its abstract syntax (`idyllic-parser`); what is
--            wrong with it, at the nodes it is about
--   Rename   names resolved, equations and records desugared (`Hir`,
--            `idyllic-rename`), against the prelude
--   Scc      definitions in dependency order (`idyllic-scc`)
--   Types    the type checker (`Check`, `Elab`, `Decl`, and the machinery
--            under them; `idyllic-typecheck`)
--   Run      the reference interpreter, a CEK machine on the checked Core
--            (`Cek`, `World`; `idyll-eval`)
--   Cut      the checked Core lowered to Cut (`Lower`, with `Typer` and
--            `Prune`; `idyllic-cut`) and written with the Cut package
--            (`Emit`)
--
-- Run as `Idyll <pass> <file>...`, it writes each file's dump for the pass,
-- each after a line `== <file>`: what the differential tests compare with
-- the Rust compiler's. `Idyll errors <file>...` draws what is wrong with
-- each file's syntax, where it is.

use Idyll.Layout (dumped)
use Idyll.Syntax (parseIdyll)
use Idyll.Surface (SurfaceProgram)
use Idyll.Surface as Surface
use Idyll.Rename (renameModule, renamePackage)
use Idyll.Rename as Rename
use Idyll.Hir as Hir
use Std.String as S
use Std.Maybe as M
use Idyll.Scc (sccModule)
use Idyll.Check (checkModule, checkModuleWith, checked, checkedAgainst, checkedWith, Checked)
use Idyll.Compiled (compiledOf)
use Idyll.Parts as Parts
use Std.Macro (toDatum, fromDatum)
use Idyll.Link (merged, emptyCompiled)
use Idyll.Link (linked, toLink)
use Std.St (runSt)
use Idyll.Interface
use Std.Sort (sortOn)
use Idyll.Typer as Ty
use Idyll.Lower as Lo
use Idyll.Cek as Cek
use Idyll.World as W
use Idyll.Core as C
use Idyll.Hir (Literal)
use Idyll.Driver as D
use Lingua.Green (dump)
use Lingua.Diagnostic (renderAll)
use Std.Collections.Vector as V
use Std.Result.Result.*
use Std.Maybe.Maybe.*

fun main () =
  let args = argv () in
  -- `idyll build`, `run` and `check` on a package (`Driver`); the passes'
  -- dumps, which the differential tests compare, are given `--prelude`
  let testing = V.get args 1 == Just "--prelude" in
  match V.get args 0 with
  | Just "build" if not testing -> D.drive ()
  | Just "run" if not testing -> D.drive ()
  | Just "check" -> D.drive ()
  | Just "update" -> D.drive ()
  -- (a flag every command of the driver takes may come before the command)
  | Just "--offline" -> D.drive ()
  | Just "--locked" -> D.drive ()
  | Just "help" -> D.drive ()
  | Just "--help" -> D.drive ()
  | Just "tokens" -> V.foldl (\u f -> each f dumpTokens) () (V.drop args 1)
  | Just "tree" -> V.foldl (\u f -> each f dumpTree) () (V.drop args 1)
  | Just "parse" -> V.foldl (\u f -> each f Surface.dumped) () (V.drop args 1)
  | Just "errors" -> V.foldl (\u f -> each f (errorsIn f)) () (V.drop args 1)
  | Just "rename" ->
      (match (V.get args 1, V.get args 2) with
       | (Just "--prelude", Just path) ->
           (match readToString path with
            | Ok text ->
                (match Surface.parsed text with
                 | Ok prelude -> V.foldl (\u f -> each f (renamed prelude)) () (V.drop args 3)
                 | Err _ -> writeError "the prelude does not parse\n")
            | Err e -> writeError "could not read the prelude: ${e}\n")
       | _ -> writeError "usage: Idyll rename --prelude <file> <file>...\n")
  | Just "cut" ->
      (match (V.get args 1, V.get args 2) with
       | (Just "--prelude", Just path) ->
           (match readToString path with
            | Ok text ->
                (match Surface.parsed text with
                 | Ok prelude ->
                     (match (V.get args 3, V.get args 4) with
                      | (Just "--std", Just dir) ->
                          (match packageModules dir with
                           | Ok std ->
                               (match compiledPackage prelude "Std" std [] with
                                | Ok (names, compiled) -> V.foldl (\u f -> each f (cutAgainst prelude names compiled)) () (V.drop args 5)
                                | Err why -> writeError "Std: ${why}\n")
                           | Err why -> writeError "Std: ${why}\n")
                      | _ -> V.foldl (\u f -> each f (cutOf prelude)) () (V.drop args 3))
                 | Err _ -> writeError "the prelude does not parse\n")
            | Err e -> writeError "could not read the prelude: ${e}\n")
       | _ -> writeError "usage: Idyll cut --prelude <file> [--std <dir>] <file>...\n")
  | Just "run" ->
      (match (V.get args 1, V.get args 2) with
       | (Just "--prelude", Just path) ->
           (match readToString path with
            | Ok text ->
                (match Surface.parsed text with
                 | Ok prelude ->
                     (match (V.get args 3, V.get args 4) with
                      | (Just "--std", Just dir) ->
                          (match packageModules dir with
                           | Ok std ->
                               (match compiledPackage prelude "Std" std [] with
                                | Ok (names, compiled) -> V.foldl (\u f -> each f (ranAgainst prelude names compiled)) () (V.drop args 5)
                                | Err why -> writeError "Std: ${why}\n")
                           | Err why -> writeError "Std: ${why}\n")
                      | _ -> V.foldl (\u f -> each f (ran prelude)) () (V.drop args 3))
                 | Err _ -> writeError "the prelude does not parse\n")
            | Err e -> writeError "could not read the prelude: ${e}\n")
       | _ -> writeError "usage: Idyll run --prelude <file> [--std <dir>] <file>...\n")
  | Just "types" ->
      (match (V.get args 1, V.get args 2) with
       | (Just "--prelude", Just path) ->
           (match readToString path with
            | Ok text ->
                (match Surface.parsed text with
                 | Ok prelude ->
                     -- `--std <dir>`: the standard library's sources, which a
                     -- program that names `Std` depends on
                     (match (V.get args 3, V.get args 4) with
                      | (Just "--std", Just dir) ->
                          (match packageModules dir with
                           | Ok std ->
                               -- (Std compiled once, as the Rust compiler
                               -- compiles it, and every program checked
                               -- against that)
                               (match compiledPackage prelude "Std" std [] with
                                | Ok (names, compiled) -> V.foldl (\u f -> each f (typedAgainst prelude names compiled)) () (V.drop args 5)
                                | Err why -> writeError "Std: ${why}\n")
                           | Err why -> writeError "Std: ${why}\n")
                      | _ -> V.foldl (\u f -> each f (typed prelude)) () (V.drop args 3))
                 | Err _ -> writeError "the prelude does not parse\n")
            | Err e -> writeError "could not read the prelude: ${e}\n")
       | _ -> writeError "usage: Idyll types --prelude <file> [--std <dir>] <file>...\n")
  | Just "parted" ->
      (match (V.get args 1, V.get args 2, V.get args 3, V.get args 4) with
       | (Just "--prelude", Just path, Just name, Just dir) ->
           (match readToString path with
            | Ok text ->
                (match (Surface.parsed text, packageModules dir) with
                 | (Ok prelude, Ok modules) ->
                     let texts = V.map (\m -> readToStringOr "" (dir ++ "/" ++ moduleFile (fst m))) modules in
                     let u = writeOutput "== ${name}\n" in
                     writeOutput "${partedDump prelude name modules texts}\n"
                 | (Err _, _) -> writeError "the prelude does not parse\n"
                 | (_, Err why) -> writeError "${name}: ${why}\n")
            | Err e -> writeError "could not read the prelude: ${e}\n")
       | _ -> writeError "usage: Idyll parted --prelude <file> <name> <dir>\n")
  | Just "compiled" ->
      (match (V.get args 1, V.get args 2, V.get args 3, V.get args 4) with
       | (Just "--prelude", Just path, Just name, Just dir) ->
           (match readToString path with
            | Ok text ->
                (match (Surface.parsed text, packageModules dir) with
                 | (Ok prelude, Ok modules) ->
                     let u = writeOutput "== ${name}\n" in
                     writeOutput "${compiledDump prelude name modules}\n"
                 | (Err _, _) -> writeError "the prelude does not parse\n"
                 | (_, Err why) -> writeError "${name}: ${why}\n")
            | Err e -> writeError "could not read the prelude: ${e}\n")
       | _ -> writeError "usage: Idyll compiled --prelude <file> <name> <dir>\n")
  | Just "package" ->
      (match (V.get args 1, V.get args 2, V.get args 3, V.get args 4) with
       | (Just "--prelude", Just path, Just name, Just dir) ->
           (match readToString path with
            | Ok text ->
                (match (Surface.parsed text, packageModules dir) with
                 | (Ok prelude, Ok modules) ->
                     let u = writeOutput "== ${name}\n" in
                     writeOutput "${packageTypes prelude name modules}\n"
                 | (Err _, _) -> writeError "the prelude does not parse\n"
                 | (_, Err why) -> writeError "${name}: ${why}\n")
            | Err e -> writeError "could not read the prelude: ${e}\n")
       | _ -> writeError "usage: Idyll package --prelude <file> <name> <dir>\n")
  -- a package built to run: its modules, with Std, lowered to Cut, its
  -- `main` the entry; the Cut `meadow cut` runs
  | Just "build" ->
      (match (V.get args 1, V.get args 2, V.get args 3, V.get args 4, V.get args 5) with
       | (Just "--prelude", Just path, Just "--std", Just stdDir, Just dir) ->
           (match readToString path with
            | Ok text ->
                (match (Surface.parsed text, packageModules stdDir, packageModules (dir ++ "/src")) with
                 | (Ok prelude, Ok std, Ok modules) ->
                     -- Std only if the package uses it, which it does by naming it, as
                     -- the Rust compiler links it only then
                     let named = V.any (\f -> match readToString (dir ++ "/src/" ++ f) with | Ok t -> S.contains "Std" t | Err _ -> False) (idlFiles (dir ++ "/src") []) in
                     writeOutput "${built prelude (if named then [("Std", std)] else []) (packageName dir) modules}\n"
                 | (Err _, _, _) -> writeError "the prelude does not parse\n"
                 | (_, Err why, _) -> writeError "Std: ${why}\n"
                 | (_, _, Err why) -> writeError "${dir}: ${why}\n")
            | Err e -> writeError "could not read the prelude: ${e}\n")
       | _ -> writeError "usage: Idyll build --prelude <file> --std <dir> <package>\n")
  | _ -> writeError "usage: Idyll (tokens | tree | parse | errors | rename --prelude <file> | types --prelude <file>) <file>...\n"

-- A package built to run, as Cut: `(error)` if it does not rename or check.
fun built prelude deps (name : String) (modules : [([String], SurfaceProgram)]) : String ! { Mut | e } =
  match renamePackage name modules prelude deps with
  | (m, problems) -> if V.isEmpty problems then Lo.cutTextAt (sccModule m) "Main" True else "(error: ${S.join "; " problems})"

-- A package's name, as its `Idyll.toml` says (`name = "Hello"`), or the
-- directory's; with its version, `Hello@0.1.0`, if it says one, as the Rust
-- compiler names a package's symbols.
fun packageName (dir : String) : String ! { Fs | e } =
  let fallback = M.unwrapOr dir (V.last (S.split "/" dir)) in
  match readToString (dir ++ "/Idyll.toml") with
  | Err _ -> fallback
  | Ok text ->
      let name = M.unwrapOr fallback (manifestField text "name") in
      (match manifestField text "version" with
       | Just v -> "${name}@${v}"
       | None -> name)

-- A field of a manifest's, `key = "value"`: its value.
fun manifestField (text : String) (key : String) : Maybe String =
  V.foldl
    (\acc line ->
      match acc with
      | Just n -> Just n
      | None ->
          let t = S.trim line in
          let parts = S.split "\"" t in
          if S.startsWith key t and S.trim (S.drop (S.take t (S.byteLength (V.getOr "" parts 0))) (S.byteLength key)) == "=" then V.get parts 1 else None)
    None
    (S.lines text)

-- `file`'s dump, under a line naming it.
fun each (file : String) dumpOf =
  let u = writeOutput "== ${file}\n" in
  match readToString file with
  | Ok text -> writeOutput "${dumpOf text}\n"
  | Err e -> writeOutput "(could not read it: ${e})\n"

fun dumpTokens (text : String) : String = dumped text

-- The lossless tree, drawn, after what the parser said was wrong with it.
fun dumpTree (text : String) : String =
  match parseIdyll text with
  | (g, errs) ->
      V.foldl (\s e -> match e with | (at, msg) -> s ++ "error at ${show at}: ${msg}\n") "" errs ++ dump display g

-- What is wrong with `file`'s syntax, `text`, drawn where it is; `ok` if
-- nothing is.
fun errorsIn (file : String) (text : String) : String =
  match Surface.parsed text with
  | Ok _ -> "ok"
  | Err ds -> renderAll file text ds

-- A program renamed after the prelude, as `Hir` writes it; `(error)` if it
-- does not parse, or anything in it is wrong.
fun renamed prelude (text : String) : String ! { Mut | e } =
  match Surface.parsed text with
  | Err _ -> "(error)"
  | Ok prog ->
      (match renameModule prog prelude with
       | (m, problems) -> if V.isEmpty problems then Rename.dumped m else "(error)")

-- A program checked after the prelude, as `Check` writes it; `(error)` if
-- it does not parse or rename.
fun typed prelude (text : String) : String ! { Mut | e } = typedWith prelude None text

-- A package checked whole against the compiled packages it depends on
-- (each a name, what it gives, and what it compiled to) and compiled: what
-- it gives, and what it compiled to; or what is wrong.
fun compiledPackage prelude (name : String) (modules : [([String], SurfaceProgram)]) (deps : [(String, Rename.PackageNames, Compiled)]) =
  let programs = V.map (\m -> Rename.programOf (snd m)) modules in
  let vis = V.any (\p -> Rename.mentionsVisibility p) programs in
  let first = V.foldl (\acc d -> match d with | (_, _, (c : Compiled)) -> if c.high > acc then c.high else acc) 0 deps in
  match Rename.renamePackageWith name modules prelude (V.map (\d -> match d with | (n, ns, _) -> (n, ns)) deps) [] first True vis with
  | (m, names, problems) ->
      if not (V.isEmpty problems) then Err (S.join "; " problems)
      else
        let grouped = sccModule m in
        let c = checkedAgainst grouped False (V.map (\d -> match d with | (_, _, cp) -> cp) deps) in
        let errors = getRef c.tc.errors in
        if not (V.isEmpty errors) then Err (S.join ", " errors) else Ok (names, compiledOf c grouped names)

-- A program's Cut: checked against Std compiled, if it names Std, and
-- linked with it.
fun cutAgainst prelude (names : Rename.PackageNames) (std : Compiled) (text : String) : String ! { Mut | e } =
  match Surface.parsed text with
  | Err _ -> "(error)"
  | Ok prog ->
      if not (S.contains "Std" text) then cutOf prelude text
      else
        let vis = Rename.mentionsVisibility (Rename.programOf prog) in
        (match Rename.renamePackageWith "Main" [([], prog)] prelude [("Std", names)] [] std.high True vis with
         | (m, own, problems) -> if V.isEmpty problems then Lo.cutTextLinked (sccModule m) own "Main" False [std] else "(error)")

-- A program checked against Std compiled, if it names Std, as the test
-- compares it.
fun typedAgainst prelude (names : Rename.PackageNames) (std : Compiled) (text : String) : String ! { Mut | e } =
  match Surface.parsed text with
  | Err _ -> "(error)"
  | Ok prog ->
      if not (S.contains "Std" text) then typed prelude text
      else
        let vis = Rename.mentionsVisibility (Rename.programOf prog) in
        (match Rename.renamePackageWith "Main" [([], prog)] prelude [("Std", names)] [] std.high True vis with
         | (m, _, problems) -> if V.isEmpty problems then checkModuleWith (sccModule m) [std] else "(error)")

-- The same, with the standard library's modules given: a program that
-- names `Std` is the root of a package that depends on it.
fun typedWith prelude std (text : String) : String ! { Mut | e } =
  match Surface.parsed text with
  | Err _ -> "(error)"
  | Ok prog ->
      let renamed =
        match std with
        | Just mods -> if S.contains "Std" text then renamePackage "Main" [([], prog)] prelude [("Std", mods)] else renameModule prog prelude
        | None -> renameModule prog prelude
      in
      (match renamed with
       | (m, problems) -> if V.isEmpty problems then checkModule (sccModule m) else "(error)")

-- A whole package checked, its modules each a path and a program.
-- A package checked whole and compiled, as those that depend on it see it:
-- a line for each of its constants (its type, whether the types may see
-- its value, how many arguments it unfolds after), its top-level `let`s,
-- its recursive definitions, its hints and its traits, sorted. The Rust
-- side writes its `CompiledPackage` the same way
-- (`the_compiled_packages_agree`).
-- The file a module of a package is in, under its `src/`: the root's
-- `Lib.idl`.
fun moduleFile (path : [String]) : String = if V.isEmpty path then "Lib.idl" else S.join "/" path ++ ".idl"

-- A package compiled a part at a time (`Parts`), each part against the
-- parts it imports, and the parts made one (`Link.merged`), written as
-- `compiled` writes a package compiled whole.
fun partedDump prelude (name : String) (modules : [([String], SurfaceProgram)]) (texts : [String]) : String ! { Mut | e } =
  let paths = V.map (\m -> S.join "." (fst m)) modules in
  let programs = V.map (\m -> Rename.programOf (snd m)) modules in
  let vis = V.any (\p -> Rename.mentionsVisibility p) programs in
  let ps = Parts.parts name paths texts in
  let step =
    \acc p ->
      match acc with
      | Err why -> Err why
      | Ok (done, next) ->
          let imported = V.concatMap (\k -> match V.get done k with | Just d -> [d] | None -> []) (Parts.partImports p) in
          let mods = V.concatMap (\i -> match V.get modules i with | Just m -> [m] | None -> []) (Parts.partModules p) in
          let slotFirst = 16384 * V.foldl (\acc i -> if acc < 0 or i < acc then i else acc) (0 - 1) (Parts.partModules p) in
          (match Rename.renamePackageWith name mods prelude [] (V.map fst imported) slotFirst (Parts.partRoot p) vis with
           | (m, names, problems) ->
               if not (V.isEmpty problems) then Err (S.join "; " problems)
               else
                 let grouped = sccModule m in
                 let c = checkedAgainst grouped False (V.map snd imported) in
                 let errors = getRef c.tc.errors in
                 if not (V.isEmpty errors) then Err "${S.join "+" (V.map (\i -> V.getOr "" paths i) (Parts.partModules p))}: ${S.join ", " errors}"
                 else
                   let compiled0 = compiledOf c grouped names in
                   -- (kept as a build keeps it, and read back)
                   match fromDatum (toDatum compiled0) with
                   | Err why -> Err "a compiled part does not read back: ${why}"
                   | Ok (compiled : Compiled) -> Ok (V.pushBack done (names, compiled), ((compiled.high + 4095) / 4096) * 4096))
  in
  match V.foldl step (Ok ([], 0)) ps with
  | Err why -> "(error: ${why})"
  | Ok (done, _) -> dumpCompiled (merged (V.map snd done))

fun compiledDump prelude (name : String) (modules : [([String], SurfaceProgram)]) : String ! { Mut | e } =
  let programs = V.map (\m -> Rename.programOf (snd m)) modules in
  let vis = V.any (\p -> Rename.mentionsVisibility p) programs in
  match Rename.renamePackageWith name modules prelude [] [] 0 True vis with
  | (m, names, problems) ->
      if not (V.isEmpty problems) then "(error: ${S.join "; " problems})"
      else
        let grouped = sccModule m in
        let c = checked grouped in
        let errors = getRef c.tc.errors in
        if not (V.isEmpty errors) then "(error: ${S.join ", " errors})"
        else
          dumpCompiled (compiledOf c grouped names)

-- A compiled package, a line for each of its constants, `let`s, recursive
-- definitions, hints and traits, sorted.
fun dumpCompiled (p : Compiled) : String =
          let nameOf = \u -> M.unwrapOr "?" (M.map (\k -> match k with | Constant.Constant _ n _ _ _ -> n) (V.find (\k -> match k with | Constant.Constant v _ _ _ _ -> v == u) p.constants)) in
          let constants =
            V.map
              (\k ->
                match k with
                | Constant.Constant _ n ty value unfold ->
                    let v = if M.isSome value then " = .." else "" in
                    let f = match unfold with | Just (Unfold.Unfold arity _) -> " unfold ${show arity}" | None -> "" in
                    "constant ${n} : ${C.shown False ty}${v}${f}")
              p.constants
          in
          let lets = V.map (\l -> match l with | TopLet.TopLet _ n _ -> "let ${n}") p.lets in
          let recs = V.map (\r -> match r with | RecDef.RecDef _ n _ _ local -> if local then "rec ${n} local" else "rec ${n}") p.recDefs in
          let hints = V.map (\u -> "hint ${nameOf u}") p.hints in
          let traits = V.map (\u -> "trait ${nameOf u}") p.traits in
          S.join "\n" (sortOn (\l -> l) (V.concat [constants, lets, recs, hints, traits]))

fun packageTypes prelude (name : String) (modules : [([String], SurfaceProgram)]) : String ! { Mut | e } =
  match renamePackage name modules prelude [] with
  | (m, problems) -> if V.isEmpty problems then checkModule (sccModule m) else "(error: ${S.join "; " problems})"

-- A package's modules, read from its source directory: each `.idl` file
-- under it, its path the file's (`Collections/List.idl` is
-- `Collections.List`), `Main.idl` or `Lib.idl` the root, as the Rust driver
-- has it; the root first, then the rest
-- by path.
fun packageModules (dir : String) : Result String [([String], SurfaceProgram)] ! { Fs, Mut | e } =
  let files = idlFiles dir [] in
  let modules =
    V.map
      (\rel ->
        let path = V.take (S.split "/" rel) (V.len (S.split "/" rel)) in
        let last = M.unwrapOr "" (V.last path) in
        let segs = V.pushBack (V.take path (V.len path - 1)) (S.take last (S.byteLength last - 4)) in
        let p = if V.len segs == 1 and (V.getOr "" segs 0 == "Lib" or V.getOr "" segs 0 == "Main") then [] else segs in
        (p, rel))
      files
  in
  let sorted = V.foldl (\acc m -> V.concat [V.filter (\x -> not (S.lessThan (key m) (key x))) acc, [m], V.filter (\x -> S.lessThan (key m) (key x)) acc]) [] modules in
  V.foldl
    (\acc m ->
      match acc with
      | Err why -> Err why
      | Ok done ->
          (match readToString (dir ++ "/" ++ snd m) with
           | Err e -> Err e
           | Ok text ->
               (match Surface.parsed text with
                | Ok prog -> Ok (V.pushBack done (fst m, prog))
                | Err _ -> Err "${snd m} does not parse")))
    (Ok [])
    sorted

-- How modules sort: the root first, then by path.
fun key (m : ([String], String)) : String = if V.isEmpty (fst m) then "" else S.join "." (fst m)

-- The `.idl` files under a directory, by their paths in it.
fun idlFiles (dir : String) (prefix : [String]) : [String] ! { Fs | e } =
  let here = if V.isEmpty prefix then dir else dir ++ "/" ++ S.join "/" prefix in
  match readDir here with
  | Err _ -> []
  | Ok names ->
      V.concatMap
        (\n ->
          let full = here ++ "/" ++ n in
          if isDir full then idlFiles dir (V.pushBack prefix n)
          else if S.endsWith ".idl" n then [S.join "/" (V.pushBack prefix n)]
          else [])
        names

-- How many steps a program is given before it is taken not to stop.
def fuel = 5000000

-- A program run after the prelude, as the run differential compares it:
-- its answer as the REPL shows it (or `-`, for a function or a type) and
-- how many steps it took, or how it stopped; and what it printed. `(error)`
-- if it does not check, `(no expression)` if it has nothing to run.
fun ran prelude (text : String) : String ! { Mut | e } = ranWith prelude None text

-- The same, with the standard library's modules given (see `cutWith`).
fun ranWith prelude std (text : String) : String ! { Mut | e } =
  match Surface.parsed text with
  | Err _ -> "(error)"
  | Ok prog ->
      let renamed =
        match std with
        | Just mods -> if S.contains "Std" text then renamePackage "Main" [([], prog)] prelude [("Std", mods)] else renameModule prog prelude
        | None -> renameModule prog prelude
      in
      (match renamed with
       | (m, problems) ->
           if not (V.isEmpty problems) then "(error)"
           else
             (let c = checked (sccModule m) in
              if not (V.isEmpty (getRef c.tc.unsupported)) then "(unsupported)"
              else if not (V.isEmpty (getRef c.tc.errors)) then "(error)"
              else
                (let p = Cek.programOf c in
                 match p.body with
                 | None -> "(no expression)"
                 | Just term -> runCore p term)))

-- A program run on the CEK machine: checked against Std compiled, if it
-- names Std, and linked with it.
fun ranAgainst prelude (names : Rename.PackageNames) (std : Compiled) (text : String) : String ! { Mut | e } =
  match Surface.parsed text with
  | Err _ -> "(error)"
  | Ok prog ->
      if not (S.contains "Std" text) then ran prelude text
      else
        let vis = Rename.mentionsVisibility (Rename.programOf prog) in
        (match Rename.renamePackageWith "Main" [([], prog)] prelude [("Std", names)] [] std.high True vis with
         | (m, own, problems) ->
             if not (V.isEmpty problems) then "(error)"
             else
               let grouped = sccModule m in
               runSt (\() ->
                 let c = checkedWith grouped False [std] in
                 if not (V.isEmpty (getRef c.tc.unsupported)) then "(unsupported)"
                 else if not (V.isEmpty (getRef c.tc.errors)) then "(error)"
                 else
                   let compiled = compiledOf c grouped own in
                   let p = Cek.programOf (linked c compiled (toLink compiled [std])) in
                   match p.body with
                   | None -> "(no expression)"
                   | Just term -> runCore p term))

fun runCore p term : String ! { Mut | e } =
  let w = W.captured () in
  let result = Cek.run p w term fuel in
  if not (V.isEmpty (getRef w.missing)) then "(unsupported: the world's ${S.join ", " (getRef w.missing)})"
  else
    let outcome =
      match result with
      | Ok (v, steps) -> ["answer: " ++ M.unwrapOr "-" (Cek.shown v), "steps: " ++ show steps]
      | Err h -> ["stopped: " ++ Cek.haltShown h]
    in
    let printed = if getRef w.output == "" then [] else ["printed: " ++ C.literalShown (Literal.Str (getRef w.output))] in
    let errors = if getRef w.errors == "" then [] else ["errors: " ++ C.literalShown (Literal.Str (getRef w.errors))] in
    S.join "\n" (V.concat [outcome, printed, errors])

-- A program lowered to Cut, as its text: `(error)` if it does not check,
-- `(not lowered: ..)` with why, if it cannot be.
fun cutOf prelude (text : String) : String ! { Mut | e } = cutWith prelude None text

-- The same, with the standard library's modules given: a program that
-- names `Std` is the root of a package that depends on it, Std checked and
-- lowered alongside.
fun cutWith prelude std (text : String) : String ! { Mut | e } =
  match Surface.parsed text with
  | Err _ -> "(error)"
  | Ok prog ->
      let renamed =
        match std with
        | Just mods -> if S.contains "Std" text then renamePackage "Main" [([], prog)] prelude [("Std", mods)] else renameModule prog prelude
        | None -> renameModule prog prelude
      in
      (match renamed with
       | (m, problems) -> if not (V.isEmpty problems) then "(error)" else Lo.cutText (sccModule m) "Main")
