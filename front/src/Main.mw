-- Idyll's compiler, in Meadow.
--
-- Its passes, each a module, each checked against the Rust compiler in
-- compiler/ on the same programs (`compiler/idyllic/tests/front.rs`):
--
--   Lex      the tokens, as the Rust lexer (`idyllic-lexer`) reads them
--   Layout   the offside rule: virtual braces and semicolons
--            (`idyllic-layout`)
--   Syntax   the grammar, and the lossless tree Lingua parses it into
--   View     what that tree means, read off its typed nodes as the Rust
--            parser reads its abstract syntax (`idyllic-parser`); what is
--            wrong with it, at the nodes it is about
--   Rename   names resolved, equations and records desugared (`Hir`,
--            `idyllic-rename`), against the prelude
--   Scc      definitions in dependency order (`idyllic-scc`)
--   Types    the type checker (`Check`, `Elab`, `Decl`, and the machinery
--            under them; `idyllic-typecheck`)
--   Run      the reference interpreter, a CEK machine on the checked Core
--            (`Cek`, `World`; `idyll-eval`)
--   Cut      the checked Core lowered to Cut (`Lower`, with `Typer` and
--            `Prune`; `idyllic-cut`) and written with the Cut package
--            (`Emit`)
--
-- Run as `Idyll <pass> <file>...`, it writes each file's dump for the pass,
-- each after a line `== <file>`: what the differential tests compare with
-- the Rust compiler's. `Idyll errors <file>...` draws what is wrong with
-- each file's syntax, where it is.

use Idyll.Layout (dumped)
use Idyll.Syntax (parseIdyll)
use Idyll.Surface (SurfaceProgram)
use Idyll.Surface as Surface
use Idyll.Rename (renameModule, renamePackage, toData)
use Idyll.Hir as Hir
use Std.String as S
use Std.Maybe as M
use Idyll.Scc (sccModule)
use Idyll.Check (checkModule, checked, Checked)
use Idyll.Typer as Ty
use Idyll.Prune as Pr
use Idyll.CutAst as Ca
use Idyll.Lower as Lo
use Idyll.Emit as Em
use Idyll.Cek as Cek
use Idyll.World as W
use Idyll.Core as C
use Idyll.Hir (Literal)
use Lingua.Green (dump)
use Lingua.Diagnostic (renderAll)
use Std.Collections.Vector as V
use Std.Result.Result.*
use Std.Maybe.Maybe.*

fun main () =
  let args = argv () in
  match V.get args 0 with
  | Just "tokens" -> V.foldl (\u f -> each f dumpTokens) () (V.drop args 1)
  | Just "tree" -> V.foldl (\u f -> each f dumpTree) () (V.drop args 1)
  | Just "parse" -> V.foldl (\u f -> each f Surface.dumped) () (V.drop args 1)
  | Just "errors" -> V.foldl (\u f -> each f (errorsIn f)) () (V.drop args 1)
  | Just "rename" ->
      (match (V.get args 1, V.get args 2) with
       | (Just "--prelude", Just path) ->
           (match readToString path with
            | Ok text ->
                (match Surface.parsed text with
                 | Ok prelude -> V.foldl (\u f -> each f (renamed prelude)) () (V.drop args 3)
                 | Err _ -> writeError "the prelude does not parse\n")
            | Err e -> writeError "could not read the prelude: ${e}\n")
       | _ -> writeError "usage: Idyll rename --prelude <file> <file>...\n")
  | Just "cut" ->
      (match (V.get args 1, V.get args 2) with
       | (Just "--prelude", Just path) ->
           (match readToString path with
            | Ok text ->
                (match Surface.parsed text with
                 | Ok prelude -> V.foldl (\u f -> each f (cutOf prelude)) () (V.drop args 3)
                 | Err _ -> writeError "the prelude does not parse\n")
            | Err e -> writeError "could not read the prelude: ${e}\n")
       | _ -> writeError "usage: Idyll cut --prelude <file> <file>...\n")
  | Just "run" ->
      (match (V.get args 1, V.get args 2) with
       | (Just "--prelude", Just path) ->
           (match readToString path with
            | Ok text ->
                (match Surface.parsed text with
                 | Ok prelude -> V.foldl (\u f -> each f (ran prelude)) () (V.drop args 3)
                 | Err _ -> writeError "the prelude does not parse\n")
            | Err e -> writeError "could not read the prelude: ${e}\n")
       | _ -> writeError "usage: Idyll run --prelude <file> <file>...\n")
  | Just "types" ->
      (match (V.get args 1, V.get args 2) with
       | (Just "--prelude", Just path) ->
           (match readToString path with
            | Ok text ->
                (match Surface.parsed text with
                 | Ok prelude ->
                     -- `--std <dir>`: the standard library's sources, which a
                     -- program that names `Std` depends on
                     (match (V.get args 3, V.get args 4) with
                      | (Just "--std", Just dir) ->
                          (match packageModules dir with
                           | Ok std -> V.foldl (\u f -> each f (typedWith prelude (Just std))) () (V.drop args 5)
                           | Err why -> writeError "Std: ${why}\n")
                      | _ -> V.foldl (\u f -> each f (typed prelude)) () (V.drop args 3))
                 | Err _ -> writeError "the prelude does not parse\n")
            | Err e -> writeError "could not read the prelude: ${e}\n")
       | _ -> writeError "usage: Idyll types --prelude <file> [--std <dir>] <file>...\n")
  | Just "package" ->
      (match (V.get args 1, V.get args 2, V.get args 3, V.get args 4) with
       | (Just "--prelude", Just path, Just name, Just dir) ->
           (match readToString path with
            | Ok text ->
                (match (Surface.parsed text, packageModules dir) with
                 | (Ok prelude, Ok modules) ->
                     let u = writeOutput "== ${name}\n" in
                     writeOutput "${packageTypes prelude name modules}\n"
                 | (Err _, _) -> writeError "the prelude does not parse\n"
                 | (_, Err why) -> writeError "${name}: ${why}\n")
            | Err e -> writeError "could not read the prelude: ${e}\n")
       | _ -> writeError "usage: Idyll package --prelude <file> <name> <dir>\n")
  | _ -> writeError "usage: Idyll (tokens | tree | parse | errors | rename --prelude <file> | types --prelude <file>) <file>...\n"

-- `file`'s dump, under a line naming it.
fun each (file : String) dumpOf =
  let u = writeOutput "== ${file}\n" in
  match readToString file with
  | Ok text -> writeOutput "${dumpOf text}\n"
  | Err e -> writeOutput "(could not read it: ${e})\n"

fun dumpTokens (text : String) : String = dumped text

-- The lossless tree, drawn, after what the parser said was wrong with it.
fun dumpTree (text : String) : String =
  match parseIdyll text with
  | (g, errs) ->
      V.foldl (\s e -> match e with | (at, msg) -> s ++ "error at ${show at}: ${msg}\n") "" errs ++ dump display g

-- What is wrong with `file`'s syntax, `text`, drawn where it is; `ok` if
-- nothing is.
fun errorsIn (file : String) (text : String) : String =
  match Surface.parsed text with
  | Ok _ -> "ok"
  | Err ds -> renderAll file text ds

-- A program renamed after the prelude, as `Hir` writes it; `(error)` if it
-- does not parse, or anything in it is wrong.
fun renamed prelude (text : String) : String ! { Mut | e } =
  match Surface.parsed text with
  | Err _ -> "(error)"
  | Ok prog ->
      (match renameModule prog prelude with
       | (m, problems) -> if V.isEmpty problems then Hir.dumped (toData m) else "(error)")

-- A program checked after the prelude, as `Check` writes it; `(error)` if
-- it does not parse or rename.
fun typed prelude (text : String) : String ! { Mut | e } = typedWith prelude None text

-- The same, with the standard library's modules given: a program that
-- names `Std` is the root of a package that depends on it.
fun typedWith prelude std (text : String) : String ! { Mut | e } =
  match Surface.parsed text with
  | Err _ -> "(error)"
  | Ok prog ->
      let renamed =
        match std with
        | Just mods -> if S.contains "Std" text then renamePackage "Main" [([], prog)] prelude [("Std", mods)] else renameModule prog prelude
        | None -> renameModule prog prelude
      in
      (match renamed with
       | (m, problems) -> if V.isEmpty problems then checkModule (sccModule m) else "(error)")

-- A whole package checked, its modules each a path and a program.
fun packageTypes prelude (name : String) (modules : [([String], SurfaceProgram)]) : String ! { Mut | e } =
  match renamePackage name modules prelude [] with
  | (m, problems) -> if V.isEmpty problems then checkModule (sccModule m) else "(error: ${S.join "; " problems})"

-- A package's modules, read from its source directory: each `.idl` file
-- under it, its path the file's (`Collections/List.idl` is
-- `Collections.List`), `Lib.idl` the root; the root first, then the rest
-- by path.
fun packageModules (dir : String) : Result String [([String], SurfaceProgram)] ! { Fs, Mut | e } =
  let files = idlFiles dir [] in
  let modules =
    V.map
      (\rel ->
        let path = V.take (S.split "/" rel) (V.len (S.split "/" rel)) in
        let last = M.unwrapOr "" (V.last path) in
        let segs = V.pushBack (V.take path (V.len path - 1)) (S.take last (S.byteLength last - 4)) in
        let p = if V.len segs == 1 and V.getOr "" segs 0 == "Lib" then [] else segs in
        (p, rel))
      files
  in
  let sorted = V.foldl (\acc m -> V.concat [V.filter (\x -> not (S.lessThan (key m) (key x))) acc, [m], V.filter (\x -> S.lessThan (key m) (key x)) acc]) [] modules in
  V.foldl
    (\acc m ->
      match acc with
      | Err why -> Err why
      | Ok done ->
          (match readToString (dir ++ "/" ++ snd m) with
           | Err e -> Err e
           | Ok text ->
               (match Surface.parsed text with
                | Ok prog -> Ok (V.pushBack done (fst m, prog))
                | Err _ -> Err "${snd m} does not parse")))
    (Ok [])
    sorted

-- How modules sort: the root first, then by path.
fun key (m : ([String], String)) : String = if V.isEmpty (fst m) then "" else S.join "." (fst m)

-- The `.idl` files under a directory, by their paths in it.
fun idlFiles (dir : String) (prefix : [String]) : [String] ! { Fs | e } =
  let here = if V.isEmpty prefix then dir else dir ++ "/" ++ S.join "/" prefix in
  match readDir here with
  | Err _ -> []
  | Ok names ->
      V.concatMap
        (\n ->
          let full = here ++ "/" ++ n in
          if isDir full then idlFiles dir (V.pushBack prefix n)
          else if S.endsWith ".idl" n then [S.join "/" (V.pushBack prefix n)]
          else [])
        names

-- How many steps a program is given before it is taken not to stop.
def fuel = 5000000

-- A program run after the prelude, as the run differential compares it:
-- its answer as the REPL shows it (or `-`, for a function or a type) and
-- how many steps it took, or how it stopped; and what it printed. `(error)`
-- if it does not check, `(no expression)` if it has nothing to run.
fun ran prelude (text : String) : String ! { Mut | e } =
  match Surface.parsed text with
  | Err _ -> "(error)"
  | Ok prog ->
      (match renameModule prog prelude with
       | (m, problems) ->
           if not (V.isEmpty problems) then "(error)"
           else
             (let c = checked (sccModule m) in
              if not (V.isEmpty (getRef c.tc.unsupported)) then "(unsupported)"
              else if not (V.isEmpty (getRef c.tc.errors)) then "(error)"
              else
                (match c.program with
                 | None -> "(no expression)"
                 | Just core -> runCore c.tc core)))

fun runCore tc core : String ! { Mut | e } =
  let w = W.captured () in
  let result = Cek.run (Cek.programOf tc) w core fuel in
  if not (V.isEmpty (getRef w.missing)) then "(unsupported: the world's ${S.join ", " (getRef w.missing)})"
  else
    let outcome =
      match result with
      | Ok (v, steps) -> ["answer: " ++ M.unwrapOr "-" (Cek.shown v), "steps: " ++ show steps]
      | Err h -> ["stopped: " ++ Cek.haltShown h]
    in
    let printed = if getRef w.output == "" then [] else ["printed: " ++ C.literalShown (Literal.Str (getRef w.output))] in
    let errors = if getRef w.errors == "" then [] else ["errors: " ++ C.literalShown (Literal.Str (getRef w.errors))] in
    S.join "\n" (V.concat [outcome, printed, errors])

-- A program lowered to Cut, as its text: `(error)` if it does not check,
-- `(not lowered: ..)` with why, if it cannot be.
fun cutOf prelude (text : String) : String ! { Mut | e } =
  match Surface.parsed text with
  | Err _ -> "(error)"
  | Ok prog ->
      (match renameModule prog prelude with
       | (m, problems) ->
           if not (V.isEmpty problems) then "(error)"
           else
             (let c = checked (sccModule m) in
              if not (V.isEmpty (getRef c.tc.unsupported)) then "(unsupported)"
              else if not (V.isEmpty (getRef c.tc.errors)) then "(error)"
              else
                (match Lo.lower c "Main" with
                 | Ok p -> Em.programText p
                 | Err whys -> "(not lowered: " ++ S.join "; " whys ++ ")")))
