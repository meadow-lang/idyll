-- The prelude, the Rust compiler's own (`compiler/idyllic/src/prelude.idl`).
def prelude = includeStr "../../compiler/idyllic/src/prelude.idl"

-- Std's modules, as the Rust compiler embeds them (`stdlib::MODULES`).
def stdModules : [(String, String)] =
  [
    ("", includeStr "../../lib/std/src/Lib.idl"),
    ("Bool", includeStr "../../lib/std/src/Bool.idl"),
    ("Char", includeStr "../../lib/std/src/Char.idl"),
    ("Cmp", includeStr "../../lib/std/src/Cmp.idl"),
    ("Collections.Array", includeStr "../../lib/std/src/Collections/Array.idl"),
    ("Collections.List", includeStr "../../lib/std/src/Collections/List.idl"),
    ("Collections.MArray", includeStr "../../lib/std/src/Collections/MArray.idl"),
    ("Collections.Vec", includeStr "../../lib/std/src/Collections/Vec.idl"),
    ("Collections.Vector", includeStr "../../lib/std/src/Collections/Vector.idl"),
    ("Console", includeStr "../../lib/std/src/Console.idl"),
    ("Dec", includeStr "../../lib/std/src/Dec.idl"),
    ("Either", includeStr "../../lib/std/src/Either.idl"),
    ("Eq", includeStr "../../lib/std/src/Eq.idl"),
    ("Exn", includeStr "../../lib/std/src/Exn.idl"),
    ("Fs", includeStr "../../lib/std/src/Fs.idl"),
    ("Function", includeStr "../../lib/std/src/Function.idl"),
    ("Maybe", includeStr "../../lib/std/src/Maybe.idl"),
    ("Num.Fin", includeStr "../../lib/std/src/Num/Fin.idl"),
    ("Num.Int", includeStr "../../lib/std/src/Num/Int.idl"),
    ("Num.Nat", includeStr "../../lib/std/src/Num/Nat.idl"),
    ("Ordering", includeStr "../../lib/std/src/Ordering.idl"),
