    ("Result", includeStr "../../lib/std/src/Result.idl"),
    ("Sigma", includeStr "../../lib/std/src/Sigma.idl"),
    ("Sort", includeStr "../../lib/std/src/Sort.idl"),
    ("State", includeStr "../../lib/std/src/State.idl"),
