-- The compiler as queries (`database!`), for the language server (`Server`)
-- and the prompt to come: each open file's text is an input, and what is
-- worked out from it -- its tree, what is wrong with it, how it is set out
-- -- is worked out again only when something it read changed. A file is
-- checked as a lone program after the prelude, as `idyllic file.idl`
-- checks one, against Std compiled if it names Std; Std is compiled once
-- a session.
--
-- A query may perform nothing but asking other queries, which is why the
-- renamer and the checker keep their state in `St` (each run in a
-- `runSt` of its own), never in a `Mut` cell.

use Lingua (database!)
use Lingua.Green (Green)
use Lingua.Diagnostic (Diagnostic, errorAt, warningAt, isError, whereAt)
use Lingua.Lang (Meta, spanMeta)
use Idyll.Syntax (Idyll, parseIdyll)
use Idyll.Surface (SurfaceProgram)
use Idyll.Surface as Surface
use Idyll.Rename (PackageNames)
use Idyll.Rename as Rename
use Idyll.Scc (sccModule)
use Idyll.Check (checkedAgainst, checkedWanting)
use Idyll.Elab (goalNamed)
use Idyll.Tc (Tc, CtorInfo, ctorInfo)
use Std.Collections.HashMap as Hm
use Idyll.Core as C
use Idyll.Core (Core)
use Idyll.Compiled (compiledOf)
use Idyll.Interface (Compiled)
use Idyll.Driver as D
use Idyll.Format as Fmt
use Idyll.Lower as Lo
use Idyll.Parts as Parts
use Idyll.Messages (diagnosticsIn, placedDiagnostics, said, problemAt, shiftedBack, metaBack)
use Std.St (runSt)
use Std.St as St
use Std.Collections.Vector as V
use Std.String as S
use Std.Maybe as M
use Std.Result.Result.*

database! {
  pub Session
    | input source (file : Int) : String
    -- the declarations a prompt has been given so far (`Prompt`)
    | input earlier (unit : Int) : String
    -- the proof under way in tactic mode, if one is (`Tactic`)
    | input proving (unit : Int) : Maybe Proof
    -- the package a file is a module of, if it is one (`Server`'s `opened`)
    | input package (file : Int) : Maybe PackageContext
    | query parsed (file : Int) : (Green Idyll, [(Int, String)]) = parseIdyll (querySource file)
    -- what a file's package depends on, compiled: kept until the package is
    -- read again with other dependencies
    | query dependencies (file : Int) : [Dependency] =
        (match queryPackage file with
         | Just pc -> dependenciesCompiled pc.needs (stdNamed pc) (queryPrelude 0) (\u -> queryStd 0)
         | None -> [])
    | query prelude (unit : Int) : Result [Diagnostic] SurfaceProgram = Surface.parsed D.prelude
    | query std (unit : Int) : Result String (PackageNames, Compiled) = stdOf (queryPrelude 0)
    | query problems (file : Int) : [Diagnostic] =
        problemsIn (querySource file) (M.map (\pc -> (pc, \u -> queryDependencies file)) (queryPackage file)) (queryPrelude 0) (\u -> queryStd 0)
    | query formatted (file : Int) : String = formattedOf (querySource file)
    -- what the prompt's declarations and the prelude declare, each its name,
    -- its type and its type shown: what the finder searches, kept until a
    -- declaration is entered
    | query catalog (unit : Int) : [(String, Core, String)] = catalogOf (queryEarlier 0) (queryPrelude 0) (\u -> queryStd 0)
}

-- A proof under way in tactic mode (`Tactic`): the declarations, with
-- what has been built so far in the goal's place; the goals left, the one
-- worked on first; how the checker says that one (its type and context);
-- and each proof before a step, the last first, for `undo`.
@derive(PartialEq)
@pub record Proof = {
  source : String,
  goals : [String],
  said : String,
  before : [(String, [String], String)]
}

-- What renaming found wrong, at the name it was resolving: its headline,
-- and the label on a line after it, if it has one.

-- --- what the queries do ----------------------------------------------------------

-- A program ready to check: renamed after the prelude, against Std compiled
-- if it names Std; with what renaming found wrong, each where. Or what its
-- syntax says is wrong with it.
@pub fun preparedProgram (text : String) prelude std = prepared text prelude std

fun prepared (text : String) (prelude : Result [Diagnostic] SurfaceProgram) (std : () -> Result String (PackageNames, Compiled) ! e) : Result [Diagnostic] (Rename.Renamed, [Compiled], [Diagnostic]) ! e =
  match (Surface.parsed text, prelude) with
  | (Err ds, _) -> Err ds
  | (_, Err _) -> Err [errorAt nowhere "the prelude does not parse"]
  | (Ok prog, Ok pre) ->
      let deps =
        if not (S.contains "Std" text) then []
        else (match std () with | Ok (names, c) -> [("Std", names, c)] | Err _ -> [])
      in
      let first = V.foldl (\acc d -> match d with | (_, _, (c : Compiled)) -> if c.high > acc then c.high else acc) 0 deps in
      let vis = Rename.mentionsVisibility (Rename.programOf prog) in
      (match Rename.renamePackageWith "Main" [([], prog)] pre (V.map (\d -> match d with | (n, ns, _) -> (n, ns)) deps) [] first True vis with
       | (m, _, _) ->
           Ok (m, V.map (\d -> match d with | (_, _, cp) -> cp) deps, V.map (\p -> match p with | (at, why) -> problemAt at why) m.problemsAt))

-- A program lowered to Cut, as `meadow cut` reads it: linked with Std
-- compiled, if it names Std; or why there is none, in parentheses, as the
-- Cut dumps say it (`(error)`, `(not lowered: ..)`).
@pub fun cutIn (text : String) (prelude : Result [Diagnostic] SurfaceProgram) (std : () -> Result String (PackageNames, Compiled) ! e) : String ! e =
  match (Surface.parsed text, prelude) with
  | (Ok prog, Ok pre) ->
      let deps =
        if not (S.contains "Std" text) then []
        else (match std () with | Ok (names, c) -> [("Std", names, c)] | Err _ -> [])
      in
      let first = V.foldl (\acc d -> match d with | (_, _, (c : Compiled)) -> if c.high > acc then c.high else acc) 0 deps in
      let vis = Rename.mentionsVisibility (Rename.programOf prog) in
      (match Rename.renamePackageWith "Main" [([], prog)] pre (V.map (\d -> match d with | (n, ns, _) -> (n, ns)) deps) [] first True vis with
       | (m, own, problems) ->
           if not (V.isEmpty problems) then "(error)"
           else if V.isEmpty deps then Lo.cutText (sccModule m) "Main"
           else Lo.cutTextLinked (sccModule m) own "Main" False (V.map (\d -> match d with | (_, _, cp) -> cp) deps))
  | _ -> "(error)"

-- What is wrong with a program: what its syntax says, or what renaming it
-- says, or what checking it does, each where it was found.
@pub fun problemsOf (text : String) (prelude : Result [Diagnostic] SurfaceProgram) (std : () -> Result String (PackageNames, Compiled) ! e) : [Diagnostic] ! e =
  match prepared text prelude std with
  | Err ds -> ds
  | Ok (m, deps, renaming) ->
      if not (V.isEmpty renaming) then renaming
      else
        runSt (\() ->
          let c = checkedAgainst (sccModule m) False deps in
          V.append
            (diagnosticsIn c.tc m.linearBody)
            (V.map (\k -> warningAt nowhere "this compiler cannot check this yet: ${k}") (distinct (St.getRef c.tc.unsupported))))

-- The type of the innermost term of `text` at byte `at`, and where that
-- term is: the program checked again, keeping it (`Check.checkedWanting`).
@pub fun typeAt (text : String) (prelude : Result [Diagnostic] SurfaceProgram) (std : () -> Result String (PackageNames, Compiled) ! e) (at : Int) : Maybe (Meta, String) ! e =
  typeAtIn text None prelude std at

-- The same, of a file in its package, if it is in one.
@pub fun typeAtIn (text : String) (package : Maybe (PackageContext, () -> [Dependency] ! e)) (prelude : Result [Diagnostic] SurfaceProgram) (std : () -> Result String (PackageNames, Compiled) ! e) (at : Int) : Maybe (Meta, String) ! e =
  let (ready, base) = preparedFor text package prelude std in
  match ready with
  | Ok (m, deps, renaming) ->
      if not (V.isEmpty renaming) then None
      else
        runSt (\() ->
          let c = checkedWanting (sccModule m) False deps (at + base) in
          match St.getRef c.tc.found with
          | Just (place, ty) -> Just (metaBack place base, C.shown m.linearBody ty)
          | None -> None)
  | Err _ -> None

-- The goal `?name` of a program, as the checker found it: the type wanted
-- there, and its definition's variables, each its name and type.
@pub fun goalIn (text : String) (prelude : Result [Diagnostic] SurfaceProgram) (std : () -> Result String (PackageNames, Compiled) ! e) (name : String) : Maybe (Core, [(String, Core)]) ! e =
  match prepared text prelude std with
  | Ok (m, deps, _) ->
      runSt (\() ->
        let c = checkedAgainst (sccModule m) False deps in
        goalNamed c.tc name)
  | Err _ -> None

-- The package a file the editor opened is a module of (`Server`'s
-- `opened`): its name, the file's module path, the package's other modules,
-- each its path and text as they were read, the names of the packages it
-- depends on, and every package it reaches, each after those it depends on.
@derive(PartialEq)
@pub record PackageContext = {
  name : String,
  own : [String],
  others : [([String], String)],
  uses : [String],
  needs : [Needed]
}

-- A package a file's package reaches: its name as `use`s write it, its
-- modules as they were read, and the names of the packages it depends on.
@derive(PartialEq)
@pub record Needed = {
  name : String,
  modules : [([String], String)],
  uses : [String]
}

-- A package compiled, for those that depend on it: its name, what it gives,
-- and what it compiled to.
@pub type Dependency = (String, PackageNames, Compiled)

-- What is wrong with a file: checked as a module of its package, if it is
-- one, with the package's other modules; else as a lone program.
@pub fun problemsIn (text : String) (package : Maybe (PackageContext, () -> [Dependency] ! e)) (prelude : Result [Diagnostic] SurfaceProgram) (std : () -> Result String (PackageNames, Compiled) ! e) : [Diagnostic] ! e =
  match package with
  | None -> problemsOf text prelude std
  | Just _ ->
      let (ready, base) = preparedFor text package prelude std in
      let mine = \(d : Diagnostic) -> match whereAt d with | Meta.Meta a b -> (a >= base and a <= base + S.byteLength text) or (a == 0 and b == 0) in
      let back = \(ds : [Diagnostic]) -> V.map (\d -> shiftedBack d base) (V.filter mine ds) in
      match ready with
      | Err ds -> back ds
      | Ok (m, deps, renaming) ->
          if not (V.isEmpty renaming) then back renaming
          else
            back (runSt (\() ->
              let c = checkedAgainst (sccModule m) False deps in
              diagnosticsIn c.tc m.linearBody))

-- A file ready to check, as `prepared` makes a lone program ready: as a
-- module of its package, if it is one, and where its places start in the
-- package's places. The package is renamed whole: each module, in the
-- order of its imports, parsed after as many newlines as the modules
-- before it have bytes, so that each has places of its own in one source
-- map, as the Rust compiler's files do. A file in no package, or whose
-- package has another module that does not parse, is a lone program, its
-- places from 0.
@pub fun preparedFor (text : String) (package : Maybe (PackageContext, () -> [Dependency] ! e)) (prelude : Result [Diagnostic] SurfaceProgram) (std : () -> Result String (PackageNames, Compiled) ! e) : (Result [Diagnostic] (Rename.Renamed, [Compiled], [Diagnostic]), Int) ! e =
  match package with
  | None -> (prepared text prelude std, 0)
  | Just (pc, built) -> M.unwrapOr (prepared text prelude std, 0) (packagePrepared text pc built prelude std)

fun packagePrepared (text : String) (pc : PackageContext) (built : () -> [Dependency] ! e) (prelude : Result [Diagnostic] SurfaceProgram) (std : () -> Result String (PackageNames, Compiled) ! e) : Maybe (Result [Diagnostic] (Rename.Renamed, [Compiled], [Diagnostic]), Int) ! e =
  let modules = V.pushBack (V.filter (\m -> fst m != pc.own) pc.others) (pc.own, text) in
  let ordered = inImportOrder pc.name modules in
  let bases = V.foldl (\acc m -> V.pushBack acc (M.unwrapOr 0 (V.last acc) + S.byteLength (snd m) + 1)) [0] ordered in
  let ownAt = M.unwrapOr 0 (V.find (\i -> M.map fst (V.get ordered i) == Just pc.own) (V.range 0 (V.len ordered))) in
  let base = V.getOr 0 bases ownAt in
  let parsedAll = V.map (\i -> match V.get ordered i with | Just (p, t) -> (p, Surface.parsed (S.repeat "\n" (V.getOr 0 bases i) ++ t)) | None -> ([], Err [])) (V.range 0 (V.len ordered)) in
  match V.find (\x -> fst x == pc.own) parsedAll with
  | Just (_, Err ds) -> Just (Err ds, base)
  | _ ->
      if V.any (\x -> match snd x with | Err _ -> True | Ok _ -> False) parsedAll then None
      else
        match prelude with
        | Err _ -> None
        | Ok pre ->
            let progs = V.concatMap (\x -> match snd x with | Ok p -> [(fst x, p)] | Err _ -> []) parsedAll in
            -- (Std compiled only if something here, or in a package it
            -- reaches, names it, as for a lone file: compiling it is most of
            -- what opening a file costs. What it depends on was compiled after
            -- Std if the rest of the package names it; if only this text
            -- does, it is compiled again after Std, so no two share a unique)
            let needsStd = pc.name != "Std" and (stdNamed pc or namesStd [(pc.own, text)]) in
            let base0 = if needsStd then (match std () with | Ok (names, c) -> [("Std", names, c)] | Err _ -> []) else [] in
            let compiled =
              if V.isEmpty pc.needs then []
              else if needsStd and not (stdNamed pc) then dependenciesCompiled pc.needs True prelude std
              else built ()
            in
            let deps = V.append base0 compiled in
            let direct = V.filter (\d -> match d with | (n, _, _) -> n == "Std" or V.elem n pc.uses) deps in
            let vis = V.any (\x -> Rename.mentionsVisibility (Rename.programOf (snd x))) progs in
            (match Rename.renamePackageWith pc.name progs pre (V.map (\d -> match d with | (n, ns, _) -> (n, ns)) direct) [] (highest deps) True vis with
             | (m, _, _) ->
                 Just (Ok (m, V.map (\d -> match d with | (_, _, cp) -> cp) deps, V.map (\p -> match p with | (at, why) -> problemAt at why) m.problemsAt), base))

-- What tactic mode (`Tactic`) needs of the goal `?name`: the type wanted
-- there; its definition's variables, each its name and type; and, for each
-- of those whose type is a data type, its constructors, each as a pattern
-- names it (`Maybe.Just`, or `::`) with how many fields it takes.
@pub record GoalFacts = {
  want : Core,
  locals : [(String, Core)],
  splits : [(String, [(String, Int)])]
}

@pub fun goalFacts (text : String) (prelude : Result [Diagnostic] SurfaceProgram) (std : () -> Result String (PackageNames, Compiled) ! e) (name : String) : Maybe GoalFacts ! e =
  match prepared text prelude std with
  | Ok (m, deps, _) ->
      runSt (\() ->
        let c = checkedAgainst (sccModule m) False deps in
        match goalNamed c.tc name with
        | None -> None
        | Just (want, locals) ->
            let splits = V.concatMap (\l -> match l with | (x, t) -> M.unwrapOr [] (M.map (\cs -> [(x, cs)]) (constructorsOf c.tc t))) locals in
            Just (GoalFacts { want, locals, splits }))
  | Err _ -> None

-- What one check of a program says, for tactic mode, which would otherwise
-- check it once for each: what is wrong with it; its goals in the order
-- the checker meets them, each its name and how it is said (its type and
-- context); and what is known of the goal `focus`, if there is one.
@pub record Checkup = {
  wrong : [Diagnostic],
  goals : [(String, String)],
  focused : Maybe GoalFacts
}

@pub fun checkup (text : String) (prelude : Result [Diagnostic] SurfaceProgram) (std : () -> Result String (PackageNames, Compiled) ! e) (focus : String) : Checkup ! e =
  match prepared text prelude std with
  | Err ds -> Checkup { wrong = ds, goals = [], focused = None }
  | Ok (m, deps, renaming) ->
      runSt (\() ->
        let c = checkedAgainst (sccModule m) False deps in
        let placed = St.getRef c.tc.placed in
        let goals = V.concatMap (\p -> match p with | (_, said) -> if S.startsWith "goal ?" said then [goalEntry (S.drop said 5)] else []) placed in
        let focused =
          M.map
            (\g -> match g with
              | (want, locals) ->
                  GoalFacts { want, locals, splits = V.concatMap (\l -> match l with | (x, t) -> M.unwrapOr [] (M.map (\cs -> [(x, cs)]) (constructorsOf c.tc t))) locals })
            (goalNamed c.tc focus)
        in
        Checkup { wrong = V.append renaming (V.filter isError (diagnosticsIn c.tc m.linearBody)), goals, focused })

-- A goal as the checker says it, `?name : T` and its context, with its name.
fun goalEntry (said : String) : (String, String) =
  (S.drop (M.unwrapOr said (M.map (\at -> S.slice said 0 at) (S.indexOf " :" said))) 1, said)

-- The constructors of the data type `t` is, if it is one: each as a
-- pattern names it, and its fields.
fun constructorsOf (tc : Tc s) (t : Core) : Maybe [(String, Int)] ! { St s | e } =
  match headOf t with
  | Core.Opaque d dname ->
      M.map
        (\cs ->
          V.concatMap
            (\u ->
              match ctorInfo tc u with
              | Just (CtorInfo.CtorInfo name _ _ _ fields) -> [(if name == "::" then name else "${dname}.${name}", fields)]
              | None -> [])
            cs)
        (Hm.lookup d (St.getRef tc.datas))
  | _ -> None

fun headOf (t : Core) : Core =
  match t with
  | Core.App f _ -> headOf f
  | _ -> t

-- The goals, `?name`, left in a program: each said with its type.
@pub fun goalsIn (text : String) (prelude : Result [Diagnostic] SurfaceProgram) (std : () -> Result String (PackageNames, Compiled) ! e) : [String] ! e =
  match prepared text prelude std with
  | Ok (m, deps, _) ->
      runSt (\() ->
        let c = checkedAgainst (sccModule m) False deps in
        V.concatMap (\p -> match p with | (_, said) -> if S.startsWith "goal ?" said then [S.drop said 5] else []) (St.getRef c.tc.placed))
  | Err _ -> []

-- What a program and the prelude declare, each its name, its type, and its
-- type shown: what the finder searches.
@pub fun catalogOf (text : String) (prelude : Result [Diagnostic] SurfaceProgram) (std : () -> Result String (PackageNames, Compiled) ! e) : [(String, Core, String)] ! e =
  match prepared text prelude std with
  | Ok (m, deps, _) ->
      runSt (\() ->
        let c = checkedAgainst (sccModule m) False deps in
        V.concatMap
          (\d -> match d with | (_, name, ty) -> if written name then [(name, ty, C.shown m.linearBody ty)] else [])
          (St.getRef c.tc.declared))
  | Err _ -> []

-- What the program and the prelude declare: each name, the unique it is
-- named by, and its type, shown; with the program's own first unique.
@pub fun declaredIn (text : String) (prelude : Result [Diagnostic] SurfaceProgram) (std : () -> Result String (PackageNames, Compiled) ! e) : ([(Int, String, String)], Int) ! e =
  declaredInPackage text None prelude std

-- The same, of a file in its package, if it is in one: what every module
-- of the package declares.
@pub fun declaredInPackage (text : String) (package : Maybe (PackageContext, () -> [Dependency] ! e)) (prelude : Result [Diagnostic] SurfaceProgram) (std : () -> Result String (PackageNames, Compiled) ! e) : ([(Int, String, String)], Int) ! e =
  match fst (preparedFor text package prelude std) with
  -- (checked though renaming found something wrong: a program being
  -- written always has something wrong with it)
  | Ok (m, deps, _) ->
      runSt (\() ->
        let c = checkedAgainst (sccModule m) False deps in
        (V.map (\d -> match d with | (u, name, ty) -> (u, name, C.shown m.linearBody ty)) (St.getRef c.tc.declared), m.first))
  | Err _ -> ([], 0)

-- Every name of the program's own, with the unique it stands for and where
-- it is (`Rename.occurrences`).
fun ownOccurrences (m : Rename.Renamed) : [(Int, Meta)] =
  V.concatMap
    (\o -> match o with | (us, place) -> V.concatMap (\u -> if u >= m.first then [(u, place)] else []) us)
    (Rename.occurrencesModule (Rename.hirArena m.hir) (Rename.hirRoot m.hir))

-- Where the name at byte `at` of `text` is defined, and every place it is
-- named (the definition among them): of the program's own names, each
-- defined where it is first bound, its equation or its binder.
@pub fun namedAt (text : String) (prelude : Result [Diagnostic] SurfaceProgram) (std : () -> Result String (PackageNames, Compiled) ! e) (at : Int) : Maybe (Meta, [Meta]) ! e =
  namedAtIn text None prelude std at

-- The same, of a file in its package, if it is in one: of the places in
-- this file (a name another module defines has its definition there).
@pub fun namedAtIn (text : String) (package : Maybe (PackageContext, () -> [Dependency] ! e)) (prelude : Result [Diagnostic] SurfaceProgram) (std : () -> Result String (PackageNames, Compiled) ! e) (at : Int) : Maybe (Meta, [Meta]) ! e =
  let (ready, base) = preparedFor text package prelude std in
  match ready with
  | Ok (m, _, _) ->
      let own = V.filter (\o -> inFile (snd o) base text) (ownOccurrences m) in
      let holding = V.filter (\o -> contains (snd o) (at + base)) own in
      (match V.foldl (\best o -> match best with | Just b -> (if width (snd o) < width (snd b) then Just o else best) | None -> Just o) None holding with
       | Just (u, _) ->
           let places = V.map (\p -> metaBack p base) (sortedPlaces (V.concatMap (\o -> if fst o == u then [snd o] else []) own)) in
           M.map (\d -> (d, places)) (V.head places)
       | None -> None)
  | Err _ -> None

-- Whether a place of a package is in the file whose places start at `base`.
fun inFile (m : Meta) (base : Int) (text : String) : Bool =
  match m with | Meta.Meta a _ -> a >= base and a <= base + S.byteLength text

-- The program's own declarations, for an editor's outline: each name, what
-- kind of thing it is, and where it is first bound.
@pub fun symbolsIn (text : String) (prelude : Result [Diagnostic] SurfaceProgram) (std : () -> Result String (PackageNames, Compiled) ! e) : [(String, String, Meta)] ! e =
  symbolsInPackage text None prelude std

-- The same, of a file in its package, if it is in one: its own
-- declarations, not its package's other modules'.
@pub fun symbolsInPackage (text : String) (package : Maybe (PackageContext, () -> [Dependency] ! e)) (prelude : Result [Diagnostic] SurfaceProgram) (std : () -> Result String (PackageNames, Compiled) ! e) : [(String, String, Meta)] ! e =
  let (ready, base) = preparedFor text package prelude std in
  match ready with
  | Ok (m, deps, renaming) ->
      let own = V.concatMap (\o -> if inFile (snd o) base text then [(fst o, metaBack (snd o) base)] else []) (ownOccurrences m) in
      let declared = (match declaredInPackage text package prelude std with | (ds, _) -> ds) in
      V.concatMap
        (\d ->
          match d with
          | (u, name, ty) ->
              (match V.head (sortedPlaces (V.concatMap (\o -> if fst o == u then [snd o] else []) own)) with
               | Just place -> (if u >= m.first and not (S.startsWith "#" name) then [(name, kindOf ty, place)] else [])
               | None -> []))
        declared
  | Err _ -> []

-- What kind of thing a declaration of type `ty` is, to an editor.
fun kindOf (ty : String) : String =
  if S.startsWith "Type" ty or S.contains "-> Type" ty then "type"
  else if S.contains "->" ty then "function"
  else "constant"

-- Names to complete with at byte `at`: the program's own and the
-- prelude's (Std's, if it names Std), each with its type. The line being
-- written seldom parses yet, so if the program does not, it is checked
-- without that line; and failing that, the prelude's alone.
@pub fun completionsIn (text : String) (prelude : Result [Diagnostic] SurfaceProgram) (std : () -> Result String (PackageNames, Compiled) ! e) (at : Int) : [(String, String)] ! e =
  completionsInPackage text None prelude std at

-- The same, of a file in its package, if it is in one: the names of the
-- package's other modules among them.
@pub fun completionsInPackage (text : String) (package : Maybe (PackageContext, () -> [Dependency] ! e)) (prelude : Result [Diagnostic] SurfaceProgram) (std : () -> Result String (PackageNames, Compiled) ! e) (at : Int) : [(String, String)] ! e =
  let declared =
    match declaredInPackage text package prelude std with
    | ([], _) ->
        (match declaredInPackage (withoutLineAt text at) package prelude std with
         | ([], _) -> declaredIn "" prelude std
         | d -> d)
    | d -> d
  in
  match declared with
  | (ds, _) ->
      V.foldl
        (\acc d ->
          match d with
          | (_, name, ty) -> if not (written name) or V.any (\x -> fst x == name) acc then acc else V.pushBack acc (name, ty))
        []
        ds

-- Whether a program could write the name: not the checker's own
-- (`#super0`), nor one with nothing after its type's name.
@pub fun written (name : String) : Bool =
  not (S.isEmpty name) and not (S.contains "#" name) and not (S.contains " " name) and not (S.endsWith "." name)

-- `text` with the line `at` is on left empty.
fun withoutLineAt (text : String) (at : Int) : String =
  let line = V.len (S.split "\n" (S.slice text 0 at)) - 1 in
  S.join "\n" (V.set (S.split "\n" text) line "")

fun contains (m : Meta) (at : Int) : Bool = match m with | Meta.Meta a b -> a <= at and at <= b

fun width (m : Meta) : Int = match m with | Meta.Meta a b -> b - a

fun startOf (m : Meta) : Int = match m with | Meta.Meta a _ -> a

-- Places in the order they come in the text, each once.
fun sortedPlaces (ps : [Meta]) : [Meta] =
  V.foldl (\acc p -> if V.elem p acc then acc else V.concat [V.filter (\q -> startOf q <= startOf p) acc, [p], V.filter (\q -> startOf q > startOf p) acc]) [] ps

-- Std compiled, after the prelude: its modules as this program holds them.
@pub fun stdOf (prelude : Result [Diagnostic] SurfaceProgram) : Result String (PackageNames, Compiled) =
  match prelude with
  | Err _ -> Err "the prelude does not parse"
  | Ok pre ->
      let parsed =
        V.foldl
          (\acc m ->
            match (acc, m) with
            | (Err e, _) -> Err e
            | (Ok done, (path, text)) ->
                (match Surface.parsed text with
                 | Ok p -> Ok (V.pushBack done ((if path == "" then [] else S.split "." path), p))
                 | Err _ -> Err "Std.${path} does not parse"))
          (Ok [])
          D.stdModules
      in
      match parsed with
      | Err e -> Err e
      | Ok mods ->
          let paths = V.map fst D.stdModules in
          compiledPackage pre "Std" (V.concatMap (\i -> match V.get mods i with | Just m -> [m] | None -> []) (importOrder "Std" paths (V.map snd D.stdModules))) []

-- The modules of a package at `paths`, by index: each after the modules it
-- imports, so that a module's instances are there for the searches of those
-- that use it (as a package read from its directory is ordered); the root
-- still first.
fun importOrder (package : String) (paths : [String]) (texts : [String]) : [Int] =
  let parted = V.concatMap Parts.partModules (Parts.parts package paths texts) in
  V.append (V.filter (\i -> V.getOr "" paths i == "") parted) (V.filter (\i -> V.getOr "" paths i != "") parted)

fun inImportOrder (package : String) (modules : [([String], String)]) : [([String], String)] =
  V.concatMap
    (\i -> match V.get modules i with | Just m -> [m] | None -> [])
    (importOrder package (V.map (\m -> S.join "." (fst m)) modules) (V.map snd modules))

-- Whether what a package's file is checked with names Std, which is then
-- compiled first, before what the package depends on: one of the package's
-- other modules, or a module of a package it reaches.
@pub fun stdNamed (pc : PackageContext) : Bool =
  namesStd pc.others or V.any (\(n : Needed) -> namesStd n.modules) pc.needs

fun namesStd (modules : [([String], String)]) : Bool = V.any (\m -> S.contains "Std" (snd m)) modules

-- The most names any of these packages has given: where one checked against
-- them names its things from.
fun highest (deps : [Dependency]) : Int =
  V.foldl (\acc d -> match d with | (_, _, (c : Compiled)) -> if c.high > acc then c.high else acc) 0 deps

-- The packages a file's package reaches, compiled in turn, each against Std
-- (`withStd`: something names it) and those before it: so no two share a
-- unique, and one reached twice is compiled once. One that does not compile
-- is left out, as Std is: what names it says so, where it does.
@pub fun dependenciesCompiled (needed : [Needed]) (withStd : Bool) (prelude : Result [Diagnostic] SurfaceProgram) (std : () -> Result String (PackageNames, Compiled) ! e) : [Dependency] ! e =
  match prelude with
  | Err _ -> []
  | Ok pre ->
      if V.isEmpty needed then []
      else
        let base = if not withStd then [] else (match std () with | Ok (names, c) -> [("Std", names, c)] | Err _ -> []) in
        let done =
          V.foldl
            (\acc (n : Needed) ->
              let mods = V.map (\m -> (fst m, Surface.parsed (snd m))) (inImportOrder n.name n.modules) in
              let parsed = V.concatMap (\m -> match snd m with | Ok p -> [(fst m, p)] | Err _ -> []) mods in
              if V.len parsed != V.len mods then acc
              else
                let direct = V.filter (\d -> match d with | (name, _, _) -> name == "Std" or V.elem name n.uses) acc in
                match compiledAgainst pre n.name parsed direct acc (highest acc) with
                | Ok (names, c) -> V.pushBack acc (n.name, names, c)
                | Err _ -> acc)
            base
            needed
        in
        V.drop done (V.len base)

-- A package compiled whole, after the prelude, against the compiled
-- packages it depends on: the names it gives, and its interface.
@pub fun compiledPackage prelude (name : String) (modules : [([String], SurfaceProgram)]) (deps : [Dependency]) : Result String (PackageNames, Compiled) =
  compiledAgainst prelude name modules deps deps (highest deps)

-- The same: its `use`s may name those of `direct`, it is checked against
-- all `reached`, and it names its things from `first`.
fun compiledAgainst prelude (name : String) (modules : [([String], SurfaceProgram)]) (direct : [Dependency]) (reached : [Dependency]) (first : Int) : Result String (PackageNames, Compiled) =
  let programs = V.map (\m -> Rename.programOf (snd m)) modules in
  let vis = V.any (\p -> Rename.mentionsVisibility p) programs in
  match Rename.renamePackageWith name modules prelude (V.map (\d -> match d with | (n, ns, _) -> (n, ns)) direct) [] first True vis with
  | (m, names, problems) ->
      if not (V.isEmpty problems) then Err (S.join "; " problems)
      else
        let grouped = sccModule m in
        runSt (\() ->
          let c = checkedAgainst grouped False (V.map (\d -> match d with | (_, _, cp) -> cp) reached) in
          let errors = St.getRef c.tc.errors in
          if not (V.isEmpty errors) then Err (S.join ", " errors) else Ok (names, compiledOf c grouped names))

-- A file set out, or as it is if it has errors.
@pub fun formattedOf (text : String) : String = match Fmt.formatted text with | Ok out -> out | Err _ -> text

fun nowhere = spanMeta 0 0

fun distinct (xs : [String]) : [String] = V.foldl (\acc x -> if V.elem x acc then acc else V.pushBack acc x) [] xs
