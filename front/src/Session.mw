-- The compiler as queries (`database!`), for the language server (`Server`)
-- and the prompt to come: each open file's text is an input, and what is
-- worked out from it -- its tree, what is wrong with it, how it is set out
-- -- is worked out again only when something it read changed. A file is
-- checked as a lone program after the prelude, as `idyllic file.idl`
-- checks one, against Std compiled if it names Std; Std is compiled once
-- a session.
--
-- A query may perform nothing but asking other queries, which is why the
-- renamer and the checker keep their state in `St` (each run in a
-- `runSt` of its own), never in a `Mut` cell.

use Lingua (database!)
use Lingua.Green (Green)
use Lingua.Diagnostic (Diagnostic, errorAt, warningAt)
use Lingua.Lang (Meta, spanMeta)
use Idyll.Syntax (Idyll, parseIdyll)
use Idyll.Surface (SurfaceProgram)
use Idyll.Surface as Surface
use Idyll.Rename (PackageNames)
use Idyll.Rename as Rename
use Idyll.Scc (sccModule)
use Idyll.Check (checkedAgainst, checkedWanting)
use Idyll.Core as C
use Idyll.Compiled (compiledOf)
use Idyll.Interface (Compiled)
use Idyll.Driver as D
use Idyll.Format as Fmt
use Std.St (runSt)
use Std.St as St
use Std.Collections.Vector as V
use Std.String as S
use Std.Maybe as M
use Std.Result.Result.*

database! {
  pub Session
    | input source (file : Int) : String
    -- the declarations a prompt has been given so far (`Prompt`)
    | input earlier (unit : Int) : String
    | query parsed (file : Int) : (Green Idyll, [(Int, String)]) = parseIdyll (querySource file)
    | query prelude (unit : Int) : Result [Diagnostic] SurfaceProgram = Surface.parsed D.prelude
    | query std (unit : Int) : Result String (PackageNames, Compiled) = stdOf (queryPrelude 0)
    | query problems (file : Int) : [Diagnostic] =
        problemsOf (querySource file) (queryPrelude 0) (\u -> queryStd 0)
    | query formatted (file : Int) : String = formattedOf (querySource file)
}

-- --- what the queries do ----------------------------------------------------------

-- A program ready to check: renamed after the prelude, against Std compiled
-- if it names Std; with what renaming found wrong, each where. Or what its
-- syntax says is wrong with it.
@pub fun preparedProgram (text : String) prelude std = prepared text prelude std

fun prepared (text : String) (prelude : Result [Diagnostic] SurfaceProgram) (std : () -> Result String (PackageNames, Compiled) ! e) : Result [Diagnostic] (Rename.Renamed, [Compiled], [Diagnostic]) ! e =
  match (Surface.parsed text, prelude) with
  | (Err ds, _) -> Err ds
  | (_, Err _) -> Err [errorAt nowhere "the prelude does not parse"]
  | (Ok prog, Ok pre) ->
      let deps =
        if not (S.contains "Std" text) then []
        else (match std () with | Ok (names, c) -> [("Std", names, c)] | Err _ -> [])
      in
      let first = V.foldl (\acc d -> match d with | (_, _, (c : Compiled)) -> if c.high > acc then c.high else acc) 0 deps in
      let vis = Rename.mentionsVisibility (Rename.programOf prog) in
      (match Rename.renamePackageWith "Main" [([], prog)] pre (V.map (\d -> match d with | (n, ns, _) -> (n, ns)) deps) [] first True vis with
       | (m, _, _) ->
           Ok (m, V.map (\d -> match d with | (_, _, cp) -> cp) deps, V.map (\p -> match p with | (at, why) -> errorAt at why) m.problemsAt))

-- What is wrong with a program: what its syntax says, or what renaming it
-- says, or what checking it does, each where it was found.
@pub fun problemsOf (text : String) (prelude : Result [Diagnostic] SurfaceProgram) (std : () -> Result String (PackageNames, Compiled) ! e) : [Diagnostic] ! e =
  match prepared text prelude std with
  | Err ds -> ds
  | Ok (m, deps, renaming) ->
      if not (V.isEmpty renaming) then renaming
      else
        runSt (\() ->
          let c = checkedAgainst (sccModule m) False deps in
          V.append
            (placedOnce (St.getRef c.tc.placed))
            (V.map (\k -> warningAt nowhere "this compiler cannot check this yet: ${k}") (distinct (St.getRef c.tc.unsupported))))

-- The type of the innermost term of `text` at byte `at`, and where that
-- term is: the program checked again, keeping it (`Check.checkedWanting`).
@pub fun typeAt (text : String) (prelude : Result [Diagnostic] SurfaceProgram) (std : () -> Result String (PackageNames, Compiled) ! e) (at : Int) : Maybe (Meta, String) ! e =
  match prepared text prelude std with
  | Ok (m, deps, renaming) ->
      if not (V.isEmpty renaming) then None
      else
        runSt (\() ->
          let c = checkedWanting (sccModule m) False deps at in
          match St.getRef c.tc.found with
          | Just (place, ty) -> Just (place, C.shown m.linearBody ty)
          | None -> None)
  | Err _ -> None

-- The goals, `?name`, left in a program: each said with its type.
@pub fun goalsIn (text : String) (prelude : Result [Diagnostic] SurfaceProgram) (std : () -> Result String (PackageNames, Compiled) ! e) : [String] ! e =
  match prepared text prelude std with
  | Ok (m, deps, _) ->
      runSt (\() ->
        let c = checkedAgainst (sccModule m) False deps in
        V.concatMap (\p -> match p with | (_, said) -> if S.startsWith "goal ?" said then [S.drop said 5] else []) (St.getRef c.tc.placed))
  | Err _ -> []

-- What the program and the prelude declare: each name, the unique it is
-- named by, and its type, shown; with the program's own first unique.
@pub fun declaredIn (text : String) (prelude : Result [Diagnostic] SurfaceProgram) (std : () -> Result String (PackageNames, Compiled) ! e) : ([(Int, String, String)], Int) ! e =
  match prepared text prelude std with
  -- (checked though renaming found something wrong: a program being
  -- written always has something wrong with it)
  | Ok (m, deps, _) ->
      runSt (\() ->
        let c = checkedAgainst (sccModule m) False deps in
        (V.map (\d -> match d with | (u, name, ty) -> (u, name, C.shown m.linearBody ty)) (St.getRef c.tc.declared), m.first))
  | Err _ -> ([], 0)

-- Every name of the program's own, with the unique it stands for and where
-- it is (`Rename.occurrences`).
fun ownOccurrences (m : Rename.Renamed) : [(Int, Meta)] =
  V.concatMap
    (\o -> match o with | (us, place) -> V.concatMap (\u -> if u >= m.first then [(u, place)] else []) us)
    (Rename.occurrencesModule (Rename.hirArena m.hir) (Rename.hirRoot m.hir))

-- Where the name at byte `at` of `text` is defined, and every place it is
-- named (the definition among them): of the program's own names, each
-- defined where it is first bound, its equation or its binder.
@pub fun namedAt (text : String) (prelude : Result [Diagnostic] SurfaceProgram) (std : () -> Result String (PackageNames, Compiled) ! e) (at : Int) : Maybe (Meta, [Meta]) ! e =
  match prepared text prelude std with
  | Ok (m, _, _) ->
      let own = ownOccurrences m in
      let holding = V.filter (\o -> contains (snd o) at) own in
      (match V.foldl (\best o -> match best with | Just b -> (if width (snd o) < width (snd b) then Just o else best) | None -> Just o) None holding with
       | Just (u, _) ->
           let places = sortedPlaces (V.concatMap (\o -> if fst o == u then [snd o] else []) own) in
           M.map (\d -> (d, places)) (V.head places)
       | None -> None)
  | Err _ -> None

-- The program's own declarations, for an editor's outline: each name, what
-- kind of thing it is, and where it is first bound.
@pub fun symbolsIn (text : String) (prelude : Result [Diagnostic] SurfaceProgram) (std : () -> Result String (PackageNames, Compiled) ! e) : [(String, String, Meta)] ! e =
  match prepared text prelude std with
  | Ok (m, deps, renaming) ->
      let own = ownOccurrences m in
      let declared = (match declaredIn text prelude std with | (ds, _) -> ds) in
      V.concatMap
        (\d ->
          match d with
          | (u, name, ty) ->
              (match V.head (sortedPlaces (V.concatMap (\o -> if fst o == u then [snd o] else []) own)) with
               | Just place -> (if u >= m.first and not (S.startsWith "#" name) then [(name, kindOf ty, place)] else [])
               | None -> []))
        declared
  | Err _ -> []

-- What kind of thing a declaration of type `ty` is, to an editor.
fun kindOf (ty : String) : String =
  if S.startsWith "Type" ty or S.contains "-> Type" ty then "type"
  else if S.contains "->" ty then "function"
  else "constant"

-- Names to complete with at byte `at`: the program's own and the
-- prelude's (Std's, if it names Std), each with its type. The line being
-- written seldom parses yet, so if the program does not, it is checked
-- without that line; and failing that, the prelude's alone.
@pub fun completionsIn (text : String) (prelude : Result [Diagnostic] SurfaceProgram) (std : () -> Result String (PackageNames, Compiled) ! e) (at : Int) : [(String, String)] ! e =
  let declared =
    match declaredIn text prelude std with
    | ([], _) ->
        (match declaredIn (withoutLineAt text at) prelude std with
         | ([], _) -> declaredIn "" prelude std
         | d -> d)
    | d -> d
  in
  match declared with
  | (ds, _) ->
      V.foldl
        (\acc d ->
          match d with
          | (_, name, ty) -> if not (written name) or V.any (\x -> fst x == name) acc then acc else V.pushBack acc (name, ty))
        []
        ds

-- Whether a program could write the name: not the checker's own
-- (`#super0`), nor one with nothing after its type's name.
@pub fun written (name : String) : Bool =
  not (S.isEmpty name) and not (S.contains "#" name) and not (S.contains " " name) and not (S.endsWith "." name)

-- `text` with the line `at` is on left empty.
fun withoutLineAt (text : String) (at : Int) : String =
  let line = V.len (S.split "\n" (S.slice text 0 at)) - 1 in
  S.join "\n" (V.set (S.split "\n" text) line "")

fun contains (m : Meta) (at : Int) : Bool = match m with | Meta.Meta a b -> a <= at and at <= b

fun width (m : Meta) : Int = match m with | Meta.Meta a b -> b - a

fun startOf (m : Meta) : Int = match m with | Meta.Meta a _ -> a

-- Places in the order they come in the text, each once.
fun sortedPlaces (ps : [Meta]) : [Meta] =
  V.foldl (\acc p -> if V.elem p acc then acc else V.concat [V.filter (\q -> startOf q <= startOf p) acc, [p], V.filter (\q -> startOf q > startOf p) acc]) [] ps

-- Std compiled, after the prelude: its modules as this program holds them.
@pub fun stdOf (prelude : Result [Diagnostic] SurfaceProgram) : Result String (PackageNames, Compiled) =
  match prelude with
  | Err _ -> Err "the prelude does not parse"
  | Ok pre ->
      let parsed =
        V.foldl
          (\acc m ->
            match (acc, m) with
            | (Err e, _) -> Err e
            | (Ok done, (path, text)) ->
                (match Surface.parsed text with
                 | Ok p -> Ok (V.pushBack done ((if path == "" then [] else S.split "." path), p))
                 | Err _ -> Err "Std.${path} does not parse"))
          (Ok [])
          D.stdModules
      in
      match parsed with
      | Err e -> Err e
      | Ok mods -> compiledPackage pre "Std" mods []

-- A package compiled whole, after the prelude, against the compiled
-- packages it depends on: the names it gives, and its interface.
@pub fun compiledPackage prelude (name : String) (modules : [([String], SurfaceProgram)]) (deps : [(String, PackageNames, Compiled)]) : Result String (PackageNames, Compiled) =
  let programs = V.map (\m -> Rename.programOf (snd m)) modules in
  let vis = V.any (\p -> Rename.mentionsVisibility p) programs in
  let first = V.foldl (\acc d -> match d with | (_, _, (c : Compiled)) -> if c.high > acc then c.high else acc) 0 deps in
  match Rename.renamePackageWith name modules prelude (V.map (\d -> match d with | (n, ns, _) -> (n, ns)) deps) [] first True vis with
  | (m, names, problems) ->
      if not (V.isEmpty problems) then Err (S.join "; " problems)
      else
        let grouped = sccModule m in
        runSt (\() ->
          let c = checkedAgainst grouped False (V.map (\d -> match d with | (_, _, cp) -> cp) deps) in
          let errors = St.getRef c.tc.errors in
          if not (V.isEmpty errors) then Err (S.join ", " errors) else Ok (names, compiledOf c grouped names))

-- A file set out, or as it is if it has errors.
@pub fun formattedOf (text : String) : String = match Fmt.formatted text with | Ok out -> out | Err _ -> text

fun nowhere = spanMeta 0 0

-- The checker's errors, each once where it was found, said in words.
@pub fun placedDiagnostics (placed : [(Meta, String)]) : [Diagnostic] = placedOnce placed

fun placedOnce (placed : [(Meta, String)]) : [Diagnostic] =
  V.map
    (\p ->
      match p with
      -- a goal, and a hole filled in, are warnings: what is around them
      -- can still be worked on
      | (at, kind) -> if S.startsWith "goal ?" kind then warningAt at kind else if kind == "HoleSolved" then warningAt at (said kind) else errorAt at (said kind))
    (V.foldl (\acc p -> if V.elem p acc then acc else V.pushBack acc p) [] placed)

-- An error's kind, said in words: the commonest in a sentence, the rest by
-- the name the Rust checker gives the kind, its words apart
-- (`NotAConstructorOf`, "not a constructor of").
fun said (kind : String) : String =
  match V.find (\p -> fst p == kind) errorWords with
  | Just (_, words) -> words
  | None -> wordsOf kind

def errorWords : [(String, String)] =
  [
    ("Mismatch", "this has a type other than the one wanted"),
    ("UnknownVariable", "nothing of this name is in scope"),
    ("NotAFunction", "this is applied, but it is not a function"),
    ("UsageMismatch", "this is used other than as its grade allows"),
    ("UnsolvedMeta", "what this is could not be worked out"),
    ("MissingCases", "these patterns do not cover every case"),
    ("UnreachableClause", "this clause can never be reached"),
    ("AmbiguousName", "this name has more than one meaning here"),
    ("MayNotTerminate", "this may not terminate"),
    ("UnhandledEffects", "this performs effects nothing here handles")
  ]

-- `NotAConstructorOf` as "not a constructor of".
fun wordsOf (name : String) : String =
  let n = S.byteLength name in
  let step =
    \acc i ->
      let c = S.slice name i (i + 1) in
      let lower = S.toLower c in
      if i > 0 and c != lower then acc ++ " " ++ lower else acc ++ lower
  in
  V.foldl step "" (V.range 0 n)

fun distinct (xs : [String]) : [String] = V.foldl (\acc x -> if V.elem x acc then acc else V.pushBack acc x) [] xs
