-- Idyll's REPL (`repl!`), `Idyll repl`, over the same session of the
-- compiler's queries as the language server (`Session`).
--
-- As the Rust driver's REPL does (`pipeline::Session`), it keeps the
-- declarations entered so far as source (the session's `earlier`), and
-- checks each entry after them. An entry of declarations alone, with
-- nothing wrong with it, extends them, and says what it declares
-- (`double : Int -> Int`). An expression is run on the CEK machine
-- (`Cek`), and its value and type are said (`3 : Int`; a function, which
-- has no value to show, `: Int -> Int`). What is wrong with an entry is
-- drawn against the entry.

use Lingua (repl!)
use Lingua.Repl (Reply, Hit, hitName)
use Lingua.Diagnostic (Diagnostic, renderAll, whereAt, isError)
use Lingua.Lang (Meta)
use Idyll.Session
use Idyll.Messages (diagnosticsIn, shiftedBack)
use Idyll.Find as Find
use Idyll.Prove as Prove
use Idyll.Tactic as Tactic
use Idyll.Syntax (parseIdyll)
use Idyll.Layout as Layout
use Idyll.Surface as Surface
use Idyll.Rename as Rename
use Idyll.Scc (sccModule)
use Idyll.Check (checkedAgainst)
use Idyll.Core as C
use Idyll.Hir (Literal)
use Idyll.Cek as Cek
use Idyll.World as W
use Std.St (runSt)
use Std.Process (run, getEnv, currentPid)
use Std.Fs (writeString)
use Std.Path as Path
use Std.St as St
use Std.Exn (toResult)
use Std.Time (timed)
use Std.Collections.Vector as V
use Std.String as S
use Std.Maybe as M
use Std.Result.Result.*

repl! {
  pub Prompt "idyll" for Session
    | text = setSessionSource
    | eval = entered
    | tree = treeIn
    | errors = errorsIn
    | completion = completedIn
    | declarations = declaredSoFar
    | search = searchedFor
    | commands = promptCommands
    | prompt = "> "
    | history = ".idyll_history"
}

-- A query's answer, or `fallback` if it has none (an input never set).
fun answered fallback act = match toResult act with | Ok x -> x | Err _ -> fallback

-- Std compiled, or why not.
fun stdIn db = answered (Err "Std could not be compiled") (\() -> sessionStd db 0)

-- The declarations entered so far.
fun earlierIn db = answered "" (\() -> sessionEarlier db 0)

-- What entering the entry says, and how long it took if every entry's time
-- is said (`:time`).
fun entered db file = if answered False (\() -> sessionTiming db 0) then timed1 (\() -> enteredNow db file) else enteredNow db file

-- What `act`, an entry entered, says, then how long it took.
fun timed1 act =
  match timed act with
  | (said, took) -> (if S.isEmpty said then "" else said ++ "\n") ++ "(${show (took / 1000000)} ms, checked and run)"

-- What entering the entry says; the declarations entered so far are
-- extended by it, if it is declarations alone and nothing is wrong.
fun enteredNow db file =
  let before = earlierIn db in
  let entry = answered "" (\() -> sessionSource db file) in
  let program = before ++ S.trimEnd entry ++ "\n" in
  let wl = setSessionLast db 0 (before, S.trimEnd entry) in
  match ran program (S.byteLength before) (answered (Err []) (\() -> sessionPrelude db 0)) (\u -> stdIn db) with
  | (said, extends) ->
      let w = if extends then setSessionEarlier db 0 program else () in
      said

-- What entering `program` (the declarations so far, `earlier` bytes of it,
-- then an entry) says, and whether it is declarations alone that check.
fun ran (program : String) (earlier : Int) prelude std =
  -- (what was declared before, not to be said again)
  let before = if earlier == 0 then [] else (match declaredIn (S.slice program 0 earlier) prelude std with | (ds, _) -> V.map (\d -> match d with | (_, n, _) -> n) ds) in
  match preparedProgram program prelude std with
  | Err ds -> (drawn program earlier ds, False)
  | Ok (m, deps, renaming) ->
      if not (V.isEmpty renaming) then (drawn program earlier renaming, False)
      else
        -- checked; an expression, which checks, is then run on Glade, as a
        -- program runs, and on the CEK machine where Meadow cannot be run
        let (said, extends, expression) =
          runSt (\() ->
            let c = checkedAgainst (sccModule m) False deps in
            -- (a warning -- a goal, a hole filled in -- is said, and stops
            -- nothing)
            let said = diagnosticsIn c.tc m.linearBody in
            if V.any isError said then (drawn program earlier said, False, None)
            else
              let warned = if V.isEmpty said then "" else drawn program earlier said in
              match c.bodyType with
              | None ->
                  -- declarations: each new one, with its type
                  let own = V.filter (\d -> match d with | (u, name, _) -> u >= m.first and written name and not (V.elem name before)) (St.getRef c.tc.declared) in
                  (warned ++ S.join "\n" (V.map (\d -> match d with | (_, name, ty) -> "${name} : ${C.shown m.linearBody ty}") own), True, None)
              | Just ty -> (warned, False, Just (C.shown m.linearBody ty)))
        in
        match expression with
        | None -> (said, extends)
        | Just ty ->
            match onGlade program prelude std ty with
            | Just shown -> (said ++ shown, False)
            | None -> (said ++ onCek m deps ty, False)

-- What running a program's expression on the CEK machine says.
fun onCek m deps (ty : String) =
  runSt (\() ->
    let c = checkedAgainst (sccModule m) False deps in
    let p = Cek.programOf c in
    match p.body with
    | None -> ": ${ty}"
    | Just term -> valueOf p term ty)

-- What running an entry's program on Glade says, as `meadow cut` runs its
-- Cut: what it printed, then its answer and type (the type alone, for a
-- function, which has no answer to show); or nothing, if it could not be
-- lowered or Meadow could not be run. `IDYLL_REPL_CEK` set keeps every
-- entry on the CEK machine.
fun onGlade (program : String) prelude std (ty : String) =
  if M.isSome (getEnv "IDYLL_REPL_CEK") then None
  else
    let cut = cutIn program prelude std in
    if S.startsWith "(" cut then None
    else
      let file = Path.join (M.unwrapOr "." (M.orElse (getEnv "TMP") (getEnv "TMPDIR"))) "idyll-repl-${show (currentPid ())}.cut" in
      match writeString (file, cut) with
      | Err _ -> None
      | Ok _ ->
          match run "meadow" ["cut", file] with
          | Err _ -> None
          | Ok (code, out, err) ->
              let out = S.join "\n" (S.split "\r\n" out) in
              if code != 0 then Just (out ++ err ++ (if code == 1 then "" else "(exit ${show code})"))
              else if S.contains "\nanswer str" cut then
                (let cut = lastNewline out (S.byteLength out - 1) in
                 let printed = S.slice out 0 (cut + 1) in
                 let answer = S.slice out (cut + 1) (S.byteLength out) in
                 Just "${printed}${answer} : ${ty}")
              else Just "${out}: ${ty}"

-- Where the last newline of `text` up to `i` is, or -1.
fun lastNewline (text : String) (i : Int) : Int =
  if i < 0 then 0 - 1 else if toInt (stringByteAt text i) == 10 then i else lastNewline text (i - 1)

-- What running a program's expression says: what it printed, then its
-- value and type (only the type, for a value with nothing to show).
fun valueOf p term (ty : String) =
  let w = W.captured () in
  let printed = \u -> getRef w.output in
  match Cek.run p w term fuel with
  | Ok (v, _) ->
      let out = printed () in
      let answer = match Cek.shown v with | Just s -> "${s} : ${ty}" | None -> ": ${ty}" in
      if out == "" then answer else out ++ (if S.endsWith "\n" out then "" else "\n") ++ answer
  | Err h -> printed () ++ Cek.haltShown h

-- How many steps an entry is given before it is taken not to stop.
def fuel = 5000000

-- What is wrong, drawn against the entry: of what is wrong with the whole
-- program, what is in the entry (or nowhere in particular).
fun drawn (program : String) (earlier : Int) (ds : [Diagnostic]) : String =
  let entry = S.slice program earlier (S.byteLength program) in
  let mine = V.filter (\d -> match whereAt d with | Meta.Meta a b -> a >= earlier or (a == 0 and b == 0)) ds in
  renderAll "entry" entry (V.map (\d -> shiftedBack d earlier) mine)

-- --- the rest of what the prompt asks ---------------------------------------------

fun treeIn db file = answered (fst (parseIdyll "")) (\() -> fst (sessionParsed db file))

-- Where the parser's errors are, in bytes: an entry with one is not
-- finished. Nor is one that ends in a signature, which waits for its
-- equations (as the Rust REPL's does): its end is taken for an error.
fun errorsIn db file =
  answered [] (\() ->
    let errs = V.map fst (snd (sessionParsed db file)) in
    let text = sessionSource db file in
    if V.isEmpty errs and awaitsEquations text then [S.byteLength text] else errs)

-- Whether `text`'s last line is a signature, `name : type`, that nothing
-- after it defines.
fun awaitsEquations (text : String) : Bool =
  let lines = V.filter (\l -> not (S.isEmpty (S.trim l))) (S.split "\n" text) in
  match V.last lines with
  | Just last ->
      (match S.split " : " last with
       | [] -> False
       | parts ->
           let name = S.trim (V.getOr "" parts 0) in
           V.len parts > 1 and not (S.startsWith " " last) and isName name)
  | None -> False

-- A lower-case name alone: a definition's.
fun isName (s : String) : Bool =
  not (S.isEmpty s) and not (S.contains " " s) and not (S.contains "(" s) and (let c = S.slice s 0 1 in c == S.toLower c and c != S.toUpper c)

-- Names to complete with: the declarations so far, the entry's, the
-- prelude's.
fun completedIn db file at =
  let before = earlierIn db in
  answered [] (\() -> completionsIn (before ++ sessionSource db file) (sessionPrelude db 0) (\u -> stdIn db) (S.byteLength before + at))

-- What the finder finds for a query: by name, or by type as Hoogle reads
-- one (`Find`), among what has been declared and what the prelude has.
fun searchedFor db file (query : String) =
  let w = if answered True (\() -> (let x = sessionEarlier db 0 in False)) then setSessionEarlier db 0 "" else () in
  -- `?T`: terms of `T`, found by proof search
  if S.startsWith "?" (S.trim query) then
    (match proofsOf db (S.drop (S.trim query) 1) with
     | Ok proofs -> V.map (\p -> Hit.Hit p (S.drop (S.trim query) 1) "" "a term of the type, found by proof search" p "") proofs
     | Err _ -> [])
  else answered [] (\() -> Find.found query (sessionCatalog db 0))

-- What has been declared so far, for the finder: each name and its type.
fun declaredSoFar db file =
  let before = earlierIn db in
  answered [] (\() ->
    match declaredIn before (sessionPrelude db 0) (\u -> stdIn db) with
    | (ds, first) -> V.concatMap (\d -> match d with | (u, name, ty) -> if u >= first and written name then [(name, ty, "")] else []) ds)

-- The prompt's own commands.
def promptCommands =
  [
    ("type", "EXPR", "what an expression is, without running it", typeOfEntry),
    ("reset", "", "forget every declaration entered", \db rest -> (let u = setSessionEarlier db 0 "" in Reply.Said "")),
    ("declarations", "", "the declarations entered so far, as source", \db rest -> Reply.Said (S.trimEnd (earlierIn db))),
    ("module", "", "what has been declared so far, each with its type (:browse)", moduleSoFar),
    ("browse", "", "what has been declared so far, each with its type", moduleSoFar),
    ("find", "QUERY", "search by name, or by a type like  Int -> String; ?TYPE, by proof search", foundFor),
    ("ir", "[STAGES] [CODE]", "what an entry is at each stage of the compiler, in a pane (:ir tokens,cut 1 + 2); alone, the last entry's", irOf),
    ("time", "[EXPR]","enter an entry, and say how long it took; alone, time every entry from now on, or stop", timedEntry),
    ("goals", "", "the goals (?name) left in what has been declared, each with its type", goalsSoFar),
    ("prove", "TYPE", "look for a term of a type, or for the goal ?name: proof search", provedEntry),
    ("tactic", "?NAME", "prove the goal ?name a step at a time, each step a `:by`", beganProof),
    ("by", "TACTIC", "a step of the proof under way: intro, intros, exact, refine, apply, cases, induction, rewrite, search, undo", steppedProof),
    ("qed", "", "keep the proof under way: the declarations, the goal filled", keptProof),
    ("abandon", "", "drop the proof under way", \db rest -> (let u = setSessionProving db 0 None in Reply.Said "(abandoned)"))
  ]

-- `:module`: what has been declared so far, a line each, as the Rust REPL
-- lists it.
fun moduleSoFar db rest =
  match declaredSoFar db 0 with
  | [] -> Reply.Said "(nothing defined yet)"
  | ds -> Reply.Said (S.join "\n" (V.map (\d -> match d with | (name, ty, _) -> "${name} : ${ty}") ds))

-- `:find QUERY`: what the finder finds (Ctrl-F's), the first dozen, each
-- with its type.
fun foundFor db rest =
  match V.take (searchedFor db 0 rest) 12 with
  | [] -> Reply.Said "(nothing matches)"
  | hits -> Reply.Said (S.join "\n" (V.map (\h -> match h with | Hit.Hit name ty _ _ _ _ -> if S.isEmpty ty then name else "${name} : ${ty}") hits))

-- The stages `:ir` shows, each its name and what it is: front/'s passes, as
-- `Idyll tokens`, `parse`, `rename`, `types` and `cut` write them.
def irStages : [(String, String)] =
  [
    ("tokens", "the lexer's tokens, laid out: «{» «;» «}» are what layout inserts"),
    ("parse", "the parser's syntax tree"),
    ("rename", "names resolved to uniques: the HIR"),
    ("types", "what the checker made of the entry: each declaration's type, or the expression's"),
    ("cut", "Cut, the IR Meadow's runtimes, Glade and Silo, run (docs/CUT.md in Meadow)")
  ]

-- `:ir [STAGES] [CODE]`: what the code is at each stage (those named, `:ir
-- tokens,cut 1 + 2`, or all), after the declarations so far, in a pane of a
-- page a stage, as the Rust REPL's `:ir` shows them; with no code, the last
-- entry's, after the declarations it was entered after.
fun irOf db rest =
  let names = V.map fst irStages in
  let line = S.trim rest in
  let first = V.getOr "" (S.split " " line) 0 in
  let asked = S.split "," first in
  let named = not (S.isEmpty first) and V.all (\s -> V.elem s names) asked in
  let wanted = if named then asked else [] in
  let code = if named then S.trim (S.drop line (S.byteLength first)) else line in
  let (earlier, entry) = if S.isEmpty code then answered ("", "") (\() -> sessionLast db 0) else (earlierIn db, code) in
  if S.isEmpty entry then
    Reply.Said ("(:ir takes a block of code, or shows the last entry: there is none yet)\n\n" ++ S.join "\n" (V.map (\s -> "  ${fst s}  ${snd s}") irStages))
  else
    -- (each worked out here, not in a function given to another, where the
    -- session's queries may not be asked)
    let program = earlier ++ entry ++ "\n" in
    let prelude = preludeIn db in
    let std = \u -> stdIn db in
    let texts = [Layout.dumped entry, Surface.dumped entry, renamedStage program earlier prelude, typesStage program earlier entry prelude std, cutIn program prelude std] in
    let pages =
      V.concatMap
        (\i -> match V.get irStages i with
          | Just (name, about) -> if V.isEmpty wanted or V.elem name wanted then [(name, "-- ${about}\n\n" ++ V.getOr "" texts i)] else []
          | None -> [])
        (V.range 0 (V.len irStages))
    in
    Reply.Pages (V.getOr "" (S.split "\n" entry) 0) pages

-- The program an entry makes with the declarations before it, `earlier`,
-- renamed: its HIR.
fun renamedStage (program : String) (earlier : String) prelude : String =
  match (Surface.parsed program, prelude) with
  | (Ok prog, Ok pre) -> (match Rename.renameModule prog pre with | (m, problems) -> if V.isEmpty problems then Rename.dumped m else S.join "\n" problems)
  | (Err ds, _) -> drawn program (S.byteLength earlier) ds
  | _ -> "(the prelude does not parse)"

-- The same, checked: each declaration the entry makes, with its type, or
-- the entry's type if it is an expression.
fun typesStage (program : String) (earlier : String) (entry : String) prelude std =
  -- (what was declared before, not to be said again)
  let before = match declaredIn earlier prelude std with | (ds, _) -> V.map (\d -> match d with | (_, n, _) -> n) ds in
  match preparedProgram program prelude std with
  | Err ds -> drawn program (S.byteLength earlier) ds
  | Ok (m, deps, renaming) ->
      if not (V.isEmpty renaming) then drawn program (S.byteLength earlier) renaming
      else
        runSt (\() ->
          let c = checkedAgainst (sccModule m) False deps in
          let wrong = V.filter isError (diagnosticsIn c.tc m.linearBody) in
          if not (V.isEmpty wrong) then drawn program (S.byteLength earlier) wrong
          else
            match c.bodyType with
            | Just ty -> "${entry} : ${C.shown m.linearBody ty}"
            | None ->
                S.join "\n" (V.concatMap (\d -> match d with | (u, n, ty) -> if u >= m.first and written n and not (V.elem n before) then ["${n} : ${C.shown m.linearBody ty}"] else []) (St.getRef c.tc.declared)))

-- `:time EXPR`: the entry entered, as any is, and how long that took; `:time`
-- alone, every entry's time said from now on, or no longer.
fun timedEntry db rest =
  if S.isEmpty (S.trim rest) then
    let now = not (answered False (\() -> sessionTiming db 0)) in
    let w = setSessionTiming db 0 now in
    Reply.Said "(timing every entry: ${if now then "on" else "off"})"
  else
    let w = setSessionSource db 0 rest in
    Reply.Said (timed1 (\() -> enteredNow db 0))

-- The proof under way in tactic mode, if one is.
fun provingIn db = answered None (\() -> sessionProving db 0)

fun preludeIn db = answered (Err []) (\() -> sessionPrelude db 0)

-- `:tactic ?name`: a proof of that goal begun, and the goal said.
fun beganProof db rest =
  match Tactic.begin (earlierIn db) (S.trim rest) (preludeIn db) (\u -> stdIn db) with
  | Err why -> Reply.Said why
  | Ok p ->
      let u = setSessionProving db 0 (Just p) in
      Reply.Said (Tactic.shown p (preludeIn db) (\u -> stdIn db))

-- `:by TACTIC`: the step taken, and the goal now worked on said; or why it
-- cannot be.
fun steppedProof db rest =
  match provingIn db with
  | None -> Reply.Said "no proof under way: `:tactic ?name` begins one"
  | Just p ->
          let catalog = answered [] (\() -> sessionCatalog db 0) in
      match Tactic.step p rest (preludeIn db) (\u -> stdIn db) catalog with
      | Err why -> Reply.Said why
      | Ok p2 ->
          let u = setSessionProving db 0 (Just p2) in
          Reply.Said (Tactic.shown p2 (preludeIn db) (\u -> stdIn db))

-- `:qed`: the declarations, with what the proof built in the goal's place;
-- goals it left are goals still.
fun keptProof db rest =
  match provingIn db with
  | None -> Reply.Said "no proof under way"
  | Just p ->
      let u = setSessionEarlier db 0 p.source in
      let v = setSessionProving db 0 None in
      Reply.Said (if V.isEmpty p.goals then "(proved)" else "(kept, with goals left: ${S.join ", " (V.map (\g -> "?" ++ g) p.goals)})")

-- `:prove T`: terms of `T` the checker accepts, after what has been
-- declared.
fun provedEntry db rest =
  match proofsOf db rest with
  | Err why -> Reply.Said why
  | Ok [] -> Reply.Said "(no proof found)"
  | Ok proofs -> Reply.Said (S.join "\n" proofs)

fun proofsOf db (goal : String) =
  let w = if answered True (\() -> (let x = sessionEarlier db 0 in False)) then setSessionEarlier db 0 "" else () in
  let catalog = answered [] (\() -> sessionCatalog db 0) in
  let prelude = answered (Err []) (\() -> sessionPrelude db 0) in
  -- `?name`: the goal of that name, its variables in scope
  if S.startsWith "?" (S.trim goal) then Prove.provedAt (earlierIn db) (S.drop (S.trim goal) 1) catalog prelude (\u -> stdIn db) 5
  else Prove.proved (earlierIn db) goal catalog prelude (\u -> stdIn db) 5

fun goalsSoFar db rest =
  let goals = goalsIn (earlierIn db) (answered (Err []) (\() -> sessionPrelude db 0)) (\u -> stdIn db) in
  Reply.Said (if V.isEmpty goals then "(no goals)" else S.join "\n" goals)

fun typeOfEntry db rest =
  let before = earlierIn db in
  let program = before ++ rest ++ "\n" in
  match preparedProgram program (answered (Err []) (\() -> sessionPrelude db 0)) (\u -> stdIn db) with
  | Err ds -> Reply.Said (drawn program (S.byteLength before) ds)
  | Ok (m, deps, renaming) ->
      if not (V.isEmpty renaming) then Reply.Said (drawn program (S.byteLength before) renaming)
      else
        runSt (\() ->
          let c = checkedAgainst (sccModule m) False deps in
          let wrong = V.filter isError (diagnosticsIn c.tc m.linearBody) in
          if not (V.isEmpty wrong) then Reply.Said (drawn program (S.byteLength before) wrong)
          else
            match c.bodyType with
            | Just ty -> Reply.Said "${rest} : ${C.shown m.linearBody ty}"
            | None -> Reply.Said "${rest} is no expression")

-- --- tests ---------------------------------------------------------------------------

use Std.Test (assertEq)

-- What entering each entry in turn says.
fun enteredAll (entries : [String]) =
  let db = batchSession () in
  V.map (\e -> (let u = setSessionSource db 0 e in entered db 0)) entries

@test fun anExpressionIsItsValueAndType () =
  assertEq (enteredAll ["1 + 2"]) ["3 : Int"] "as the Rust REPL says it"

@test fun declarationsStayForLaterEntries () =
  assertEq
    (enteredAll ["double : Int -> Int\ndouble n = n + n", "double 21"])
    ["double : Int -> Int", "42 : Int"]
    "declared, then used"

@test fun goalsAreListed () =
  let db = batchSession () in
  let w = setSessionSource db 0 "half : Int -> Int\nhalf n = ?todo" in
  let said = entered db 0 in
  assertEq (goalsIn (earlierIn db) (sessionPrelude db 0) (\u -> stdIn db)) ["?todo : Int\n  n : Int"] "the goal, with its type and what is in scope"

@test fun theFinderFindsByType () =
  let db = batchSession () in
  let names = V.map (\h -> hitName h) (searchedFor db 0 "Int -> String") in
  assertEq (V.elem "showInt" names) True "showInt : Int -> String"

@test fun proofSearchFindsATerm () =
  let db = batchSession () in
  assertEq (proofsOf db "{a : Type} -> a -> a") (Ok ["\\x -> x"]) "the identity"

@test fun proofSearchFillsAGoal () =
  let db = batchSession () in
  let w = setSessionSource db 0 "pick : (b : Bool) -> (x : Int) -> Int\npick b x = ?other" in
  let said = entered db 0 in
  assertEq (M.map (\ps -> V.elem "x" ps) (okOf (proofsOf db "?other"))) (Just True) "x, which is in scope there"

fun okOf r = match r with | Ok x -> Just x | Err _ -> None

-- What each command, `(name, rest)`, says in turn, after `declared`.
fun commandsSaid (declared : String) (commands : [(String, String)]) =
  let db = batchSession () in
  let w = setSessionSource db 0 declared in
  let said = entered db 0 in
  let run = \c -> match c with | (name, rest) -> (match V.find (\pc -> match pc with | (n, _, _, _) -> n == name) promptCommands with
    | Just (_, _, _, act) -> (match act db rest with | Reply.Said s -> s | _ -> "")
    | None -> "") in
  (V.map run commands, earlierIn db)

@test fun irShowsEachStageInAPage () =
  let db = batchSession () in
  let asked = match irOf db "tokens,types 1 + 2" with | Reply.Pages _ ps -> V.map fst ps | _ -> [] in
  let w = setSessionSource db 0 "double : Int -> Int\ndouble n = n + n" in
  let said = entered db 0 in
  let lastOne =
    match irOf db "" with
    | Reply.Pages title ps -> (title, V.map fst ps, S.contains "double : Int -> Int" (snd (V.getOr ("", "") ps 3)))
    | _ -> ("", [], False)
  in
  -- (an expression's Cut, the declarations it uses in it)
  let cut = match irOf db "cut double 21" with | Reply.Pages _ ps -> S.contains "double" (snd (V.getOr ("", "") ps 0)) | _ -> False in
  let a = assertEq asked ["tokens", "types"] "the stages asked for" in
  let b = assertEq cut True "double, in the Cut of what uses it" in
  assertEq lastOne ("double : Int -> Int", ["tokens", "parse", "rename", "types", "cut"], True) "the last entry's, at every stage"

@test fun moduleFindAndTimeSayWhatTheRustReplSays () =
  let (said, after) = commandsSaid "double : Int -> Int\ndouble n = n + n" [("module", ""), ("find", "double"), ("time", "double 21"), ("find", "zzzz")] in
  let a = assertEq (V.getOr "" said 0) "double : Int -> Int" "what is declared" in
  let b = assertEq (S.startsWith "double : Int -> Int" (V.getOr "" said 1)) True "found by name, with its type" in
  let c = assertEq (S.startsWith "42 : Int\n(" (V.getOr "" said 2), S.endsWith " ms, checked and run)" (V.getOr "" said 2)) (True, True) "the answer, then how long" in
  let d = assertEq (V.getOr "" said 3) "(nothing matches)" "nothing of that name" in
  -- `:time` alone: every entry timed, then none
  let db = batchSession () in
  let on = match timedEntry db "" with | Reply.Said s -> s | _ -> "" in
  let w = setSessionSource db 0 "1 + 2" in
  let first = entered db 0 in
  let off = match timedEntry db "" with | Reply.Said s -> s | _ -> "" in
  let second = entered db 0 in
  assertEq (on, S.startsWith "3 : Int\n(" first, off, second) ("(timing every entry: on)", True, "(timing every entry: off)", "3 : Int") "on, timed, off, not"

@test fun aGoalIsProvedAStepAtATime () =
  let (said, after) =
    commandsSaid
      "data N = Z | S N\n\nplus : N -> N -> N\nplus m n = ?todo"
      [("tactic", "?todo"), ("by", "cases m"), ("by", "exact n"), ("by", "exact N.S (plus m1 n)"), ("qed", "")]
  in
  let a = assertEq (V.getOr "" said 0) "?todo : N\n  m : N\n  n : N" "the goal, and what is in scope" in
  let b = assertEq (V.getOr "" said 1) "?todo1 : N\n  m : N\n  n : N\n(and 1 goal more)" "a goal for each constructor" in
  let c = assertEq (V.getOr "" said 4) "(proved)" "nothing left" in
  assertEq (S.contains "N.S m1 -> (N.S (plus m1 n))" after) True "the proof, in the declarations"

@test fun aStepTheCheckerRefusesIsNotTaken () =
  let (said, after) =
    commandsSaid
      "pick : (b : Bool) -> (x : Int) -> Int\npick b x = ?p"
      [("tactic", "?p"), ("by", "exact b"), ("by", "intro y"), ("by", "exact x"), ("qed", "")]
  in
  -- (a step taken says the goal worked on next; one refused, why)
  let a = assertEq (S.startsWith "?" (V.getOr "" said 1)) False "a Bool is no Int" in
  let b = assertEq (V.getOr "" said 2) "?p is not a function of that many arguments" "an Int is no function" in
  assertEq (V.getOr "" said 4) "(proved)" "x was"

@test fun introNamesWhatTheGoalTakes () =
  let (said, after) =
    commandsSaid
      "twice : (f : Int -> Int) -> Int -> Int\ntwice = ?t"
      [("tactic", "?t"), ("by", "intros"), ("by", "exact f (f x)"), ("by", "undo"), ("by", "apply f"), ("by", "apply f"), ("by", "exact x"), ("qed", "")]
  in
  let a = assertEq (V.getOr "" said 1) "?t1 : Int\n  f : Int -> Int\n  x : Int" "f, then x for the arrow with no name" in
  assertEq (S.contains "(\\f -> \\x -> (f (f (x))))" after) True "built by apply, after undo"

@test fun anEntryThatIsWrongIsForgotten () =
  let said = enteredAll ["x : Int\nx = True", "x"] in
  assertEq (V.map (\s -> S.isEmpty s) said) [False, False] "both say something"

@test fun stdCompilesInTheSession () =
  -- (its modules each after those they import: `Hash` uses `Num.Bits`'s
  -- instances, and comes before it by name)
  let db = batchSession () in
  assertEq (match stdIn db with | Ok _ -> "ok" | Err why -> why) "ok" "Std"

@test fun rewriteMatchesAProofOfAnEquality () =
  let (said, after) =
    commandsSaid
      "data Same : {a : Type} -> a -> a -> Type where\n  Refl : {a : Type} -> {x : a} -> Same x x\n\nback : {a : Type} -> {x y : a} -> Same x y -> Same y x\nback p = ?g\n\nagain : {a : Type} -> {x y : a} -> Same x y -> Same y x\nagain p = ?h"
      [("tactic", "?g"), ("by", "rewrite p"), ("by", "exact Same.Refl"), ("qed", ""), ("tactic", "?h"), ("by", "rewrite back (back p)"), ("by", "exact Same.Refl"), ("qed", "")]
  in
  let a = assertEq (V.getOr "" said 3) "(proved)" "a variable: a case on it" in
  assertEq (V.getOr "" said 7) "(proved)" "a term: named, then a case on it"
