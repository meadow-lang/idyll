-- Name resolution: `Surface` to `Hir`, as
-- `compiler/idyllic-rename` does it: a package of modules, after the prelude
-- and the packages it depends on.
--
-- * Each module is a namespace of its own, whose names others reach with
--   `use` or written in full (`Std.Collections.List.map`); a package that
--   says how visible anything is keeps the rest to its own module, and
--   another package gives only what it makes `@pub`.
-- * Every name a use refers to is resolved to the unique its binder was
--   given; every binder gets a fresh one, with lexical scoping (a binder's
--   annotation does not see the name it binds; a group of declarations is
--   recursive).
-- * Signatures are paired with their equations. One equation of variables
--   is a lambda; anything else is a `Match` of the equations.
-- * The lower-case names a signature mentions that nothing binds are bound
--   in front of it, implicitly: `Vec n a -> a` is `{n} {a} -> Vec n a -> a`.
-- * Records are taken apart: a literal is its constructor applied to the
--   fields in order, `e.x` the one record in scope with an `x`'s
--   projection, an update a `case` that builds it again.
-- * Sequence literals and patterns are taken apart into `SeqCons`/`SeqNil`.
--
-- Terms and patterns are renamed by a pass (`resolve`, a `pass!` from
-- `Surface` to `Hir`, both `lang!`s): a case for each production that names
-- or binds something, and the rest copied. What is around it -- a package's
-- modules, their `use`s, each module's declarations paired and bound -- is
-- the driver below it, which hands each term and pattern to the pass.
--
-- One thing it does differently: a name brought into a module by more than
-- one `use`, or by a `use` and the module itself, keeps every unique it
-- could stand for, for the checker to choose between by type (ROADMAP,
-- phase 3). The Rust renamer lets the last `use` win.
--
-- What is wrong is collected (`problems`), not said, for now: the rename test
-- compares only whether there was anything.

use Lingua (lang!, pass!)
use Lingua.Lang (Meta, noMeta)
use Idyll.Surface
use Idyll.Surface (Surface!)
use Idyll.Hir (Icit, Literal, Visibility)
use Std.St (runSt)
use Idyll.Hir (Ident)
use Idyll.Hir as H
use Std.Collections.Vector as V
use Std.Collections.HashMap as Hm
use Std.Collections.HashMap (HashMap)
use Std.String as S
use Std.Maybe as M
use Std.Maybe.Maybe.*
use Std.Sort (sortOn)

-- A scope: each name, with the uniques it may stand for (a binder's, one).
type Scope = HashMap String [Int]

record Rn = {
  -- innermost last; the first is the builtins'
  scopes : Ref [Scope],
  -- where the module's own scope is, once one is entered: the one under it
  -- is what its `use`s bring, and the two are one layer
  ownAt : Ref Int,
  next : Ref Int,
  problems : Ref [String],
  -- each data type's constructors, by its unique
  ctors : Ref (HashMap Int [(String, Int)]),
  typeNames : Ref (HashMap Int String),
  -- a type whose constructor has its name, and that constructor
  twins : Ref (HashMap Int Int),
  -- each record's fields, by its type's unique: each one's projection
  fields : Ref (HashMap Int [(String, Int)]),
  effectOps : Ref (HashMap Int [(String, Int)]),
  terminating : Ref [Int],
  -- whether the module is linear: an unannotated binder is `[1]`
  linear : Ref Bool,
  -- whether what is being renamed is a type
  inType : Ref Bool,
  -- the scopes under the module's: the builtins' and the prelude's
  base : Ref [Scope],
  -- every module of every package being renamed
  modules : Ref [Mod],
  -- the module whose names are in `scopes`, if one is
  current : Ref Int,
  -- each package's name, by its index; the packages each may name; and
  -- whether any of its declarations says how visible it is
  packageNames : Ref [String],
  packageDeps : Ref [[Int]],
  visibilityMentioned : Ref [Bool],
  -- the module each top-level name of a module other than a package's root
  -- is in, as written before it from outside (`Math` for `Math.double`)
  qualifiers : Ref (HashMap Int String)
}

-- A module: its package's index, its path in it (the root's is empty), its
-- own declarations' names, what its `use`s bring, its aliases for other
-- modules (`use M as C`), and what it gives others, each with how visible.
record Mod = {
  package : Int,
  path : [String],
  own : Scope,
  imports : Scope,
  aliases : HashMap String Int,
  exports : HashMap String (Int, Visibility)
}

-- The package a lone module is the root of.
def package = "Main"

-- The builtins and the primitive operations, as `idyllic-builtins` reserves
-- them: the uniques below the program's.
def builtins : [String] =
  ["Unit", "Int", "Bool", "String", "Grade", "Effect", "Div", "+", "*", "-", "<", "==", "/", "%", "++"]

fun new () =
  let global = V.foldl (\m i -> Hm.insert (V.getOr "" builtins i) [i] m) Hm.empty (V.range 0 (V.len builtins)) in
  Rn {
    scopes = newRef [global],
    ownAt = newRef (0 - 1),
    next = newRef (V.len builtins),
    problems = newRef [],
    ctors = newRef Hm.empty,
    typeNames = newRef Hm.empty,
    twins = newRef Hm.empty,
    fields = newRef Hm.empty,
    effectOps = newRef Hm.empty,
    terminating = newRef [],
    linear = newRef False,
    inType = newRef False,
    base = newRef [],
    modules = newRef [],
    current = newRef (0 - 1),
    packageNames = newRef [],
    packageDeps = newRef [],
    visibilityMentioned = newRef [],
    qualifiers = newRef Hm.empty
  }

fun modAt (r : Rn) (i : Int) : Maybe Mod ! { Mut | e } = V.get (getRef r.modules) i

fun setMod (r : Rn) (i : Int) (m : Mod) = setRef r.modules (V.set (getRef r.modules) i m)

-- The package of the module being renamed.
fun currentPackage (r : Rn) : Int ! { Mut | e } =
  match modAt r (getRef r.current) with
  | Just m -> m.package
  | None -> 0 - 1

-- Put module `i`'s names in scope: the prelude's, then what it uses, then
-- its own.
fun enter (r : Rn) (i : Int) =
  match modAt r i with
  | Just m ->
      let w = setRef r.scopes (V.append (getRef r.base) [m.imports, m.own]) in
      let w2 = setRef r.ownAt (V.len (getRef r.base) + 1) in
      setRef r.current i
  | None -> ()

fun leave (r : Rn) =
  let i = getRef r.current in
  let scopes = getRef r.scopes in
  let w =
    match modAt r i with
    | Just m ->
        setMod r i { m | own = M.unwrapOr Hm.empty (V.last scopes), imports = V.getOr Hm.empty scopes (V.len scopes - 2) }
    | None -> ()
  in
  setRef r.current (0 - 1)

fun bad (r : Rn) (why : String) = setRef r.problems (V.pushBack (getRef r.problems) why)

fun fresh (r : Rn) =
  let u = getRef r.next in
  let w = setRef r.next (u + 1) in
  u

fun distinct (us : [Int]) : [Int] = V.foldl (\acc u -> if V.elem u acc then acc else V.pushBack acc u) [] us

-- Change the innermost scope.
fun onTop (r : Rn) f =
  let scopes = getRef r.scopes in
  setRef r.scopes (V.pushBack (V.popBack scopes) (f (M.unwrapOr Hm.empty (V.last scopes))))

-- Run `f` in a fresh innermost scope.
fun scoped (r : Rn) f =
  let w = setRef r.scopes (V.pushBack (getRef r.scopes) Hm.empty) in
  let x = f () in
  let v = setRef r.scopes (V.popBack (getRef r.scopes)) in
  x

-- Rename what `f` renames as a type, or as a term.
fun withType (r : Rn) (on : Bool) f =
  let outer = getRef r.inType in
  let w = setRef r.inType on in
  let x = f () in
  let v = setRef r.inType outer in
  x

fun asType (r : Rn) f = withType r True f

fun asTerm (r : Rn) f = withType r False f

-- Bind `name` in the innermost scope; a second binding of a name in one
-- scope is a duplicate. `_` binds a slot nothing can refer to.
fun bindName (r : Rn) (name : String) =
  let u = fresh r in
  if name == "_" then Ident.Ident [u] name
  else
    let top = M.unwrapOr Hm.empty (V.last (getRef r.scopes)) in
    let w = if Hm.member name top then bad r "duplicate binding of ${name}" else () in
    let v = onTop r (\s -> Hm.insert name [u] s) in
    Ident.Ident [u] name

-- What `name` may stand for here: the innermost scope that has it. The
-- module's own names and what its `use`s bring are one layer.
fun lookup (r : Rn) (name : String) : [Int] ! { Mut | e } =
  let scopes = getRef r.scopes in
  let own = getRef r.ownAt in
  let at = V.find (\i -> Hm.member name (V.getOr Hm.empty scopes i)) (V.reverse (V.range 0 (V.len scopes))) in
  match at with
  | None -> []
  | Just i ->
      let found = Hm.getOr [] name (V.getOr Hm.empty scopes i) in
      if i == own and own > 0 then distinct (V.append found (Hm.getOr [] name (V.getOr Hm.empty scopes (own - 1))))
      else found

fun known (r : Rn) (name : String) : Bool ! { Mut | e } = not (V.isEmpty (lookup r name))

-- What a name that found `u` stands for: a type and the constructor of its
-- name are one name, the type in a type and the constructor elsewhere.
fun asWritten (r : Rn) (u : Int) : Int ! { Mut | e } =
  let twins = getRef r.twins in
  let pair =
    match Hm.lookup u twins with
    | Just c -> Just (u, c)
    | None -> V.find (\p -> snd p == u) (Hm.toVec twins)
  in
  match pair with
  | Just (t, c) -> if getRef r.inType then t else c
  | None -> u

fun noteTwin (r : Rn) (ty : Int) =
  let name = Hm.getOr "" ty (getRef r.typeNames) in
  match V.find (\c -> fst c == name) (Hm.getOr [] ty (getRef r.ctors)) with
  | Just (_, c) -> setRef r.twins (Hm.insert ty c (getRef r.twins))
  | None -> ()

-- A use of `name`.
fun useName (r : Rn) (name : String) =
  if name == "(,)" then tuple r
  else if S.contains "." name and stringByteLength name > 1 then useQualified r name
  else
    let found = lookup r name in
    let w =
      if V.isEmpty found then
        if V.isEmpty (constructorTypes r name) then bad r "name not in scope: ${name}"
        else bad r "a constructor lives under its type: ${name}"
      else ()
    in
    Ident.Ident (distinct (V.map (asWritten r) found)) name

-- The prelude's `Pair`, which a tuple is made of.
fun tuple (r : Rn) =
  let found = V.find (\s -> Hm.member "Pair" s) (V.reverse (getRef r.base)) in
  match found with
  | Just s -> Ident.Ident (distinct (V.map (asWritten r) (Hm.getOr [] "Pair" s))) "Pair"
  | None ->
      let w = bad r "name not in scope: Pair" in
      Ident.Ident [] "Pair"

-- The types in scope with a constructor of this name.
fun constructorTypes (r : Rn) (name : String) : [String] ! { Mut | e } =
  V.concatMap
    (\entry ->
      match entry with
      | (d, cs) ->
          if V.any (\c -> fst c == name) cs then
            match Hm.lookup d (getRef r.typeNames) with
            | Just t -> if V.elem d (lookup r t) then [t] else []
            | None -> []
          else [])
    (Hm.toVec (getRef r.ctors))

-- What a dotted path names: a module; a directory of modules with no
-- module of its own (a package and a path), only a step on the way to one;
-- or a name.
data Target = Module Int | Namespace Int [String] | Name Int

fun samePath (a : [String]) (b : [String]) : Bool = V.len a == V.len b and V.all (\i -> V.getOr "" a i == V.getOr "" b i) (V.range 0 (V.len a))

fun startsWith (path : [String]) (prefix : [String]) : Bool = V.len path >= V.len prefix and samePath (V.take path (V.len prefix)) prefix

-- The module at this path in a package, if it has one.
fun moduleAt (r : Rn) (package : Int) (path : [String]) : Maybe Int ! { Mut | e } =
  let ms = getRef r.modules in
  V.find (\i -> match V.get ms i with | Just (m : Mod) -> m.package == package and samePath m.path path | None -> False) (V.range 0 (V.len ms))

-- What is at this path under a package's root: a module, or failing that a
-- directory with modules in it.
fun underRoot (r : Rn) (package : Int) (path : [String]) : Maybe Target ! { Mut | e } =
  match moduleAt r package path with
  | Just m -> Just (Target.Module m)
  | None ->
      if V.any (\(m : Mod) -> m.package == package and V.len m.path > V.len path and startsWith m.path path) (getRef r.modules) then
        Just (Target.Namespace package path)
      else None

-- A module as a `use` writes it.
fun moduleName (r : Rn) (i : Int) : String ! { Mut | e } =
  match modAt r i with
  | Just m ->
      let pkg = V.getOr "" (getRef r.packageNames) m.package in
      if V.isEmpty m.path then pkg
      else if m.package == currentPackage r then S.join "." m.path
      else pkg ++ "." ++ S.join "." m.path
  | None -> ""

-- May the module being renamed see something of module `owner`'s that is
-- this visible? Its own and its descendants', always; its parent's
-- subtree's, with `@pub(super)`; the package's, with `@pub(pkg)` or `@pub`.
-- Another package gives only what it makes `@pub`.
fun visible (r : Rn) (owner : Int) (vis : Visibility) : Bool ! { Mut | e } =
  match (modAt r owner, modAt r (getRef r.current)) with
  | (Just o, Just c) ->
      if o.package != c.package then vis == Visibility.Public
      else if not (V.getOr False (getRef r.visibilityMentioned) c.package) then True
      else
        (match vis with
         | Visibility.Public -> True
         | Visibility.Package -> True
         | Visibility.Super -> startsWith c.path (V.take o.path (if V.len o.path > 0 then V.len o.path - 1 else 0))
         | Visibility.Private -> startsWith c.path o.path)
  | (Just o, None) -> True
  | _ -> True

-- What a dotted path names: a module, or a name in one or in scope, then a
-- type's constructor or a record's field. The first segment is a module's
-- alias, a name in scope, the package's own name, a module under its root,
-- or a package it depends on.
fun resolvePath (r : Rn) (segments : [String]) : Maybe Target ! { Mut | e } =
  let first = V.getOr "" segments 0 in
  let cur = getRef r.current in
  let pkg = currentPackage r in
  let alias = match modAt r cur with | Just m -> Hm.lookup first m.aliases | None -> None in
  let start =
    match alias with
    | Just m -> Just (Target.Module m)
    | None ->
        (match V.head (lookup r first) with
         | Just u -> Just (Target.Name u)
         | None ->
             if pkg >= 0 and first == V.getOr "" (getRef r.packageNames) pkg then Just (Target.Module (M.unwrapOr 0 (moduleAt r pkg [])))
             else
               (match (if pkg >= 0 then underRoot r pkg [first] else None) with
                | Just t -> Just t
                | None ->
                    let deps = V.getOr [] (getRef r.packageDeps) (if pkg >= 0 then pkg else 0) in
                    (match V.find (\d -> V.getOr "" (getRef r.packageNames) d == first) deps with
                     | Just d -> M.map (\m -> Target.Module m) (moduleAt r d [])
                     | None ->
                         let w = bad r "no module or type ${first}" in
                         None)))
  in
  V.foldl
    (\at seg ->
      match at with
      | None -> None
      | Just (Target.Namespace package path) ->
          (match underRoot r package (V.pushBack path seg) with
           | Just t -> Just t
           | None ->
               let w = bad r "${S.join "." path} has no ${seg}" in
               None)
      | Just (Target.Module m) ->
          (match modAt r m with
           | None -> None
           | Just md ->
               (match underRoot r md.package (V.pushBack md.path seg) with
                | Just t -> Just t
                | None ->
                    (match Hm.lookup seg md.exports with
                     | Just (u, vis) ->
                         let w = if visible r m vis then () else bad r "${seg} is not visible from here" in
                         Just (Target.Name u)
                     | None ->
                         let w = bad r "${moduleName r m} has no ${seg}" in
                         None)))
      | Just (Target.Name u) ->
          (match Hm.lookup u (getRef r.ctors) with
           | None ->
               let w = bad r "${seg}: not something with constructors" in
               None
           | Just cs ->
               (match V.find (\c -> fst c == seg) cs with
                | Just (_, c) -> Just (Target.Name c)
                | None ->
                    (match V.find (\f -> fst f == seg) (Hm.getOr [] u (getRef r.fields)) with
                     | Just (_, p) -> Just (Target.Name p)
                     | None ->
                         let w = bad r "no constructor ${seg}" in
                         None))))
    start
    (V.drop segments 1)

-- `Nat.Z`, `Math.double`: a name, from wherever its path says.
fun useQualified (r : Rn) (name : String) =
  let segments = S.split "." name in
  let last = M.unwrapOr "" (V.last segments) in
  match resolvePath r segments with
  | Just (Target.Name u) -> Ident.Ident [u] last
  | Just _ ->
      let w = bad r "${name} is a module" in
      Ident.Ident [] last
  | None -> Ident.Ident [] last

-- Bring a name into the module's scope from elsewhere (naming an effect
-- brings its operations): beside what is there already, not over it. With
-- `@pub use`, give it on to whoever uses this module.
fun import (r : Rn) (name : String) (unique : Int) (public : Bool) =
  let ops = Hm.getOr [] unique (getRef r.effectOps) in
  let both = V.append [(name, unique)] ops in
  let w =
    if public then
      (match modAt r (getRef r.current) with
       | Just m -> setMod r (getRef r.current) { m | exports = V.foldl (\e p -> match p with | (x, u) -> Hm.insert x (u, Visibility.Public) e) m.exports both }
       | None -> ())
    else ()
  in
  let scopes = getRef r.scopes in
  let at = V.len scopes - 2 in
  let imports =
    V.foldl
      (\sc p -> match p with | (x, u) -> Hm.insert x (distinct (V.append (Hm.getOr [] x sc) [u])) sc)
      (V.getOr Hm.empty scopes at)
      both
  in
  setRef r.scopes (V.set scopes at imports)

-- `use M`, `use M as C`, `use M (a, b)`: another module's names; `use T.*`,
-- `use T (C)`: a type's constructors, bare.
fun renameUse (r : Rn) (u : Use) =
  match resolvePath r u.path with
  | None -> ()
  | Just (Target.Namespace _ _) -> bad r "${S.join "." u.path} has no module of its own"
  | Just (Target.Module m) ->
      let cur = getRef r.current in
      let v =
        match (u.alias, modAt r cur) with
        | (Just a, Just c) -> setMod r cur { c | aliases = Hm.insert a m c.aliases }
        | _ -> ()
      in
      (match modAt r m with
       | None -> ()
       | Just md ->
           -- everything it gives, unless it has an alias or a list
           let wanted =
             match u.names with
             | Just ns -> ns
             | None ->
                 if M.isNone u.alias or u.glob then
                   V.map fst (V.filter (\kv -> match snd kv with | (_, vis) -> visible r m vis) (sortOn fst (Hm.toVec md.exports)))
                 else []
           in
           V.foldl
             (\acc x ->
               match Hm.lookup x md.exports with
               | Just (e, vis) ->
                   let w = if visible r m vis then () else bad r "${x} is not visible from here" in
                   import r x e u.public
               | None -> bad r "${S.join "." u.path} has no ${x}")
             ()
             wanted)
  | Just (Target.Name t) ->
      let last = M.unwrapOr "" (V.last u.path) in
      match Hm.lookup t (getRef r.ctors) with
      | None -> if u.glob or M.isSome u.names then bad r "${last} has no constructors to bring" else import r last t u.public
      | Just cs ->
          if M.isSome u.alias then bad r "only a module takes an alias"
          else
            let wanted =
              if u.glob then V.map fst cs
              else
                match u.names with
                | Just ns -> ns
                | None ->
                    let w = if V.len u.path > 1 then import r last t u.public else () in
                    []
            in
            V.foldl
              (\acc x ->
                match V.find (\c -> fst c == x) cs with
                | Just (_, c) -> import r x c u.public
                | None -> bad r "no constructor ${x}")
              ()
              wanted

-- --- records -----------------------------------------------------------------

-- A record type's fields, in order, by the name it is written with.
fun recordNamed (r : Rn) (name : String) (report : Bool) : Maybe [String] ! { Mut | e } =
  let ty = asType r (\u -> useName r name) in
  let fs = M.andThen (\u -> Hm.lookup u (getRef r.fields)) (V.head (identUniques ty)) in
  match fs with
  | Just f -> Just (V.map fst f)
  | None ->
      let w = if report and not (V.isEmpty (identUniques ty)) then bad r "${name} is not a record" else () in
      None

fun identUniques (x : Ident) : [Int] = match x with | Ident.Ident us _ -> us

-- What is given for each field, in the order the fields are declared.
fun inFieldOrder (r : Rn) (recordName : String) (fields : [String]) (given : [(String, a)]) (report : Bool) : [Maybe a] ! { Mut | e } =
  let u =
    if report then
      V.foldl
        (\acc i ->
          match V.get given i with
          | Just (f, _) ->
              if not (V.elem f fields) then bad r "${recordName} has no field ${f}"
              else if V.any (\g -> fst g == f) (V.take given i) then bad r "the field ${f} is given twice"
              else ()
          | None -> ())
        ()
        (V.range 0 (V.len given))
    else ()
  in
  V.map (\f -> M.map snd (V.find (\g -> fst g == f) given)) fields

-- The records in scope with each of `wanted`'s fields, by name.
fun recordsWith (r : Rn) (wanted : [String]) : [(String, [String])] ! { Mut | e } =
  sortOn
    fst
    (V.concatMap
       (\entry ->
         match entry with
         | (t, fs) ->
             if V.all (\w -> V.any (\f -> fst f == w) fs) wanted then
               match Hm.lookup t (getRef r.typeNames) with
               | Just n -> if V.elem t (lookup r n) then [(n, V.map fst fs)] else []
               | None -> []
             else [])
       (Hm.toVec (getRef r.fields)))

fun theRecordWith (r : Rn) (wanted : [String]) : Maybe (String, [String]) ! { Mut | e } =
  let found = recordsWith r wanted in
  if V.len found == 1 then V.head found
  else
    let w =
      if V.isEmpty found then bad r "no record in scope has ${S.join ", " wanted}"
      else bad r "several records have ${S.join ", " wanted}"
    in
    None

-- --- the renamed language --------------------------------------------------------

-- `Surface` with every name resolved, as `idyllic-hir` has it: a use of a
-- name is an `Ident`, the uniques it may stand for, and a binder one with
-- its own. Equations are lambdas or matches, signatures are paired with
-- them in groups, and records and sequences are taken apart.
@pub lang! {
  pub Hir
  Module + Module { datas : [Data], effects : [Effect], natives : [Native], groups : [Group], body : Maybe Expr }
  Ident + Ident { uniques : [Int], text : String }
  Grade + Grade { uses : Expr, inType : Maybe Expr }
  Expr + Type {}
  Expr + Var { ident : Ident }
  Expr + Lit { lit : Literal }
  Expr + Pi { name : Maybe Ident, icit : Icit, grade : Maybe Grade, dom : Expr, cod : Expr }
  Expr + Lam { name : Ident, grade : Maybe Grade, ty : Maybe Expr, body : Expr }
  Expr + App { func : Expr, arg : Expr }
  Expr + Ann { expr : Expr, ty : Expr }
  Expr + Hole {}
  Expr + Box { expr : Expr }
  Expr + Inf {}
  Expr + Range { lo : Expr, hi : Expr }
  Expr + LetBox { name : Ident, value : Expr, body : Expr }
  Expr + Let { groups : [Group], body : Expr }
  Expr + Case { scrutinee : Expr, clauses : [Clause] }
  Expr + Match { clauses : [Clause] }
  Expr + Omitted {}
  Expr + Eff { ty : Expr, row : Expr }
  Expr + Row { labels : [Expr], tail : Maybe Expr }
  Expr + Handle { body : Expr, clauses : [HandleClause] }
  Expr + SeqNil {}
  Expr + SeqCons { head : Expr, tail : Expr }
  Expr + Array { items : [Expr] }
  -- `op x k -> body`; no operation for `return x -> body`
  HandleClause + HandleClause { op : Maybe Ident, params : [Ident], body : Expr }
  Clause + Clause { pats : [Pattern], rhs : Rhs }
  Rhs + Plain { body : Expr }
  Rhs + Guarded { guards : [Guard] }
  Rhs + Impossible {}
  Guard + Guard { cond : Expr, body : Expr }
  Pattern + Var { ident : Ident }
  Pattern + Wild {}
  Pattern + Lit { lit : Literal }
  Pattern + Con { ctor : Ident, args : [Pattern] }
  Pattern + As { ident : Ident, pat : Pattern }
  Pattern + Dot { expr : Expr }
  Pattern + SeqNil {}
  Pattern + SeqCons { head : Pattern, tail : Pattern }
  Bind + Bind { name : Ident, ty : Maybe Expr, rhs : Expr, linear : Bool }
  Group + NonRec { bind : Bind }
  Group + Rec { binds : [Bind] }
  Ctor + Fields { name : Ident, fields : [Expr] }
  Ctor + Sig { name : Ident, ty : Expr }
  TypeParam + TypeParam { name : Ident, kindSig : Maybe Expr }
  SeqPair + SeqPair { nil : Ident, cons : Ident }
  Data + Data { name : Ident, params : [TypeParam], kindSig : Maybe Expr, ctors : [Ctor], seq : Maybe SeqPair, linear : Bool }
  Op + Op { name : Ident, ty : Expr, many : Bool }
  Effect + Effect { name : Ident, params : [TypeParam], ops : [Op] }
  Native + Native { name : Ident, ty : Expr }
}

-- An identifier, written.
fun idNode out (m : Meta) (x : Ident) = match x with | Ident.Ident us t -> newHirIdent out m us t

fun gradeOne out (m : Meta) = newHirGrade out m (newHirExprLit out m (Literal.Int 1)) None

fun unresolved out (m : Meta) = newHirExprVar out m (idNode out m (Ident.Ident [] "_"))

-- --- records ----------------------------------------------------------------------

-- `Point { x = 1, y = 2 }`: the constructor, given each field in order.
fun recordLiteral out (m : Meta) (r : Rn) (name : String) (values : [(String, HirExpr)]) =
  match recordNamed r name True with
  | None -> None
  | Just fields ->
      let ordered = inFieldOrder r name fields values True in
      if V.any M.isNone ordered then
        let w = bad r "${name} is built with every one of its fields" in
        None
      else
        let ctor = newHirExprVar out m (idNode out m (useName r name)) in
        Just (V.foldl (\f v -> match v with | Just e -> newHirExprApp out m f e | None -> f) ctor ordered)

-- `Point { x = p }`: the constructor's pattern, `_` for a field not named.
fun recordPattern out (m : Meta) (r : Rn) (name : String) given =
  match recordNamed r name True with
  | None -> newHirPatternWild out m
  | Just fields ->
      let ctor = idNode out m (asTerm r (\u -> useName r name)) in
      newHirPatternCon
        out
        m
        ctor
        (V.map (\p -> match p with | Just q -> q () | None -> newHirPatternWild out m) (inFieldOrder r name fields given True))

-- `e.x`: the projection of the one record in scope with an `x`.
fun projection out (m : Meta) (r : Rn) e (field : String) =
  M.map
    (\rf -> match rf with | (recName, _) -> newHirExprApp out m (newHirExprVar out m (idNode out m (useName r "${recName}.${field}"))) e)
    (theRecordWith r [field])

-- `{ e | x = v }`: `e` taken apart and built again, with `v` for `x`.
fun recordUpdate out (m : Meta) (r : Rn) e (values : [(String, HirExpr)]) =
  match theRecordWith r (V.map fst values) with
  | None -> None
  | Just (recName, fields) ->
      let ordered = inFieldOrder r recName fields values True in
      let kept = \f -> "#" ++ f in
      Just
        (newHirExprCase out m e [
           scoped r (\u ->
             let pats =
               V.map
                 (\i ->
                   match V.get ordered i with
                   | Just (Just _) -> newHirPatternWild out m
                   | _ -> newHirPatternVar out m (idNode out m (bindName r (kept (V.getOr "" fields i)))))
                 (V.range 0 (V.len fields))
             in
             let con = newHirPatternCon out m (idNode out m (asTerm r (\v -> useName r recName))) pats in
             let rebuilt =
               V.foldl
                 (\acc i ->
                   let value =
                     match V.get ordered i with
                     | Just (Just v) -> v
                     | _ -> newHirExprVar out m (idNode out m (useName r (kept (V.getOr "" fields i))))
                   in
                   newHirExprApp out m acc value)
                 (newHirExprVar out m (idNode out m (useName r recName)))
                 (V.range 0 (V.len fields))
             in
             newHirClause out m [con] (newHirRhsPlain out m rebuilt))
         ])

-- --- terms and patterns: the pass --------------------------------------------------

-- A binder, its name bound in the innermost scope after its annotation is
-- renamed. An unboxing one, `[x]`, also has the box it receives, which
-- nothing can name.
data BoundParam g t = BoundParam Ident (Maybe Ident) (Maybe g) (Maybe t)

-- `resolve`: `Surface` to `Hir`, each name made the binder it means, carried
-- down with the renamer, `r`, whose scopes are what is bound where. A
-- binder's children are taken `later`, to be renamed in the scope it makes:
-- a `Pi`'s domain sees nothing of its name and its codomain does. A
-- pattern answers what writes it, once every name it binds is bound: so an
-- equation's patterns bind all their names before any `.e` among them is
-- renamed. What has no case is copied as it is -- an application, an
-- annotation's term, a row.
pass! {
  resolve : Surface -> Hir with r from Expr, Pat, Param
    | Name { text } -> text
    | Field { name, value } -> (name, value)
    | PatField { name, later pat } -> (name, pat r)
    -- `otherwise` is `True`, unless something else is called that
    | Expr.Var { name } ->
        (if name == "otherwise" and not (known r name) then Lit { lit = Literal.Bool True }
         else Var { ident = idNode out here (useName r name) })
    | Ann { expr, later ty } -> Ann { expr, ty = asType r (\u -> ty r) }
    -- neither the domain nor the grades see the name bound
    | Pi { name, icit, later grade, later dom, later cod } ->
        (let g =
           (match grade with
            | Just f -> Just (f r)
            | None -> if getRef r.linear and icit == Icit.Explicit then Just (gradeOne out here) else None)
         in
         let d = asType r (\u -> dom r) in
         scoped r (\u ->
           let x = M.map (\n -> idNode out here (bindName r n)) name in
           Pi { name = x, icit, grade = g, dom = d, cod = asType r (\v -> cod r) }))
    | Lam { later param, later body } -> scoped r (\u -> (let bp = param r in wrapParam out here bp (body r)))
    | Param { name, unbox, grade, later ty } ->
        (let ty2 = M.map (\f -> asType r (\u -> f r)) ty in
         let x = bindName r name in
         let boxed = if unbox then Just (Ident.Ident [fresh r] name) else None in
         BoundParam.BoundParam x boxed grade ty2)
    | LetBox { value, name, later body } ->
        scoped r (\u -> (let x = bindName r name in LetBox { name = idNode out here x, value, body = body r }))
    | Let { raw decls, later body } ->
        scoped r (\u ->
          (let bs = renameDecls src out r decls in
           Let { groups = [newHirGroupRec out here bs], body = body r }))
    | Case { scrutinee, raw alts } ->
        Case {
          scrutinee,
          clauses = V.map (\a -> renameClause src out r here [surfaceAltPat src a] None (surfaceAltRhs src a)) alts
        }
    | Handle { body, raw clauses } -> Handle { body, clauses = V.map (\c -> handleClause src out r c) clauses }
    | Expr.Seq { items } -> V.foldr (\h tl -> newHirExprSeqCons out here h tl) (newHirExprSeqNil out here) items
    | Expr.Record { name, fields } ->
        (match recordLiteral out here r name fields with
         | Just built -> built
         | None -> unresolved out here)
    | Proj { expr, field } ->
        (match projection out here r expr field with
         | Just read -> read
         | None -> unresolved out here)
    | Update { expr, fields } ->
        (match recordUpdate out here r expr fields with
         | Just rebuilt -> rebuilt
         | None -> unresolved out here)
    -- patterns
    | Bind { raw param } ->
        (let x = bindName r (surfaceNameText src (surfaceParamName src param)) in
         let w =
           if surfaceParamUnbox src param or M.isSome (surfaceParamGrade src param) or M.isSome (surfaceParamTy src param) then
             bad r "this pattern needs a single equation of variables"
           else ()
         in \u -> Pattern.Var { ident = idNode out here x })
    | Wild {} -> (\u -> Wild {})
    | Pat.Lit { lit } -> (\u -> Pattern.Lit { lit })
    | Con { name, args } ->
        (\u -> Con { ctor = idNode out here (asTerm r (\v -> useName r name)), args = V.map (\a -> a ()) args })
    | As { name, later pat } ->
        (let x = bindName r name in
         let q = pat r in
         \u -> As { ident = idNode out here x, pat = q () })
    | Dot { later expr } -> (\u -> Dot { expr = asTerm r (\v -> expr r) })
    | Pat.Seq { items } ->
        (\u -> V.foldr (\h tl -> newHirPatternSeqCons out here h tl) (newHirPatternSeqNil out here) (V.map (\i -> i ()) items))
    | Pat.Record { name, fields } -> (\u -> recordPattern out here r name fields)
}

-- `\x -> body`, or `\[x] -> body`, which is `\b -> let [x] = b in body`.
fun wrapParam out (m : Meta) p body =
  match p with
  | BoundParam.BoundParam name boxed grade ty ->
      (match boxed with
       | None -> newHirExprLam out m (idNode out m name) grade ty body
       | Just b -> newHirExprLam out m (idNode out m b) None None (newHirExprLetBox out m (idNode out m name) (newHirExprVar out m (idNode out m b)) body))

-- `op x k -> e`: `return` is not a name.
fun handleClause src out (r : Rn) (c : SurfaceClause) =
  let m = metaSurfaceClause src c in
  let op = surfaceNameText src (surfaceClauseOp src c) in
  let op2 = if op != "return" then Just (idNode out m (useName r op)) else None in
  scoped r (\u ->
    let params = V.map (\x -> idNode out m (bindName r (surfaceNameText src x))) (surfaceClauseParams src c) in
    newHirHandleClause out m op2 params (resolveExpr src out r (surfaceClauseBody src c)))

-- A signature: the lower-case names it mentions that nothing binds are bound
-- in front of it, implicitly, in order of appearance, their types left to
-- the checker.
fun renameSig src out (r : Rn) (ty : SurfaceExpr) =
  let m = metaSurfaceExpr src ty in
  let free = freeVars src ty [] (\x -> known r x) [] in
  scoped r (\u ->
    let bound = V.map (\x -> bindName r x) free in
    let body = asType r (\v -> resolveExpr src out r ty) in
    V.foldr (\x acc -> newHirExprPi out m (Just (idNode out m x)) Icit.Implicit None (newHirExprOmitted out m) acc) body bound)

-- One equation or alternative: its patterns bind names for the rest of it,
-- all of them before any `.e` is renamed; then the right-hand side, under a
-- result type if one was written.
fun renameClause src out (r : Rn) (m : Meta) (pats : [SurfacePat]) (resultTy : Maybe SurfaceExpr) (rhs : SurfaceRhs) =
  scoped r (\u ->
    let writers = V.map (\p -> resolvePat src out r p) pats in
    let pats2 = V.map (\w -> w ()) writers in
    let annotate =
      \e ->
        let body = resolveExpr src out r e in
        match resultTy with
        | Just ty -> newHirExprAnn out m body (asType r (\w -> resolveExpr src out r ty))
        | None -> body
    in
    let rhs2 =
      match (src, rhs) with
      | SurfaceRhsPlain e -> newHirRhsPlain out m (annotate e)
      | SurfaceRhsGuarded gs ->
          newHirRhsGuarded
            out
            m
            (V.map
               (\g ->
                 let c2 = resolveExpr src out r (surfaceGuardCond src g) in
                 newHirGuard out m c2 (annotate (surfaceGuardBody src g)))
               gs)
      | _ -> newHirRhsImpossible out m
    in
    newHirClause out m pats2 rhs2)

-- --- declarations ------------------------------------------------------------------

-- What a module's program declares, read off its tables.
record Program = {
  src : SurfaceArena,
  datas : [SurfaceData],
  effects : [SurfaceEffect],
  decls : [SurfaceDecl],
  uses : [Use],
  visibility : [(String, Visibility)],
  terminating : [String],
  linear : Bool,
  body : Maybe SurfaceExpr
}

record Use = {
  public : Bool,
  path : [String],
  glob : Bool,
  alias : Maybe String,
  names : Maybe [String]
}

@pub fun programOf (p : SurfaceProgram) : Program =
  let a = surfaceArena p in
  let f = surfaceRoot p in
  let text = \n -> surfaceNameText a n in
  Program {
    src = a,
    datas = surfaceFileDatas a f,
    effects = surfaceFileEffects a f,
    decls = surfaceFileDecls a f,
    uses =
      V.map
        (\u ->
          Use {
            public = surfaceUsePublic a u,
            path = V.map text (surfaceUsePath a u),
            glob = surfaceUseGlob a u,
            alias = M.map text (surfaceUseAlias a u),
            names = if surfaceUseListed a u then Just (V.map text (surfaceUseNames a u)) else None
          })
        (surfaceFileUses a f),
    visibility = V.map (\v -> (text (surfaceShownName a v), surfaceShownVis a v)) (surfaceFileShown a f),
    terminating = V.map text (surfaceFileTerminating a f),
    linear = surfaceFileLinear a f,
    body = surfaceFileBody a f
  }

fun ctorNameOf (a : SurfaceArena) (c : SurfaceCtor) : String =
  match (a, c) with
  | SurfaceCtorFields n _ -> surfaceNameText a n
  | SurfaceCtorSig n _ -> surfaceNameText a n

fun dataName (a : SurfaceArena) (d : SurfaceData) : String = surfaceNameText a (surfaceDataName a d)

-- Each data type's name, and its constructors' under it.
fun bindDatas (r : Rn) (a : SurfaceArena) (datas : [SurfaceData]) =
  V.map
    (\d ->
      let dn = dataName a d in
      let name = bindName r dn in
      let cs =
        V.foldl
          (\acc c ->
            let cname = ctorNameOf a c in
            let w = if V.any (\x -> fst x == cname) acc then bad r "duplicate binding of ${cname}" else () in
            V.pushBack acc (cname, fresh r))
          []
          (surfaceDataCtors a d)
      in
      let u = H.uniqueOf name in
      let w1 = setRef r.ctors (Hm.insert u cs (getRef r.ctors)) in
      let w2 = setRef r.typeNames (Hm.insert u dn (getRef r.typeNames)) in
      let w3 = noteTwin r u in
      (name, V.map (\c -> match c with | (x, cu) -> Ident.Ident [cu] x) cs))
    datas

-- A data type's or an effect's parameters: each kind may mention the
-- parameters before it.
fun typeParams src out (r : Rn) (ps : [SurfaceTypeParam]) =
  V.map
    (\p ->
      let m = metaSurfaceTypeParam src p in
      let k2 = M.map (\t -> asType r (\u -> resolveExpr src out r t)) (surfaceTypeParamKindSig src p) in
      newHirTypeParam out m (idNode out m (bindName r (surfaceNameText src (surfaceTypeParamName src p)))) k2)
    ps

fun renameDatas src out (r : Rn) (datas : [SurfaceData]) (names : [(Ident, [Ident])]) =
  V.map
    (\pair ->
      match pair with
      | (d, (name, ctorNames)) ->
          let m = metaSurfaceData src d in
          scoped r (\u ->
            let params = typeParams src out r (surfaceDataParams src d) in
            let kind = M.map (\k -> asType r (\v -> resolveExpr src out r k)) (surfaceDataKindSig src d) in
            let cs = surfaceDataCtors src d in
            let ctors =
              V.map
                (\j ->
                  let cname = idNode out m (V.getOr (Ident.Ident [] "_") ctorNames j) in
                  match V.get cs j with
                  | Just c ->
                      (match (src, c) with
                       | SurfaceCtorFields _ ts -> newHirCtorFields out m cname (V.map (\t -> asType r (\v -> resolveExpr src out r t)) ts)
                       | SurfaceCtorSig _ ty -> newHirCtorSig out m cname (renameSig src out r ty))
                  | None -> newHirCtorFields out m cname [])
                (V.range 0 (V.len cs))
            in
            let own =
              \c ->
                match V.find (\x -> fst x == c) (Hm.getOr [] (H.uniqueOf name) (getRef r.ctors)) with
                | Just (_, cu) -> Ident.Ident [cu] c
                | None ->
                    let w = bad r "${dataName src d} has no constructor ${c}" in
                    Ident.Ident [] c
            in
            let seq =
              M.map
                (\s -> newHirSeqPair out m (idNode out m (own (surfaceNameText src (surfaceSeqAttrNil src s)))) (idNode out m (own (surfaceNameText src (surfaceSeqAttrCons src s)))))
                (surfaceDataSeq src d)
            in
            newHirData out m (idNode out m name) params kind ctors seq (getRef r.linear)))
    (V.zip datas names)

fun renameEffect src out (r : Rn) (e : SurfaceEffect) (names : (Ident, [Ident])) =
  let m = metaSurfaceEffect src e in
  match names with
  | (name, opNames) ->
      scoped r (\u ->
        let params = typeParams src out r (surfaceEffectParams src e) in
        let ops = surfaceEffectOps src e in
        let written =
          V.map
            (\j ->
              match V.get ops j with
              | Just o -> newHirOp out m (idNode out m (V.getOr (Ident.Ident [] "_") opNames j)) (renameSig src out r (surfaceOpSigTy src o)) (surfaceOpSigMany src o)
              | None -> newHirOp out m (idNode out m (Ident.Ident [] "_")) (newHirExprHole out m) False)
            (V.range 0 (V.len ops))
        in
        newHirEffect out m (idNode out m name) params written)

-- A definition: its equations, its name bound, and its signature.
record Def = {
  eqs : [SurfaceDecl],
  name : Ident,
  sig : Maybe SurfaceExpr
}

fun renameDecls src out (r : Rn) (ds : [SurfaceDecl]) = renameDefs src out r (bindDecls src r ds)

-- An equation's name and patterns, if it is one.
fun equation (a : SurfaceArena) (d : SurfaceDecl) : Maybe (String, [SurfacePat]) =
  match (a, d) with
  | SurfaceDeclDef f ps _ _ -> Just (surfaceNameText a f, ps)
  | _ -> None

-- Pair signatures with equations, and bind each name a block defines.
-- Equations of one name in a row are one definition, if they have patterns
-- to tell them apart.
fun bindDecls (a : SurfaceArena) (r : Rn) (ds : [SurfaceDecl]) : [Def] ! { Mut | e } =
  let sigs =
    V.foldl
      (\acc d ->
        match (a, d) with
        | SurfaceDeclSig x ty ->
            let n = surfaceNameText a x in
            let w = if V.any (\s -> fst s == n) acc then bad r "duplicate binding of ${n}" else () in
            V.pushBack acc (n, ty)
        | _ -> acc)
      []
      ds
  in
  let groups =
    V.foldl
      (\(acc : [[SurfaceDecl]]) d ->
        match equation a d with
        | Just (x, ps) ->
            let continues =
              match M.andThen (\g -> M.andThen (equation a) (V.head g)) (V.last acc) with
              | Just (f, qs) -> f == x and not (V.isEmpty qs) and not (V.isEmpty ps)
              | None -> False
            in
            if continues then V.pushBack (V.popBack acc) (V.pushBack (M.unwrapOr [] (V.last acc)) d)
            else V.pushBack acc [d]
        | None -> acc)
      []
      ds
  in
  let defs =
    V.map
      (\eqs ->
        let x = match M.andThen (equation a) (V.head eqs) with | Just (f, _) -> f | None -> "_" in
        let ident = bindName r x in
        Def { eqs, name = ident, sig = M.map snd (V.find (\s -> fst s == x) sigs) })
      groups
  in
  let defined = V.map (\(d : Def) -> H.textOf d.name) defs in
  let w = V.foldl (\acc s -> if V.elem (fst s) defined then acc else bad r "the signature for ${fst s} has no definition") () sigs in
  defs

fun renameDefs src out (r : Rn) (defs : [Def]) = V.map (\d -> renameDef src out r d) defs

fun simplePat (a : SurfaceArena) (p : SurfacePat) : Bool =
  match kindSurfacePat a p with
  | SurfacePatKind.Bind -> True
  | SurfacePatKind.Wild -> True
  | _ -> False

fun renameDef src out (r : Rn) (dfn : Def) =
  let m = match V.head dfn.eqs with | Just d -> metaSurfaceDecl src d | None -> noMeta in
  match M.map (\d -> (src, d)) (V.head dfn.eqs) with
  | Just (SurfaceDeclDef _ params inline rhs) ->
      -- `x : a = e` is a signature written inline; anywhere else an inline
      -- type is the result's
      let inlineSig = M.isNone dfn.sig and M.isSome inline and V.isEmpty params and V.len dfn.eqs == 1 in
      let sig = if inlineSig then inline else dfn.sig in
      let resultTy = if inlineSig then None else inline in
      let ty = M.map (\t -> renameSig src out r t) sig in
      -- a definition whose type ends in a universe defines a type, so its
      -- body is one: `pairOf a = (a, a)` is the pair type, not a pair
      let typeBody = match sig with | Just t -> endsInUniverse src t | None -> False in
      withType r (typeBody or getRef r.inType) (\z -> renameDefBody src out r m dfn ty params rhs resultTy)
  | _ -> newHirBind out m (idNode out m dfn.name) None (newHirExprHole out m) False

-- Whether a signature's type ends in a universe, `.. -> Type`: what it gives
-- is a type.
fun endsInUniverse (a : SurfaceArena) (t : SurfaceExpr) : Bool =
  match kindSurfaceExpr a t with
  | SurfaceExprKind.Pi -> endsInUniverse a (surfaceExprPiCod a t)
  | SurfaceExprKind.Type -> True
  | SurfaceExprKind.App -> kindSurfaceExpr a (surfaceExprAppFunc a t) == SurfaceExprKind.Type
  | _ -> False

fun renameDefBody src out (r : Rn) (m : Meta) (dfn : Def) ty params rhs resultTy =
      let isPlain = kindSurfaceRhs src rhs == SurfaceRhsKind.Plain in
      if isPlain and V.len dfn.eqs == 1 and V.all (simplePat src) params then
        scoped r (\u ->
          let v = scopeQuantified out r ty in
          let built =
            scoped r (\w ->
              let bps =
                V.map
                  (\p ->
                    match (src, p) with
                    | SurfacePatBind q -> resolveParam src out r q
                    | _ -> BoundParam.BoundParam (bindName r "_") None None None)
                  params
              in
              let b = resolveExpr src out r (surfaceRhsPlainBody src rhs) in
              let b2 = match resultTy with | Just t -> newHirExprAnn out m b (asType r (\x -> resolveExpr src out r t)) | None -> b in
              V.foldr (\bp acc -> wrapParam out m bp acc) b2 bps)
          in
          newHirBind out m (idNode out m dfn.name) ty built (getRef r.linear))
      else renameMatch src out r m dfn ty

-- A definition by matching: each equation a clause.
fun renameMatch src out (r : Rn) (m : Meta) (dfn : Def) ty =
  scoped r (\u ->
    let v = scopeQuantified out r ty in
    let clauses =
      V.map
        (\d ->
          match (src, d) with
          | SurfaceDeclDef _ pats resultTy rhs -> renameClause src out r (metaSurfaceDecl src d) pats resultTy rhs
          | _ -> newHirClause out m [] (newHirRhsImpossible out m))
        dfn.eqs
    in
    newHirBind out m (idNode out m dfn.name) ty (newHirExprMatch out m clauses) (getRef r.linear))

-- The binders a signature quantifies over, in front of it: the implicit
-- `Pi`s it starts with.
fun quantified out (t : HirExpr) =
  if kindHirExpr out t != HirExprKind.Pi or hirExprPiIcit out t != Icit.Implicit then []
  else
    match hirExprPiName out t with
    | Just x -> V.append [(hirIdentText out x, hirIdentUniques out x)] (quantified out (hirExprPiCod out t))
    | None -> []

-- What a signature quantifies over scopes over the equation.
fun scopeQuantified out (r : Rn) ty =
  match ty with
  | Just t -> V.foldl (\acc x -> match x with | (n, us) -> onTop r (\s -> Hm.insert n [V.getOr (0 - 1) us 0] s)) () (quantified out t)
  | None -> ()

-- The lower-case names `t` mentions that are neither bound in it nor
-- `known`, in order of first appearance.
fun freeVars (a : SurfaceArena) (t : SurfaceExpr) (bound : [String]) known (out : [String]) : [String] ! { Mut | e } =
  let go = \u o -> freeVars a u bound known o in
  let under = \x u o -> match x with | Just n -> freeVars a u (V.pushBack bound n) known o | None -> go u o in
  let grades =
    \g o ->
      match g with
      | Just gr -> (match surfaceGradeInType a gr with | Just x -> go x (go (surfaceGradeUses a gr) o) | None -> go (surfaceGradeUses a gr) o)
      | None -> o
  in
  let text = \n -> surfaceNameText a n in
  match (a, t) with
  | SurfaceExprVar n ->
      let x = text n in
      let b = if stringByteLength x > 0 then toInt (stringByteAt x 0) else 0 in
      let lower = (b >= 97 and b <= 122) or b == 95 in
      if lower and not (V.elem x bound) and not (V.elem x out) and not (known x) and x != "otherwise" then V.pushBack out x
      else out
  | SurfaceExprPi x _ g dom cod -> under (M.map text x) cod (go dom (grades g out))
  | SurfaceExprLam p body ->
      let o1 = grades (surfaceParamGrade a p) out in
      let o2 = match surfaceParamTy a p with | Just tt -> go tt o1 | None -> o1 in
      under (Just (text (surfaceParamName a p))) body o2
  | SurfaceExprApp f x -> go x (go f out)
  | SurfaceExprAnn f x -> go x (go f out)
  | SurfaceExprRange f x -> go x (go f out)
  | SurfaceExprEff f x -> go x (go f out)
  | SurfaceExprRow ls tail -> V.foldl (\o l -> go l o) out (V.append ls (match tail with | Just x -> [x] | None -> []))
  | SurfaceExprBox e -> go e out
  | SurfaceExprSeq es -> V.foldl (\o e -> go e o) out es
  | SurfaceExprArray es -> V.foldl (\o e -> go e o) out es
  | SurfaceExprRecord _ fs -> V.foldl (\o f -> go (surfaceFieldValue a f) o) out fs
  | SurfaceExprProj e _ -> go e out
  | SurfaceExprUpdate e fs -> V.foldl (\o f -> go (surfaceFieldValue a f) o) (go e out) fs
  | SurfaceExprLetBox x e body -> under (Just (text x)) body (go e out)
  | SurfaceExprLet ds body ->
      let names = V.concatMap (\d -> match equation a d with | Just (x, _) -> [x] | None -> []) ds in
      freeVars a body (V.append bound names) known out
  | SurfaceExprCase e _ -> go e out
  | SurfaceExprHandle e _ -> go e out
  | _ -> out

-- --- programs ----------------------------------------------------------------------

-- What binding a program's names leaves to do.
record Bound = {
  datas : [SurfaceData],
  dataNames : [(Ident, [Ident])],
  effectNames : [(Ident, [Ident])],
  defs : [Def],
  natives : [(Ident, SurfaceExpr)]
}

-- The names a program declares, `decls` its declarations (or a `let`'s), all
-- in the innermost scope.
fun bindProgram (r : Rn) (prog : Program) (decls : [SurfaceDecl]) : Bound ! { Mut | e } =
  let a = prog.src in
  let effectNames =
    V.map
      (\e ->
        let name = bindName r (surfaceNameText a (surfaceEffectName a e)) in
        let ops = V.map (\o -> bindName r (surfaceNameText a (surfaceOpSigName a o))) (surfaceEffectOps a e) in
        let w = setRef r.effectOps (Hm.insert (H.uniqueOf name) (V.map (\o -> (H.textOf o, H.uniqueOf o)) ops) (getRef r.effectOps)) in
        (name, ops))
      prog.effects
  in
  let dataNames = bindDatas r a prog.datas in
  let natives =
    V.concatMap (\d -> match (a, d) with | SurfaceDeclNative x ty -> [(bindName r (surfaceNameText a x), ty)] | _ -> []) decls
  in
  let defs = bindDecls a r decls in
  -- a record's fields, by their projections, which the parser named `Point.x`
  let w1 =
    V.foldl
      (\acc i ->
        match (V.get prog.datas i, V.get dataNames i) with
        | (Just d, Just (name, _)) ->
            if surfaceDataIsRecord a d then
              let top = M.unwrapOr Hm.empty (V.last (getRef r.scopes)) in
              let found =
                V.concatMap
                  (\f ->
                    let fx = surfaceNameText a f in
                    match Hm.lookup "${dataName a d}.${fx}" top with | Just ps -> [(fx, V.getOr 0 ps 0)] | None -> [])
                  (surfaceDataFields a d)
              in
              setRef r.fields (Hm.insert (H.uniqueOf name) found (getRef r.fields))
            else acc
        | _ -> acc)
      ()
      (V.range 0 (V.len prog.datas))
  in
  let w2 =
    V.foldl
      (\acc (d : Def) ->
        if V.elem (H.textOf d.name) prog.terminating then setRef r.terminating (V.pushBack (getRef r.terminating) (H.uniqueOf d.name))
        else acc)
      ()
      defs
  in
  Bound { datas = prog.datas, dataNames, effectNames, defs, natives }

-- What a program says, its names bound and its `use`s taken.
fun renameProgram out (r : Rn) (prog : Program) (b : Bound) =
  let src = prog.src in
  let datas = renameDatas src out r b.datas b.dataNames in
  let effects =
    V.concatMap
      (\i ->
        match (V.get prog.effects i, V.get b.effectNames i) with
        | (Just e, Just names) -> [renameEffect src out r e names]
        | _ -> [])
      (V.range 0 (V.len prog.effects))
  in
  let natives =
    V.map
      (\n -> match n with | (x, ty) -> newHirNative out (metaSurfaceExpr src ty) (idNode out (metaSurfaceExpr src ty) x) (renameSig src out r ty))
      b.natives
  in
  let binds = renameDefs src out r b.defs in
  (datas, effects, natives, binds)

-- Record what module `i` declares, and how visible each is, for the
-- others' `use`s.
fun export (r : Rn) (i : Int) (prog : Program) (b : Bound) =
  let a = prog.src in
  let declared = \x -> match V.find (\v -> fst v == x) prog.visibility with | Just (_, vis) -> vis | None -> Visibility.Private in
  let names =
    V.concat [
      V.map (\dn -> match dn with | (d, (n, _)) -> (n, surfaceDataVis a d)) (V.zip b.datas b.dataNames),
      V.concatMap (\en -> match en with | (e, (n, ops)) -> V.map (\x -> (x, surfaceEffectVis a e)) (V.append [n] ops)) (V.zip prog.effects b.effectNames),
      V.map (\(d : Def) -> (d.name, declared (H.textOf d.name))) b.defs,
      V.map (\nt -> (fst nt, declared (H.textOf (fst nt)))) b.natives
    ]
  in
  match modAt r i with
  | None -> ()
  | Just m ->
      let qualifier = S.join "." m.path in
      let w =
        if S.isEmpty qualifier then ()
        else V.foldl (\acc xv -> setRef r.qualifiers (Hm.insert (H.uniqueOf (fst xv)) qualifier (getRef r.qualifiers))) () names
      in
      setMod r i { m | exports = V.foldl (\e xv -> match xv with | (x, vis) -> Hm.insert (H.textOf x) (H.uniqueOf x, vis) e) m.exports names }

-- Whether a module says how visible anything in it is.
fun mentionsVisibility (p : Program) : Bool =
  not (V.isEmpty p.visibility)
    or V.any (\(u : Use) -> u.public) p.uses
    or V.any (\d -> surfaceDataVis p.src d != Visibility.Private) p.datas
    or V.any (\e -> surfaceEffectVis p.src e != Visibility.Private) p.effects

-- What renaming a package made: its data types, effects, natives,
-- definitions, and, for the root package, its expression and its `main`.
data Done = Done [HirData] [HirEffect] [HirNative] [HirBind] (Maybe HirExpr) (Maybe Int)

-- A package renamed: its program, and what is known about it beside.
@pub record Renamed = {
  hir : HirProgram,
  main : Maybe Int,
  -- the first unique the program named its own things with: what came
  -- before is the builtins' and the prelude's
  first : Int,
  terminating : [Int],
  linearBody : Bool,
  -- the module each top-level name of a module other than a package's root
  -- is in (`Collections.List` for `map`), as written before it from outside
  qualifiers : HashMap Int String,
  -- the uniques each package named its own things with, and its name: the
  -- dependencies', then the package's own
  ranges : [(Int, Int, String)]
}

-- Rename the modules of package `pkg` (whose modules are `first` on in
-- `r.modules`), its root's expression if `root`: every module's names, so
-- that any may mention any other; then what their `use`s bring, twice,
-- since a `@pub use` may give on what another's brings it (only the second
-- time says what is wrong); then what each says.
fun renamePackageAt out (r : Rn) (pkg : Int) (first : Int) (progs : [Program]) (root : Bool) (linearPackage : Bool) =
  let n = V.len progs in
  -- a root that is nothing but `let ... in body` is those declarations and
  -- that body
  let parts =
    V.map
      (\i ->
        match V.get progs i with
        | Just (p : Program) ->
            (match (V.isEmpty p.decls, M.map (\b -> (p.src, b)) p.body) with
             | (True, Just (SurfaceExprLet ds body)) -> if i == 0 and root then (ds, Just body) else (p.decls, None)
             | _ -> (p.decls, if i == 0 and root then p.body else None))
        | None -> ([], None))
      (V.range 0 n)
  in
  let bound =
    V.map
      (\i ->
        match (V.get progs i, V.get parts i) with
        | (Just (p : Program), Just (decls, _)) ->
            let w = enter r (first + i) in
            let w2 = setRef r.linear (linearPackage or p.linear) in
            let b = bindProgram r p decls in
            let w3 = export r (first + i) p b in
            let w4 = leave r in
            b
        | _ -> Bound { datas = [], dataNames = [], effectNames = [], defs = [], natives = [] })
      (V.range 0 n)
  in
  let uses =
    \quiet ->
      let mark = V.len (getRef r.problems) in
      let w =
        V.foldl
          (\acc i ->
            match V.get progs i with
            | Just (p : Program) ->
                let a = enter r (first + i) in
                let b = V.foldl (\acc2 u -> renameUse r u) () p.uses in
                leave r
            | None -> ())
          ()
          (V.range 0 n)
      in
      if quiet then setRef r.problems (V.take (getRef r.problems) mark) else ()
  in
  let w1 = uses True in
  let w2 = uses False in
  V.foldl
    (\acc i ->
      match (acc, V.get progs i, V.get bound i, V.get parts i) with
      | (Done.Done ds es ns bs body main, Just (p : Program), Just b, Just (_, rootBody)) ->
          let w = enter r (first + i) in
          let w3 = setRef r.linear (linearPackage or p.linear) in
          (match renameProgram out r p b with
           | (d, e, nt, bnd) ->
               let (body2, main2) =
                 if i == 0 and root then
                   let bd = M.map (\x -> resolveExpr p.src out r x) rootBody in
                   let own = M.unwrapOr Hm.empty (V.last (getRef r.scopes)) in
                   (bd, M.andThen V.head (Hm.lookup "main" own))
                 else (body, main)
               in
               let w4 = leave r in
               Done.Done (V.append ds d) (V.append es e) (V.append ns nt) (V.append bs bnd) body2 main2)
      | _ -> acc)
    (Done.Done [] [] [] [] None None)
    (V.range 0 n)

-- Rename a package, its modules each a path and a program, the root first,
-- after the prelude and the packages it depends on (each a name and its
-- modules, the same way), which are renamed first and named from the
-- uniques before its own: their declarations come in the module beside the
-- prelude's, and only what they make `@pub` is theirs to give.
@pub fun renamePackage
    (name : String)
    (modules : [([String], SurfaceProgram)])
    (prelude : SurfaceProgram)
    (deps : [(String, [([String], SurfaceProgram)])])
    : (Renamed, [String]) ! { Mut | e } =
  runSt (\() ->
    let out = newHirBuilder () in
    let r = new () in
    let pre = programOf prelude in
    let w1 = setRef r.scopes (V.append (getRef r.scopes) [Hm.empty, Hm.empty]) in
    let w2 = setRef r.linear pre.linear in
    let pb = bindProgram r pre pre.decls in
    let w3 = V.foldl (\acc u -> renameUse r u) () pre.uses in
    match renameProgram out r pre pb with
    | (pdatas, peffects, pnatives, pbinds) ->
        let w4 = setRef r.linear False in
        let w5 = setRef r.base (getRef r.scopes) in
        -- the root package is 0, its dependencies 1 on
        let allPackages = V.append [(name, V.map (\m -> (fst m, programOf (snd m))) modules)] (V.map (\d -> (fst d, V.map (\m -> (fst m, programOf (snd m))) (snd d))) deps) in
        let w6 = setRef r.packageNames (V.map fst allPackages) in
        let w7 = setRef r.packageDeps (V.append [V.range 1 (V.len allPackages)] (V.map (\d -> []) deps)) in
        let w8 = setRef r.visibilityMentioned (V.map (\pm -> V.any (\m -> mentionsVisibility (snd m)) (snd pm)) allPackages) in
        let mods =
          V.concatMap
            (\pi ->
              match V.get allPackages pi with
              | Just (_, ms) -> V.map (\m -> Mod { package = pi, path = fst m, own = Hm.empty, imports = Hm.empty, aliases = Hm.empty, exports = Hm.empty }) ms
              | None -> [])
            (V.range 0 (V.len allPackages))
        in
        let w9 = setRef r.modules mods in
        let starts = V.foldl (\acc pm -> V.pushBack acc (V.getOr 0 acc (V.len acc - 1) + V.len (snd pm))) [0] allPackages in
        -- the dependencies, in turn
        let depParts =
          V.map
            (\di ->
              let lo = getRef r.next in
              let progs = V.map snd (snd (V.getOr ("", []) allPackages (di + 1))) in
              let renamed = renamePackageAt out r (di + 1) (V.getOr 0 starts (di + 1)) progs False False in
              (renamed, (lo, getRef r.next, fst (V.getOr ("", []) deps di))))
            (V.range 0 (V.len deps))
        in
        let first = getRef r.next in
        let rootProgs = V.map snd (snd (V.getOr ("", []) allPackages 0)) in
        (match renamePackageAt out r 0 0 rootProgs True False with
         | Done.Done datas effects natives binds body main ->
             let depDatas = V.concatMap (\dp -> match fst dp with | Done.Done d _ _ _ _ _ -> d) depParts in
             let depEffects = V.concatMap (\dp -> match fst dp with | Done.Done _ e _ _ _ _ -> e) depParts in
             let depNatives = V.concatMap (\dp -> match fst dp with | Done.Done _ _ n _ _ _ -> n) depParts in
             let depBinds = V.map (\dp -> match fst dp with | Done.Done _ _ _ b _ _ -> b) depParts in
             let groups =
               V.map (\bs -> newHirGroupRec out noMeta bs) (V.filter (\bs -> not (V.isEmpty bs)) (V.concat [[pbinds], depBinds, [binds]]))
             in
             let linearBody = match V.head rootProgs with | Just (p : Program) -> p.linear | None -> False in
             let root =
               newHirModule out noMeta (V.concat [pdatas, depDatas, datas]) (V.concat [peffects, depEffects, effects]) (V.concat [pnatives, depNatives, natives]) groups body
             in
             (
               Renamed {
                 hir = HirProgram (freezeHir out) root,
                 main,
                 first,
                 terminating = getRef r.terminating,
                 linearBody,
                 qualifiers = getRef r.qualifiers,
                 ranges = V.pushBack (V.map snd depParts) (first, getRef r.next, name)
               },
               getRef r.problems
             )))

-- Rename a lone module, the root of a package called `Main`, after the
-- prelude.
@pub fun renameModule (prog : SurfaceProgram) (prelude : SurfaceProgram) : (Renamed, [String]) ! { Mut | e } =
  renamePackage package [([], prog)] prelude []

-- --- writing ---------------------------------------------------------------------

-- `dumped` writes a package's own part as the rename test compares it with
-- the Rust renamer's HIR: a line for each declaration, every name as
-- `text@unique`. The Rust side (`compiler/idyllic/tests/front.rs`) writes
-- its HIR the same way, and the test renumbers the uniques of both in the
-- order they first appear, so that what is compared is which use is of
-- which binder, not how the two renamers count.

fun sx (parts : [String]) : String = "(" ++ S.join " " parts ++ ")"

fun opt (f : a -> String) (m : Maybe a) : String =
  match m with
  | Just x -> f x
  | None -> "-"

fun flag (yes : String) (b : Bool) : String = if b then yes else "-"

fun identText (a : HirArena) (x : HirIdent) : String = H.ident (identOf a x)

fun gradeText (a : HirArena) (g : HirGrade) : String = sx ["grade", termText a (hirGradeUses a g), opt (termText a) (hirGradeInType a g)]

fun termText (a : HirArena) (t : HirExpr) : String =
  let go = termText a in
  let id = identText a in
  match (a, t) with
  | HirExprType -> "Type"
  | HirExprVar x -> id x
  | HirExprLit l -> H.literal l
  | HirExprPi x icit g dom cod ->
      sx ["pi", opt id x, (match icit with | Icit.Explicit -> "e" | Icit.Implicit -> "i"), opt (gradeText a) g, go dom, go cod]
  | HirExprLam x g ty body -> sx ["lam", id x, opt (gradeText a) g, opt go ty, go body]
  | HirExprApp f x -> sx ["app", go f, go x]
  | HirExprAnn x ty -> sx ["ann", go x, go ty]
  | HirExprHole -> "_"
  | HirExprBox x -> sx ["box", go x]
  | HirExprInf -> "inf"
  | HirExprRange l h -> sx ["range", go l, go h]
  | HirExprLetBox x v body -> sx ["letbox", id x, go v, go body]
  | HirExprLet gs body -> sx ["let", sx (V.map (groupText a) gs), go body]
  | HirExprCase x cs -> sx (V.append ["case", go x] (V.map (clauseText a) cs))
  | HirExprMatch cs -> sx (V.append ["match"] (V.map (clauseText a) cs))
  | HirExprOmitted -> "?"
  | HirExprEff b r -> sx ["eff", go b, go r]
  | HirExprRow ls tail -> sx ["row", sx (V.map go ls), opt go tail]
  | HirExprHandle x cs ->
      sx (V.append ["handle", go x] (V.map (\c -> sx ["clause", opt id (hirHandleClauseOp a c), sx (V.map id (hirHandleClauseParams a c)), go (hirHandleClauseBody a c)]) cs))
  | HirExprSeqNil -> "nil"
  | HirExprSeqCons h tl -> sx ["cons", go h, go tl]
  | HirExprArray es -> sx (V.append ["array"] (V.map go es))

fun clauseText (a : HirArena) (c : HirClause) : String =
  let rhs =
    match (a, hirClauseRhs a c) with
    | HirRhsPlain e -> sx ["=", termText a e]
    | HirRhsGuarded gs -> sx (V.append ["guards"] (V.map (\g -> sx [termText a (hirGuardCond a g), termText a (hirGuardBody a g)]) gs))
    | _ -> "impossible"
  in
  sx ["clause", sx (V.map (patternText a) (hirClausePats a c)), rhs]

fun patternText (a : HirArena) (p : HirPattern) : String =
  let go = patternText a in
  let id = identText a in
  match (a, p) with
  | HirPatternVar x -> id x
  | HirPatternWild -> "_"
  | HirPatternLit l -> H.literal l
  | HirPatternCon c ps -> sx (V.append ["con", id c] (V.map go ps))
  | HirPatternAs x q -> sx ["as", id x, go q]
  | HirPatternDot e -> sx ["dot", termText a e]
  | HirPatternSeqNil -> "pnil"
  | HirPatternSeqCons h tl -> sx ["pcons", go h, go tl]

fun uniqueIn (a : HirArena) (x : HirIdent) : Int = V.getOr (0 - 1) (hirIdentUniques a x) 0

-- A binding; `terminating`, if it is one `@terminating` vouches for.
fun bindText (a : HirArena) (terminating : [Int]) (b : HirBind) : String =
  let x = hirBindName a b in
  sx [
    "bind",
    identText a x,
    opt (termText a) (hirBindTy a b),
    termText a (hirBindRhs a b),
    flag "linear" (hirBindLinear a b),
    flag "terminating" (V.elem (uniqueIn a x) terminating)
  ]

fun groupText (a : HirArena) (g : HirGroup) : String =
  match (a, g) with
  | HirGroupNonRec b -> sx ["nonrec", bindText a [] b]
  | HirGroupRec bs -> sx (V.append ["rec"] (V.map (bindText a []) bs))

fun typeParamText (a : HirArena) (p : HirTypeParam) : String =
  sx [identText a (hirTypeParamName a p), opt (termText a) (hirTypeParamKindSig a p)]

fun dataText (a : HirArena) (d : HirData) : String =
  sx [
    "data",
    identText a (hirDataName a d),
    sx (V.map (typeParamText a) (hirDataParams a d)),
    opt (termText a) (hirDataKindSig a d),
    sx
      (V.map
         (\c ->
           match (a, c) with
           | HirCtorFields n ts -> sx [identText a n, sx (V.append ["fields"] (V.map (termText a) ts))]
           | HirCtorSig n ty -> sx [identText a n, sx ["sig", termText a ty]])
         (hirDataCtors a d)),
    opt (\q -> sx ["seq", identText a (hirSeqPairNil a q), identText a (hirSeqPairCons a q)]) (hirDataSeq a d),
    flag "linear" (hirDataLinear a d)
  ]

fun effectText (a : HirArena) (e : HirEffect) : String =
  sx [
    "effect",
    identText a (hirEffectName a e),
    sx (V.map (typeParamText a) (hirEffectParams a e)),
    sx (V.map (\o -> sx ["op", identText a (hirOpName a o), flag "many" (hirOpMany a o), termText a (hirOpTy a o)]) (hirEffectOps a e))
  ]

-- The program's own part of a package, a line each: its data types,
-- effects, natives and bindings, then its body, its `main` and whether it is
-- linear.
@pub fun dumped (r : Renamed) : String =
  let a = hirArena r.hir in
  let root = hirRoot r.hir in
  let own = \x -> uniqueIn a x >= r.first in
  let binds = V.concatMap (\g -> match (a, g) with | HirGroupNonRec b -> [b] | HirGroupRec bs -> bs) (hirModuleGroups a root) in
  S.join
    "\n"
    (V.concat [
       V.map (dataText a) (V.filter (\d -> own (hirDataName a d)) (hirModuleDatas a root)),
       V.map (effectText a) (V.filter (\e -> own (hirEffectName a e)) (hirModuleEffects a root)),
       V.map
         (\n -> sx ["native", identText a (hirNativeName a n), termText a (hirNativeTy a n)])
         (V.filter (\n -> own (hirNativeName a n)) (hirModuleNatives a root)),
       V.map (bindText a r.terminating) (V.filter (\b -> own (hirBindName a b)) binds),
       (match hirModuleBody a root with | Just e -> [sx ["body", termText a e]] | None -> []),
       (match r.main with | Just u -> [sx ["main", "main@" ++ show u]] | None -> []),
       [sx ["linear", if r.linearBody then "true" else "false"]]
     ])

-- An identifier, as the checker's context keeps one: the uniques a name
-- may stand for, and its text.
@pub fun identOf (a : HirArena) (x : HirIdent) : Ident = Ident.Ident (hirIdentUniques a x) (hirIdentText a x)
