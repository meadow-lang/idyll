-- Each token's class in what the server says to colour, as the protocol
-- encodes them: five numbers a token, its class the fourth.
fun classes (reply : Maybe Json) : [Int] =
  match M.andThen (J.path ["result", "data"]) reply with
  | Just (J.Json.Array xs) ->
      V.concatMap
        (\i -> if i % 5 == 3 then (match V.get xs i with | Just j -> M.unwrapOr [] (M.map (\n -> [n]) (J.asInt j)) | None -> []) else [])
        (V.range 0 (V.len xs))
  | _ -> []

-- Each token the server coloured, where it is: its line, its column, and
-- its class (`keyword` 0, `type` 1, `enumMember` 2, `function` 3,
-- `variable` 4, `namespace` 8, `comment` 9).
fun tokensOf (reply : Maybe Json) : [(Int, Int, Int)] =
  match M.andThen (J.path ["result", "data"]) reply with
  | Just (J.Json.Array xs) ->
      let n = \i -> M.unwrapOr 0 (M.andThen J.asInt (V.get xs i)) in
      (match V.foldl
         (\acc k ->
           match acc with
           | (out, line, col) ->
               let dl = n (k * 5) in
               let l = line + dl in
               let c = if dl == 0 then col + n (k * 5 + 1) else n (k * 5 + 1) in
               (V.pushBack out (l, c, n (k * 5 + 3)), l, c))
         ([], 0, 0)
         (V.range 0 (V.len xs / 5)) with
       | (out, _, _) -> out)
  | _ -> []

fun colourAt (tokens : [(Int, Int, Int)]) (line : Int) (col : Int) : Maybe Int =
  M.map (\t -> match t with | (_, _, c) -> c) (V.find (\t -> match t with | (l, c, _) -> l == line and c == col) tokens)

