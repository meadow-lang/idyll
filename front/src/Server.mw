-- Where a reply to `textDocument/definition` goes: the file (the end of
-- its uri) and the line and column it starts at.
fun wentTo (reply : Maybe Json) : Maybe (String, Json, Json) =
  let first = M.andThen (\r -> match r with | J.Json.Array xs -> V.get xs 0 | other -> Just other) (M.andThen (J.get "result") reply) in
  match (M.andThen (J.get "uri") first, M.andThen (J.path ["range", "start", "line"]) first, M.andThen (J.path ["range", "start", "character"]) first) with
  | (Just (J.Json.String uri), Just line, Just column) -> Just (M.unwrapOr uri (V.last (S.split "/" uri)), line, column)
  | _ -> None

