-- Idyll's language server (`lsp!`), `Idyll lsp`: on standard input and
-- output, over a session of the compiler's queries (`Session`), which
-- works out again only what an edit changed. It publishes what is wrong
-- with each open file, colours a file from its tree, and sets a file out
-- as `Idyll fmt` does.

use Lingua (lsp!)
use Idyll.Session
use Idyll.Syntax (parseIdyll)
use Std.Exn (toResult)
use Std.Result.Result.*

lsp! {
  pub Server "idyll" for Session
    | text = setSessionSource
    | diagnostics = diagnosticsOf
    | tree = treeOf
    | format = formatOf
    | hover = hoverAt
    | definition = definitionAt
    | references = referencesAt
    | completion = completionAt
    | symbols = symbolsOf
}

-- A query's answer, or `fallback` if it has none (an input never set).
fun answered fallback act = match toResult act with | Ok x -> x | Err _ -> fallback

fun diagnosticsOf db file = answered [] (\() -> sessionProblems db file)

fun treeOf db file = answered (fst (parseIdyll "")) (\() -> fst (sessionParsed db file))

-- What the term at a place is: its type, as the checker found it.
fun hoverAt db file at =
  answered None (\() ->
    match typeAt (sessionSource db file) (sessionPrelude db 0) (\u -> sessionStd db 0) at with
    | Just (place, ty) -> Just (place, "```idyll\n${ty}\n```")
    | None -> None)

-- Where the name at a place is defined: where the program first binds it,
-- its equation or its binder.
fun definitionAt db file at =
  answered [] (\() ->
    match namedAt (sessionSource db file) (sessionPrelude db 0) (\u -> sessionStd db 0) at with
    | Just (d, _) -> [(file, d)]
    | None -> [])

-- Every place the name at a place is named.
fun referencesAt db file at =
  answered [] (\() ->
    match namedAt (sessionSource db file) (sessionPrelude db 0) (\u -> sessionStd db 0) at with
    | Just (_, places) -> V.map (\p -> (file, p)) places
    | None -> [])

-- What a name being written may be: the program's own names and the
-- prelude's, each with its type.
fun completionAt db file at =
  answered [] (\() -> completionsIn (sessionSource db file) (sessionPrelude db 0) (\u -> sessionStd db 0) at)

-- The file's own declarations, for an outline.
fun symbolsOf db file =
  answered [] (\() -> symbolsIn (sessionSource db file) (sessionPrelude db 0) (\u -> sessionStd db 0))

-- The file set out; as it is, if it cannot be.
fun formatOf db file = answered (answered "" (\() -> sessionSource db file)) (\() -> sessionFormatted db file)

-- --- the server, told what an editor would tell it --------------------------------

use Lingua.Lsp (told)
use Std.Json (Json)
use Std.Json as J
use Std.Collections.Vector as V
use Std.Maybe as M
use Std.Test (assertEq)

fun message (fields : [(String, Json)]) : Json = J.jObject (V.pushFront fields ("jsonrpc", J.jString "2.0"))

fun asking (id : Int) (method : String) (params : Json) : Json =
  message [("id", J.jInt id), ("method", J.jString method), ("params", params)]

fun inFile (uri : String) : Json = J.jObject [("textDocument", J.jObject [("uri", J.jString uri)])]

fun opening (uri : String) (text : String) : Json =
  message [
    ("method", J.jString "textDocument/didOpen"),
    ("params", J.jObject [("textDocument", J.jObject [("uri", J.jString uri), ("text", J.jString text)])])
  ]

-- How many diagnostics the first thing the server said, after an edit,
-- published.
fun published (said : [Json]) : Maybe Int =
  M.andThen (\d -> match d with | J.Json.Array xs -> Just (V.len xs) | _ -> None) (M.andThen (J.path ["params", "diagnostics"]) (V.get said 0))

@test fun aProgramThatChecksHasNothingWrong () =
  assertEq (published (told [opening "file:///a.idl" "x : Int\nx = 1\n"] serveServer)) (Just 0) "nothing to say"

@test fun aSyntaxErrorIsPublished () =
  assertEq (M.map (\n -> n > 0) (published (told [opening "file:///a.idl" "x = (1 +\n"] serveServer))) (Just True) "what the parser said"

-- Where the first diagnostic published starts: its line and column.
fun firstAt (said : [Json]) : Maybe (Json, Json) =
  match V.get said 0 with
  | Just m ->
      (match (J.path ["params", "diagnostics"] m) with
       | Just (J.Json.Array ds) ->
           (match V.get ds 0 with
            | Just d ->
                (match (J.path ["range", "start", "line"] d, J.path ["range", "start", "character"] d) with
                 | (Just l, Just c) -> Just (l, c)
                 | _ -> None)
            | None -> None)
       | _ -> None)
  | None -> None

@test fun aTypeErrorIsWhereItWasFound () =
  assertEq (firstAt (told [opening "file:///a.idl" "x : Bool\nx = 1\n"] serveServer)) (Just (J.jInt 1, J.jInt 4)) "at the 1, not the start of the file"

fun hovering (id : Int) (uri : String) (line : Int) (column : Int) : Json =
  asking id "textDocument/hover" (J.jObject [
    ("textDocument", J.jObject [("uri", J.jString uri)]),
    ("position", J.jObject [("line", J.jInt line), ("character", J.jInt column)])
  ])

@test fun hoverSaysWhatATermIs () =
  let said = told [opening "file:///a.idl" "x : Int\nx = 1\n", hovering 1 "file:///a.idl" 1 4] serveServer in
  assertEq
    (M.andThen (J.path ["result", "contents", "value"]) (V.get said 1))
    (Just (J.jString "```idyll\nInt\n```"))
    "the 1 is an Int"

@test fun aNameNotInScopeIsWhereItIsWritten () =
  assertEq (firstAt (told [opening "file:///a.idl" "x : Int\nx = nope\n"] serveServer)) (Just (J.jInt 1, J.jInt 4)) "at nope"

fun asked (id : Int) (method : String) (uri : String) (line : Int) (column : Int) : Json =
  asking id method (J.jObject [
    ("textDocument", J.jObject [("uri", J.jString uri)]),
    ("position", J.jObject [("line", J.jInt line), ("character", J.jInt column)])
  ])

@test fun aDefinitionIsWhereANameIsBound () =
  let said = told [opening "file:///a.idl" "f : Int -> Int\nf n = n\nx = f 1\n", asked 1 "textDocument/definition" "file:///a.idl" 2 4] serveServer in
  let result = M.andThen (J.get "result") (V.get said 1) in
  let first = M.andThen (\r -> match r with | J.Json.Array xs -> V.get xs 0 | other -> Just other) result in
  assertEq
    (M.andThen (J.path ["range", "start", "line"]) first, M.andThen (J.path ["range", "start", "character"]) first)
    (Just (J.jInt 1), Just (J.jInt 0))
    "f's equation, which the renamer binds it at"

@test fun aNamesReferencesAreEveryPlaceItIsNamed () =
  let said = told [opening "file:///a.idl" "f : Int -> Int\nf n = n\nx = f (f 1)\n", asked 1 "textDocument/references" "file:///a.idl" 2 4] serveServer in
  assertEq
    (M.map (\r -> match r with | J.Json.Array xs -> V.len xs >= 3 | _ -> False) (M.andThen (J.get "result") (V.get said 1)))
    (Just True)
    "its signature and both uses, at least"

-- The labels of what a reply's result lists, each its `field`.
fun listed (field : String) (reply : Maybe Json) : [Json] =
  match M.andThen (J.get "result") reply with
  | Just (J.Json.Array xs) -> V.concatMap (\x -> match J.get field x with | Just l -> [l] | None -> []) xs
  | Just other ->
      (match J.get "items" other with
       | Just (J.Json.Array xs) -> V.concatMap (\x -> match J.get field x with | Just l -> [l] | None -> []) xs
       | _ -> [])
  | None -> []

@test fun completionOffersTheProgramsNamesAndThePreludes () =
  let said = told [opening "file:///a.idl" "double : Int -> Int\ndouble n = n + n\nx = do\n", asked 1 "textDocument/completion" "file:///a.idl" 2 6] serveServer in
  let labels = listed "label" (V.get said 1) in
  assertEq (V.elem (J.jString "double") labels, V.elem (J.jString "putStrLn") labels) (True, True) "double, and the prelude's putStrLn"

@test fun theOutlineIsTheProgramsOwnDeclarations () =
  let said = told [opening "file:///a.idl" "double : Int -> Int\ndouble n = n + n\n", asking 1 "textDocument/documentSymbol" (inFile "file:///a.idl")] serveServer in
  assertEq (listed "name" (V.get said 1)) [J.jString "double"] "double, and nothing of the prelude's"

@test fun aTypeErrorIsPublished () =
  assertEq (M.map (\n -> n > 0) (published (told [opening "file:///a.idl" "x : Bool\nx = 1\n"] serveServer))) (Just True) "what the checker said"
