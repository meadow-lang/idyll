-- Idyll's language server (`lsp!`), `Idyll lsp`: on standard input and
-- output, over a session of the compiler's queries (`Session`), which
-- works out again only what an edit changed. It publishes what is wrong
-- with each open file, colours a file from its tree, and sets a file out
-- as `Idyll fmt` does.

use Lingua (lsp!)
use Idyll.Session
use Idyll.Syntax (parseIdyll)
use Std.Exn (toResult)
use Std.Result.Result.*
use Lingua.Lsp (pathOf)
use Idyll.Driver as D
use Idyll.Workspace as Ws
use Std.Path as Path
use Std.Fs (exists, readToString, readToStringOr, createDirAll, writeString)
use Std.Maybe as M
use Std.Collections.Vector as V

lsp! {
  pub Server "idyll" for Session
    | text = setSessionSource
    | diagnostics = diagnosticsOf
    | tree = treeOf
    | format = formatOf
    | hover = hoverAt
    | definition = definitionAt
    | references = referencesAt
    | completion = completionAt
    | symbols = symbolsOf
    | opened = openedIn
}

-- A file the editor opened: the package it is a module of found (an
-- `Idyll.toml` in a directory above it, its modules under `src`), and its
-- other modules read, so that what is wrong with it is what is wrong with
-- it in its package. A file in no package is a lone program.
fun openedIn db file (uri : String) =
  let path = pathOf uri in
  setSessionPackage db file (M.andThen (\root -> contextOf root path) (packageRoot (Path.parent path)))

-- The nearest directory from `dir` up with an `Idyll.toml` in it.
fun packageRoot (dir : Maybe String) : Maybe String ! { Fs | e } =
  match dir with
  | None -> None
  | Just d -> if exists (Path.join d "Idyll.toml") then Just d else (match Path.parent d with | Just up -> if up == d then None else packageRoot (Just up) | None -> None)

-- The package at `root`, as the file at `path` sees it: its name, the
-- file's module path, every other module, read, and every package it
-- reaches, read, by the same paths and lock file a build goes by.
fun contextOf (root : String) (path : String) : Maybe PackageContext ! { Fs | e } =
  let own = D.modulePathIn path in
  let manifest = readToStringOr "" (Path.join root "Idyll.toml") in
  let name = M.unwrapOr "Main" (Ws.manifestField "name" manifest) in
  let others = V.filter (\m -> fst m != own) (modulesAt root) in
  let dirs = D.dependencyDirs root root manifest in
  let found = V.foldl (\acc d -> packagesFrom root [root] acc d) [] dirs in
  Just (PackageContext { name, own, others, uses = namesIn dirs found, needs = V.map snd found })

-- A package's modules, read.
fun modulesAt (dir : String) : [([String], String)] ! { Fs | e } =
  let src = Path.join dir "src" in
  V.concatMap
    (\rel ->
      match readToString (Path.join src rel) with
      | Ok t -> [(D.modulePathIn (Path.join src rel), t)]
      | Err _ -> [])
    (D.idlFiles src [])

-- `done`, with the package at `dir` and what it reaches, each after those it
-- depends on. (`from`, the packages on the way here: a circle is a build's
-- to refuse, and must not stop the server.)
fun packagesFrom (root : String) (from : [String]) (done : [(String, Needed)]) (dir : String) =
  if V.any (\d -> fst d == dir) done or V.elem dir from then done
  else
    let manifest = readToStringOr "" (Path.join dir "Idyll.toml") in
    let dirs = D.dependencyDirs root dir manifest in
    let after = V.foldl (\acc d -> packagesFrom root (V.pushBack from dir) acc d) done dirs in
    let name = D.plainName (D.nameOfManifest dir manifest) in
    V.pushBack after (dir, Needed { name, modules = modulesAt dir, uses = namesIn dirs after })

-- The names of the packages at `dirs`, among those found.
fun namesIn (dirs : [String]) (found : [(String, Needed)]) : [String] =
  V.map (\(n : Needed) -> n.name) (V.map snd (V.filter (\f -> V.elem (fst f) dirs) found))

-- A query's answer, or `fallback` if it has none (an input never set).
fun answered fallback act = match toResult act with | Ok x -> x | Err _ -> fallback

-- The package a file is a module of, if the editor said where it is.
fun packageIn db file = answered None (\() -> M.map (\pc -> (pc, \u -> sessionDependencies db file)) (sessionPackage db file))

fun diagnosticsOf db file = answered [] (\() -> sessionProblems db file)

fun treeOf db file = answered (fst (parseIdyll "")) (\() -> fst (sessionParsed db file))

-- What the term at a place is: its type, as the checker found it.
fun hoverAt db file at =
  answered None (\() ->
    match typeAtIn (sessionSource db file) (packageIn db file) (sessionPrelude db 0) (\u -> sessionStd db 0) at with
    | Just (place, ty) -> Just (place, "```idyll\n${ty}\n```")
    | None -> None)

-- Where the name at a place is defined: where the program first binds it,
-- its equation or its binder.
fun definitionAt db file at =
  answered [] (\() ->
    match namedAtIn (sessionSource db file) (packageIn db file) (sessionPrelude db 0) (\u -> sessionStd db 0) at with
    | Just (d, _) -> [(file, d)]
    | None -> [])

-- Every place the name at a place is named.
fun referencesAt db file at =
  answered [] (\() ->
    match namedAtIn (sessionSource db file) (packageIn db file) (sessionPrelude db 0) (\u -> sessionStd db 0) at with
    | Just (_, places) -> V.map (\p -> (file, p)) places
    | None -> [])

-- What a name being written may be: the program's own names and the
-- prelude's, each with its type.
fun completionAt db file at =
  answered [] (\() -> completionsInPackage (sessionSource db file) (packageIn db file) (sessionPrelude db 0) (\u -> sessionStd db 0) at)

-- The file's own declarations, for an outline.
fun symbolsOf db file =
  answered [] (\() -> symbolsInPackage (sessionSource db file) (packageIn db file) (sessionPrelude db 0) (\u -> sessionStd db 0))

-- The file set out; as it is, if it cannot be.
fun formatOf db file = answered (answered "" (\() -> sessionSource db file)) (\() -> sessionFormatted db file)

-- --- the server, told what an editor would tell it --------------------------------

use Lingua.Lsp (told)
use Std.Json (Json)
use Std.Json as J
use Std.Collections.Vector as V
use Std.Maybe as M
use Std.Test (assertEq)

fun message (fields : [(String, Json)]) : Json = J.jObject (V.pushFront fields ("jsonrpc", J.jString "2.0"))

fun asking (id : Int) (method : String) (params : Json) : Json =
  message [("id", J.jInt id), ("method", J.jString method), ("params", params)]

fun inFile (uri : String) : Json = J.jObject [("textDocument", J.jObject [("uri", J.jString uri)])]

fun opening (uri : String) (text : String) : Json =
  message [
    ("method", J.jString "textDocument/didOpen"),
    ("params", J.jObject [("textDocument", J.jObject [("uri", J.jString uri), ("text", J.jString text)])])
  ]

-- How many diagnostics the first thing the server said, after an edit,
-- published.
fun published (said : [Json]) : Maybe Int =
  M.andThen (\d -> match d with | J.Json.Array xs -> Just (V.len xs) | _ -> None) (M.andThen (J.path ["params", "diagnostics"]) (V.get said 0))

@test fun aProgramThatChecksHasNothingWrong () =
  assertEq (published (told [opening "file:///a.idl" "x : Int\nx = 1\n"] serveServer)) (Just 0) "nothing to say"

@test fun aSyntaxErrorIsPublished () =
  assertEq (M.map (\n -> n > 0) (published (told [opening "file:///a.idl" "x = (1 +\n"] serveServer))) (Just True) "what the parser said"

-- Where the first diagnostic published starts: its line and column.
fun firstAt (said : [Json]) : Maybe (Json, Json) =
  match V.get said 0 with
  | Just m ->
      (match (J.path ["params", "diagnostics"] m) with
       | Just (J.Json.Array ds) ->
           (match V.get ds 0 with
            | Just d ->
                (match (J.path ["range", "start", "line"] d, J.path ["range", "start", "character"] d) with
                 | (Just l, Just c) -> Just (l, c)
                 | _ -> None)
            | None -> None)
       | _ -> None)
  | None -> None

@test fun aTypeErrorIsWhereItWasFound () =
  assertEq (firstAt (told [opening "file:///a.idl" "x : Bool\nx = 1\n"] serveServer)) (Just (J.jInt 1, J.jInt 4)) "at the 1, not the start of the file"

fun hovering (id : Int) (uri : String) (line : Int) (column : Int) : Json =
  asking id "textDocument/hover" (J.jObject [
    ("textDocument", J.jObject [("uri", J.jString uri)]),
    ("position", J.jObject [("line", J.jInt line), ("character", J.jInt column)])
  ])

@test fun hoverSaysWhatATermIs () =
  let said = told [opening "file:///a.idl" "x : Int\nx = 1\n", hovering 1 "file:///a.idl" 1 4] serveServer in
  assertEq
    (M.andThen (J.path ["result", "contents", "value"]) (V.get said 1))
    (Just (J.jString "```idyll\nInt\n```"))
    "the 1 is an Int"

@test fun aNameNotInScopeIsWhereItIsWritten () =
  assertEq (firstAt (told [opening "file:///a.idl" "x : Int\nx = nope\n"] serveServer)) (Just (J.jInt 1, J.jInt 4)) "at nope"

fun asked (id : Int) (method : String) (uri : String) (line : Int) (column : Int) : Json =
  asking id method (J.jObject [
    ("textDocument", J.jObject [("uri", J.jString uri)]),
    ("position", J.jObject [("line", J.jInt line), ("character", J.jInt column)])
  ])

@test fun aDefinitionIsWhereANameIsBound () =
  let said = told [opening "file:///a.idl" "f : Int -> Int\nf n = n\nx = f 1\n", asked 1 "textDocument/definition" "file:///a.idl" 2 4] serveServer in
  let result = M.andThen (J.get "result") (V.get said 1) in
  let first = M.andThen (\r -> match r with | J.Json.Array xs -> V.get xs 0 | other -> Just other) result in
  assertEq
    (M.andThen (J.path ["range", "start", "line"]) first, M.andThen (J.path ["range", "start", "character"]) first)
    (Just (J.jInt 1), Just (J.jInt 0))
    "f's equation, which the renamer binds it at"

@test fun aNamesReferencesAreEveryPlaceItIsNamed () =
  let said = told [opening "file:///a.idl" "f : Int -> Int\nf n = n\nx = f (f 1)\n", asked 1 "textDocument/references" "file:///a.idl" 2 4] serveServer in
  assertEq
    (M.map (\r -> match r with | J.Json.Array xs -> V.len xs >= 3 | _ -> False) (M.andThen (J.get "result") (V.get said 1)))
    (Just True)
    "its signature and both uses, at least"

-- The labels of what a reply's result lists, each its `field`.
fun listed (field : String) (reply : Maybe Json) : [Json] =
  match M.andThen (J.get "result") reply with
  | Just (J.Json.Array xs) -> V.concatMap (\x -> match J.get field x with | Just l -> [l] | None -> []) xs
  | Just other ->
      (match J.get "items" other with
       | Just (J.Json.Array xs) -> V.concatMap (\x -> match J.get field x with | Just l -> [l] | None -> []) xs
       | _ -> [])
  | None -> []

@test fun completionOffersTheProgramsNamesAndThePreludes () =
  let said = told [opening "file:///a.idl" "double : Int -> Int\ndouble n = n + n\nx = do\n", asked 1 "textDocument/completion" "file:///a.idl" 2 6] serveServer in
  let labels = listed "label" (V.get said 1) in
  assertEq (V.elem (J.jString "double") labels, V.elem (J.jString "putStrLn") labels) (True, True) "double, and the prelude's putStrLn"

@test fun completionOffersTheVariablesInScope () =
  let begun = told [opening "file:///a.idl" "f : Int -> Int\nf count = let total = count + 1 in to\n", asked 1 "textDocument/completion" "file:///a.idl" 1 37] serveServer in
  let labels = listed "label" (V.get begun 1) in
  let a = assertEq (V.elem (J.jString "count") labels, V.elem (J.jString "total") labels) (True, True) "f's parameter, and the let's" in
  let unfinished = told [opening "file:///a.idl" "f : Int -> Int\nf count = count + \n", asked 1 "textDocument/completion" "file:///a.idl" 1 18] serveServer in
  assertEq (V.elem (J.jString "count") (listed "label" (V.get unfinished 1))) True "where the line stops"

@test fun completionAfterAModuleOffersWhatItGives () =
  let aliased = told [opening "file:///a.idl" "use Std.Collections.List as L\n\nxs : List Int\nxs = L.\n", asked 1 "textDocument/completion" "file:///a.idl" 3 7] serveServer in
  let labels = listed "label" (V.get aliased 1) in
  let a = assertEq (V.elem (J.jString "map") labels, V.elem (J.jString "xs") labels, V.elem (J.jString "putStrLn") labels) (True, False, False) "List's map, and nothing of the program's or the prelude's" in
  let b = assertEq (V.any (\d -> d != J.jString "") (listed "detail" (V.get aliased 1))) True "with their types" in
  let pathed = told [opening "file:///a.idl" "xs : List Int\nxs = Std.Collections.List.\n", asked 1 "textDocument/completion" "file:///a.idl" 1 26] serveServer in
  assertEq (V.elem (J.jString "map") (listed "label" (V.get pathed 1))) True "the module at that path in Std"

@test fun theOutlineIsTheProgramsOwnDeclarations () =
  let said = told [opening "file:///a.idl" "double : Int -> Int\ndouble n = n + n\n", asking 1 "textDocument/documentSymbol" (inFile "file:///a.idl")] serveServer in
  assertEq (listed "name" (V.get said 1)) [J.jString "double"] "double, and nothing of the prelude's"

@test fun aTypeErrorIsPublished () =
  assertEq (M.map (\n -> n > 0) (published (told [opening "file:///a.idl" "x : Bool\nx = 1\n"] serveServer))) (Just True) "what the checker said"

-- A package with path dependencies, one of them reached through another:
-- each is compiled, and the file's `use`s name those it depends on directly.
@test fun aFileIsCheckedAgainstItsDependencies () =
  let dir = "target/lsp-deps" in
  let a = createDirAll (dir ++ "/app/src") in
  let b = createDirAll (dir ++ "/util/src") in
  let c = createDirAll (dir ++ "/base/src") in
  let d = writeString (dir ++ "/base/Idyll.toml", "[package]\nname = \"Base\"\nversion = \"0.1.0\"\n") in
  let e = writeString (dir ++ "/base/src/Lib.idl", "@pub\none : Int\none = 1\n") in
  let f = writeString (dir ++ "/util/Idyll.toml", "[package]\nname = \"Util\"\n\n[dependencies]\nBase = { path = \"../base\" }\n") in
  let g = writeString (dir ++ "/util/src/Lib.idl", "use Base (one)\n\n@pub\nnext : Int -> Int\nnext n = n + one\n") in
  let h = writeString (dir ++ "/app/Idyll.toml", "[package]\nname = \"app\"\n\n[dependencies]\nUtil = { path = \"../util\" }\n") in
  let uri = "file://" ++ dir ++ "/app/src/Main.idl" in
  let fine = told [opening uri "use Util (next)\n\nx : Int\nx = next 2\n"] serveServer in
  let wrong = told [opening uri "use Util (next)\n\nx : Bool\nx = next 2\n"] serveServer in
  let reached = told [opening uri "use Base (one)\n\nx : Int\nx = one\n"] serveServer in
  let i = assertEq (published fine) (Just 0) "Util is a dependency of the package" in
  let j = assertEq (firstAt wrong) (Just (J.jInt 3, J.jInt 4)) "where it is in Main.idl" in
  let hovered = told [opening uri "use Util (next)\n\nx : Int\nx = next 2\n", hovering 1 uri 3 4] serveServer in
  let k = assertEq (M.andThen (J.path ["result", "contents", "value"]) (V.get hovered 1)) (Just (J.jString "```idyll\n(_ : [1] Int) -> Int\n```")) "Util's next, on hover" in
  assertEq (M.map (\n -> n > 0) (published reached)) (Just True) "Base is not one of its own dependencies"

-- A package on disk, its root module using another: checked alone, `Helper`
-- is no module; checked in its package, as the server checks a file the
-- editor opens, it is, and an error is where it is in the root's text.
@test fun aFileIsCheckedInItsPackage () =
  let dir = "target/lsp-package" in
  let a = createDirAll (dir ++ "/src") in
  let b = writeString (dir ++ "/Idyll.toml", "[package]\nname = \"lspcheck\"\nversion = \"0.1.0\"\n") in
  let c = writeString (dir ++ "/src/Helper.idl", "@pub\ndouble : Int -> Int\ndouble n = n + n\n") in
  let uri = "file://" ++ dir ++ "/src/Main.idl" in
  let fine = told [opening uri "use Helper (double)\n\nx : Int\nx = double 2\n"] serveServer in
  let wrong = told [opening uri "use Helper (double)\n\nx : Bool\nx = double 2\n"] serveServer in
  let d = assertEq (published fine) (Just 0) "Helper is a module of the package" in
  let e = assertEq (firstAt wrong) (Just (J.jInt 3, J.jInt 4)) "where it is in Main.idl" in
  let hovered = told [opening uri "use Helper (double)\n\nx : Int\nx = double 2\n", hovering 1 uri 3 4] serveServer in
  assertEq (M.andThen (J.path ["result", "contents", "value"]) (V.get hovered 1)) (Just (J.jString "```idyll\nInt -> Int\n```")) "Helper's double, on hover"
