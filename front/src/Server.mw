-- Idyll's language server (`lsp!`), `Idyll lsp`: on standard input and
-- output, over a session of the compiler's queries (`Session`), which
-- works out again only what an edit changed. It publishes what is wrong
-- with each open file, colours a file from its tree and from what each
-- name resolved to, and sets a file out as `Idyll fmt` does. Of its own it
-- answers a lens above each `@test`, to run it, and `idyll/ir`, a
-- definition in one of the compiler's IRs.

use Lingua (lsp!)
use Idyll.Session
use Idyll.Syntax (parseIdyll)
use Std.Exn (toResult)
use Std.Result.Result.*
use Lingua.Lsp (pathOf, Asked, rangeIn, rangeJson, lineStarts, uriOf, positionIn)
use Lingua.Lang (Meta)
use Std.String as S
use Idyll.Driver as D
use Idyll.Workspace as Ws
use Std.Path as Path
use Std.Fs (exists, readToString, readToStringOr, createDirAll, writeString)
use Std.Maybe as M
use Std.Collections.Vector as V
use Std.Char as Ch
use Std.Json as J

lsp! {
  pub Server "idyll" for Session
    | text = setSessionSource
    | diagnostics = diagnosticsOf
    | tree = treeOf
    | format = formatOf
    | hover = hoverAt
    | definition = definitionAt
    | references = referencesAt
    | completion = completionAt
    | symbols = symbolsOf
    | opened = openedIn
    | resolved = resolvedOf
    | requests = serverRequests
}

-- A file the editor opened: the package it is a module of found (an
-- `Idyll.toml` in a directory above it, its modules under `src`), and its
-- other modules read, so that what is wrong with it is what is wrong with
-- it in its package. A file in no package is a lone program.
fun openedIn db file (uri : String) =
  let path = pathOf uri in
  setSessionPackage db file (M.andThen (\root -> contextOf root path) (packageRoot (Path.parent path)))

-- The nearest directory from `dir` up with an `Idyll.toml` in it.
fun packageRoot (dir : Maybe String) : Maybe String ! { Fs | e } =
  match dir with
  | None -> None
  | Just d -> if exists (Path.join d "Idyll.toml") then Just d else (match Path.parent d with | Just up -> if up == d then None else packageRoot (Just up) | None -> None)

-- The package at `root`, as the file at `path` sees it: its name, the
-- file's module path, every other module, read, and every package it
-- reaches, read, by the same paths and lock file a build goes by.
fun contextOf (root : String) (path : String) : Maybe PackageContext ! { Fs | e } =
  let own = D.modulePathIn path in
  let manifest = readToStringOr "" (Path.join root "Idyll.toml") in
  let name = M.unwrapOr "Main" (Ws.manifestField "name" manifest) in
  let others = V.filter (\m -> fst m != own) (modulesAt root) in
  let dirs = D.dependencyDirs root root manifest in
  let found = V.foldl (\acc d -> packagesFrom root [root] acc d) [] dirs in
  Just (PackageContext { name, own, others, uses = namesIn dirs found, needs = V.map snd found })

-- A package's modules, read.
fun modulesAt (dir : String) : [([String], String)] ! { Fs | e } =
  let src = Path.join dir "src" in
  V.concatMap
    (\rel ->
      match readToString (Path.join src rel) with
      | Ok t -> [(D.modulePathIn (Path.join src rel), t)]
      | Err _ -> [])
    (D.idlFiles src [])

-- `done`, with the package at `dir` and what it reaches, each after those it
-- depends on. (`from`, the packages on the way here: a circle is a build's
-- to refuse, and must not stop the server.)
fun packagesFrom (root : String) (from : [String]) (done : [(String, Needed)]) (dir : String) =
  if V.any (\d -> fst d == dir) done or V.elem dir from then done
  else
    let manifest = readToStringOr "" (Path.join dir "Idyll.toml") in
    let dirs = D.dependencyDirs root dir manifest in
    let after = V.foldl (\acc d -> packagesFrom root (V.pushBack from dir) acc d) done dirs in
    let name = D.plainName (D.nameOfManifest dir manifest) in
    V.pushBack after (dir, Needed { name, modules = modulesAt dir, uses = namesIn dirs after })

-- The names of the packages at `dirs`, among those found.
fun namesIn (dirs : [String]) (found : [(String, Needed)]) : [String] =
  V.map (\(n : Needed) -> n.name) (V.map snd (V.filter (\f -> V.elem (fst f) dirs) found))

-- A query's answer, or `fallback` if it has none (an input never set).
fun answered fallback act = match toResult act with | Ok x -> x | Err _ -> fallback

-- The package a file is a module of, if the editor said where it is.
fun packageIn db file = answered None (\() -> M.map (\pc -> (pc, \u -> sessionDependencies db file)) (sessionPackage db file))

fun diagnosticsOf db file = answered [] (\() -> sessionProblems db file)

fun treeOf db file = answered (fst (parseIdyll "")) (\() -> fst (sessionParsed db file))

-- What the term at a place is: its type, as the checker found it, and,
-- of a name the file defines at the start of a line, the `--` comment above
-- its definition. A binder (a parameter, a `let`) is no term: on one, it is
-- the type the binder got, as its inlay hint says.
fun hoverAt db file at =
  answered None (\() ->
    let text = sessionSource db file in
    let named = answered None (\() -> namedAtIn text (packageIn db file) (sessionPrelude db 0) (\u -> sessionStd db 0) at) in
    let bound =
      match named with
      | Just (Meta.Meta d e, _) ->
          if d <= at and at <= e then M.map (\h -> (Meta.Meta d e, snd h)) (V.find (\h -> fst h == e) (answered [] (\() -> sessionHints db file)))
          else None
      | None -> None
    in
    -- a name the program or the prelude declares: its signature, as the file
    -- writes it if it does, else as the checker has it; a signature's own
    -- name, which is no occurrence, too
    let word = wordAt text at in
    let written = signatureIn text word in
    let declared =
      match bound with
      | Just _ -> None
      | None ->
          if S.isEmpty word then None
          else
            (match answered None (\() -> declaredAtIn text (packageIn db file) (sessionPrelude db 0) (\u -> sessionStd db 0) at word) with
             | Just (place, shown) -> Just (place, M.unwrapOr shown written)
             | None ->
                 (match (written, wordStart text at) with
                  | (Just sig, Just from) -> if startsLine text from then Just (Meta.Meta from (from + S.byteLength word), sig) else None
                  | _ -> None))
    in
    let typed =
      match (bound, declared) with
      | (Just b, _) -> Just b
      | (_, Just d) -> Just d
      | _ -> typeAtIn text (packageIn db file) (sessionPrelude db 0) (\u -> sessionStd db 0) at
    in
    let doc = match named with | Just (Meta.Meta d _, _) -> if startsLine text d then docAbove text d else "" | None -> "" in
    M.map (\p -> match p with | (place, ty) -> (place, "```idyll\n${ty}\n```" ++ (if S.isEmpty doc then "" else "\n\n" ++ doc))) typed)

-- The signature `text` gives `name`, as it is written: its line, and the
-- lines after it that go on with it (indented).
fun signatureIn (text : String) (name : String) : Maybe String =
  if S.isEmpty name then None
  else
    let lines = V.map (\l -> S.trimEnd l) (S.split "\n" text) in
    match V.find (\i -> S.startsWith "${name} :" (V.getOr "" lines i)) (V.range 0 (V.len lines)) with
    | Just i ->
        let more = V.takeWhile (\l -> S.startsWith " " l or S.startsWith "\t" l) (V.drop lines (i + 1)) in
        Just (S.join "\n" (V.pushFront more (V.getOr "" lines i)))
    | None -> None

-- Where the name byte `at` of `text` is in starts, if it is in one.
fun wordStart (text : String) (at : Int) : Maybe Int =
  let left = V.takeWhile isWordChar (V.reverse (S.chars (S.take text at))) in
  if S.isEmpty (wordAt text at) then None else Just (at - S.byteLength (S.fromChars left))

-- Whether byte `at` of `text` starts a line: where a declaration is.
fun startsLine (text : String) (at : Int) : Bool = at == 0 or S.drop (S.take text at) (at - 1) == "\n"

-- The `--` comment just above the line byte `at` is on, its markers taken
-- off: what a definition says of itself. Attributes (`@test`) between the
-- comment and the definition are passed over.
fun docAbove (text : String) (at : Int) : String =
  let lines = S.split "\n" (S.take text at) in
  let above0 = V.reverse (V.take lines (V.len lines - 1)) in
  -- (a definition is bound at its equation: its signature is passed over)
  let above = if isSignature (V.getOr "" above0 0) then V.drop above0 1 else above0 in
  let kept =
    V.foldl
      (\acc l ->
        match acc with
        | (ks, going) ->
            let t = S.trim l in
            if not going then acc
            else if S.startsWith "--" t then (V.pushBack ks (S.trim (S.drop t 2)), True)
            else if S.startsWith "@" t then acc
            else (ks, False))
      ([], True)
      above
  in S.join "\n" (V.reverse (fst kept))

-- Where the name at a place is defined: where the program first binds it,
-- its equation or its binder.
fun definitionAt db file at =
  answered [] (\() ->
    match namedAtIn (sessionSource db file) (packageIn db file) (sessionPrelude db 0) (\u -> sessionStd db 0) at with
    | Just (d, _) -> [(file, d)]
    | None -> [])

-- Every place the name at a place is named.
fun referencesAt db file at =
  answered [] (\() ->
    match namedAtIn (sessionSource db file) (packageIn db file) (sessionPrelude db 0) (\u -> sessionStd db 0) at with
    | Just (_, places) -> V.map (\p -> (file, p)) places
    | None -> [])

-- What a name being written may be: the program's own names and the
-- prelude's, each with its type.
fun completionAt db file at =
  answered [] (\() -> completionsInPackage (sessionSource db file) (packageIn db file) (sessionPrelude db 0) (\u -> sessionStd db 0) at)

-- The file's own declarations, for an outline.
fun symbolsOf db file =
  answered [] (\() -> symbolsInPackage (sessionSource db file) (packageIn db file) (sessionPrelude db 0) (\u -> sessionStd db 0))

-- Whether a line is a signature, `name : type`.
fun isSignature (line : String) : Bool =
  let words = S.split " " line in
  not (S.startsWith " " line) and V.len words > 1 and V.getOr "" words 1 == ":"

-- The file set out; as it is, if it cannot be.
fun formatOf db file = answered (answered "" (\() -> sessionSource db file)) (\() -> sessionFormatted db file)

-- What each name in the file resolved to, for its colours.
fun resolvedOf db file = answered [] (\() -> sessionResolved db file)

-- What Idyll's server answers itself: a lens above each `@test`, and a
-- definition in one of the compiler's IRs.
def serverRequests =
  [
    ("textDocument/codeLens", lensesOf),
    ("textDocument/inlayHint", hintsOf),
    ("idyll/ir", irAsked)
  ]

-- The type each parameter and `let` with none written got, after its
-- name.
fun hintsOf db (a : Asked) =
  J.jArray
    (V.map
      (\h ->
        match h with
        | (at, shown) ->
            J.jObject [
              ("position", positionIn a at),
              ("label", J.jString ": ${shown}"),
              ("kind", J.jInt 1),
              ("paddingLeft", J.jBool False)
            ])
      (answered [] (\() -> sessionHints db a.file)))

-- A "Test" lens above each `@test`, which runs that one test, by its whole
-- name (`Module.test`, a bare name in the package's root module), as
-- `idyll test --exact` takes it.
fun lensesOf db (a : Asked) =
  let own = answered [] (\() -> M.unwrapOr [] (M.map (\(pc : PackageContext) -> pc.own) (sessionPackage db a.file))) in
  J.jArray
    (V.map
      (\t ->
        match t with
        | (name, from, upto) ->
            let whole = if V.isEmpty own then name else S.join "." (V.pushBack own name) in
            J.jObject [
              ("range", rangeIn a (Meta.Meta from upto)),
              ("command", J.jObject [
                ("title", J.jString "\u{25B6} Test"),
                ("command", J.jString "idyll.testFunction"),
                ("arguments", J.jArray [J.jObject [("uri", J.jString (uriOf a.docs a.file)), ("test", J.jString whole)]])
              ])
            ])
      (testsIn a.text))

-- Each `@test` of a file: the name the definition after it binds, and the
-- bytes of that definition's first line.
@pub fun testsIn (text : String) : [(String, Int, Int)] =
  let lines = S.split "\n" text in
  let starts = V.foldl (\acc l -> V.pushBack acc (M.unwrapOr 0 (V.last acc) + S.byteLength l + 1)) [0] lines in
  V.concatMap
    (\i ->
      let l = S.trim (V.getOr "" lines i) in
      if l == "@test" or S.startsWith "@test " l then
        (match declarationAfter lines (i + 1) with
         | Just j ->
             let line = V.getOr "" lines j in
             let name = V.getOr "" (S.split ":" (V.getOr "" (S.split " " (S.trim line)) 0)) 0 in
             if S.isEmpty name then [] else [(name, V.getOr 0 starts j, V.getOr 0 starts j + S.byteLength line)]
         | None -> [])
      else [])
    (V.range 0 (V.len lines))

-- The first line from `i` that is neither blank, nor a comment, nor an
-- attribute.
fun declarationAfter (lines : [String]) (i : Int) : Maybe Int =
  if i >= V.len lines then None
  else
    let t = S.trim (V.getOr "" lines i) in
    if S.isEmpty t or S.startsWith "--" t or S.startsWith "@" t then declarationAfter lines (i + 1) else Just i

-- `idyll/ir`: the definition the cursor is in, as `ir` (`hir` or `cut`)
-- makes it, and where the name the cursor is on is in that text -- what an
-- editor shows beside the source, and marks.
fun irAsked db (a : Asked) =
  let ir = M.unwrapOr "cut" (M.andThen J.asString (J.get "ir" a.params)) in
  let defs = symbolsOf db a.file in
  let around = V.foldl (\best d -> match d with | (n, _, Meta.Meta s _) -> if s <= a.offset then Just n else best) None defs in
  match around with
  | None -> J.jNull ()
  | Just name ->
      let whole = answered "(error)" (\() -> if ir == "hir" then sessionHirShown db a.file else sessionCutShown db a.file) in
      let shown = definitionIn ir name whole in
      let word = wordAt a.text a.offset in
      let starts = lineStarts shown in
      J.jObject [
        ("text", J.jString shown),
        ("focus", J.jArray (V.map (\m -> rangeJson shown starts m) (if S.isEmpty word then [] else namedIn shown word)))
      ]

-- What of `whole`, the file as one IR, is the top-level definition `name`:
-- in Cut, each `def` of it (a function lifted out of it among them), in
-- the HIR its `bind`. All of it if it says nothing of `name`.
@pub fun definitionIn (ir : String) (name : String) (whole : String) : String =
  -- (the HIR is a line a declaration, Cut a paragraph a def)
  let sep = if ir == "hir" then "\n" else "\n\n" in
  let mine =
    V.filter
      (\b ->
        if ir == "hir" then S.startsWith "(bind ${name}@" b or S.contains "(bind ${name}@" b
        else V.any (\l -> S.startsWith "def " l and (S.contains "/${name} " l or S.contains "/${name}." l)) (S.split "\n" b))
      (S.split sep whole)
  in
  if V.isEmpty mine then whole else S.join sep mine

-- The name the byte `at` of `text` is in, if it is in one.
fun wordAt (text : String) (at : Int) : String =
  let before = V.reverse (S.chars (S.take text at)) in
  let after = S.chars (S.drop text at) in
  let left = V.reverse (V.takeWhile isWordChar before) in
  let right = V.takeWhile isWordChar after in
  S.fromChars (V.append left right)

fun isWordChar (c : Char) : Bool = Ch.isAlphaNum c or c == '_' or c == '\''

-- Where `word` is named in an IR's text: on its own, or as Cut and the HIR
-- write a variable, `word_12` and `word@12`.
@pub fun namedIn (text : String) (word : String) : [Meta] =
  let n = S.byteLength word in
  V.concatMap
    (\at ->
      let before = V.last (S.chars (S.take text at)) in
      let next = V.head (S.chars (S.drop text (at + n))) in
      let startsHere = match before with | Just c -> not (isWordChar c) | None -> True in
      let endsHere = match next with | Just c -> not (isWordChar c) or c == '_' | None -> True in
      if startsHere and endsHere then [Meta.Meta at (at + n)] else [])
    (indicesOf word text 0)

-- Every byte of `text` from `from` that `word` starts at.
fun indicesOf (word : String) (text : String) (from : Int) : [Int] =
  match S.indexOfFrom word text from with
  | Just at -> V.pushFront (indicesOf word text (at + 1)) at
  | None -> []

-- --- the server, told what an editor would tell it --------------------------------

use Lingua.Lsp (told)
use Std.Json (Json)
use Std.Json as J
use Std.Collections.Vector as V
use Std.Maybe as M
use Std.Test (assertEq)

fun message (fields : [(String, Json)]) : Json = J.jObject (V.pushFront fields ("jsonrpc", J.jString "2.0"))

fun asking (id : Int) (method : String) (params : Json) : Json =
  message [("id", J.jInt id), ("method", J.jString method), ("params", params)]

fun inFile (uri : String) : Json = J.jObject [("textDocument", J.jObject [("uri", J.jString uri)])]

fun opening (uri : String) (text : String) : Json =
  message [
    ("method", J.jString "textDocument/didOpen"),
    ("params", J.jObject [("textDocument", J.jObject [("uri", J.jString uri), ("text", J.jString text)])])
  ]

-- How many diagnostics the first thing the server said, after an edit,
-- published.
fun published (said : [Json]) : Maybe Int =
  M.andThen (\d -> match d with | J.Json.Array xs -> Just (V.len xs) | _ -> None) (M.andThen (J.path ["params", "diagnostics"]) (V.get said 0))

@test fun aProgramThatChecksHasNothingWrong () =
  assertEq (published (told [opening "file:///a.idl" "x : Int\nx = 1\n"] serveServer)) (Just 0) "nothing to say"

@test fun aSyntaxErrorIsPublished () =
  assertEq (M.map (\n -> n > 0) (published (told [opening "file:///a.idl" "x = (1 +\n"] serveServer))) (Just True) "what the parser said"

-- Where the first diagnostic published starts: its line and column.
fun firstAt (said : [Json]) : Maybe (Json, Json) =
  match V.get said 0 with
  | Just m ->
      (match (J.path ["params", "diagnostics"] m) with
       | Just (J.Json.Array ds) ->
           (match V.get ds 0 with
            | Just d ->
                (match (J.path ["range", "start", "line"] d, J.path ["range", "start", "character"] d) with
                 | (Just l, Just c) -> Just (l, c)
                 | _ -> None)
            | None -> None)
       | _ -> None)
  | None -> None

@test fun aTypeErrorIsWhereItWasFound () =
  assertEq (firstAt (told [opening "file:///a.idl" "x : Bool\nx = 1\n"] serveServer)) (Just (J.jInt 1, J.jInt 4)) "at the 1, not the start of the file"

fun hovering (id : Int) (uri : String) (line : Int) (column : Int) : Json =
  asking id "textDocument/hover" (J.jObject [
    ("textDocument", J.jObject [("uri", J.jString uri)]),
    ("position", J.jObject [("line", J.jInt line), ("character", J.jInt column)])
  ])

@test fun hoverSaysWhatATermIs () =
  let said = told [opening "file:///a.idl" "x : Int\nx = 1\n", hovering 1 "file:///a.idl" 1 4] serveServer in
  assertEq
    (M.andThen (J.path ["result", "contents", "value"]) (V.get said 1))
    (Just (J.jString "```idyll\nInt\n```"))
    "the 1 is an Int"

@test fun aNameNotInScopeIsWhereItIsWritten () =
  assertEq (firstAt (told [opening "file:///a.idl" "x : Int\nx = nope\n"] serveServer)) (Just (J.jInt 1, J.jInt 4)) "at nope"

fun asked (id : Int) (method : String) (uri : String) (line : Int) (column : Int) : Json =
  asking id method (J.jObject [
    ("textDocument", J.jObject [("uri", J.jString uri)]),
    ("position", J.jObject [("line", J.jInt line), ("character", J.jInt column)])
  ])

@test fun aDefinitionIsWhereANameIsBound () =
  let said = told [opening "file:///a.idl" "f : Int -> Int\nf n = n\nx = f 1\n", asked 1 "textDocument/definition" "file:///a.idl" 2 4] serveServer in
  let result = M.andThen (J.get "result") (V.get said 1) in
  let first = M.andThen (\r -> match r with | J.Json.Array xs -> V.get xs 0 | other -> Just other) result in
  assertEq
    (M.andThen (J.path ["range", "start", "line"]) first, M.andThen (J.path ["range", "start", "character"]) first)
    (Just (J.jInt 1), Just (J.jInt 0))
    "f's equation, which the renamer binds it at"

@test fun aNamesReferencesAreEveryPlaceItIsNamed () =
  let said = told [opening "file:///a.idl" "f : Int -> Int\nf n = n\nx = f (f 1)\n", asked 1 "textDocument/references" "file:///a.idl" 2 4] serveServer in
  assertEq
    (M.map (\r -> match r with | J.Json.Array xs -> V.len xs >= 3 | _ -> False) (M.andThen (J.get "result") (V.get said 1)))
    (Just True)
    "its signature and both uses, at least"

-- The labels of what a reply's result lists, each its `field`.
fun listed (field : String) (reply : Maybe Json) : [Json] =
  match M.andThen (J.get "result") reply with
  | Just (J.Json.Array xs) -> V.concatMap (\x -> match J.get field x with | Just l -> [l] | None -> []) xs
  | Just other ->
      (match J.get "items" other with
       | Just (J.Json.Array xs) -> V.concatMap (\x -> match J.get field x with | Just l -> [l] | None -> []) xs
       | _ -> [])
  | None -> []

@test fun completionOffersTheProgramsNamesAndThePreludes () =
  let said = told [opening "file:///a.idl" "double : Int -> Int\ndouble n = n + n\nx = do\n", asked 1 "textDocument/completion" "file:///a.idl" 2 6] serveServer in
  let labels = listed "label" (V.get said 1) in
  assertEq (V.elem (J.jString "double") labels, V.elem (J.jString "putStrLn") labels) (True, True) "double, and the prelude's putStrLn"

@test fun completionOffersTheVariablesInScope () =
  let begun = told [opening "file:///a.idl" "f : Int -> Int\nf count = let total = count + 1 in to\n", asked 1 "textDocument/completion" "file:///a.idl" 1 37] serveServer in
  let labels = listed "label" (V.get begun 1) in
  let a = assertEq (V.elem (J.jString "count") labels, V.elem (J.jString "total") labels) (True, True) "f's parameter, and the let's" in
  let unfinished = told [opening "file:///a.idl" "f : Int -> Int\nf count = count + \n", asked 1 "textDocument/completion" "file:///a.idl" 1 18] serveServer in
  assertEq (V.elem (J.jString "count") (listed "label" (V.get unfinished 1))) True "where the line stops"

@test fun completionAfterAModuleOffersWhatItGives () =
  let aliased = told [opening "file:///a.idl" "use Std.Collections.List as L\n\nxs : List Int\nxs = L.\n", asked 1 "textDocument/completion" "file:///a.idl" 3 7] serveServer in
  let labels = listed "label" (V.get aliased 1) in
  let a = assertEq (V.elem (J.jString "map") labels, V.elem (J.jString "xs") labels, V.elem (J.jString "putStrLn") labels) (True, False, False) "List's map, and nothing of the program's or the prelude's" in
  let b = assertEq (V.any (\d -> d != J.jString "") (listed "detail" (V.get aliased 1))) True "with their types" in
  let pathed = told [opening "file:///a.idl" "xs : List Int\nxs = Std.Collections.List.\n", asked 1 "textDocument/completion" "file:///a.idl" 1 26] serveServer in
  assertEq (V.elem (J.jString "map") (listed "label" (V.get pathed 1))) True "the module at that path in Std"

@test fun theOutlineIsTheProgramsOwnDeclarations () =
  let said = told [opening "file:///a.idl" "double : Int -> Int\ndouble n = n + n\n", asking 1 "textDocument/documentSymbol" (inFile "file:///a.idl")] serveServer in
  assertEq (listed "name" (V.get said 1)) [J.jString "double"] "double, and nothing of the prelude's"

@test fun hoverSaysWhatADefinitionSaysOfItself () =
  let text = "-- Twice n.\ndouble : Int -> Int\ndouble n = n + n\n\nx = double 1\n" in
  let said = told [opening "file:///a.idl" text, hovering 1 "file:///a.idl" 4 5] serveServer in
  assertEq
    (M.andThen (J.path ["result", "contents", "value"]) (V.get said 1))
    (Just (J.jString "```idyll\ndouble : Int -> Int\n```\n\nTwice n."))
    "its type, then its comment"

@test fun aParameterIsTheTypeItGot () =
  let text = "-- Twice n.\ndouble : Int -> Int\ndouble n = n + n\n" in
  let said = told [opening "file:///a.idl" text, hovering 1 "file:///a.idl" 2 7] serveServer in
  assertEq
    (M.andThen (J.path ["result", "contents", "value"]) (V.get said 1), M.andThen (J.path ["result", "range", "start", "character"]) (V.get said 1))
    (Just (J.jString "```idyll\nInt\n```"), Just (J.jInt 7))
    "n is an Int, and says nothing of double's comment"

@test fun aDefinedNameIsWhatItsSignatureSays () =
  let text = "f : (n : Int) -> Int\nf n = n + 1\n\nx : Int\nx = f 2\n" in
  let said = told [opening "file:///a.idl" text, hovering 1 "file:///a.idl" 4 4, hovering 2 "file:///a.idl" 0 0] serveServer in
  assertEq
    (M.andThen (J.path ["result", "contents", "value"]) (V.get said 1), M.andThen (J.path ["result", "contents", "value"]) (V.get said 2))
    (Just (J.jString "```idyll\nf : (n : Int) -> Int\n```"), Just (J.jString "```idyll\nf : (n : Int) -> Int\n```"))
    "f where it is used and where it is declared"

@test fun everyLineOfADefinitionColoursItsName () =
  let text = "o : Bool -> Int\no True = 1\no False = 0\n" in
  let said = told [opening "file:///a.idl" text, asking 1 "textDocument/semanticTokens/full" (inFile "file:///a.idl")] serveServer in
  -- (each line's first token, deltaLine 1 or the first: its class)
  let firsts =
    match M.andThen (J.path ["result", "data"]) (V.get said 1) with
    | Just (J.Json.Array xs) ->
        V.concatMap
          (\i -> if i % 5 == 0 and (i == 0 or J.asInt (V.getOr (J.jInt 0) xs i) == Just 1) then M.unwrapOr [] (M.map (\c -> [c]) (M.andThen J.asInt (V.get xs (i + 3)))) else [])
          (V.range 0 (V.len xs))
    | _ -> []
  in
  assertEq firsts [3, 3, 3] "o a function on each line"

@test fun aCommentIsTheDefinitionsOwn () =
  assertEq
    (docAbove "-- a\n\n-- Twice n.\n-- (or more)\n@test\ndouble : Int -> Int\ndouble n = n + n\n" 50)
    "Twice n.\n(or more)"
    "the comment above, past the attribute and the signature, not the one before the blank line"

@test fun aParameterSaysTheTypeItGot () =
  let text = "f : Int -> Int\nf n = let m = n + 1 in m\n" in
  let said = told [opening "file:///a.idl" text, asking 1 "textDocument/inlayHint" (inFile "file:///a.idl")] serveServer in
  assertEq (listed "label" (V.get said 1)) [J.jString ": Int", J.jString ": Int"] "n and m are Ints"

@test fun aTestHasALensToRunIt () =
  let text = "x : Int\nx = 1\n\n@test\nones : () -> ()\nones u = ()\n" in
  let said = told [opening "file:///a.idl" text, asking 1 "textDocument/codeLens" (inFile "file:///a.idl")] serveServer in
  let lens = M.andThen (\r -> match r with | J.Json.Array xs -> V.get xs 0 | _ -> None) (M.andThen (J.get "result") (V.get said 1)) in
  assertEq
    (M.andThen (J.path ["command", "arguments"]) lens, M.andThen (J.path ["range", "start", "line"]) lens)
    (Just (J.jArray [J.jObject [("uri", J.jString "file:///a.idl"), ("test", J.jString "ones")]]), Just (J.jInt 4))
    "above the definition after the @test, by its whole name"

@test fun theTestsOfAFileAreTheDefinitionsAfterTest () =
  assertEq
    (V.map (\t -> match t with | (n, _, _) -> n) (testsIn "@test\na : () -> ()\na u = ()\n\n@test\n-- why\nb : () -> ()\nb u = ()\nc = 1\n"))
    ["a", "b"]
    "a and b, not c"

fun irAt (id : Int) (uri : String) (line : Int) (column : Int) (ir : String) : Json =
  asking id "idyll/ir" (J.jObject [
    ("textDocument", J.jObject [("uri", J.jString uri)]),
    ("position", J.jObject [("line", J.jInt line), ("character", J.jInt column)]),
    ("ir", J.jString ir)
  ])

@test fun aDefinitionIsShownInCut () =
  let text = "double : Int -> Int\ndouble n = n + n\n\nx : Int\nx = double 21\n" in
  let said = told [opening "file:///a.idl" text, irAt 1 "file:///a.idl" 1 7 "cut"] serveServer in
  let shown = M.unwrapOr "" (M.andThen J.asString (M.andThen (J.path ["result", "text"]) (V.get said 1))) in
  let focus = M.andThen (J.path ["result", "focus"]) (V.get said 1) in
  assertEq
    (S.startsWith "def " shown and S.contains "/double " shown and not (S.contains "/x " shown), M.map (\f -> match f with | J.Json.Array xs -> V.len xs > 0 | _ -> False) focus)
    (True, Just True)
    "double's def and not x's, with n marked in it"

@test fun aNameIsFoundInAnIrAsItIsWritten () =
  assertEq
    (namedIn "def a/f (n_75: i64; k_76: ptr) = <n_75 | k_76> nn n" "n")
    [Meta.Meta 9 10, Meta.Meta 34 35, Meta.Meta 50 51]
    "n_75 twice and n alone, not nn"

-- Each token's class in what the server says to colour, as the protocol
-- encodes them: five numbers a token, its class the fourth.
fun classes (reply : Maybe Json) : [Int] =
  match M.andThen (J.path ["result", "data"]) reply with
  | Just (J.Json.Array xs) ->
      V.concatMap
        (\i -> if i % 5 == 3 then (match V.get xs i with | Just j -> M.unwrapOr [] (M.map (\n -> [n]) (J.asInt j)) | None -> []) else [])
        (V.range 0 (V.len xs))
  | _ -> []

@test fun aTypeAndAConstructorAreColouredApart () =
  let text = "f : Maybe Int -> Int\nf m = case m of\n  Just x -> x\n  Nothing -> 0\n" in
  let said = told [opening "file:///a.idl" text, asking 1 "textDocument/semanticTokens/full" (inFile "file:///a.idl")] serveServer in
  let cs = classes (V.get said 1) in
  -- (`type` is the protocol's class 1, `enumMember` 2, `function` 3)
  assertEq (V.elem 1 cs, V.elem 2 cs, V.elem 3 cs) (True, True, True) "Maybe a type, Just a constructor, f a function"

@test fun aTypeErrorIsPublished () =
  assertEq (M.map (\n -> n > 0) (published (told [opening "file:///a.idl" "x : Bool\nx = 1\n"] serveServer))) (Just True) "what the checker said"

-- A package with path dependencies, one of them reached through another:
-- each is compiled, and the file's `use`s name those it depends on directly.
@test fun aFileIsCheckedAgainstItsDependencies () =
  let dir = "target/lsp-deps" in
  let a = createDirAll (dir ++ "/app/src") in
  let b = createDirAll (dir ++ "/util/src") in
  let c = createDirAll (dir ++ "/base/src") in
  let d = writeString (dir ++ "/base/Idyll.toml", "[package]\nname = \"Base\"\nversion = \"0.1.0\"\n") in
  let e = writeString (dir ++ "/base/src/Lib.idl", "@pub\none : Int\none = 1\n") in
  let f = writeString (dir ++ "/util/Idyll.toml", "[package]\nname = \"Util\"\n\n[dependencies]\nBase = { path = \"../base\" }\n") in
  let g = writeString (dir ++ "/util/src/Lib.idl", "use Base (one)\n\n@pub\nnext : Int -> Int\nnext n = n + one\n") in
  let h = writeString (dir ++ "/app/Idyll.toml", "[package]\nname = \"app\"\n\n[dependencies]\nUtil = { path = \"../util\" }\n") in
  let uri = "file://" ++ dir ++ "/app/src/Main.idl" in
  let fine = told [opening uri "use Util (next)\n\nx : Int\nx = next 2\n"] serveServer in
  let wrong = told [opening uri "use Util (next)\n\nx : Bool\nx = next 2\n"] serveServer in
  let reached = told [opening uri "use Base (one)\n\nx : Int\nx = one\n"] serveServer in
  let i = assertEq (published fine) (Just 0) "Util is a dependency of the package" in
  let j = assertEq (firstAt wrong) (Just (J.jInt 3, J.jInt 4)) "where it is in Main.idl" in
  let hovered = told [opening uri "use Util (next)\n\nx : Int\nx = next 2\n", hovering 1 uri 3 4] serveServer in
  let k = assertEq (M.andThen (J.path ["result", "contents", "value"]) (V.get hovered 1)) (Just (J.jString "```idyll\n(_ : [1] Int) -> Int\n```")) "Util's next, on hover" in
  -- (Std, named by this text alone: what it depends on is compiled after it)
  let withStd = told [opening uri "use Util (next)\nuse Std.Maybe (withDefault)\n\nx : Int\nx = withDefault (next 2) Nothing\n"] serveServer in
  let l = assertEq (published withStd) (Just 0) "Std and Util both" in
  assertEq (M.map (\n -> n > 0) (published reached)) (Just True) "Base is not one of its own dependencies"

-- A package on disk, its root module using another: checked alone, `Helper`
-- is no module; checked in its package, as the server checks a file the
-- editor opens, it is, and an error is where it is in the root's text.
@test fun aFileIsCheckedInItsPackage () =
  let dir = "target/lsp-package" in
  let a = createDirAll (dir ++ "/src") in
  let b = writeString (dir ++ "/Idyll.toml", "[package]\nname = \"lspcheck\"\nversion = \"0.1.0\"\n") in
  let c = writeString (dir ++ "/src/Helper.idl", "@pub\ndouble : Int -> Int\ndouble n = n + n\n") in
  let uri = "file://" ++ dir ++ "/src/Main.idl" in
  let fine = told [opening uri "use Helper (double)\n\nx : Int\nx = double 2\n"] serveServer in
  let wrong = told [opening uri "use Helper (double)\n\nx : Bool\nx = double 2\n"] serveServer in
  let d = assertEq (published fine) (Just 0) "Helper is a module of the package" in
  let e = assertEq (firstAt wrong) (Just (J.jInt 3, J.jInt 4)) "where it is in Main.idl" in
  let hovered = told [opening uri "use Helper (double)\n\nx : Int\nx = double 2\n", hovering 1 uri 3 4] serveServer in
  assertEq (M.andThen (J.path ["result", "contents", "value"]) (V.get hovered 1)) (Just (J.jString "```idyll\ndouble : Int -> Int\n```")) "Helper's double, on hover: its signature"
