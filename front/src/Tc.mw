-- The type checker's state: the metacontext, and what else checking a
-- program keeps, as `Checker` holds it in `compiler/idyllic-typecheck`.
--
-- Solving a metavariable must change what every value that mentions it
-- means at once, which a cell of the metacontext gives: `Eval.force` looks a
-- solution up whenever it meets a metavariable's head.

use Std.Macro (Reflect)
use Idyll.Rename (HirArena, HirExpr, freezeHir, newHirBuilder)
use Idyll.Elab (Cx)
use Idyll.Usage (Usage)
use Idyll.Usage as U
use Std.St (runSt)
use Idyll.Value (Value, Env, Poly)
use Idyll.Core (Core)
use Idyll.Hir (Literal, Ident)
use Idyll.Ctx (Ctx)
use Std.Collections.Vector as V
use Std.Collections.HashMap as Hm
use Std.Collections.HashMap (HashMap)
use Std.Maybe.Maybe.*

-- Where a metavariable came from: a hole the program wrote, or something
-- the checker had to work out, said in words for a message.
@pub data Origin = Hole | Inferred String

-- The type of a metavariable, in the context it was made in: the name and
-- type of every slot of that context, the levels of the bound variables it
-- is applied to, and its type.
@pub data MetaTy = MetaTy [(String, Value)] [Int] Value

-- A metavariable: where it was made (a node of the HIR), where it came
-- from, and its type if that is known.
@pub data MetaInfo = MetaInfo Int Origin (Maybe MetaTy)

-- A use that had to fit a grade still being worked out: at what length of
-- context, what was used, what was allowed, and whether it is a field's.
@pub data Waiting = Waiting Int Poly Value Bool

@pub data Meta = Unsolved MetaInfo | Solved Value MetaInfo

-- A `_` the program wrote, kept to be reported at the end, when what fills
-- it is known: the context's length, the metavariable applied to its
-- spine, and its type.
@pub data HoleAt = HoleAt Int Value Value

-- A question kept for later: at a context's length, a term of type
-- `actual` where `expected` was wanted, which neither unified nor failed
-- for good, one being stuck on a metavariable applied to something.
@pub data Postponed = Postponed Int Value Value

-- What is known of a constructor: its name, its data type's unique, its
-- position among the type's constructors, how many erased arguments come
-- first (the type's parameters, then its own implicit ones), and how many
-- fields follow.
@derive(Reflect)
@pub data CtorInfo = CtorInfo String Int Int Int Int

-- What is known of an effect: its name, its parameters' kinds, and its
-- operations in order.
@derive(Reflect)
@pub data EffectInfo = EffectInfo String [Core] [Int]

-- What is known of an operation: its name, its effect's unique, its place
-- among the effect's operations, how many erased arguments come first (the
-- effect's parameters, then its own implicit ones), how many it takes after
-- those, and whether a handler may resume it more than once (`@many`).
@derive(Reflect)
@pub data OpInfo = OpInfo String Int Int Int Int Bool

@pub record Tc = {
  -- the renamed program being checked, whose tables everything reads
  hir : Ref HirArena,
  -- the elaborating pass's function for an expression (`Elab.install`)
  elab : Ref (Cx -> HirExpr -> (Core, Value, Usage) ! { Mut }),
  metas : Ref [Meta],
  -- the type of every constant (a data type, a constructor, a recursive
  -- definition), by its unique
  constants : Ref (HashMap Int Value),
  -- the values of other packages' definitions that the types may see, by
  -- unique: what such a constant is (`Compiled`)
  globals : Ref (HashMap Int Value),
  -- what is wrong, a line each, for now
  problems : Ref [String],
  -- the row variables made to keep a solved row open for more, each with
  -- how many arguments it is applied to: closed to the empty row when the
  -- definition they were made in has been checked, if nothing filled them
  opened : Ref [(Int, Int)],
  -- the metavariables a solution met applied to variables it may not
  -- mention, with which of their arguments it may: to be pruned of the
  -- others, and the solution tried again (see `Unify.solve`)
  prunes : Ref [(Int, [Bool])],
  -- the grades being worked out, of the parameters that say none in a module
  -- that is not linear, with the constraints that waited on each (see
  -- `Elab.settleGrade`)
  inferred : Ref (HashMap Int [Waiting]),
  -- the joins of two alternatives' uses that mention a grade still being
  -- worked out, each standing for `join(p, q)` until it can be (see
  -- `Elab.joinUsage`), in the order they were made
  joins : Ref [(Int, Poly, Poly)],
  -- how many of the explicit arrows ahead are a definition's parameters, on
  -- its signature's spine (or its lambdas): given to the next term inferred,
  -- which hands it to its `Pi` or `Lam` as `spineHere`
  inferSpine : Ref Int,
  spineHere : Ref Int,
  -- what was wrong, by the name the Rust checker gives the kind of error
  errors : Ref [String],
  holes : Ref [HoleAt],
  postponed : Ref [Postponed],
  -- whether the definition being checked is in a linear module, where an
  -- unannotated binder is used once
  linear : Ref Bool,
  -- how many `let`s deep the checker is: none is the top level
  lets : Ref Int,
  -- what the program uses that this checker cannot check yet; a program
  -- with anything here is not compared
  unsupported : Ref [String],
  -- the declared effects and their operations, by unique
  effects : Ref (HashMap Int EffectInfo),
  ops : Ref (HashMap Int OpInfo),
  -- the `nil` and `cons` of each data type declared `@seq`
  seqs : Ref (HashMap Int (Int, Int)),
  -- the natives, by the names they are declared by
  nativeNames : Ref (HashMap String Int),
  -- the prelude's `List`, which a sequence is with nothing to say otherwise
  list : Ref Int,
  -- what the program declares, with its type, as the REPL lists it: the
  -- unique, the name (`Nat.Z` for a constructor), the type
  declared : Ref [(Int, String, Core)],
  -- the data types and native types, by unique, and for each, which of its
  -- parameters it uses strictly positively
  datas : Ref (HashMap Int [Int]),
  ctors : Ref (HashMap Int CtorInfo),
  -- the unique the next slot no name refers to is charged to, counting down
  -- from where no name's unique is
  nextKey : Ref Int,
  -- the recursive definitions found to terminate, which unfold in types
  -- when their case trees can choose: where each was defined, how many
  -- arguments it takes first, and its case tree under them
  transparent : Ref (HashMap Int (Env, Int, Core)),
  -- the definitions `@terminating` vouches for
  terminating : Ref [Int],
  -- the recursive definitions, for running the program: each one's unique,
  -- how many slots the context it was defined in had, and its body
  recDefs : Ref [(Int, Int, Core)],
  -- those of them defined inside another definition
  localRecs : Ref [Int],
  recNames : Ref (HashMap Int String),
  -- the natives, by unique: which each is, and how many erased arguments
  -- come before the ones it takes at run time
  nativeInfo : Ref (HashMap Int (String, Int)),
  natives : Ref (HashMap Int Bool),
  positive : Ref (HashMap Int [Bool]),
  -- the definitions a search for an auto argument may find (a trait's
  -- instances), the traits' records, each trait's superclass projections,
  -- and each trait's methods (by the method's unique: the record, the
  -- field, how many parameters the trait has)
  hints : Ref [Int],
  traits : Ref [Int],
  supers : Ref (HashMap Int [Int]),
  methods : Ref (HashMap Int (Int, Int, Int)),
  -- each instance with no parameters, and those of its fields that are a
  -- constant or a primitive: what a method of it is (`Elab.specialize`)
  instanceFields : Ref (HashMap Int [Maybe Core]),
  -- the hints' names, as a type shows one a search found: this package's
  -- under their modules, a dependency's by its path there
  hintNames : Ref (HashMap Int String),
  -- the metavariables standing for an auto argument still to be found, and
  -- what each was found to be, with the length of the context it was found
  -- in: written over the placeholder once the definition is checked
  placeholders : Ref [Int],
  chosen : Ref (HashMap Int (Core, Int)),
  -- the searches waiting for their types to be known: the placeholder, the
  -- context, and the type wanted
  deferredAutos : Ref [(Int, Ctx, Value, Bool)],
  -- the number literals waiting for their types (`Literals`): the
  -- placeholder, the context, the type wanted, and the literal
  deferredLiterals : Ref [(Int, Ctx, Value, Literal)],
  -- a signature's implicit binders that equations naming one before them
  -- left to their matching, by name (`Elab.checkAgainstSig`)
  quantified : Ref [Ident],
  -- the transparent definitions that unfold only where a `case` reads a
  -- field a type may compute with off them (instances), and which fields
  -- of each constructor those are; the instances being unfolded
  onCase : Ref [Int],
  opens : Ref (HashMap Int [Bool]),
  opening : Ref [Int],
  -- that a solution is being read off what it was equated with keeping
  -- definitions by their names (`Unify.solveMeta`)
  naming : Ref Bool,
  -- the data types that live above `Type`, and where
  large : Ref (HashMap Int Int),
  -- that the application being inferred is the head of `f x @{d}`
  autoGiven : Ref Bool,
  -- the meaning chosen for an overloaded name, by the node it was written
  -- at; the terms put off because more than one still fitted (the
  -- placeholder, the name's node, the term, its context, and what it is to
  -- be); and the constructor chosen for an overloaded name in a pattern
  forced : Ref (HashMap Int Int),
  deferred : Ref [(Int, Int, HirExpr, Ctx, Value)],
  patternChoice : Ref (HashMap Int Int)
}

