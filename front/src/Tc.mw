  Tc {
    hir = newRef (runSt (\() -> freezeHir (newHirBuilder ()))),
    elab = newRef (\cx t -> (Core.Error, Value.Error, U.unknown ())),
    metas = newRef [],
    constants = newRef Hm.empty,
    globals = newRef Hm.empty,
    problems = newRef [],
    opened = newRef [],
    prunes = newRef [],
    inferred = newRef Hm.empty,
    joins = newRef [],
    inferSpine = newRef 0,
    spineHere = newRef 0,
    errors = newRef [],
    holes = newRef [],
    postponed = newRef [],
    linear = newRef False,
    lets = newRef 0,
    unsupported = newRef [],
    effects = newRef Hm.empty,
    ops = newRef Hm.empty,
    seqs = newRef Hm.empty,
    nativeNames = newRef Hm.empty,
    list = newRef (0 - 1),
    declared = newRef [],
    datas = newRef Hm.empty,
    ctors = newRef Hm.empty,
    nextKey = newRef 4611686018427387903,
    transparent = newRef Hm.empty,
    terminating = newRef [],
    recDefs = newRef [],
    localRecs = newRef [],
    recNames = newRef Hm.empty,
    nativeInfo = newRef Hm.empty,
    natives = newRef Hm.empty,
    positive = newRef Hm.empty,
    hints = newRef [],
    traits = newRef [],
    supers = newRef Hm.empty,
    methods = newRef Hm.empty,
    instanceFields = newRef Hm.empty,
    hintNames = newRef Hm.empty,
    placeholders = newRef [],
    chosen = newRef Hm.empty,
    deferredAutos = newRef [],
    deferredLiterals = newRef [],
    quantified = newRef [],
    onCase = newRef [],
    opens = newRef Hm.empty,
    opening = newRef [],
    naming = newRef False,
    large = newRef Hm.empty,
    autoGiven = newRef False,
    forced = newRef Hm.empty,
    deferred = newRef [],
    patternChoice = newRef Hm.empty
  }

-- The checker as it is now, to go back to (`restore`): a trial, of a
-- candidate for an auto argument, is made on the checker itself and then
-- undone. Every table is a value, so this is a copy of each.
@pub fun save (tc : Tc) : Tc ! { Mut | e } =
  Tc {
    hir = newRef (getRef tc.hir),
    elab = newRef (getRef tc.elab),
    metas = newRef (getRef tc.metas),
    constants = newRef (getRef tc.constants),
    globals = newRef (getRef tc.globals),
    problems = newRef (getRef tc.problems),
    opened = newRef (getRef tc.opened),
    prunes = newRef (getRef tc.prunes),
    inferred = newRef (getRef tc.inferred),
    joins = newRef (getRef tc.joins),
    inferSpine = newRef (getRef tc.inferSpine),
    spineHere = newRef (getRef tc.spineHere),
    errors = newRef (getRef tc.errors),
    holes = newRef (getRef tc.holes),
    postponed = newRef (getRef tc.postponed),
    linear = newRef (getRef tc.linear),
    lets = newRef (getRef tc.lets),
    unsupported = newRef (getRef tc.unsupported),
    effects = newRef (getRef tc.effects),
    ops = newRef (getRef tc.ops),
    seqs = newRef (getRef tc.seqs),
    nativeNames = newRef (getRef tc.nativeNames),
    list = newRef (getRef tc.list),
    declared = newRef (getRef tc.declared),
    datas = newRef (getRef tc.datas),
    ctors = newRef (getRef tc.ctors),
    nextKey = newRef (getRef tc.nextKey),
    transparent = newRef (getRef tc.transparent),
    terminating = newRef (getRef tc.terminating),
    recDefs = newRef (getRef tc.recDefs),
    localRecs = newRef (getRef tc.localRecs),
    recNames = newRef (getRef tc.recNames),
    nativeInfo = newRef (getRef tc.nativeInfo),
    natives = newRef (getRef tc.natives),
    positive = newRef (getRef tc.positive),
    hints = newRef (getRef tc.hints),
    traits = newRef (getRef tc.traits),
    supers = newRef (getRef tc.supers),
    methods = newRef (getRef tc.methods),
    instanceFields = newRef (getRef tc.instanceFields),
    hintNames = newRef (getRef tc.hintNames),
    placeholders = newRef (getRef tc.placeholders),
    chosen = newRef (getRef tc.chosen),
    deferredAutos = newRef (getRef tc.deferredAutos),
    deferredLiterals = newRef (getRef tc.deferredLiterals),
    quantified = newRef (getRef tc.quantified),
    onCase = newRef (getRef tc.onCase),
    opens = newRef (getRef tc.opens),
    opening = newRef (getRef tc.opening),
    naming = newRef False,
    large = newRef (getRef tc.large),
    autoGiven = newRef (getRef tc.autoGiven),
    forced = newRef (getRef tc.forced),
    deferred = newRef (getRef tc.deferred),
    patternChoice = newRef (getRef tc.patternChoice)
  }

-- Back to what `save` kept.
@pub fun restore (tc : Tc) (saved : Tc) : () ! { Mut | e } =
  let w0 = setRef tc.hir (getRef saved.hir) in
  let w1 = setRef tc.elab (getRef saved.elab) in
  let w2 = setRef tc.metas (getRef saved.metas) in
  let w3 = setRef tc.constants (getRef saved.constants) in
  let wGlobals = setRef tc.globals (getRef saved.globals) in
  let w4 = setRef tc.problems (getRef saved.problems) in
  let w5 = setRef tc.opened (getRef saved.opened) in
  let w6 = setRef tc.prunes (getRef saved.prunes) in
  let w7 = setRef tc.inferred (getRef saved.inferred) in
  let w8 = setRef tc.joins (getRef saved.joins) in
  let w9 = setRef tc.inferSpine (getRef saved.inferSpine) in
  let w10 = setRef tc.spineHere (getRef saved.spineHere) in
  let w11 = setRef tc.errors (getRef saved.errors) in
  let w12 = setRef tc.holes (getRef saved.holes) in
  let w13 = setRef tc.postponed (getRef saved.postponed) in
  let w14 = setRef tc.linear (getRef saved.linear) in
  let w15 = setRef tc.lets (getRef saved.lets) in
  let w16 = setRef tc.unsupported (getRef saved.unsupported) in
  let w17 = setRef tc.effects (getRef saved.effects) in
  let w18 = setRef tc.ops (getRef saved.ops) in
  let w19 = setRef tc.seqs (getRef saved.seqs) in
  let w20 = setRef tc.nativeNames (getRef saved.nativeNames) in
  let w21 = setRef tc.list (getRef saved.list) in
  let w22 = setRef tc.declared (getRef saved.declared) in
  let w23 = setRef tc.datas (getRef saved.datas) in
  let w24 = setRef tc.ctors (getRef saved.ctors) in
  let w25 = setRef tc.nextKey (getRef saved.nextKey) in
  let w26 = setRef tc.transparent (getRef saved.transparent) in
  let w27 = setRef tc.terminating (getRef saved.terminating) in
  let w28 = setRef tc.recDefs (getRef saved.recDefs) in
  let w29 = setRef tc.localRecs (getRef saved.localRecs) in
  let w30 = setRef tc.recNames (getRef saved.recNames) in
  let w31 = setRef tc.nativeInfo (getRef saved.nativeInfo) in
  let w32 = setRef tc.natives (getRef saved.natives) in
  let w33 = setRef tc.positive (getRef saved.positive) in
  let w34 = setRef tc.hints (getRef saved.hints) in
  let w35 = setRef tc.traits (getRef saved.traits) in
  let w36 = setRef tc.supers (getRef saved.supers) in
  let w37 = setRef tc.methods (getRef saved.methods) in
  let w38 = setRef tc.instanceFields (getRef saved.instanceFields) in
  let w39 = setRef tc.placeholders (getRef saved.placeholders) in
  let w40 = setRef tc.chosen (getRef saved.chosen) in
  let w41 = setRef tc.deferredAutos (getRef saved.deferredAutos) in
  let w41b = setRef tc.deferredLiterals (getRef saved.deferredLiterals) in
  let w42 = setRef tc.forced (getRef saved.forced) in
  let w43 = setRef tc.deferred (getRef saved.deferred) in
  let w44 = setRef tc.patternChoice (getRef saved.patternChoice) in
  ()

@pub fun problem (tc : Tc) (why : String) = setRef tc.problems (V.pushBack (getRef tc.problems) why)

-- An error, by its kind's name.
@pub fun error (tc : Tc) (kind : String) = setRef tc.errors (V.pushBack (getRef tc.errors) kind)

-- Something this checker cannot check yet.
@pub fun cannot (tc : Tc) (what : String) = setRef tc.unsupported (V.pushBack (getRef tc.unsupported) what)

-- A new metavariable, unsolved.
@pub fun newMeta (tc : Tc) (info : MetaInfo) =
  let ms = getRef tc.metas in
  let w = setRef tc.metas (V.pushBack ms (Meta.Unsolved info)) in
  V.len ms

@pub fun meta (tc : Tc) (m : Int) : Maybe Meta ! { Mut | e } = V.get (getRef tc.metas) m

@pub fun solve (tc : Tc) (m : Int) (v : Value) =
  let ms = getRef tc.metas in
  match V.get ms m with
  | Just (Meta.Unsolved info) -> setRef tc.metas (V.set ms m (Meta.Solved v info))
  | Just (Meta.Solved _ info) -> setRef tc.metas (V.set ms m (Meta.Solved v info))
  | None -> ()

@pub fun infoOf (entry : Meta) : MetaInfo =
  match entry with
  | Meta.Unsolved i -> i
  | Meta.Solved _ i -> i

-- A fresh key, for a slot no name refers to.
@pub fun freshKey (tc : Tc) : Int ! { Mut | e } =
  let k = getRef tc.nextKey - 1 in
  let w = setRef tc.nextKey k in
  k

@pub fun ctorInfo (tc : Tc) (c : Int) : Maybe CtorInfo ! { Mut | e } = Hm.lookup c (getRef tc.ctors)
