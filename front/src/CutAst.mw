-- Cut as data: what the lowering (`Lower.mw`) makes, as
-- `compiler/idyllic-cut/src/lib.rs` has it, before `Emit.mw` builds it with
-- the Cut package. Lowering builds a program inside out, sharing a consumer
-- between branches as it goes, which plain data makes easy; the package's
-- nodes are made once, at the end.

use Std.Collections.Vector as V
use Std.String as S
use Std.Maybe.Maybe.*

-- How a value is represented at run time: the only types Cut has.
@derive(PartialEq)
@pub data Rep = I64 | Bool | Unit | Str | Ptr | Desc | Var String | Any

@pub fun repText (r : Rep) : String =
  match r with
  | Rep.I64 -> "i64"
  | Rep.Bool -> "bool"
  | Rep.Unit -> "unit"
  | Rep.Str -> "str"
  | Rep.Ptr -> "ptr"
  | Rep.Desc -> "desc"
  | Rep.Var a -> "'" ++ a
  | Rep.Any -> "any"

-- A flat, globally unique name, `idyll:App/Math.double`: its language, its
-- package, and its path, the module path then the name.
@derive(PartialEq)
@pub data Sym = Sym String String [String]

-- An Idyll name: its package, and its path there, `Math.double`, split at
-- the dots before the name (which may be an operator with dots of its own).
@pub fun idyll (package : String) (path : String) : Sym = Sym.Sym "idyll" package (splitPath path [])

-- Something declared under a name: a constructor under its type.
@pub fun child (s : Sym) (name : String) : Sym = match s with | Sym.Sym l p path -> Sym.Sym l p (V.pushBack path name)

fun splitPath (rest : String) (acc : [String]) : [String] =
  match S.indexOf "." rest with
  | Just i ->
      let head = S.slice rest 0 i in
      let tail = S.drop rest (i + 1) in
      if isIdent head and not (S.isEmpty tail) then splitPath tail (V.pushBack acc head) else V.pushBack acc rest
  | None -> V.pushBack acc rest

fun isAlpha (c : Int) : Bool = (c >= 65 and c <= 90) or (c >= 97 and c <= 122)

fun byte (s : String) (i : Int) : Int =
  match S.byteAt s i with
  | Just b -> toInt b
  | None -> 0

fun isIdent (s : String) : Bool =
  let n = S.byteLength s in
  n > 0
    and (let c = byte s 0 in isAlpha c or c == 95)
    and V.all (\i -> let c = byte s i in isAlpha c or c == 95 or (c >= 48 and c <= 57)) (V.range 1 n)

-- A segment as it is written: quoted if it is not a plain identifier.
@pub fun segment (seg : String) : String =
  if isIdent seg then seg
  else "\"" ++ S.join "\\\"" (S.split "\"" (S.join "\\\\" (S.split "\\" seg))) ++ "\""

@pub fun symText (s : Sym) : String =
  match s with
  | Sym.Sym l p path -> l ++ ":" ++ p ++ "/" ++ S.join "." (V.map segment path)

-- A binder: a name, and how its value is represented.
@pub data Binder = Binder String Rep

@pub data Prod
  = Var String
  | Val Sym
  | Int Int
  | Str String
  | Bool Bool
  | Unit
  | Desc Rep
  | Con Sym [Prod]
  | Tuple [Prod]
  | Mu String Stmt
  | Cocase [Method]
  | Array [Prod]

-- A method: its name, its parameters, its continuations, its body.
@pub data Method = Method String [Binder] [String] Stmt

@pub data Cons
  = KVar String
  | Halt
  | MuT Binder Stmt
  | Case [Arm]
  -- a method of the object received, called
  | Call String [Prod] [Cons]

-- An arm of a `case`: a constructor (none for the IR's tuple), its fields.
@pub data Arm = Arm (Maybe Sym) [Binder] Stmt

@pub data Stmt
  = Cut Prod Cons
  | Invoke Sym [Prod] [Cons]
  | Prim String [Prod] [Cons]
  -- clauses; `return(x: rep; k) => s`; the body's continuation and body;
  -- where the handled value goes
  | Handle [Clause] Binder String Stmt String Stmt Cons
  | Perform Sym [Prod] Cons
  | Error String

-- `E.op(x: rep, ..; r, k) => s`
@pub data Clause = Clause Sym [Binder] String String Stmt

-- `data S <'a> { K(rep, ..); .. }`
@pub data CData = CData Sym [String] [(String, [Rep])]

-- `effect S { @many op(rep, ..) -> rep; .. }`: name, many, params, result
@pub data COp = COp String Bool [Rep] Rep

@pub data CEffect = CEffect Sym [COp]

-- `def S <'a = d; e: Effect> (params; conts) = body`
@pub data CDef = CDef Sym [(String, String)] [(String, String)] [Binder] [String] Stmt

-- `val S : rep = s`
@pub data CVal = CVal Sym Rep Stmt

-- A whole program: its entry, whether its answer is a string, its data
-- types, roles, the world's operations it leaves to the runtime, effects,
-- values in the order they are computed, and definitions.
@pub data CProgram = CProgram (Maybe Sym) Bool [CData] [(String, Sym)] [(Sym, String)] [CEffect] [CVal] [CDef]
