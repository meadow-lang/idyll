-- What the passes after renaming share: an argument's `Icit`, a
-- `Literal`, a declaration's `Visibility`, and an `Ident` -- a name as the
-- checker's context keeps one, the uniques it may stand for and its text.
-- (The renamed program itself is `Hir`, a Lingua language, in `Rename`.)
--
-- A name's uniques are a list. None is a name nothing in scope has (it is
-- reported); one is a name resolved; several are a name brought in by more
-- than one `use`, which the checker chooses between by type (ROADMAP,
-- phase 3). A binder always has one.
--
-- And how the dumps write a literal and a name, as the Rust side does.

use Std.Collections.Vector as V
use Std.String as S
use Std.Maybe.Maybe.*

-- Whether an argument is written, or left for the checker to work out.
@derive(PartialEq)
@pub data Icit = Explicit | Implicit

@derive(PartialEq)
@pub data Literal = Unit | Int Int | Bool Bool | Str String | Char Char

-- How far a declaration is seen: its module, the module above, its
-- package, or anywhere.
@derive(PartialEq)
@pub data Visibility = Private | Super | Package | Public

@pub data Ident = Ident [Int] String

-- The one unique of a binder.
@pub fun uniqueOf (x : Ident) : Int =
  match x with
  | Ident.Ident us _ -> V.getOr (0 - 1) us 0

@pub fun textOf (x : Ident) : String = match x with | Ident.Ident _ t -> t

-- Every unique a name may stand for.
@pub fun uniquesOf (x : Ident) : [Int] = match x with | Ident.Ident us _ -> us

-- --- writing -----------------------------------------------------------------

-- A string as the Rust side writes it: in quotes, with `\`, `"` and the
-- control characters escaped. Any other byte is itself.
-- A character as `idyllic_ast::show_char` writes one: in single quotes,
-- escaped as a one-character string is, but for `'`, `'\''`, and `"`, which
-- needs no escape here.
@pub fun showChar (c : Char) : String =
  let n = charCode c in
  if n == 39 then "'\\''"
  else if n == 34 then "'\"'"
  else
    let d = debugString (charsToString #[c]) in
    "'" ++ stringSlice d 1 (stringByteLength d - 1) ++ "'"

-- Rust's `Debug` for a string: in quotes, `\`, `"` and control characters
-- escaped, anything else as it is.
@pub fun debugString (s : String) : String =
  let n = stringByteLength s in
  let byte = \i -> toInt (stringByteAt s i) in
  let escape =
    \b ->
      if b == 92 then "\\\\"
      else if b == 34 then "\\\""
      else if b == 10 then "\\n"
      else if b == 9 then "\\t"
      else if b == 13 then "\\r"
      else if b == 0 then "\\0"
      else if b < 32 or b == 127 then "\\u{" ++ hexDigits b ++ "}"
      else ""
  in
  let cut = V.filter (\i -> escape (byte i) != "") (V.range 0 n) in
  let starts = V.append [0] (V.map (\i -> i + 1) cut) in
  let ends = V.append cut [n] in
  let runs =
    V.map
      (\k ->
        let run = stringSlice s (V.getOr 0 starts k) (V.getOr n ends k) in
        match V.get cut k with
        | Just i -> run ++ escape (byte i)
        | None -> run)
      (V.range 0 (V.len starts))
  in
  "\"" ++ S.join "" runs ++ "\""

fun hexDigits (n : Int) : String =
  let digit = \d -> stringSlice "0123456789abcdef" d (d + 1) in
  if n < 16 then digit n else hexDigits (n / 16) ++ digit (n % 16)

@pub fun quoted (s : String) : String =
  let n = stringByteLength s in
  let byte = \i -> toInt (stringByteAt s i) in
  -- the bytes that are escaped, and the runs between them copied whole, so
  -- that no character is cut
  let cut = V.filter (\i -> escaped (byte i) != "") (V.range 0 n) in
  let starts = V.append [0] (V.map (\i -> i + 1) cut) in
  let ends = V.append cut [n] in
  let runs =
    V.map
      (\k ->
        let run = stringSlice s (V.getOr 0 starts k) (V.getOr n ends k) in
        match V.get cut k with
        | Just i -> run ++ escaped (byte i)
        | None -> run)
      (V.range 0 (V.len starts))
  in
  "\"" ++ S.join "" runs ++ "\""

-- How byte `b` is escaped, or "" if it is not.
fun escaped (b : Int) : String =
  if b == 92 then "\\\\"
  else if b == 34 then "\\\""
  else if b == 10 then "\\n"
  else if b == 9 then "\\t"
  else if b == 13 then "\\r"
  else if b < 32 or b == 127 then "\\u{" ++ hex b ++ "}"
  else ""

fun hex (n : Int) : String =
  let digit = \d -> stringSlice "0123456789abcdef" d (d + 1) in
  if n < 16 then digit n else hex (n / 16) ++ digit (n % 16)

@pub fun literal (l : Literal) : String =
  match l with
  | Literal.Unit -> "(lit ())"
  | Literal.Int n -> "(lit ${show n})"
  | Literal.Bool b -> if b then "(lit True)" else "(lit False)"
  | Literal.Str s -> "(lit ${quoted s})"
  | Literal.Char c -> "(lit ${showChar c})"

fun sx (parts : [String]) : String = "(" ++ S.join " " parts ++ ")"

@pub fun ident (x : Ident) : String =
  match x with
  | Ident.Ident us t ->
      if V.isEmpty us then t ++ "@?"
      else if V.len us == 1 then t ++ "@" ++ show (V.getOr 0 us 0)
      else sx (V.append ["overload"] (V.map (\u -> t ++ "@" ++ show u) us))
