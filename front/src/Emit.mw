-- Emitting Cut, the back end's IR (`docs/CUT.md` in the Meadow repository),
-- which `meadow cut` runs on Glade and Silo. Every piece of Cut front/ makes
-- is built here, with the Cut package MeadowBoot uses too: nothing else
-- builds Cut's nodes or writes its text. What it builds from is what the
-- lowering made (`Lower.mw`, as `CutAst.mw`'s data).

use Cut as C
use Idyll.CutAst (Rep, Sym, Binder, Prod, Method, Cons, Arm, Stmt, Clause, CData, COp, CEffect, CDef, CVal, CProgram)
use Idyll.CutAst as A
use Std.Collections.Vector as V
use Std.Maybe.Maybe.*

-- A program as the text `meadow cut` reads.
@pub fun programText (p : CProgram) : String =
  runSt (\() ->
    let out = C.builder () in
    let m = C.nowhere in
    match p with
    | CProgram.CProgram entry answer datas roles natives effects vals defs ->
        let decls =
          V.concat [
            V.map (\d -> dataDecl out d) datas,
            if V.isEmpty roles then [] else [C.rolesDecl out m (V.map (\r -> match r with | (role, s) -> (role, A.symText s)) roles)],
            if V.isEmpty natives then [] else [C.nativeDecl out m (V.map (\n -> match n with | (s, rt) -> (A.symText s, rt)) natives)],
            V.map (\e -> effectDecl out e) effects,
            V.map (\v -> valDecl out v) vals,
            V.map (\d -> defDecl out d) defs
          ]
        in
        let entryText = match entry with | Just s -> A.symText s | None -> "" in
        C.text (C.finished out (C.file out m entryText (if answer then "str" else "none") decls)))

fun dataDecl out (d : CData) =
  match d with
  | CData.CData s vars ctors ->
      C.dataDecl
        out
        C.nowhere
        (A.symText s)
        (V.map (\a -> "'" ++ a) vars)
        (V.map (\c -> match c with | (n, fs) -> C.ctorDecl out C.nowhere (A.segment n) (V.map A.repText fs)) ctors)

fun effectDecl out (e : CEffect) =
  match e with
  | CEffect.CEffect s ops ->
      C.effectDecl
        out
        C.nowhere
        (A.symText s)
        (V.map
           (\o ->
             match o with
             | COp.COp n many ps r ->
                 if many then C.manyOpDecl out C.nowhere (A.segment n) (V.map A.repText ps) (A.repText r)
                 else C.opDecl out C.nowhere (A.segment n) (V.map A.repText ps) (A.repText r))
           ops)

fun valDecl out (v : CVal) =
  match v with
  | CVal.CVal s r body -> C.valDecl out C.nowhere (A.symText s) (A.repText r) (stmt out body)

fun defDecl out (d : CDef) =
  match d with
  | CDef.CDef s reps effects params conts body ->
      C.defWith out C.nowhere (A.symText s) reps effects (V.map (\b -> param out b) params) (V.map (\k -> C.param out C.nowhere k "ptr") conts) (stmt out body)

fun param out (b : Binder) = match b with | Binder.Binder n r -> C.param out C.nowhere n (A.repText r)

fun stmt out (s : Stmt) =
  let m = C.nowhere in
  match s with
  | Stmt.Cut p k -> C.give out m (prod out p) (cons out k)
  | Stmt.Invoke f args ks -> C.invoke out m (A.symText f) (V.map (\a -> prod out a) args) (V.map (\k -> cons out k) ks)
  | Stmt.Prim op args ks -> C.prim out m op (V.map (\a -> prod out a) args) (V.map (\k -> cons out k) ks)
  | Stmt.Perform op args k -> C.performed out m (A.symText op) (V.map (\a -> prod out a) args) (cons out k)
  | Stmt.Error why -> C.fail out m why
  | Stmt.Handle clauses x retK retS bodyK body k ->
      C.handled
        out
        m
        (V.map
           (\c -> match c with | Clause.Clause op ps r kc b -> C.clause out m (A.symText op) (V.map (\p -> param out p) ps) r kc (stmt out b))
           clauses)
        (param out x)
        retK
        (stmt out retS)
        bodyK
        (stmt out body)
        (cons out k)

fun prod out (p : Prod) =
  let m = C.nowhere in
  match p with
  | Prod.Var x -> C.var out m x
  | Prod.Val s -> C.sym out m (A.symText s)
  | Prod.Int n -> C.int out m n
  | Prod.Str t -> C.str out m t
  | Prod.Bool b -> C.bool out m b
  | Prod.Unit -> C.unit out m
  | Prod.Desc r -> C.desc out m (A.repText r)
  | Prod.Con s args -> C.con out m (A.symText s) (V.map (\a -> prod out a) args)
  | Prod.Tuple items -> C.tuple out m (V.map (\a -> prod out a) items)
  | Prod.Array items -> C.array out m (V.map (\a -> prod out a) items)
  | Prod.Mu k body -> C.newCutProdMu out m k (stmt out body)
  | Prod.Cocase methods ->
      C.newCutProdCocase
        out
        m
        (V.map
           (\me ->
             match me with
             | Method.Method n ps ks b ->
                 C.newCutMethod out m n (V.map (\x -> param out x) ps) (V.map (\k -> C.param out m k "ptr") ks) (stmt out b))
           methods)

fun cons out (c : Cons) =
  let m = C.nowhere in
  match c with
  | Cons.KVar k -> C.cont out m k
  | Cons.Halt -> C.halt out m
  | Cons.MuT (Binder.Binder x r) body -> C.newCutConsMuT out m x (A.repText r) (stmt out body)
  | Cons.Case arms ->
      C.caseOf
        out
        m
        (V.map
           (\a ->
             match a with
             | Arm.Arm ctor fields body ->
                 C.arm out m (match ctor with | Just s -> A.symText s | None -> "#tuple") (V.map (\f -> param out f) fields) (stmt out body))
           arms)
  | Cons.Call meth args ks -> C.newCutConsCall out m meth (V.map (\a -> prod out a) args) (V.map (\k -> cons out k) ks)

-- --- tests -------------------------------------------------------------------

use Std.Test (assertTrue)
use Std.String as S

@test fun theSmallestProgramIsWritten () =
  let k = "k" in
  let main = CDef.CDef (A.idyll "Main" "main") [] [] [] [k] (Stmt.Cut (Prod.Str "hi") (Cons.KVar k)) in
  let text = programText (CProgram.CProgram (Just (A.idyll "Main" "main")) True [] [] [] [] [] [main]) in
  assertTrue (S.contains "idyll:Main/main" text and S.contains "\"hi\"" text) text
