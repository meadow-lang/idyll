-- The surface syntax tree: `compiler/idyllic-ast`, what the parser makes and
-- the renamer reads. Names are still their text. Nothing here says where it
-- was written: the tree it was read from (`Syntax`) does.
--
-- `dumped` writes a program out as the parse test compares it with the Rust
-- parser's, an S-expression a line for each of its parts; the Rust side is
-- in `compiler/idyllic/tests/front.rs`, and the two must stay alike.

use Std.Collections.Vector as V
use Std.String as S
use Std.Maybe.Maybe.*

-- Whether an argument is written, or left for the checker to work out.
@pub data Icit = Explicit | Implicit

-- The grades on a binder, `[s]` or `(s, r)`: how often the function uses it,
-- and how often the rest of its type mentions it.
@pub data Grade = Grade Term (Maybe Term)

@pub data Literal = Unit | Int Int | Bool Bool | Str String

@pub data Term
  = Type
  | Var String
  | Lit Literal
  | Pi (Maybe String) Icit (Maybe Grade) Term Term
  | Lam Param Term
  | App Term Term
  | Ann Term Term
  | Hole
  | BoxIntro Term
  | Inf
  | Range Term Term
  | LetBox String Term Term
  | Let [Decl] Term
  | Case Term [Alt]
  | Eff Term Term
  | Row [Term] (Maybe Term)
  | Handle Term [Clause]
  | Seq [Term]
  | ArrayLit [Term]
  | RecordLit String [(String, Term)]
  | Proj Term String
  | Update Term [(String, Term)]

-- A binder: its name, whether it unboxes (`[x]`), its grades and its type.
@pub data Param = Param String Bool (Maybe Grade) (Maybe Term)

@pub data Pat
  = Bind Param
  | Wild
  | Lit Literal
  | Con String [Pat]
  | As String Pat
  | Dot Term
  | Seq [Pat]
  | Record String [(String, Pat)]

@pub data Rhs = Plain Term | Guarded [(Term, Term)] | Impossible

@pub data Alt = Alt Pat Rhs

-- `op x k -> e`: the operation, the names it binds, and the body.
@pub data Clause = Clause String [String] Term

@pub data Decl
  = Sig String Term
  | Def String [Pat] (Maybe Term) Rhs
  | Native String Term

@derive(PartialEq)
@pub data Visibility = Private | Super | Package | Public

@pub data Ctor = Fields [Term] | Sig Term

@pub record Data = {
  name : String,
  params : [(String, Maybe Term)],
  kind : Maybe Term,
  ctors : [(String, Ctor)],
  seq : Maybe (String, String),
  visibility : Visibility,
  fields : Maybe [String]
}

-- An operation of an effect: its name, its type, and whether `@many`.
@pub data OpSig = OpSig String Term Bool

@pub record Effect = {
  name : String,
  params : [(String, Maybe Term)],
  ops : [OpSig],
  visibility : Visibility
}

@pub record Use = {
  public : Bool,
  path : [String],
  glob : Bool,
  alias : Maybe String,
  names : Maybe [String]
}

@pub record Program = {
  datas : [Data],
  effects : [Effect],
  decls : [Decl],
  uses : [Use],
  visibility : [(String, Visibility)],
  terminating : [String],
  linear : Bool,
  body : Maybe Term
}

-- `t` with the free variable `name` replaced by `by`: what a record's field
-- type becomes when an earlier field is read off the record. A binder of the
-- same name hides it. Inside a `let`, a `case`, a handler or a record update
-- nothing is replaced, as in `idyllic_ast::substitute`.
@pub fun substitute (t : Term) (name : String) (by : Term) : Term =
  let go = \u -> substitute u name by in
  match t with
  | Term.Var x -> if x == name then by else t
  | Term.Pi x icit g dom cod ->
      let hidden = match x with | Just y -> y == name | None -> False in
      Term.Pi x icit g (go dom) (if hidden then cod else go cod)
  | Term.Lam p body ->
      (match p with
       | Param.Param x unbox g ty ->
           let ty2 = match ty with | Just u -> Just (go u) | None -> None in
           Term.Lam (Param.Param x unbox g ty2) (if x == name then body else go body))
  | Term.App f a -> Term.App (go f) (go a)
  | Term.Ann e ty -> Term.Ann (go e) (go ty)
  | Term.BoxIntro e -> Term.BoxIntro (go e)
  | Term.Range a b -> Term.Range (go a) (go b)
  | Term.Eff a b -> Term.Eff (go a) (go b)
  | Term.Row ls tail -> Term.Row (V.map go ls) (match tail with | Just u -> Just (go u) | None -> None)
  | Term.Seq es -> Term.Seq (V.map go es)
  | Term.ArrayLit es -> Term.ArrayLit (V.map go es)
  | Term.RecordLit r fs -> Term.RecordLit r (V.map (\f -> match f with | (x, e) -> (x, go e)) fs)
  | Term.Proj e f -> Term.Proj (go e) f
  | _ -> t

-- --- writing -----------------------------------------------------------------

-- `(a b c)`
fun sx (parts : [String]) : String = "(" ++ S.join " " parts ++ ")"

fun opt (f : a -> String) (m : Maybe a) : String =
  match m with
  | Just x -> f x
  | None -> "-"

fun flag (yes : String) (b : Bool) : String = if b then yes else "-"

-- A string as the Rust side writes it: in quotes, with `\`, `"` and the
-- control characters escaped. Any other byte is itself.
@pub fun quoted (s : String) : String =
  let n = stringByteLength s in
  let byte = \i -> toInt (stringByteAt s i) in
  -- the bytes that are escaped, and the runs between them copied whole, so
  -- that no character is cut
  let cut = V.filter (\i -> escaped (byte i) != "") (V.range 0 n) in
  let starts = V.append [0] (V.map (\i -> i + 1) cut) in
  let ends = V.append cut [n] in
  let runs =
    V.map
      (\k ->
        let run = stringSlice s (V.getOr 0 starts k) (V.getOr n ends k) in
        match V.get cut k with
        | Just i -> run ++ escaped (byte i)
        | None -> run)
      (V.range 0 (V.len starts))
  in
  "\"" ++ S.join "" runs ++ "\""

-- How byte `b` is escaped, or "" if it is not.
fun escaped (b : Int) : String =
  if b == 92 then "\\\\"
  else if b == 34 then "\\\""
  else if b == 10 then "\\n"
  else if b == 9 then "\\t"
  else if b == 13 then "\\r"
  else if b < 32 or b == 127 then "\\u{" ++ hex b ++ "}"
  else ""

fun hex (n : Int) : String =
  let digit = \d -> stringSlice "0123456789abcdef" d (d + 1) in
  if n < 16 then digit n else hex (n / 16) ++ digit (n % 16)

@pub fun literal (l : Literal) : String =
  match l with
  | Literal.Unit -> "(lit ())"
  | Literal.Int n -> "(lit ${show n})"
  | Literal.Bool b -> if b then "(lit True)" else "(lit False)"
  | Literal.Str s -> "(lit ${quoted s})"

@pub fun grade (g : Grade) : String =
  match g with
  | Grade.Grade s t -> sx ["grade", term s, opt term t]

@pub fun param (p : Param) : String =
  match p with
  | Param.Param x unbox g ty -> sx ["param", x, flag "unbox" unbox, opt grade g, opt term ty]

fun fieldOf (f : (String, Term)) : String = match f with | (x, e) -> sx [x, term e]

@pub fun term (t : Term) : String =
  match t with
  | Term.Type -> "Type"
  | Term.Var x -> x
  | Term.Lit l -> literal l
  | Term.Pi x icit g dom cod ->
      sx ["pi", opt (\n -> n) x, (match icit with | Icit.Explicit -> "e" | Icit.Implicit -> "i"), opt grade g, term dom, term cod]
  | Term.Lam p body -> sx ["lam", param p, term body]
  | Term.App f a -> sx ["app", term f, term a]
  | Term.Ann e ty -> sx ["ann", term e, term ty]
  | Term.Hole -> "_"
  | Term.BoxIntro e -> sx ["box", term e]
  | Term.Inf -> "inf"
  | Term.Range a b -> sx ["range", term a, term b]
  | Term.LetBox x e body -> sx ["letbox", x, term e, term body]
  | Term.Let ds body -> sx ["let", sx (V.map decl ds), term body]
  | Term.Case e alts -> sx (V.append ["case", term e] (V.map alt alts))
  | Term.Eff b e -> sx ["eff", term b, term e]
  | Term.Row ls tail -> sx ["row", sx (V.map term ls), opt term tail]
  | Term.Handle e cs -> sx (V.append ["handle", term e] (V.map clause cs))
  | Term.Seq es -> sx (V.append ["seq"] (V.map term es))
  | Term.ArrayLit es -> sx (V.append ["array"] (V.map term es))
  | Term.RecordLit r fs -> sx (V.append ["record", r] (V.map fieldOf fs))
  | Term.Proj e f -> sx ["proj", term e, f]
  | Term.Update e fs -> sx (V.append ["update", term e] (V.map fieldOf fs))

@pub fun pat (p : Pat) : String =
  match p with
  | Pat.Bind x -> param x
  | Pat.Wild -> "_"
  | Pat.Lit l -> literal l
  | Pat.Con c ps -> sx (V.append ["con", c] (V.map pat ps))
  | Pat.As x q -> sx ["as", x, pat q]
  | Pat.Dot e -> sx ["dot", term e]
  | Pat.Seq ps -> sx (V.append ["pseq"] (V.map pat ps))
  | Pat.Record r fs -> sx (V.append ["precord", r] (V.map (\f -> match f with | (x, q) -> sx [x, pat q]) fs))

@pub fun rhs (r : Rhs) : String =
  match r with
  | Rhs.Plain e -> sx ["=", term e]
  | Rhs.Guarded gs -> sx (V.append ["guards"] (V.map (\g -> match g with | (c, e) -> sx [term c, term e]) gs))
  | Rhs.Impossible -> "impossible"

@pub fun alt (a : Alt) : String =
  match a with
  | Alt.Alt p r -> sx ["alt", pat p, rhs r]

@pub fun clause (c : Clause) : String =
  match c with
  | Clause.Clause op xs body -> sx ["clause", op, sx xs, term body]

@pub fun decl (d : Decl) : String =
  match d with
  | Decl.Sig f ty -> sx ["sig", f, term ty]
  | Decl.Def f ps ty r -> sx ["def", f, sx (V.map pat ps), opt term ty, rhs r]
  | Decl.Native f ty -> sx ["native", f, term ty]

@pub fun visibility (v : Visibility) : String =
  match v with
  | Visibility.Private -> "private"
  | Visibility.Super -> "super"
  | Visibility.Package -> "package"
  | Visibility.Public -> "public"

fun typeParam (p : (String, Maybe Term)) : String = match p with | (x, k) -> sx [x, opt term k]

fun ctor (c : (String, Ctor)) : String =
  match c with
  | (name, Ctor.Fields ts) -> sx [name, sx (V.append ["fields"] (V.map term ts))]
  | (name, Ctor.Sig ty) -> sx [name, sx ["sig", term ty]]

@pub fun dataDecl (d : Data) : String =
  sx [
    "data",
    d.name,
    sx (V.map typeParam d.params),
    opt term d.kind,
    sx (V.map ctor d.ctors),
    opt (\s -> match s with | (nil, cons) -> sx ["seq", nil, cons]) d.seq,
    visibility d.visibility,
    opt sx d.fields
  ]

fun opSig (o : OpSig) : String =
  match o with
  | OpSig.OpSig x ty many -> sx ["op", x, flag "many" many, term ty]

@pub fun effectDecl (e : Effect) : String =
  sx ["effect", e.name, sx (V.map typeParam e.params), sx (V.map opSig e.ops), visibility e.visibility]

@pub fun useDecl (u : Use) : String =
  sx ["use", flag "pub" u.public, sx u.path, flag "glob" u.glob, opt (\a -> a) u.alias, opt sx u.names]

-- A program, a line for each part: whether it is linear, then its uses, data
-- types, effects, declarations, visibilities, `@terminating`s and body.
@pub fun program (p : Program) : String =
  S.join
    "\n"
    (V.concat [
       [sx ["linear", if p.linear then "true" else "false"]],
       V.map useDecl p.uses,
       V.map dataDecl p.datas,
       V.map effectDecl p.effects,
       V.map decl p.decls,
       V.map (\v -> match v with | (x, w) -> sx ["vis", x, visibility w]) p.visibility,
       V.map (\x -> sx ["terminating", x]) p.terminating,
       (match p.body with | Just e -> [sx ["body", term e]] | None -> [])
     ])
