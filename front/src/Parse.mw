-- Parsing: a program's lossless tree (`Syntax`) read as the abstract syntax
-- the Rust parser (`idyllic-parser`) makes of it (`Ast`).
--
-- Where the grammar reads one form for several, what the Rust parser would
-- have made of it is worked out here, in the order it tries them:
--
-- * an item is a declaration -- an equation, `f p = e` or `l + r = e`; a
--   signature, `f : a`; or `f p impossible` -- before it is an expression;
-- * a term read where a pattern is meant is read again as the pattern;
-- * in parentheses, `(x y : [2] a)` is binders where binders may be;
-- * before an arrow, binders and nothing else make a dependent function;
-- * operator chains are grouped by the Rust parser's levels: `*` `/` `%`,
--   then `+` `-` (both to the left), `::` `++` (to the right), then `<` `==`
--   and `..`, which do not chain.
--
-- And what the Rust parser does as it goes is done here too: telescopes and
-- lambdas curried, `if` a `case`, a tuple pairs, a record its data type and
-- projections, an effect's alias a definition, attributes on what they go on.
--
-- A program the Rust parser does not read is not read here either: what is
-- wrong is collected (`problems`) rather than said, for now -- the test
-- compares only whether there was anything.

use Idyll.Syntax
use Idyll.Syntax.Idyll.*
use Idyll.Ast (Icit, Grade, Literal, Term, Param, Pat, Rhs, Alt, Clause, Decl, Visibility, Ctor, Data, OpSig, Effect, Use, Program, substitute)
use Idyll.Ast as A
use Idyll.Layout (layout)
use Lingua.Red as R
use Lingua.Red (Syntax)
use Lingua.Green as G
use Std.Collections.Vector as V
use Std.String as S
use Std.Char as C
use Std.Maybe as M
use Std.Maybe.Maybe.*
use Std.Result.Result.*

-- `input`'s abstract syntax, or what is wrong with it.
@pub fun parsed (input : String) : Result [String] Program ! { Mut | e } =
  let laid = layout input in
  if not (V.isEmpty laid.problems) then Err (V.map (\pr -> match pr with | (_, m) -> m) laid.problems)
  else
    match parseIdyll input with
    | (g, errs) ->
        if not (V.isEmpty errs) then Err (V.map (\e -> match e with | (_, m) -> m) errs)
        else
          let p = newRef [] in
          let prog = program p (R.root g) in
          let wrong = getRef p in
          if V.isEmpty wrong then Ok prog else Err wrong

-- What the parse test compares: the program, or `(error)`.
@pub fun dumped (input : String) : String ! { Mut | e } =
  match parsed input with
  | Ok prog -> A.program prog
  | Err _ -> "(error)"

-- --- the tree ----------------------------------------------------------------

type Syn = Syntax Idyll

-- `s`'s children that are nodes.
fun nodesOf (s : Syn) : [Syn] =
  R.childrenWhere (\g c -> not (G.isTokenAt g c) and G.kindAt g c != Unknown) s

fun child (k : Idyll) (s : Syn) : Maybe Syn = R.childOfKind k s

fun kids (k : Idyll) (s : Syn) : [Syn] = R.childrenOfKind k s

fun is (k : Idyll) (s : Syn) : Bool = R.kindOf s == k

fun has (k : Idyll) (s : Syn) : Bool = M.isSome (child k s)

-- `s`'s one child of kind `k`, which the grammar says is there.
fun must (k : Idyll) (s : Syn) : Syn = M.unwrapOr s (child k s)

-- The text of `s`'s child token of kind `k`.
fun textOf (k : Idyll) (s : Syn) : String =
  match child k s with
  | Just t -> R.text t
  | None -> ""

fun isTerm (s : Syn) : Bool =
  let k = R.kindOf s in
  k == NodeLam or k == NodeLetE or k == NodeCaseE or k == NodeIfE or k == NodeHandleE or k == NodeOp

fun isAtom (s : Syn) : Bool =
  let k = R.kindOf s in
  k == NodeName or k == NodeNumber or k == NodeStrLit or k == NodeCharLit or k == NodeHole
    or k == NodeTypeA or k == NodeInfA or k == NodeOpName or k == NodeParen or k == NodeBoxA
    or k == NodeSeqA or k == NodeBraced or k == NodeRecordLit or k == NodeDotA

-- `s`'s children that are terms, in order.
fun termsIn (s : Syn) : [Syn] = V.filter isTerm (nodesOf s)

fun termIn (s : Syn) : Syn = M.unwrapOr s (V.head (termsIn s))

fun atomsIn (s : Syn) : [Syn] = V.filter isAtom (nodesOf s)

-- The name token of a `Name` atom, and its kind.
fun nameKind (s : Syn) : Idyll =
  match V.find (\t -> R.isTokenOf t and R.kindOf t != Unknown) (R.children s) with
  | Just t -> R.kindOf t
  | None -> Unknown

fun nameText (s : Syn) : String =
  match V.find (\t -> R.isTokenOf t and R.kindOf t != Unknown) (R.children s) with
  | Just t -> R.text t
  | None -> ""

-- A `Name` with nothing after it, of kind `k`.
fun plainName (k : Idyll) (s : Syn) : Bool = is NodeName s and nameKind s == k and not (has NodeAsTail s)

-- --- what is wrong -----------------------------------------------------------

fun bad p (why : String) = setRef p (V.pushBack (getRef p) why)

-- Whether `f` runs without finding anything wrong, and what it made: to try
-- reading a form as one thing before another.
fun tried f =
  let q = newRef [] in
  let x = f q in
  (V.isEmpty (getRef q), x)

-- Items and separators, `entries`, as the Rust parser takes them: separators
-- first if `leading`, then items a separator apart, and perhaps one after.
fun separated p (entries : [Syn]) (leading : Bool) (atLeastOne : Bool) : [Syn] ! { Mut | e } =
  let seps = \s -> is NodeSep s in
  let rest = if leading then V.dropWhile seps entries else entries in
  let starts = match V.head rest with | Just s -> seps s | None -> False in
  let pairs = V.zip rest (V.drop rest 1) in
  let adjacent = V.any (\pr -> match pr with | (a, b) -> seps a == seps b) pairs in
  let items = V.filter (\s -> not (seps s)) entries in
  let u1 = if starts or adjacent then bad p "items are a separator apart" else () in
  let u2 = if atLeastOne and V.isEmpty items then bad p "expected an item" else () in
  items

-- Whether a block's braces are both written or both laid out.
fun braced p (s : Syn) : () ! { Mut | e } =
  let written = has TokenLBrace s in
  let closed = has TokenRBrace s in
  if written != closed then bad p "a block's braces do not match" else ()

-- --- literals ----------------------------------------------------------------

def maxInt = 9223372036854775807

fun digitValue (b : Int) : Int =
  if b >= 48 and b <= 57 then b - 48 else if b >= 97 then b - 87 else b - 55

-- A number, which an `Int` must hold: 64 bits.
fun intLit p (s : Syn) : Int ! { Mut | e } =
  let k = nameKind s in
  let text = nameText s in
  let radix = if k == TokenHexadecimal then 16 else if k == TokenOctal then 8 else if k == TokenBinary then 2 else 10 in
  let from = if radix == 10 then 0 else 2 in
  let n =
    V.foldl
      (\acc i ->
        match acc with
        | None -> None
        | Just m ->
            let d = digitValue (toInt (stringByteAt text i)) in
            if m > (maxInt - d) / radix then None else Just (m * radix + d))
      (Just 0)
      (V.range from (stringByteLength text))
  in
  match n with
  | Just m -> m
  | None ->
      let u = bad p "${text} does not fit in an Int, which is 64 bits" in
      0

-- A string literal's text, its escapes resolved as the Rust lexer resolves
-- them.
fun strLit p (s : Syn) : String ! { Mut | e } =
  let text = nameText s in
  let inner = stringSlice text 1 (stringByteLength text - 1) in
  S.join "" (unescape p (S.chars inner) 0 [])

fun unescape p (cs : [Char]) (i : Int) (out : [String]) : [String] ! { Mut | e } =
  match V.get cs i with
  | None -> out
  | Just c ->
      if C.code c != 92 then unescape p cs (i + 1) (V.pushBack out (C.toString c))
      else
        match V.get cs (i + 1) with
        | None ->
            let u = bad p "trailing backslash in literal" in
            out
        | Just e ->
            let k = C.code e in
            let simple = escapeOf k in
            if simple >= 0 then unescape p cs (i + 2) (V.pushBack out (C.toString (C.fromCode simple)))
            else if k == 120 or k == 117 or k == 85 then
              let most = if k == 120 then 2 else if k == 117 then 4 else 8 in
              hexEscape p cs (i + 2) most 0 0 out
            else
              let u = bad p "unknown escape sequence" in
              unescape p cs (i + 2) (V.pushBack out (C.toString e))

fun escapeOf (k : Int) : Int =
  if k == 110 then 10
  else if k == 116 then 9
  else if k == 114 then 13
  else if k == 92 then 92
  else if k == 39 then 39
  else if k == 34 then 34
  else if k == 48 then 0
  else if k == 97 then 7
  else if k == 98 then 8
  else if k == 102 then 12
  else if k == 118 then 11
  else 0 - 1

-- `\x`, `\u`, `\U`: up to `most` hexadecimal digits from `i`.
fun hexEscape p (cs : [Char]) (i : Int) (most : Int) (n : Int) (value : Int) (out : [String]) : [String] ! { Mut | e } =
  let digit = match V.get cs i with | Just d -> C.hexDigitToInt d | None -> None in
  match digit with
  | Just d if n < most -> hexEscape p cs (i + 1) most (n + 1) (value * 16 + d) out
  | _ ->
      if n == 0 then
        let u = bad p "an escape needs at least one hexadecimal digit" in
        unescape p cs i out
      else
        match C.fromCodeSafe value with
        | Just ch -> unescape p cs i (V.pushBack out (C.toString ch))
        | None ->
            let u = bad p "invalid Unicode scalar value" in
            unescape p cs i (V.pushBack out "\u{FFFD}")

-- --- terms -------------------------------------------------------------------

fun var (x : String) : Term = Term.Var x

fun binary (op : String) (l : Term) (r : Term) : Term = Term.App (Term.App (var op) l) r

-- `[]`, any number of uses: `[0..∞]`.
def anyGrade = Term.Range (Term.Lit (Literal.Int 0)) Term.Inf

fun term p (s : Syn) : Term ! { Mut | e } =
  let k = R.kindOf s in
  if k == NodeOp then opTerm p s 0
  else if k == NodeLam then lam p s
  else if k == NodeLetE then letE p s
  else if k == NodeCaseE then caseE p s
  else if k == NodeIfE then ifE p s
  else if k == NodeHandleE then handleE p s
  else
    let u = bad p "expected a term" in
    Term.Hole

-- A chain and what follows it: an annotation, or an arrow -- a dependent one
-- when what is before it is binders. `skip` atoms at its start are grades,
-- read already.
fun opTerm p (op : Syn) (skip : Int) : Term ! { Mut | e } =
  let chain = must NodeChain op in
  match (child NodeAnnot op, child NodeArrow op) with
  | (Just a, _) -> Term.Ann (chainTerm p chain skip) (term p (termIn a))
  | (_, Just ar) ->
      let result = comp p (termIn ar) (child NodeEffects ar) in
      (match telescope chain skip with
       | Just doms ->
           let binders =
             V.concatMap
               (\d ->
                 match d with
                 | (names, icit, annot) ->
                     (match annotation p annot with
                      | (g, ty) -> V.map (\x -> (x, icit, g, ty)) names))
               doms
           in
           V.foldr
             (\b acc -> match b with | (x, icit, g, ty) -> Term.Pi (Just x) icit g ty acc)
             result
             binders
       | None -> Term.Pi None Icit.Explicit None (chainTerm p chain skip) result)
  | _ -> chainTerm p chain skip

-- `t ! row`, or `t`.
fun comp p (t : Syn) (effects : Maybe Syn) : Term ! { Mut | e } =
  match effects with
  | Just e -> Term.Eff (term p t) (row p e)
  | None -> term p t

-- Binders and nothing else, before an arrow: `(x y : a) {b : Type}`, each
-- its names, whether it is implicit, and its annotation.
fun telescope (chain : Syn) (skip : Int) : Maybe [([String], Icit, Syn)] =
  if has NodeLink chain then None
  else
    let atoms = V.drop (atomsIn (must NodeApp chain)) skip in
    let doms = V.map domain atoms in
    if not (V.isEmpty atoms) and V.all M.isSome doms then Just (V.map (\d -> M.unwrapOr ([], Icit.Explicit, chain) d) doms)
    else None

fun domain (a : Syn) : Maybe ([String], Icit, Syn) =
  let inside = termsIn a in
  let one =
    match (V.get inside 0, V.len inside) with
    | (Just t, 1) -> annotatedNames t False
    | _ -> None
  in
  if is NodeParen a then M.map (\na -> match na with | (ns, an) -> (ns, Icit.Explicit, an)) one
  else if is NodeBraced a and not (has NodeBraceRest a) then M.map (\na -> match na with | (ns, an) -> (ns, Icit.Implicit, an)) one
  else None

-- `x y : a` in parentheses: the names, and the annotation.
fun annotatedNames (t : Syn) (wild : Bool) : Maybe ([String], Syn) =
  if not (is NodeOp t) then None
  else
    match (child NodeAnnot t, names (must NodeChain t) wild) with
    | (Just an, Just ns) -> Just (ns, an)
    | _ -> None

-- A chain of names alone, `x y z` (and `_`, if `wild`).
fun names (chain : Syn) (wild : Bool) : Maybe [String] =
  if has NodeLink chain then None
  else
    let atoms = atomsIn (must NodeApp chain) in
    if V.all (\a -> plainName TokenLowerIdent a or (wild and is NodeHole a)) atoms then
      Just (V.map (\a -> if is NodeHole a then "_" else nameText a) atoms)
    else None

-- What follows a binder's `:`: grades, if it starts with them and goes on,
-- and its type.
fun annotation p (annot : Syn) : (Maybe Grade, Term) ! { Mut | e } =
  let ty = termIn annot in
  if is NodeOp ty then
    let atoms = atomsIn (must NodeApp (must NodeChain ty)) in
    match V.get atoms 0 with
    | Just g if V.len atoms >= 2 and (is NodeBoxA g or (is NodeParen g and V.len (termsIn g) == 2)) ->
        (Just (gradeOf p g), opTerm p ty 1)
    | _ -> (None, term p ty)
  else (None, term p ty)

fun gradeOf p (g : Syn) : Grade ! { Mut | e } =
  let inside = termsIn g in
  if is NodeBoxA g then
    match V.get inside 0 with
    | Just t -> Grade.Grade (term p t) None
    | None -> Grade.Grade anyGrade None
  else Grade.Grade (term p (V.getOr g inside 0)) (Just (term p (V.getOr g inside 1)))

-- An operator chain, grouped by levels.
fun chainTerm p (chain : Syn) (skip : Int) : Term ! { Mut | e } =
  let links = kids NodeLink chain in
  let operands =
    V.append [appTerm p (must NodeApp chain) skip] (V.map (\l -> appTerm p (must NodeApp l) 0) links)
  in
  let ops = V.map linkOp links in
  let u = V.foldl (\acc o -> if levelOf o == 0 then bad p "not an operator here: ${o}" else acc) () ops in
  grouped p operands ops 0 (V.len operands - 1) 5

fun linkOp (l : Syn) : String =
  match V.find (\t -> R.isTokenOf t and R.kindOf t != Unknown) (R.children l) with
  | Just t -> R.text t
  | None -> ""

fun levelOf (op : String) : Int =
  if op == "*" or op == "/" or op == "%" then 1
  else if op == "+" or op == "-" then 2
  else if op == "::" or op == "++" then 3
  else if op == "<" or op == "==" then 4
  else if op == ".." then 5
  else 0

-- Operands `lo` to `hi` and the operators between (operator `i` is after
-- operand `i`), grouped at `level` and tighter.
fun grouped p (xs : [Term]) (ops : [String]) (lo : Int) (hi : Int) (level : Int) : Term ! { Mut | e } =
  if level == 0 then V.getOr Term.Hole xs lo
  else
    let at = V.filter (\i -> levelOf (V.getOr "" ops i) == level) (V.range lo hi) in
    if V.isEmpty at then grouped p xs ops lo hi (level - 1)
    else
      let starts = V.append [lo] (V.map (\i -> i + 1) at) in
      let ends = V.append at [hi] in
      let parts = V.map (\b -> match b with | (s, e) -> grouped p xs ops s e (level - 1)) (V.zip starts ends) in
      let names = V.map (\i -> V.getOr "" ops i) at in
      let n = V.len at in
      if level >= 4 then
        let u = if n > 1 then bad p "comparisons and intervals do not chain" else () in
        let l = V.getOr Term.Hole parts 0 in
        let r = V.getOr Term.Hole parts 1 in
        if level == 5 then Term.Range l r else binary (V.getOr "" names 0) l r
      else if level == 3 then
        V.foldr
          (\i acc -> binary (V.getOr "" names i) (V.getOr Term.Hole parts i) acc)
          (V.getOr Term.Hole parts n)
          (V.range 0 n)
      else
        V.foldl
          (\acc i -> binary (V.getOr "" names i) acc (V.getOr Term.Hole parts (i + 1)))
          (V.getOr Term.Hole parts 0)
          (V.range 0 n)

-- Atoms applied to each other, each with the fields read off it: `f x.y` is
-- `f (x.y)`.
fun appTerm p (app : Syn) (skip : Int) : Term ! { Mut | e } =
  let atoms = V.drop (atomsIn app) skip in
  let terms =
    V.foldl
      (\acc a ->
        if is NodeDotA a then
          match V.last acc with
          | Just e -> V.pushBack (V.popBack acc) (Term.Proj e (fieldName p a))
          | None ->
              let u = bad p "a field of nothing" in
              acc
        else V.pushBack acc (atomTerm p a))
      []
      atoms
  in
  match V.head terms with
  | Just f -> V.foldl (\acc a -> Term.App acc a) f (V.drop terms 1)
  | None -> Term.Hole

fun fieldName p (dot : Syn) : String ! { Mut | e } =
  match V.head (atomsIn dot) with
  | Just n if plainName TokenLowerIdent n -> nameText n
  | _ ->
      let u = bad p "a field is a lower-case name" in
      "_"

fun atomTerm p (a : Syn) : Term ! { Mut | e } =
  let k = R.kindOf a in
  if k == NodeName then
    let x = nameText a in
    let u = if has NodeAsTail a then bad p "x@p is a pattern" else () in
    if nameKind a == TokenUpperIdent and x == "True" then Term.Lit (Literal.Bool True)
    else if nameKind a == TokenUpperIdent and x == "False" then Term.Lit (Literal.Bool False)
    else var x
  else if k == NodeNumber then Term.Lit (Literal.Int (intLit p a))
  else if k == NodeStrLit then Term.Lit (Literal.Str (strLit p a))
  else if k == NodeHole then Term.Hole
  else if k == NodeTypeA then Term.Type
  else if k == NodeInfA then Term.Inf
  else if k == NodeOpName then
    let u = if has TokenConOpIdent a then bad p "a constructor operator is not a term on its own" else () in
    var (linkOp a)
  else if k == NodeParen then
    let items = termsIn a in
    if V.isEmpty items then Term.Lit Literal.Unit else tuple (V.map (term p) items)
  else if k == NodeBoxA then
    match V.head (termsIn a) with
    | Just t -> Term.BoxIntro (term p t)
    | None -> Term.BoxIntro anyGrade
  else if k == NodeSeqA then
    match seqShape p a with
    | (items, array) -> if array then Term.ArrayLit (V.map (term p) items) else Term.Seq (V.map (term p) items)
  else if k == NodeBraced then
    let items = termsIn a in
    match (V.get items 0, V.len items, M.andThen (child NodeFieldVals) (child NodeBraceRest a)) with
    | (Just e, 1, Just fs) -> Term.Update (term p e) (fieldVals p fs)
    | _ ->
        let u = bad p "braces in a term are a record update, { r | x = e }" in
        Term.Hole
  else if k == NodeRecordLit then
    Term.RecordLit (nameText a) (match child NodeFieldVals a with | Just fs -> fieldVals p fs | None -> [])
  else
    let u = bad p "not a term" in
    Term.Hole

fun fieldVals p (fs : Syn) : [(String, Term)] ! { Mut | e } =
  V.map (\f -> (textOf TokenLowerIdent f, term p (termIn f))) (kids NodeFieldVal fs)

-- `(a, b, c)`: `(,) a ((,) b c)`; `(a)` is `a`.
fun tuple (items : [Term]) : Term =
  let n = V.len items in
  V.foldr
    (\x acc -> Term.App (Term.App (var "(,)") x) acc)
    (V.getOr Term.Hole items (n - 1))
    (V.take items (n - 1))

-- `#[a, b]` or `#[a; b]`: its items, and whether it is an array, as the Rust
-- parser checks them: an array's last `;` may end it, and `#[;]` is empty.
fun seqShape p (s : Syn) : ([Syn], Bool) ! { Mut | e } =
  let first = V.head (termsIn s) in
  let rest = V.map (\r -> (has TokenSemi r, V.head (termsIn r))) (kids NodeSeqRest s) in
  let array = V.any (\r -> match r with | (semi, _) -> semi) rest in
  let n = V.len rest in
  let u =
    if array then
      let empty = M.isNone first and n == 1 and (match V.get rest 0 with | Just (_, None) -> True | _ -> False) in
      let filled =
        M.isSome first
          and V.all (\i -> match V.get rest i with | Just (_, Just _) -> True | _ -> i + 1 == n) (V.range 0 n)
      in
      if V.any (\r -> match r with | (semi, _) -> not semi) rest then bad p "an array's elements are separated by ;"
      else if not empty and not filled then bad p "an array's elements are separated by single semicolons"
      else ()
    else if (M.isNone first and n > 0) or V.any (\r -> match r with | (_, item) -> M.isNone item) rest then
      bad p "a sequence's elements are separated by single commas"
    else ()
  in
  let items =
    V.append
      (match first with | Just f -> [f] | None -> [])
      (V.concatMap (\r -> match r with | (_, Just t) -> [t] | _ -> []) rest)
  in
  (items, array)

-- A row of effects: `{Log, Div | e}`, `{}`, or one effect, `State Int`.
fun row p (effects : Syn) : Term ! { Mut | e } =
  match V.head (nodesOf effects) with
  | Just r -> rowOf p r
  | None -> Term.Row [] None

fun rowOf p (r : Syn) : Term ! { Mut | e } =
  if is NodeEmptyRow r then Term.Row [] None
  else
    let atoms = atomsIn r in
    match V.get atoms 0 with
    | Just b if V.len atoms == 1 and is NodeBraced b ->
        let labels = V.map (term p) (termsIn b) in
        (match child NodeBraceRest b with
         | None -> Term.Row labels None
         | Just rest ->
             if has NodeFieldVals rest then
               let u = bad p "a row's tail is an effect" in
               Term.Row labels None
             else Term.Row labels (Just (term p (termIn rest))))
    | _ ->
        let one =
          V.map
            (\a ->
              if is NodeName a and not (has NodeAsTail a) then var (nameText a)
              else if is NodeParen a and V.len (termsIn a) == 1 then term p (termIn a)
              else
                let u = bad p "an effect is a name applied to names" in
                Term.Hole)
            atoms
        in
        (match V.head one with
         | Just f -> V.foldl (\acc a -> Term.App acc a) f (V.drop one 1)
         | None -> Term.Hole)

fun lam p (s : Syn) : Term ! { Mut | e } =
  let params = V.concatMap (binder p) (atomsIn s) in
  let body = term p (termIn s) in
  V.foldr (\x acc -> Term.Lam x acc) body params

-- A lambda's binder: `x`, `_`, `[x]`, `(x y)` or `(x y : [2] a)`.
fun binder p (a : Syn) : [Param] ! { Mut | e } =
  if plainName TokenLowerIdent a then [Param.Param (nameText a) False None None]
  else if is NodeHole a then [Param.Param "_" False None None]
  else if is NodeBoxA a and M.isSome (unboxName a) then [Param.Param (M.unwrapOr "" (unboxName a)) True None None]
  else
    let inside = termsIn a in
    match (V.get inside 0, V.len inside) with
    | (Just t, 1) if is NodeParen a and is NodeOp t and not (has NodeArrow t) ->
        (match (names (must NodeChain t) True, child NodeAnnot t) with
         | (Just ns, Just an) ->
             (match annotation p an with
              | (g, ty) -> V.map (\x -> Param.Param x False g (Just ty)) ns)
         | (Just ns, None) -> V.map (\x -> Param.Param x False None None) ns
         | _ -> badBinder p)
    | _ -> badBinder p

fun badBinder p : [Param] ! { Mut | e } =
  let u = bad p "not a binder" in
  []

-- `[x]`'s name.
fun unboxName (b : Syn) : Maybe String =
  match V.head (termsIn b) with
  | Just t if is NodeOp t and not (has NodeAnnot t) and not (has NodeArrow t) ->
      (match names (must NodeChain t) False with
       | Just ns if V.len ns == 1 -> V.head ns
       | _ -> None)
  | _ -> None

fun letE p (s : Syn) : Term ! { Mut | e } =
  let u = braced p s in
  let lines = separated p (V.filter (\n -> is NodeLine n or is NodeSep n) (nodesOf s)) False True in
  let body = term p (termIn s) in
  match (V.get lines 0, V.len lines) with
  | (Just l, 1) if M.isSome (unboxLine l) ->
      (match unboxLine l with
       | Just (x, e) -> Term.LetBox x (term p e) body
       | None -> body)
  | _ ->
      let decls =
        V.concatMap
          (\l ->
            match lineItem p l with
            | Item.Decl d -> [d]
            | _ ->
                let u = bad p "expected a declaration" in
                [])
          lines
      in
      Term.Let decls body

-- `[x] = e`, a `let`'s unboxing.
fun unboxLine (l : Syn) : Maybe (String, Syn) =
  let lhs = termIn l in
  match child NodePlain l with
  | Just plain if is NodeOp lhs and not (has NodeAnnot lhs) and not (has NodeArrow lhs) and not (has NodeEffects l) ->
      let chain = must NodeChain lhs in
      let atoms = atomsIn (must NodeApp chain) in
      (match V.get atoms 0 with
       | Just b if V.len atoms == 1 and not (has NodeLink chain) and is NodeBoxA b ->
           M.map (\x -> (x, termIn plain)) (unboxName b)
       | _ -> None)
  | _ -> None

fun caseE p (s : Syn) : Term ! { Mut | e } =
  let u = braced p s in
  let alts = separated p (V.filter (\n -> is NodeAlt n or is NodeSep n) (nodesOf s)) False True in
  Term.Case (term p (termIn s)) (V.map (alt p) alts)

fun alt p (a : Syn) : Alt ! { Mut | e } =
  let pat = patChain p (must NodeChain a) in
  match (child NodeAltPlain a, child NodeAltGuards a) with
  | (Just plain, _) -> Alt.Alt pat (Rhs.Plain (term p (termIn plain)))
  | (_, Just gs) ->
      Alt.Alt
        pat
        (Rhs.Guarded
           (V.map (\g -> (chainTerm p (must NodeChain g) 0, term p (termIn g))) (kids NodeAltGuard gs)))
  | _ ->
      (match impossibleCon pat with
       | Just q -> Alt.Alt q Rhs.Impossible
       | None ->
           let u = bad p "expected -> or a guard" in
           Alt.Alt pat Rhs.Impossible)

-- `C x impossible`'s pattern, `C x`.
fun impossibleCon (q : Pat) : Maybe Pat =
  match q with
  | Pat.Con c args ->
      (match V.last args with
       | Just last if isImpossible last -> Just (Pat.Con c (V.popBack args))
       | _ -> None)
  | _ -> None

fun isImpossible (q : Pat) : Bool =
  match q with
  | Pat.Bind (Param.Param x False None None) -> x == "impossible"
  | _ -> False

-- `if c then a else b` is `case c of True -> a; False -> b`.
fun ifE p (s : Syn) : Term ! { Mut | e } =
  let ts = V.map (term p) (termsIn s) in
  let at = \i -> V.getOr Term.Hole ts i in
  Term.Case
    (at 0)
    [
      Alt.Alt (Pat.Lit (Literal.Bool True)) (Rhs.Plain (at 1)),
      Alt.Alt (Pat.Lit (Literal.Bool False)) (Rhs.Plain (at 2))
    ]

fun handleE p (s : Syn) : Term ! { Mut | e } =
  let u = braced p s in
  let clauses = separated p (V.filter (\n -> is NodeClause n or is NodeSep n) (nodesOf s)) False True in
  Term.Handle
    (term p (termIn s))
    (V.map
       (\c ->
         Clause.Clause
           (textOf TokenLowerIdent c)
           (V.map (\x -> if has TokenUnderscore x then "_" else textOf TokenLowerIdent x) (kids NodeClauseParam c))
           (term p (termIn c)))
       clauses)

-- --- patterns ----------------------------------------------------------------

-- Patterns joined by `::`, to the right.
fun patChain p (chain : Syn) : Pat ! { Mut | e } =
  let links = kids NodeLink chain in
  let operands = V.append [patOperand p (must NodeApp chain)] (V.map (\l -> patOperand p (must NodeApp l)) links) in
  let u = V.foldl (\acc l -> if linkOp l != "::" then bad p "only :: joins patterns" else acc) () links in
  let n = V.len operands in
  V.foldr
    (\l acc -> Pat.Con "::" [l, acc])
    (V.getOr Pat.Wild operands (n - 1))
    (V.take operands (n - 1))

-- A constructor applied to patterns, or one pattern.
fun patOperand p (app : Syn) : Pat ! { Mut | e } =
  let atoms = atomsIn app in
  match V.get atoms 0 with
  | Just c if V.len atoms >= 2 ->
      if plainName TokenUpperIdent c or plainName TokenQualUpper c then
        Pat.Con (nameText c) (V.map (apat p) (V.drop atoms 1))
      else
        let u = bad p "only a constructor is applied in a pattern" in
        Pat.Wild
  | Just a -> apat p a
  | None -> Pat.Wild

-- A term read again as the pattern it is.
fun patOfTerm p (t : Syn) : Pat ! { Mut | e } =
  if is NodeOp t and not (has NodeAnnot t) and not (has NodeArrow t) then patChain p (must NodeChain t)
  else
    let u = bad p "not a pattern" in
    Pat.Wild

fun apat p (a : Syn) : Pat ! { Mut | e } =
  let k = R.kindOf a in
  if k == NodeName then
    let x = nameText a in
    let nk = nameKind a in
    if nk == TokenLowerIdent then
      match child NodeAsTail a with
      | Just tail -> Pat.As x (apat p (M.unwrapOr tail (V.head (atomsIn tail))))
      | None -> Pat.Bind (Param.Param x False None None)
    else if has NodeAsTail a or nk == TokenQualLower then
      let u = bad p "not a pattern" in
      Pat.Wild
    else if nk == TokenUpperIdent and x == "True" then Pat.Lit (Literal.Bool True)
    else if nk == TokenUpperIdent and x == "False" then Pat.Lit (Literal.Bool False)
    else Pat.Con x []
  else if k == NodeNumber then Pat.Lit (Literal.Int (intLit p a))
  else if k == NodeStrLit then Pat.Lit (Literal.Str (strLit p a))
  else if k == NodeHole then Pat.Wild
  else if k == NodeParen then
    let items = termsIn a in
    if V.isEmpty items then Pat.Lit Literal.Unit else tuplePat (V.map (patOfTerm p) items)
  else if k == NodeRecordLit then
    Pat.Record
      (nameText a)
      (match child NodeFieldVals a with
       | Just fs -> V.map (\f -> (textOf TokenLowerIdent f, patOfTerm p (termIn f))) (kids NodeFieldVal fs)
       | None -> [])
  else if k == NodeDotA then
    match V.head (atomsIn a) with
    | Just n if is NodeName n and not (has NodeAsTail n) and nameKind n != TokenQualLower -> Pat.Dot (var (nameText n))
    | Just q if is NodeParen q and V.len (termsIn q) == 1 -> Pat.Dot (term p (termIn q))
    | _ ->
        let u = bad p "a dot pattern is .x or .(e)" in
        Pat.Wild
  else if k == NodeBoxA then
    match unboxName a with
    | Just x -> Pat.Bind (Param.Param x True None None)
    | None ->
        let u = bad p "an unboxing pattern is [x]" in
        Pat.Wild
  else if k == NodeSeqA then
    match seqShape p a with
    | (items, array) ->
        let u = if array then bad p "array patterns are not supported yet" else () in
        Pat.Seq (V.map (patOfTerm p) items)
  else
    let u = bad p "not a pattern" in
    Pat.Wild

fun tuplePat (items : [Pat]) : Pat =
  let n = V.len items in
  V.foldr (\x acc -> Pat.Con "(,)" [x, acc]) (V.getOr Pat.Wild items (n - 1)) (V.take items (n - 1))

-- An equation's parameters: `(x y : [2] a)` gives each name the annotation;
-- anything else is a pattern.
fun params p (atoms : [Syn]) : [Pat] ! { Mut | e } =
  V.concatMap
    (\a ->
      let inside = termsIn a in
      let group =
        match (V.get inside 0, V.len inside) with
        | (Just t, 1) if is NodeParen a and not (has NodeArrow t) -> annotatedNames t True
        | _ -> None
      in
      match group with
      | Just (ns, an) ->
          (match annotation p an with
           | (g, ty) -> V.map (\x -> Pat.Bind (Param.Param x False g (Just ty))) ns)
      | None -> [apat p a])
    atoms

-- --- declarations ------------------------------------------------------------

data Item
  = Data Data
  | Record Data [Decl]
  | Effect Effect
  | Decl Decl
  | Use Use
  | Expr Term
  | Nothing

-- A name an equation or a signature can be for: `f` or `(+)`.
fun declName (a : Syn) : Maybe String =
  if plainName TokenLowerIdent a then Just (nameText a)
  else if is NodeOpName a and has TokenOpIdent a then Just (textOf TokenOpIdent a)
  else None

fun rhsOf p (line : Syn) : Maybe Rhs ! { Mut | e } =
  match (child NodePlain line, child NodeGuards line) with
  | (Just plain, _) -> Just (Rhs.Plain (term p (termIn plain)))
  | (_, Just gs) ->
      Just
        (Rhs.Guarded
           (V.map
              (\g -> match termsIn g with | ts -> (term p (V.getOr g ts 0), term p (V.getOr g ts 1)))
              (kids NodeGuard gs)))
  | _ -> None

-- An item's line: an equation, a signature, an operator's equation, an
-- equation with nothing to say -- or else the program's expression.
fun lineItem p (line : Syn) : Item ! { Mut | e } =
  let lhs = termIn line in
  let effects = child NodeEffects line in
  let rhs = rhsOf p line in
  if is NodeOp lhs then
    let chain = must NodeChain lhs in
    let links = kids NodeLink chain in
    let atoms = atomsIn (must NodeApp chain) in
    let named = match V.head atoms with | Just a -> declName a | None -> None in
    match named with
    | Just f if V.isEmpty links and not (has NodeArrow lhs) ->
        (match (child NodeAnnot lhs, rhs) with
         | (Just an, Just r) -> Item.Decl (Decl.Def f (params p (V.drop atoms 1)) (Just (comp p (termIn an) effects)) r)
         | (Just an, None) ->
             if V.len atoms == 1 then Item.Decl (Decl.Sig f (comp p (termIn an) effects))
             else expr p lhs effects
         | (None, Just r) ->
             let u = if M.isSome effects then bad p "effects go on a type" else () in
             Item.Decl (Decl.Def f (params p (V.drop atoms 1)) None r)
         | (None, None) ->
             (match impossible atoms with
              | Just ps if M.isNone effects -> Item.Decl (Decl.Def f ps None Rhs.Impossible)
              | _ -> expr p lhs effects))
    | _ ->
        (match (V.get links 0, rhs) with
         | (Just l, Just r) if V.len links == 1 and has TokenOpIdent l and not (has NodeAnnot lhs) and not (has NodeArrow lhs) ->
             let u = if M.isSome effects then bad p "effects go on a type" else () in
             Item.Decl (Decl.Def (linkOp l) [patOperand p (must NodeApp chain), patOperand p (must NodeApp l)] None r)
         | (_, Just _) ->
             let u = bad p "an equation is f x = e or l + r = e" in
             Item.Nothing
         | _ -> expr p lhs effects)
  else
    match rhs with
    | Just _ ->
        let u = bad p "an equation is f x = e or l + r = e" in
        Item.Nothing
    | None -> expr p lhs effects

fun expr p (lhs : Syn) (effects : Maybe Syn) : Item ! { Mut | e } =
  let u = if M.isSome effects then bad p "effects go on a type" else () in
  Item.Expr (term p lhs)

-- `f p q impossible`'s patterns, `p q`, if they are patterns.
fun impossible (atoms : [Syn]) : Maybe [Pat] ! { Mut | e } =
  match V.last atoms with
  | Just last if V.len atoms >= 3 and plainName TokenLowerIdent last and nameText last == "impossible" ->
      (match tried (\q -> params q (V.slice atoms 1 (V.len atoms - 1))) with
       | (True, ps) -> Just ps
       | _ -> None)
  | _ -> None

-- A data type's or an effect's parameter: `a`, or `(a : k)`.
fun typeParam p (a : Syn) : (String, Maybe Term) ! { Mut | e } =
  if plainName TokenLowerIdent a then (nameText a, None)
  else
    let inside = termsIn a in
    match (V.get inside 0, V.len inside) with
    | (Just t, 1) if is NodeParen a and is NodeOp t and has NodeAnnot t ->
        (match names (must NodeChain t) False with
         | Just ns if V.len ns == 1 -> (V.getOr "" ns 0, Just (term p (termIn (must NodeAnnot t))))
         | _ -> badParam p)
    | _ -> badParam p

fun badParam p : (String, Maybe Term) ! { Mut | e } =
  let u = bad p "a parameter is a or (a : k)" in
  ("_", None)

fun ctorName (s : Syn) : String =
  match (child NodePlainCtor s, child NodeParenCtor s) with
  | (Just c, _) -> textOf TokenUpperIdent c
  | (_, Just c) -> if has TokenConOpIdent c then textOf TokenConOpIdent c else textOf TokenUpperIdent c
  | _ -> ""

-- A constructor's field: a name, `Type`, or a term in parentheses.
fun fieldTerm p (a : Syn) : Term ! { Mut | e } =
  if plainName TokenUpperIdent a or plainName TokenLowerIdent a then var (nameText a)
  else if is NodeTypeA a then Term.Type
  else if is NodeParen a and V.len (termsIn a) == 1 then term p (termIn a)
  else
    let u = bad p "a field is a name, Type or a term in parentheses" in
    Term.Hole

fun dataDecl p (s : Syn) : Data ! { Mut | e } =
  let ctors =
    match (child NodeCtors s, child NodeCtorSigs s) with
    | (Just cs, _) -> V.map (\c -> (ctorName c, Ctor.Fields (V.map (fieldTerm p) (atomsIn c)))) (kids NodeCtor cs)
    | (_, Just sigs) ->
        let u = braced p sigs in
        V.map
          (\c -> (ctorName c, Ctor.Sig (term p (termIn c))))
          (separated p (V.filter (\n -> is NodeCtorSig n or is NodeSep n) (nodesOf sigs)) True False)
    | _ -> []
  in
  Data {
    name = textOf TokenUpperIdent s,
    params = V.map (typeParam p) (atomsIn s),
    kind = M.map (\k -> term p (termIn k)) (child NodeKind s),
    ctors,
    seq = None,
    visibility = Visibility.Private,
    fields = None
  }

-- `record Point = { x : Int, y : Int }`: a data type with one constructor,
-- named for the type, and its fields' projections, `Point.x`.
fun recordDecl p (s : Syn) : Item ! { Mut | e } =
  let name = textOf TokenUpperIdent s in
  let ps = V.map (typeParam p) (atomsIn s) in
  let fields = V.map (\f -> (textOf TokenLowerIdent f, term p (termIn f))) (kids NodeFieldDecl s) in
  let whole = V.foldl (\acc q -> match q with | (x, _) -> Term.App acc (var x)) (var name) ps in
  let ctorTy = V.foldr (\f acc -> match f with | (x, ty) -> Term.Pi (Just x) Icit.Explicit None ty acc) whole fields in
  let d =
    Data {
      name,
      params = ps,
      kind = None,
      ctors = [(name, Ctor.Sig ctorTy)],
      seq = None,
      visibility = Visibility.Private,
      fields = Just (V.map (\f -> match f with | (x, _) -> x) fields)
    }
  in
  let droppable = Grade.Grade (Term.Range (Term.Lit (Literal.Int 0)) (Term.Lit (Literal.Int 1))) None in
  let projections =
    V.concatMap
      (\i ->
        match V.get fields i with
        | Just (f, ty) ->
            let projection = "${name}.${f}" in
            let ty2 =
              V.foldl
                (\t g -> match g with | (x, _) -> substitute t x (Term.App (var "${name}.${x}") (var "self")))
                ty
                (V.take fields i)
            in
            let sig = Term.Pi (Just "self") Icit.Explicit (Just droppable) whole ty2 in
            let pats =
              V.map
                (\j -> if j == i then Pat.Bind (Param.Param f False None None) else Pat.Wild)
                (V.range 0 (V.len fields))
            in
            [Decl.Sig projection sig, Decl.Def projection [Pat.Con name pats] None (Rhs.Plain (var f))]
        | None -> [])
      (V.range 0 (V.len fields))
  in
  Item.Record d projections

-- `effect State (s : Type) where get : () -> s`, or `effect App = {Log, Ask}`,
-- a name for a row: a definition, `App = {Log, Ask}`, its parameters
-- lambdas, each used as often as the row mentions it.
fun effectDecl p (s : Syn) : Item ! { Mut | e } =
  let name = textOf TokenUpperIdent s in
  let ps = V.map (typeParam p) (atomsIn s) in
  match (child NodeOpBlock s, child NodeEffectAlias s) with
  | (Just block, _) ->
      let u = braced p block in
      let ops =
        V.map
          (\o ->
            let many = M.isSome (child NodeOpAttr o) in
            let v = match child NodeOpAttr o with | Just at -> (if textOf TokenLowerIdent at != "many" then bad p "an operation may be @many" else ()) | None -> () in
            OpSig.OpSig (textOf TokenLowerIdent o) (term p (termIn o)) many)
          (separated p (V.filter (\n -> is NodeOpSig n or is NodeSep n) (nodesOf block)) True False)
      in
      Item.Effect (Effect { name, params = ps, ops, visibility = Visibility.Private })
  | (_, Just alias) ->
      let body =
        V.foldr
          (\q acc ->
            match q with
            | (x, kind) ->
                Term.Lam (Param.Param x False (Just (Grade.Grade anyGrade None)) (Just (M.unwrapOr Term.Type kind))) acc)
          (row p alias)
          ps
      in
      Item.Decl (Decl.Def name [] None (Rhs.Plain body))
  | _ -> Item.Nothing

fun useDecl p (s : Syn) : Use ! { Mut | e } =
  let path = if has TokenQualUpper s then S.split "." (textOf TokenQualUpper s) else [textOf TokenUpperIdent s] in
  let glob = has TokenOpIdent s in
  let u1 = if glob and textOf TokenOpIdent s != ".*" then bad p "use M.* brings in everything" else () in
  let alias =
    M.map
      (\a ->
        let v = if textOf TokenLowerIdent a != "as" then bad p "expected as" else () in
        textOf TokenUpperIdent a)
      (child NodeUseAlias s)
  in
  let names =
    M.map
      (\ns ->
        let items = kids NodeUseName ns in
        let v = if V.isEmpty items then bad p "a use names something in its parentheses" else () in
        V.map
          (\n ->
            match V.find (\t -> R.isTokenOf t and R.kindOf t != Unknown and R.kindOf t != TokenLParen and R.kindOf t != TokenRParen) (R.children n) with
            | Just t -> R.text t
            | None -> "")
          items)
      (child NodeUseNames s)
  in
  let u2 = if glob and (M.isSome alias or M.isSome names) then bad p "use M.* takes no names and no alias" else () in
  Use { public = False, path, glob, alias, names }

-- --- attributes --------------------------------------------------------------

data Attribute = Seq String String | Vis Visibility | Native | Terminating | Linear

fun attribute p (line : Syn) : Maybe Attribute ! { Mut | e } =
  let name = textOf TokenLowerIdent line in
  let args =
    match child NodeAttrArgs line with
    | Just a -> Just (V.map (\x -> (textOf TokenLowerIdent x, M.map ctorName (child NodeAttrValue x))) (kids NodeAttrArg a))
    | None -> None
  in
  let arg = \i -> match args with | Just xs -> V.get xs i | None -> None in
  let count = match args with | Just xs -> V.len xs + 1 | None -> 0 in
  match (name, count, arg 0, arg 1) with
  | ("seq", 3, Just ("nil", Just nil), Just ("cons", Just cons)) -> Just (Attribute.Seq nil cons)
  | ("pub", 0, _, _) -> Just (Attribute.Vis Visibility.Public)
  | ("pub", 2, Just ("pkg", None), _) -> Just (Attribute.Vis Visibility.Package)
  | ("pub", 2, Just ("super", None), _) -> Just (Attribute.Vis Visibility.Super)
  | ("native", 0, _, _) -> Just Attribute.Native
  | ("terminating", 0, _, _) -> Just Attribute.Terminating
  | ("linear", 0, _, _) -> Just Attribute.Linear
  | _ ->
      let u = bad p "not an attribute: @${name}" in
      None

record Attrs = {
  seq : Maybe (String, String),
  vis : Maybe Visibility,
  native : Bool,
  terminating : Bool,
  linear : Bool
}

-- An item with its attributes on it, as `idyllic-parser`'s `attributed`
-- puts them: the item, how visible it is, whether it is `@terminating`, and
-- whether `@linear` came before it.
fun attributed p (lines : [Syn]) (item : Item) : (Item, Maybe Visibility, Bool, Bool) ! { Mut | e } =
  let twice = \u -> bad p "this attribute is given twice" in
  let a =
    V.foldl
      (\(acc : Attrs) line ->
        match attribute p line with
        | Just (Attribute.Seq nil cons) ->
            if M.isSome acc.seq then let u = twice () in acc else { acc | seq = Just (nil, cons) }
        | Just (Attribute.Vis v) -> if M.isSome acc.vis then let u = twice () in acc else { acc | vis = Just v }
        | Just Attribute.Native -> if acc.native then let u = twice () in acc else { acc | native = True }
        | Just Attribute.Terminating ->
            if acc.terminating then let u = twice () in acc else { acc | terminating = True }
        | Just Attribute.Linear -> { acc | linear = True }
        | None -> acc)
      (Attrs { seq = None, vis = None, native = False, terminating = False, linear = False })
      lines
  in
  let item =
    if not a.native then item
    else
      match item with
      | Item.Decl (Decl.Sig f ty) -> Item.Decl (Decl.Native f ty)
      | Item.Expr (Term.Ann (Term.Var x) ty) if not (S.contains "." x) -> Item.Decl (Decl.Native x ty)
      | _ ->
          let u = bad p "@native goes on a signature, f : a" in
          item
  in
  let u1 =
    if a.terminating then
      match item with
      | Item.Decl (Decl.Sig _ _) -> ()
      | _ -> bad p "@terminating goes on a definition's signature, f : a"
    else ()
  in
  let vis = M.unwrapOr Visibility.Private a.vis in
  let seqUsed = match item with | Item.Data _ -> True | _ -> False in
  let item =
    match item with
    | Item.Data (d : Data) -> Item.Data { d | seq = a.seq, visibility = vis }
    | Item.Effect (e : Effect) -> Item.Effect { e | visibility = vis }
    | Item.Record (d : Data) ps -> Item.Record { d | visibility = vis } ps
    | Item.Use (u : Use) ->
        let v =
          match a.vis with
          | Just Visibility.Public -> ()
          | Just _ -> bad p "a use is given on with @pub, or not at all"
          | None -> ()
        in
        Item.Use { u | public = M.isSome a.vis }
    | Item.Expr e ->
        let v = if M.isSome a.vis or M.isSome a.seq then bad p "an expression has no attributes" else () in
        item
    | other -> other
  in
  let u2 = if M.isSome a.seq and not seqUsed then bad p "@seq goes on a data type" else () in
  (item, a.vis, a.terminating, a.linear)

-- --- the program -------------------------------------------------------------

fun itemOf p (s : Syn) : Item ! { Mut | e } =
  match V.find (\n -> not (is NodeAttrLine n)) (nodesOf s) with
  | Just body ->
      let k = R.kindOf body in
      if k == NodeDataDecl then Item.Data (dataDecl p body)
      else if k == NodeRecordDecl then recordDecl p body
      else if k == NodeEffectDecl then effectDecl p body
      else if k == NodeUseDecl then Item.Use (useDecl p body)
      else lineItem p body
  | None -> Item.Nothing

-- The name a definition's visibility is for.
fun defined (d : Decl) : String =
  match d with
  | Decl.Sig x _ -> x
  | Decl.Def x _ _ _ -> x
  | Decl.Native x _ -> x

fun program p (root : Syn) : Program ! { Mut | e } =
  let entries = separated p (V.filter (\n -> is NodeItem n or is NodeSep n) (nodesOf root)) True False in
  let n = V.len entries in
  V.foldl
    (\(prog : Program) i ->
      let s = V.getOr root entries i in
      match attributed p (kids NodeAttrLine s) (itemOf p s) with
      | (item, vis, terminating, linear) ->
          let prog = { prog | linear = prog.linear or linear } in
          (match item with
           | Item.Data d -> { prog | datas = V.pushBack prog.datas d }
           | Item.Record d ps ->
               let shown =
                 if d.visibility == Visibility.Private then []
                 else V.concatMap (\q -> match q with | Decl.Sig x _ -> [(x, d.visibility)] | _ -> []) ps
               in
               {
                 prog |
                 decls = V.append prog.decls ps,
                 visibility = V.append prog.visibility shown,
                 datas = V.pushBack prog.datas d
               }
           | Item.Effect e -> { prog | effects = V.pushBack prog.effects e }
           | Item.Decl d ->
               {
                 prog |
                 visibility = (match vis with | Just v -> V.pushBack prog.visibility (defined d, v) | None -> prog.visibility),
                 terminating = if terminating then V.pushBack prog.terminating (defined d) else prog.terminating,
                 decls = V.pushBack prog.decls d
               }
           | Item.Use u -> { prog | uses = V.pushBack prog.uses u }
           | Item.Expr e ->
               if i + 1 == n then { prog | body = Just e }
               else
                 let u = bad p "an expression can only come last in a program" in
                 prog
           | Item.Nothing -> prog))
    (Program {
       datas = [],
       effects = [],
       decls = [],
       uses = [],
       visibility = [],
       terminating = [],
       linear = False,
