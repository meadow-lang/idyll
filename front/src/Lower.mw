-- A checked Idyll program, lowered to Cut: `compiler/idyllic-cut/src/lower.rs`.
--
-- The elaborated program is Core: the top-level definitions as `let`s
-- around the program's expression, and the recursive ones apart. Each
-- top-level definition becomes a `def` if it is a function and a `val` if
-- not; the expression becomes the entry, a `def` with nothing but its
-- continuation.
--
-- Terms are lowered in continuation-passing style: a term and the consumer
-- its value goes to make a statement, and an argument is computed into a
-- variable first, so that arguments are computed left to right, before the
-- call, as Idyll's are. What erasure promised is kept: an argument of grade
-- `0` is never computed, and a binder of grade `0` is no parameter, except
-- that a type parameter becomes a descriptor parameter and a type argument
-- a descriptor, which is how a function generic in a type is told how its
-- values are represented. Every binder's representation comes from its
-- type, by `Typer`.
--
-- A recursive definition inside another is lifted out to a `def` of its
-- own, since Cut has no local recursion: what it uses of where it was
-- defined becomes its first parameters, and every use of it passes them.
--
-- The program's answer is written out as the REPL writes it, since the
-- runtimes print only strings; and a native the runtime has no primitive
-- for is a `def` of the program's own.

use Idyll.Hir (Literal)
use Idyll.Core (Core, Builtin, Prim, Note, Head, CaseAlt, OpClause)
use Idyll.Core as C
use Idyll.Value (Value)
use Idyll.Grade (Grade)
use Idyll.Grade as G
use Idyll.Tc (Tc, Meta, CtorInfo, OpInfo, EffectInfo)
use Idyll.Tc as T
use Idyll.Eval (quote)
use Idyll.Ctx (Ctx)
use Idyll.Ctx as X
use Idyll.Typer (TRep, Shown)
use Idyll.Typer as Ty
use Idyll.Prune as Pr
use Idyll.Check (Checked)
use Idyll.CutAst (Rep, Sym, Binder, Prod, Method, Cons, Arm, Stmt, Clause, CData, COp, CEffect, CDef, CVal, CProgram)
use Idyll.CutAst as A
use Std.Collections.Vector as V
use Std.Collections.HashMap as Hm
use Std.Collections.HashMap (HashMap)
use Std.String as S
use Std.Maybe as M
use Std.Maybe.Maybe.*
use Std.Result.Result.*

-- The runtime's operation for each of the prelude's world operations that
-- has one of the same shape.
def nativeOps : [(String, String)] =
  [
    ("putStr", "Console.writeOutput"), ("putErr", "Console.writeError"), ("readLine", "Console.readLine"),
    ("readToString", "Fs.readToString"), ("writeString", "Fs.writeString"), ("appendString", "Fs.appendString"),
    ("removeFile", "Fs.removeFile"), ("createDir", "Fs.createDir"), ("createDirAll", "Fs.createDirAll"),
    ("removeDir", "Fs.removeDir"), ("removeDirAll", "Fs.removeDirAll"), ("rename", "Fs.rename"), ("copy", "Fs.copy"),
    ("listDir", "Fs.readDir"), ("exists", "Fs.exists"), ("isFile", "Fs.isFile"), ("isDir", "Fs.isDir"),
    ("exit", "Process.exit"), ("currentPid", "Process.currentPid"), ("argv", "Process.argv"), ("getEnv", "Process.getEnv"),
    ("setEnv", "Process.setEnv"), ("removeEnv", "Process.removeEnv"), ("isTerminal", "Process.isTerminal"),
    ("nextInt", "Random.nextInt"), ("intBetween", "Random.intBetween"), ("nextSeed", "Random.nextSeed"),
    ("now", "Time.now"), ("monotonic", "Time.monotonic"), ("sleep", "Time.sleep"), ("fail", "Test.fail")
  ]

-- The roles the prelude's types play, by their paths there.
def roles : [(String, String)] =
  [("none", "Maybe.Nothing"), ("some", "Maybe.Just"), ("err", "Result.Err"), ("ok", "Result.Ok"), ("nil", "List.Nil"), ("cons", "List.::")]

-- The runtime's primitive that joins strings, given an array of them.
def concatOp = "concatStrings"

-- What a parameter of a function becomes: a value, a descriptor (for a
-- type parameter), or nothing.
@derive(PartialEq)
data Param = PValue Rep | PDesc | PSkip

-- What a variable of Core's context is, in Cut.
data Slot
  = SVar String
  -- a type parameter: the descriptor variable carrying it, if there is
  -- one, and the representation variable it is
  | STypeVar (Maybe String) String
  | SErased
  | SVal Sym
  | SDef Sym [Param]
  | SPrim Prim
  -- a handler clause's resumption
  | SResume String

-- The slots of Core's context, and the typer's scope.
data LEnv = LEnv [Slot] Ctx

fun slotsOf (e : LEnv) : [Slot] = match e with | LEnv.LEnv s _ -> s

fun scopeOf (e : LEnv) : Ctx = match e with | LEnv.LEnv _ c -> c

fun pushSlot (e : LEnv) (s : Slot) : LEnv = match e with | LEnv.LEnv ss c -> LEnv.LEnv (V.pushBack ss s) c

fun withScope (e : LEnv) (c : Ctx) : LEnv = match e with | LEnv.LEnv ss _ -> LEnv.LEnv ss c

fun lenOf (e : LEnv) : Int = V.len (slotsOf e)

-- The levels a term uses: as values, and at all.
data Uses = Uses [Int] [Int]

-- What shows a data type's values: its `def`, the one for when it is a
-- field, and for the prelude's pair, what writes its items.
data ShowDefs = ShowDefs Sym (Maybe Sym) (Maybe Sym)

-- What a partial application is of.
data Head2 = HCall Sym | HCon Sym | HPerform Sym | HPrim String

record L = {
  tc : Tc,
  linear : Bool,
  symbols : HashMap Int (String, String),
  -- each recursive definition: its name, level, body, and whether it is
  -- inside another
  recs : HashMap Int (String, Int, Core, Bool),
  recParams : Ref (HashMap Int [Param]),
  local : Ref (HashMap Int (Int, Uses)),
  lifted : Ref (HashMap Int (Sym, [Param], [Int])),
  package : String,
  toplevel : [Int],
  levels : Ref [LEnv],
  fresh : Ref Int,
  defs : Ref [CDef],
  vals : Ref [CVal],
  datas : Ref [Int],
  effects : Ref [Int],
  performed : Ref [Int],
  errors : Ref [String],
  shows : Ref (HashMap String (Maybe ShowDefs)),
  handledByEntry : Ref (Maybe Int),
  nativesMade : Ref [String],
  atoms : Ref [String],
  showDefs : Ref [CDef],
  showInt : Ref (Maybe Sym)
}

-- --- small things ----------------------------------------------------------------------

fun vecOf (m : Maybe a) : [a] =
  match m with
  | Just x -> [x]
  | None -> []

fun insertSorted (xs : [Int]) (x : Int) : [Int] =
  if V.elem x xs then xs else V.concat [V.filter (\y -> y < x) xs, [x], V.filter (\y -> y > x) xs]

fun note (r : Ref [Int]) (x : Int) = setRef r (insertSorted (getRef r) x)

fun err (l : L) (why : String) = setRef l.errors (V.pushBack (getRef l.errors) why)

fun byte (s : String) (i : Int) : Int =
  match S.byteAt s i with
  | Just b -> toInt b
  | None -> 0

fun isAlnum (c : Int) : Bool = (c >= 48 and c <= 57) or (c >= 65 and c <= 90) or (c >= 97 and c <= 122)

-- A fresh name, from a hint: what is not a letter or digit made `_`.
fun name (l : L) (hint : String) : String ! { Mut | e } =
  let n = getRef l.fresh + 1 in
  let w = setRef l.fresh n in
  let clean = S.join "" (V.map (\i -> if isAlnum (byte hint i) then S.slice hint i (i + 1) else "_") (V.range 0 (S.byteLength hint))) in
  let first = byte clean 0 in
  let clean2 = if (first >= 65 and first <= 90) or (first >= 97 and first <= 122) then clean else "v" ++ clean in
  clean2 ++ "_" ++ show n

fun symbol (l : L) (u : Int) : Maybe Sym =
  M.map (\pp -> match pp with | (p, path) -> A.idyll p path) (Hm.lookup u l.symbols)

fun symbolOr (l : L) (u : Int) (fallback : String) : Sym = M.unwrapOr (A.idyll "" fallback) (symbol l u)

-- A representation the typer gave, in terms of the context's variables.
fun rep (env : LEnv) (r : TRep) : Rep =
  match r with
  | TRep.I64 -> Rep.I64
  | TRep.Bool -> Rep.Bool
  | TRep.Unit -> Rep.Unit
  | TRep.Erased -> Rep.Unit
  | TRep.Str -> Rep.Str
  | TRep.Ptr -> Rep.Ptr
  | TRep.Any -> Rep.Any
  | TRep.Var lvl ->
      (match V.get (slotsOf env) lvl with
       | Just (Slot.STypeVar (Just _) a) -> Rep.Var a
       | _ -> Rep.Any)

fun repOf (l : L) (env : LEnv) (c : Core) : Rep ! { Mut | e } = rep env (Ty.repOf l.tc (scopeOf env) c)

-- A lambda's variable, its grade if a constant, its type if noted, and its
-- body, through the note on it.
fun lambda (c : Core) : Maybe (String, Maybe Grade, Maybe Core, Core) =
  match c with
  | Core.Lam x body -> Just (x, None, None, body)
  | Core.Runtime (Note.Binds grade ty) (Core.Lam x body) -> Just (x, grade, ty, body)
  | _ -> None

fun spine (c : Core) (args : [Core]) : (Core, [Core]) =
  match c with
  | Core.App f a -> spine f (V.append [a] args)
  | _ -> (c, args)

fun primArgs (op : String) (args : [Prod]) : [Prod] = if op == concatOp then [Prod.Array args] else args

fun ctorInfo (l : L) (u : Int) : Maybe CtorInfo ! { Mut | e } = T.ctorInfo l.tc u

fun opInfo (l : L) (u : Int) : Maybe OpInfo ! { Mut | e } = Hm.lookup u (getRef l.tc.ops)

-- --- entry -----------------------------------------------------------------------------

-- `c` with each solved metavariable replaced by its solution.
fun zonk (sols : [Maybe Core]) (c : Core) : Core =
  let go = \x -> zonk sols x in
  match c with
  | Core.Meta m ->
      (match M.andThen (\x -> x) (V.get sols m) with
       | Just s -> zonk sols s
       | None -> c)
  | Core.Pi x i g r d cod -> Core.Pi x i (go g) (go r) (go d) (go cod)
  | Core.Lam x b -> Core.Lam x (go b)
  | Core.App a b -> Core.App (go a) (go b)
  | Core.BoxTy a b -> Core.BoxTy (go a) (go b)
  | Core.BoxIntro a -> Core.BoxIntro (go a)
  | Core.Unbox a -> Core.Unbox (go a)
  | Core.Let x e b -> Core.Let x (go e) (go b)
  | Core.GradeAdd a b -> Core.GradeAdd (go a) (go b)
  | Core.GradeMul a b -> Core.GradeMul (go a) (go b)
  | Core.GradeRange a b -> Core.GradeRange (go a) (go b)
  | Core.Case s alts -> Core.Case (go s) (V.map (\a -> match a with | CaseAlt.CaseAlt h n vs b -> CaseAlt.CaseAlt h n vs (go b)) alts)
  | Core.Runtime (Note.Binds g (Just t)) a -> Core.Runtime (Note.Binds g (Just (go t))) (go a)
  | Core.Runtime n a -> Core.Runtime n (go a)
  | Core.Comp a e -> Core.Comp (go a) (go e)
  | Core.Row ls ts -> Core.Row (V.map go ls) (V.map go ts)
  | Core.Handle b r ops -> Core.Handle (go b) (go r) (V.map (\o -> match o with | OpClause.OpClause u n e body -> OpClause.OpClause u n e (go body)) ops)
  | _ -> c

-- Lower a checked program, whose own package is `package`.
@pub fun lower (checked : Checked) (package : String) : Result [String] CProgram ! { Mut | e } =
  let tc = checked.tc in
  -- an answer is shown with the prelude's `showInt`, so it stays
  let showIntU = V.find (\kv -> snd kv == ("Prelude", "showInt")) (Hm.toVec checked.symbols) in
  let roots = V.map fst (vecOf showIntU) in
  match checked.program with
  | None -> Err ["there is no program: it only declares"]
  | Just program0 ->
      -- what the program never uses is left out
      let (pruned, live) = Pr.prune program0 checked.toplevel (getRef tc.recDefs) (getRef tc.ctors) roots in
      -- a hole is lowered as what it was solved with
      let sols = V.map (\m -> match m with | Meta.Solved v _ -> Just (quote tc 0 v) | _ -> None) (getRef tc.metas) in
      let program = zonk sols pruned in
      let names = getRef tc.recNames in
      let locals = getRef tc.localRecs in
      let recs =
        V.foldl
          (\acc d ->
            match d with
            | (u, lvl, core) ->
                if V.elem u live then Hm.insert u (Hm.getOr "" u names, lvl, zonk sols core, V.elem u locals) acc else acc)
          Hm.empty
          (getRef tc.recDefs)
      in
      let l =
        L {
          tc,
          linear = checked.linear,
          symbols = checked.symbols,
          recs,
          recParams = newRef Hm.empty,
          local = newRef Hm.empty,
          lifted = newRef Hm.empty,
          package,
          toplevel = checked.toplevel,
          levels = newRef [],
          fresh = newRef 0,
          defs = newRef [],
          vals = newRef [],
          datas = newRef [],
          effects = newRef [],
          performed = newRef [],
          errors = newRef [],
          shows = newRef Hm.empty,
          handledByEntry = newRef None,
          nativesMade = newRef [],
          atoms = newRef [],
          showDefs = newRef [],
          showInt = newRef None
        }
      in
      let w0 = setRef l.showInt (M.andThen (\kv -> symbol l (fst kv)) showIntU) in
      -- the context every program starts in: the builtins, then the
      -- primitives
      let prims = [Prim.IntAdd, Prim.IntMul, Prim.IntSub, Prim.IntLt, Prim.IntEq, Prim.IntDiv, Prim.IntMod, Prim.StrAppend] in
      let env0 = LEnv.LEnv (V.append (V.replicate 7 Slot.SErased) (V.map (\p -> Slot.SPrim p) prims)) (Ty.scope tc) in
      let base = 15 in
      let w1 = setRef l.local (localFreeLevels recs (owners program (V.len checked.toplevel) base recs)) in
      let w2 = setRef l.levels [env0] in
      -- the top-level definitions, and the scope at each level they reach
      let (env, c) = toplevels l env0 program 0 in
      let w3 =
        V.foldl
          (\acc kv ->
            match kv with
            | (u, (nm, lvl, core, isLocal)) ->
                -- one inside another is lifted where it is used, if it is
                if isLocal then ()
                else
                  (match V.find (\e -> lenOf e == lvl) (getRef l.levels) with
                   | None -> err l (nm ++ " is a recursive definition the lowering cannot place")
                   | Just at ->
                       let d = defOf l (M.unwrapOr (A.idyll package nm) (symbol l u)) at core in
                       setRef l.defs (V.pushBack (getRef l.defs) d)))
          ()
          (Hm.toVec recs)
      in
      -- the entry: the program's expression, written out as the REPL
      -- writes it, given to `halt`
      let k = name l "k" in
      let shownAnswer =
        match checked.bodyType with
        | Just ty -> showAnswer l (scopeOf env) (Ty.evalType tc (scopeOf env) ty) (Cons.KVar k)
        | None -> None
      in
      let (answer, kEntry) =
        match shownAnswer with
        | Just (_, shownK) -> (True, shownK)
        | None -> (False, Cons.KVar k)
      in
      let w4 =
        if answer then
          let shows = getRef l.showDefs in
          let w = setRef l.showDefs [] in
          setRef l.defs (V.append (getRef l.defs) shows)
        else ()
      in
      let entry = A.idyll package "#entry" in
      -- `abort`, which no runtime operation does, given up on in the
      -- program's own code: a handler around everything
      let abort = preludeOp l "abort" in
      let aborts =
        M.andThen
          (\au ->
            let u = fst au in
            if mentionsConst c u or V.any (\d -> match d with | (_, _, core, _) -> mentionsConst core u) (Hm.values recs) or letsMention program (V.len checked.toplevel) u then
              Just u
            else None)
          abort
      in
      let body =
        match aborts with
        | Just au ->
            let b = name l "b" in
            let inner = term l env c (Cons.KVar b) in
            let r = repOf l env c in
            let w = setRef l.handledByEntry (Just au) in
            abortHandler l au b inner r kEntry
        | None -> term l env c kEntry
      in
      let w5 = setRef l.defs (V.pushBack (getRef l.defs) (CDef.CDef entry [] [] [] [k] body)) in
      let out = declarations l (Just entry) answer in
      if V.isEmpty (getRef l.errors) then Ok out else Err (getRef l.errors)

-- The top-level `let`s: each a slot, and the scope after it a level.
fun toplevels (l : L) (env : LEnv) (c : Core) (i : Int) : (LEnv, Core) ! { Mut | e } =
  match c with
  | Core.Let x rhs body ->
      if i >= V.len l.toplevel then (env, c)
      else
        let sym = M.unwrapOr (A.idyll l.package x) (M.andThen (\u -> symbol l u) (V.get l.toplevel i)) in
        let slot = toplevel l env sym rhs in
        let env2 = pushSlot (withScope env (Ty.define l.tc (scopeOf env) x rhs)) slot in
        let w = setRef l.levels (V.pushBack (getRef l.levels) env2) in
        toplevels l env2 body (i + 1)
  | _ -> (env, c)

-- A world operation of the prelude's, by name: its unique and its effect.
fun preludeOp (l : L) (opName : String) : Maybe (Int, Int) ! { Mut | e } =
  M.map
    (\kv -> match kv with | (u, OpInfo.OpInfo _ eff _ _ _ _) -> (u, eff))
    (V.find
       (\kv ->
         match kv with
         | (u, OpInfo.OpInfo n _ _ _ _ _) -> n == opName and (match Hm.lookup u l.symbols with | Just (p, _) -> p == "Prelude" | None -> False))
       (Hm.toVec (getRef l.tc.ops)))

-- Whether `c` mentions the constant `u`.
fun mentionsConst (c : Core) (u : Int) : Bool =
  let go = \x -> mentionsConst x u in
  match c with
  | Core.Opaque v _ -> v == u
  | Core.Pi _ _ g r d cod -> go g or go r or go d or go cod
  | Core.Lam _ b -> go b
  | Core.BoxIntro b -> go b
  | Core.Unbox b -> go b
  | Core.Runtime _ b -> go b
  | Core.App a b -> go a or go b
  | Core.BoxTy a b -> go a or go b
  | Core.Let _ a b -> go a or go b
  | Core.GradeAdd a b -> go a or go b
  | Core.GradeMul a b -> go a or go b
  | Core.GradeRange a b -> go a or go b
  | Core.Comp a b -> go a or go b
  | Core.Case s alts -> go s or V.any (\a -> match a with | CaseAlt.CaseAlt _ _ _ b -> go b) alts
  | Core.Row a b -> V.any go (V.append a b)
  | Core.Handle b r ops -> go b or go r or V.any (\o -> match o with | OpClause.OpClause _ _ _ body -> go body) ops
  | _ -> False

-- Whether one of the program's first `n` (top-level) definitions mentions `u`.
fun letsMention (c : Core) (n : Int) (u : Int) : Bool =
  if n <= 0 then False
  else
    match c with
    | Core.Let _ rhs rest -> mentionsConst rhs u or letsMention rest (n - 1) u
    | _ -> False

-- `body`, its value to `b`, under a handler for the prelude's `Abort` that
-- does what Idyll's world does: the message on standard error, then exit
-- status 1.
fun abortHandler (l : L) (abort : Int) (b : String) (body : Stmt) (r : Rep) (k : Cons) : Stmt ! { Mut | e } =
  match (preludeOp l "putErr", preludeOp l "exit") with
  | (Just (putErr, console), Just (exit, process)) ->
      let abortEffect = match opInfo l abort with | Just (OpInfo.OpInfo _ eff _ _ _ _) -> eff | None -> 0 - 1 in
      let w =
        V.foldl
          (\acc oe -> match oe with | (op, eff) -> (let x = note l.performed op in note l.effects eff))
          ()
          [(putErr, console), (exit, process), (abort, abortEffect)]
      in
      (match (symbol l abort, symbol l putErr, symbol l exit) with
       | (Just abortS, Just putErrS, Just exitS) ->
           let message = name l "message" in
           let line = name l "line" in
           let rr = name l "r" in
           let kc = name l "k" in
           let u = name l "u" in
           let w2 = name l "u" in
           let thenExit = Stmt.Perform exitS [Prod.Int 1] (Cons.MuT (Binder.Binder w2 Rep.Unit) (Stmt.Cut (Prod.Var w2) (Cons.KVar kc))) in
           let clauseBody =
             Stmt.Prim
               concatOp
               (primArgs concatOp [Prod.Var message, Prod.Str "\n"])
               [Cons.MuT (Binder.Binder line Rep.Str) (Stmt.Perform putErrS [Prod.Var line] (Cons.MuT (Binder.Binder u Rep.Unit) thenExit))]
           in
           let clause = Clause.Clause abortS [Binder.Binder message Rep.Str] rr kc clauseBody in
           let x = name l "x" in
           let kr = name l "k" in
           Stmt.Handle [clause] (Binder.Binder x r) kr (Stmt.Cut (Prod.Var x) (Cons.KVar kr)) b body k
       | _ -> body)
  | _ -> body

-- --- definitions -----------------------------------------------------------------------

-- A top-level definition: a `def` for a function, a `val` otherwise.
fun toplevel (l : L) (env : LEnv) (sym : Sym) (rhs : Core) : Slot ! { Mut | e } =
  -- a type, a row or a type family is nothing at run time
  if Ty.isTypeFormer l.tc (scopeOf env) rhs then Slot.SErased
  else if M.isSome (lambda rhs) then
    let params = paramsOf l env rhs in
    let d = defOf l sym env rhs in
    let w = setRef l.defs (V.pushBack (getRef l.defs) d) in
    Slot.SDef sym params
  else
    let r = repOf l env rhs in
    let body = term l env rhs Cons.Halt in
    let w = setRef l.vals (V.pushBack (getRef l.vals) (CVal.CVal sym r body)) in
    Slot.SVal sym

-- What each of a function's leading lambdas binds.
fun paramsOf (l : L) (env : LEnv) (c : Core) : [Param] ! { Mut | e } =
  match lambda c with
  | None -> []
  | Just (x, grade, ty, body) ->
      let (env2, b, rv) = bindParam l env x grade ty in
      let p =
        match (b, rv) with
        | (Just _, Just _) -> Param.PDesc
        | (Just (Binder.Binder _ r), None) -> Param.PValue r
        | (None, _) -> Param.PSkip
      in
      V.append [p] (paramsOf l env2 body)

-- A recursive definition's parameters, in the scope it is defined in.
fun recParamsOf (l : L) (u : Int) : Maybe [Param] ! { Mut | e } =
  match Hm.lookup u (getRef l.recParams) with
  | Just p -> Just p
  | None ->
      (match Hm.lookup u l.recs with
       | None -> None
       | Just (_, lvl, core, _) ->
           (match V.find (\e -> lenOf e == lvl) (getRef l.levels) with
            | None -> None
            | Just at ->
                let params = paramsOf l at core in
                let w = setRef l.recParams (Hm.insert u params (getRef l.recParams)) in
                Just params))

fun hintOf (x : String) : String =
  match V.last (S.split "_" x) with
  | Just last -> if V.len (S.split "_" x) > 1 then S.slice x 0 (S.byteLength x - S.byteLength last - 1) else x
  | None -> x

-- A recursive definition inside another, as a `def` of its own, lifted the
-- first time it is used: the variables of the enclosing definition it uses
-- become its first parameters, a value as a value, a type as its
-- descriptor. Named under the top-level definition it was in.
fun lift (l : L) (u : Int) (env : LEnv) : Maybe (Sym, [Param], [Int]) ! { Mut | e } =
  match Hm.lookup u (getRef l.lifted) with
  | Just done -> Just done
  | None ->
      (match (Hm.lookup u l.recs, Hm.lookup u (getRef l.local)) with
       | (Just (nm, lvl, core, _), Just (top, Uses.Uses values all)) ->
           (match V.find (\e -> lenOf e == top) (getRef l.levels) with
            | None ->
                let w = err l (nm ++ " is defined where the lowering cannot place it") in
                None
            | Just baseEnv ->
                if lenOf env < lvl then
                  let w = err l (nm ++ " is used outside where it is defined") in
                  None
                else
                  let at0 = LEnv.LEnv (slotsOf baseEnv) (X.prefix (scopeOf env) lvl) in
                  let (at, binders, repVars, params, captured) =
                    V.foldl
                      (\acc lv ->
                        match acc with
                        | (a, bs, rvs, ps, cs) ->
                            let slot = V.getOr Slot.SErased (slotsOf env) lv in
                            if not (V.elem lv all) then (pushSlot a Slot.SErased, bs, rvs, ps, cs)
                            else
                              (match slot with
                               | Slot.SVar x ->
                                   if not (V.elem lv values) then (pushSlot a Slot.SErased, bs, rvs, ps, cs)
                                   else
                                     let v = name l (hintOf x) in
                                     let ty = Ty.varType (scopeOf env) lv in
                                     let r = Ty.rep l.tc (scopeOf env) ty in
                                     (pushSlot a (Slot.SVar v), V.pushBack bs (Binder.Binder v (rep a r)), rvs, V.pushBack ps (Param.PValue (rep a r)), V.pushBack cs lv)
                               | Slot.STypeVar (Just _) av ->
                                   let hint = hintOf av in
                                   let dv = name l ("d_" ++ hint) in
                                   let aa = name l hint in
                                   (pushSlot a (Slot.STypeVar (Just dv) aa), V.pushBack bs (Binder.Binder dv Rep.Desc), V.pushBack rvs (aa, dv), V.pushBack ps Param.PDesc, V.pushBack cs lv)
                               | Slot.SResume _ ->
                                   let w = err l (nm ++ " uses a handler's resumption, which is not lowered yet") in
                                   (pushSlot a Slot.SErased, bs, rvs, ps, cs)
                               | _ -> (pushSlot a Slot.SErased, bs, rvs, ps, cs)))
                      (at0, [], [], [], [])
                      (V.range top lvl)
                  in
                  let levels = getRef l.levels in
                  let enclosing =
                    match V.find (\i -> match V.get levels i with | Just e -> lenOf e == top | None -> False) (V.range 0 (V.len levels)) with
                    | Just i ->
                        (match V.get l.toplevel i with
                         | Just t -> M.unwrapOr (A.idyll l.package "#entry") (symbol l t)
                         | None -> A.idyll l.package "#entry")
                    | None -> A.idyll l.package "#entry"
                  in
                  let taken = \s -> V.any (\x -> match x with | (s2, _, _) -> s2 == s) (Hm.values (getRef l.lifted)) or V.any (\d -> match d with | CDef.CDef s2 _ _ _ _ _ -> s2 == s) (getRef l.defs) in
                  let sym = uniqueSym taken enclosing nm (A.child enclosing nm) 1 in
                  let allParams = V.append params (paramsOf l at core) in
                  -- known before its body is lowered, which may call it
                  let w = setRef l.lifted (Hm.insert u (sym, allParams, captured) (getRef l.lifted)) in
                  (match defOf l sym at core with
                   | CDef.CDef s rvs evs ps ks body ->
                       let d = CDef.CDef s (V.append repVars rvs) evs (V.append binders ps) ks body in
                       let w2 = setRef l.defs (V.pushBack (getRef l.defs) d) in
                       Just (sym, allParams, captured)))
       | _ -> None)

fun uniqueSym taken (enclosing : Sym) (nm : String) (sym : Sym) (n : Int) : Sym ! { Mut | e } =
  if taken sym then uniqueSym taken enclosing nm (A.child enclosing (nm ++ "#" ++ show (n + 1))) (n + 1) else sym

-- A function as a `def`: its leading lambdas are its parameters.
fun defOf (l : L) (sym : Sym) (env : LEnv) (c : Core) : CDef ! { Mut | e } =
  let (env2, body0, params, repVars, effectVars) = defParams l env c [] [] [] in
  let k = name l "k" in
  let body = term l env2 body0 (Cons.KVar k) in
  CDef.CDef sym repVars effectVars params [k] body

fun defParams (l : L) (env : LEnv) (c : Core) (params : [Binder]) (rvs : [(String, String)]) (evs : [(String, String)]) : (LEnv, Core, [Binder], [(String, String)], [(String, String)]) ! { Mut | e } =
  match lambda c with
  | None -> (env, c, params, rvs, evs)
  | Just (x, grade, ty, body) ->
      -- an effect variable: declared, `<e: Effect>`, and erased
      let evs2 =
        match M.andThen (\t -> Ty.effectBinderKind l.tc (scopeOf env) t) ty with
        | Just many -> V.pushBack evs (name l x, if many then "ManyEffect" else "Effect")
        | None -> evs
      in
      let (env2, b, rv) = bindParam l env x grade ty in
      defParams l env2 body (V.append params (vecOf b)) (V.append rvs (vecOf rv)) evs2

-- A lambda's variable bound: a value parameter, a descriptor parameter for
-- a type, or nothing for anything else erased.
fun bindParam (l : L) (env : LEnv) (x : String) (grade : Maybe Grade) (ty : Maybe Core) : (LEnv, Maybe Binder, Maybe (String, String)) ! { Mut | e } =
  let isType = match ty with | Just t -> Ty.isTypeBinder l.tc (scopeOf env) t | None -> False in
  let scope2 =
    match ty with
    | Just t -> Ty.bind l.tc (scopeOf env) x t
    | None -> Ty.bindUnknown (scopeOf env) x
  in
  let env1 = withScope env scope2 in
  if isType then
    let d = name l ("d_" ++ x) in
    let a = name l x in
    (pushSlot env1 (Slot.STypeVar (Just d) a), Just (Binder.Binder d Rep.Desc), Just (a, d))
  else if (match grade with | Just g -> G.isZero g | None -> False) then (pushSlot env1 Slot.SErased, None, None)
  else
    let v = name l x in
    let t = Ty.varType scope2 (scope2.lvl - 1) in
    let r = Ty.rep l.tc scope2 t in
    let b = Binder.Binder v (rep env1 r) in
    (pushSlot env1 (Slot.SVar v), Just b, None)

-- A method's parameter (a closure's, or a handler clause's): as
-- `bindParam`, but a method binds no representation variable of its own
-- (`docs/CUT.md`: only a `def`'s signature does), so a type parameter's
-- values are boxed, `any`, and what it is a descriptor of is passed on as
-- `desc(any)`.
fun bindMethodParam (l : L) (env : LEnv) (x : String) (grade : Maybe Grade) (ty : Maybe Core) : (LEnv, Maybe Binder, Maybe (String, String)) ! { Mut | e } =
  let (env2, b, rv) = bindParam l env x grade ty in
  match rv with
  | Just (a, _) ->
      (match env2 with
       | LEnv.LEnv slots scope -> (LEnv.LEnv (V.set slots (V.len slots - 1) (Slot.STypeVar None a)) scope, b, None))
  | None -> (env2, b, rv)

-- --- terms -----------------------------------------------------------------------------

-- `c`'s value, given to `k`.
fun term (l : L) (env : LEnv) (c : Core) (k : Cons) : Stmt ! { Mut | e } =
  match c with
  | Core.Var _ _ -> application l env c k
  | Core.Lit _ -> application l env c k
  | Core.Prim _ -> application l env c k
  | Core.Opaque _ _ -> application l env c k
  | Core.App _ _ -> application l env c k
  | Core.Runtime Note.Erased _ -> Stmt.Cut Prod.Unit k
  | Core.Runtime Note.Forced inner ->
      (match inner with
       | Core.Case _ alts ->
           (match V.head alts with
            -- the one alternative its type allows, nothing looked at
            | Just (CaseAlt.CaseAlt _ _ vars body) ->
                let inner2 = V.foldl (\e x -> pushSlot (withScope e (Ty.bindUnknown (scopeOf e) x)) Slot.SErased) env vars in
                term l inner2 body k
            | None -> Stmt.Error "a case with no alternatives was reached")
       | _ -> term l env inner k)
  | Core.Runtime (Note.Binds _ _) (Core.Unbox e) -> unbox l env c e k
  | Core.Runtime _ inner -> if M.isNone (lambda c) then term l env inner k else Stmt.Cut (closure l env c) k
  | Core.Lam _ _ -> Stmt.Cut (closure l env c) k
  | Core.Let x rhs body ->
      let v = name l x in
      let r = repOf l env rhs in
      let inner = pushSlot (withScope env (Ty.define l.tc (scopeOf env) x rhs)) (Slot.SVar v) in
      let rest = term l inner body k in
      term l env rhs (Cons.MuT (Binder.Binder v r) rest)
  | Core.Case s alts -> caseOf l env s alts k
  | Core.BoxIntro e -> atom l env e (\p -> Stmt.Cut (Prod.Tuple [p]) k)
  | Core.Unbox e -> unbox l env c e k
  | Core.Handle body r clauses -> handled l env body r clauses k
  | Core.Meta _ ->
      let w = err l "a hole's solution is not lowered yet" in
      Stmt.Error "a hole"
  | Core.Error -> Stmt.Error "this does not type check"
  -- a type, a grade or an effect is nothing at run time
  | _ -> Stmt.Cut Prod.Unit k

-- `[x] = e`: the box's one field.
fun unbox (l : L) (env : LEnv) (whole : Core) (e : Core) (k : Cons) : Stmt ! { Mut | e } =
  let x = name l "x" in
  let r = repOf l env whole in
  term l env e (Cons.Case [Arm.Arm None [Binder.Binder x r] (Stmt.Cut (Prod.Var x) k)])

-- `c`'s value as a producer, for `rest`: as it is if it is a value already,
-- or computed into a variable first.
fun atom (l : L) (env : LEnv) (c : Core) rest : Stmt ! { Mut | e } =
  match value l env c with
  | Just p -> rest p
  | None ->
      let v = name l "v" in
      let r = repOf l env c in
      let body = rest (Prod.Var v) in
      term l env c (Cons.MuT (Binder.Binder v r) body)

-- Several terms' values, in order.
fun atoms (l : L) (env : LEnv) (cs : [Core]) rest : Stmt ! { Mut | e } = atomsFrom l env cs [] rest

fun atomsFrom (l : L) (env : LEnv) (cs : [Core]) (done : [Prod]) rest : Stmt ! { Mut | e } =
  match V.head cs with
  | None -> rest done
  | Just first -> atom l env first (\p -> atomsFrom l env (V.drop cs 1) (V.pushBack done p) rest)

-- A term that is a value without computing anything, as a producer.
fun value (l : L) (env : LEnv) (c : Core) : Maybe Prod ! { Mut | e } =
  match c with
  | Core.Var i _ ->
      let at = lenOf env - (i + 1) in
      if at < 0 then None
      else
        (match V.get (slotsOf env) at with
         | Just (Slot.SVar v) -> Just (Prod.Var v)
         | Just (Slot.SResume v) -> Just (Prod.Var v)
         | Just (Slot.SVal s) -> Just (Prod.Val s)
         | Just Slot.SErased -> Just Prod.Unit
         | Just (Slot.STypeVar _ _) -> Just Prod.Unit
         | _ -> None)
  | Core.Lit (Literal.Int n) -> Just (Prod.Int n)
  | Core.Lit (Literal.Str s) -> Just (Prod.Str s)
  | Core.Lit (Literal.Bool b) -> Just (Prod.Bool b)
  | Core.Lit Literal.Unit -> Just Prod.Unit
  | Core.Runtime Note.Erased _ -> Just Prod.Unit
  | _ -> if M.isSome (lambda c) then Just (closure l env c) else None

-- A lambda as codata: an object whose `apply` takes its argument. A type
-- parameter's is a descriptor; one erased otherwise is no method at all.
fun closure (l : L) (env : LEnv) (c : Core) : Prod ! { Mut | e } =
  match lambda c with
  | None -> Prod.Unit
  | Just (x, grade, ty, body) ->
      let (inner, b, rv) = bindMethodParam l env x grade ty in
      (match b with
       | None ->
           -- erased: what it computes is the body's value itself
           (match value l inner body with
            | Just p -> p
            | None ->
                let k = name l "k" in
                Prod.Mu k (term l inner body (Cons.KVar k)))
       | Just binder ->
           let k = name l "k" in
           let s = term l inner body (Cons.KVar k) in
           Prod.Cocase [Method.Method "apply" [binder] [k] s])

-- An application, or a head applied to nothing: a primitive, a constructor,
-- an operation, a top-level function, or a value applied one argument at a
-- time.
fun application (l : L) (env : LEnv) (c : Core) (k : Cons) : Stmt ! { Mut | e } =
  let (head, args) = spine c [] in
  let generic =
    \u ->
      match value l env head with
      | Just f -> applyArgs l env f args k
      | None ->
          let fv = name l "f" in
          let rest = applyArgs l env (Prod.Var fv) args k in
          term l env head (Cons.MuT (Binder.Binder fv Rep.Ptr) rest)
  in
  match head with
  | Core.Prim p -> primApp l env c p args k
  | Core.Var i _ ->
      let at = lenOf env - (i + 1) in
      (match V.get (slotsOf env) (if at < 0 then 0 else at) with
       | Just (Slot.SPrim p) -> primApp l env c p args k
       | Just (Slot.SDef s params) -> call l env c s params args k
       | Just (Slot.SResume r) ->
           if V.len args == 1 then
             atom l env (V.getOr Core.Error args 0) (\v -> Stmt.Cut (Prod.Var r) (Cons.Call "resume" [v] [k]))
           else generic ()
       | _ -> generic ())
  | Core.Opaque u nm ->
      (match ctorInfo l u with
       | Just info -> construct l env c u info args k
       | None ->
           (match opInfo l u with
            | Just info -> performed l env c u info args k
            | None ->
                (match Hm.lookup u (getRef l.tc.nativeInfo) with
                 | Just ni -> nativeApp l env c ni args k
                 | None ->
                     if Hm.member u (getRef l.local) then
                       (match lift l u env with
                        | None -> Stmt.Error nm
                        | Just (s, params, captured) ->
                            -- what it captured, from where it is used, first
                            let all = V.append (V.map (\lv -> Core.Var (lenOf env - 1 - lv) "captured") captured) args in
                            call l env c s params all k)
                     else
                       (match recParamsOf l u with
                        | Just params -> call l env c (symbolOr l u nm) params args k
                        | None ->
                            let w = err l (nm ++ " is not a function the lowering knows") in
                            Stmt.Error nm))))
  | _ -> generic ()

-- `f a b ..`, `f` a value: `<f | apply(a; μ̃ g. <g | apply(b; k)>)>`. An
-- erased argument is a descriptor if it is a type, and nothing otherwise.
fun applyArgs (l : L) (env : LEnv) (f : Prod) (args : [Core]) (k : Cons) : Stmt ! { Mut | e } =
  match V.head args with
  | None -> Stmt.Cut f k
  | Just first ->
      let rest = V.drop args 1 in
      (match first with
       | Core.Runtime Note.Erased a ->
           if not (Ty.isType l.tc (scopeOf env) a) then applyArgs l env f rest k
           else applyOne l env f (descriptor l env a) rest k
       | _ -> atom l env first (\a -> applyOne l env f a rest k))

fun applyOne (l : L) (env : LEnv) (f : Prod) (a : Prod) (rest : [Core]) (k : Cons) : Stmt ! { Mut | e } =
  if V.isEmpty rest then Stmt.Cut f (Cons.Call "apply" [a] [k])
  else
    let g = name l "g" in
    let next = applyArgs l env (Prod.Var g) rest k in
    Stmt.Cut f (Cons.Call "apply" [a] [Cons.MuT (Binder.Binder g Rep.Ptr) next])

-- The descriptor for a type argument.
fun descriptor (l : L) (env : LEnv) (ty : Core) : Prod ! { Mut | e } =
  match Ty.repOfType l.tc (scopeOf env) ty with
  | TRep.Var lvl ->
      (match V.get (slotsOf env) lvl with
       | Just (Slot.STypeVar (Just d) _) -> Prod.Var d
       | _ -> Prod.Desc Rep.Any)
  | r -> Prod.Desc (rep env r)

-- A known function's arguments, as its parameters take them.
fun arguments (l : L) (env : LEnv) (params : [Param]) (args : [Core]) rest : Stmt ! { Mut | e } =
  let pairs = V.zip (V.range 0 (V.len params)) (V.zip params args) in
  let (values, descs) =
    V.foldl
      (\acc ipa ->
        match (acc, ipa) with
        | ((vs, ds), (i, (p, a))) ->
            (match p with
             | Param.PSkip -> acc
             | Param.PDesc ->
                 let ty = match a with | Core.Runtime Note.Erased t -> t | _ -> a in
                 (vs, V.pushBack ds (i, descriptor l env ty))
             | Param.PValue _ -> (V.pushBack vs (i, a), ds)))
      ([], [])
      pairs
  in
  let n = if V.len params < V.len args then V.len params else V.len args in
  atoms
    l
    env
    (V.map snd values)
    (\ps ->
      let byPosition = V.append (V.zip (V.map fst values) ps) descs in
      rest (V.concatMap (\i -> V.map snd (V.filter (\ip -> fst ip == i) byPosition)) (V.range 0 n)))

-- A top-level function called: with all its arguments, a call; with more,
-- a call whose result is applied to the rest; with fewer, an object
-- waiting for the rest.
fun call (l : L) (env : LEnv) (whole : Core) (s : Sym) (params : [Param]) (args : [Core]) (k : Cons) : Stmt ! { Mut | e } =
  if V.len args < V.len params then partial l env whole (Head2.HCall s) (V.take params (V.len args)) args k
  else
    let now = V.take args (V.len params) in
    let later = V.drop args (V.len params) in
    arguments
      l
      env
      params
      now
      (\ps ->
        if V.isEmpty later then Stmt.Invoke s ps [k]
        else
          let r = name l "r" in
          let next = applyArgs l env (Prod.Var r) later k in
          Stmt.Invoke s ps [Cons.MuT (Binder.Binder r Rep.Ptr) next])

-- A partial application: its arguments computed, then an object taking the
-- rest one `apply` at a time, as the partial application's type says.
fun partial (l : L) (env : LEnv) (whole : Core) (head : Head2) (given : [Param]) (args : [Core]) (k : Cons) : Stmt ! { Mut | e } =
  let remaining = Ty.functionParams l.tc (scopeOf env) whole in
  arguments l env given args (\g -> Stmt.Cut (waiting l env head g remaining) k)

-- The object a partial application is: one `apply` for each parameter still
-- to come, the last doing what `head` does with all of them.
fun waiting (l : L) (env : LEnv) (head : Head2) (given : [Prod]) (remaining : [(TRep, Bool, Bool)]) : Prod ! { Mut | e } =
  let names =
    V.map
      (\x -> match x with | (r, isTy, _) -> (if isTy then Rep.Desc else rep env r, name l "a"))
      (V.filter (\x -> match x with | (_, isTy, erased) -> isTy or not erased) remaining)
  in
  let k = name l "k" in
  let all = V.append given (V.map (\n -> Prod.Var (snd n)) names) in
  let done =
    match head with
    | Head2.HCall s -> Stmt.Invoke s all [Cons.KVar k]
    | Head2.HCon s -> Stmt.Cut (Prod.Con s all) (Cons.KVar k)
    | Head2.HPerform s -> Stmt.Perform s all (Cons.KVar k)
    | Head2.HPrim op -> Stmt.Prim op (primArgs op all) [Cons.KVar k]
  in
  -- innermost first: the last parameter's object does it
  let (body, cont, obj) =
    V.foldl
      (\acc rn ->
        match (acc, rn) with
        | ((b, ct, ob), (r, n)) ->
            let (b2, ct2) =
              match ob with
              | Just inner ->
                  let outer = name l "k" in
                  (Stmt.Cut inner (Cons.KVar outer), outer)
              | None -> (b, ct)
            in
            (b2, ct2, Just (Prod.Cocase [Method.Method "apply" [Binder.Binder n r] [ct2] b2])))
      (done, k, None)
      (V.reverse names)
  in
  M.unwrapOr (Prod.Mu cont body) obj

fun primApp (l : L) (env : LEnv) (whole : Core) (p : Prim) (args : [Core]) (k : Cons) : Stmt ! { Mut | e } =
  let op =
    match p with
    | Prim.IntAdd -> "add"
    | Prim.IntMul -> "mul"
    | Prim.IntSub -> "sub"
    | Prim.IntDiv -> "div"
    | Prim.IntMod -> "mod"
    | Prim.IntLt -> "lt"
    | Prim.IntEq -> "eq"
    -- the runtime joins an array of strings
    | Prim.StrAppend -> concatOp
  in
  let r = if p == Prim.StrAppend then Rep.Str else Rep.I64 in
  let params = [Param.PValue r, Param.PValue r] in
  if V.len args < 2 then partial l env whole (Head2.HPrim op) (V.take params (V.len args)) args k
  else atoms l env (V.take args 2) (\ps -> Stmt.Prim op (primArgs op ps) [k])

fun nativeArity (n : String) : Int =
  if n == "Array" or n == "MArray" then 0
  else if V.elem n ["arrayLen", "arrayPop", "arrayFromList", "arrayToList", "marrayLen", "marrayFreeze", "marrayThaw"] then 1
  else if V.elem n ["arrayGet", "arrayPush", "arrayConcat", "marrayNew", "marrayGet"] then 2
  else 3

-- A native: an array's operation is the runtime's primitive of the same
-- name, and an array literal an array.
fun nativeApp (l : L) (env : LEnv) (whole : Core) (ni : (String, Int)) (args : [Core]) (k : Cons) : Stmt ! { Mut | e } =
  let (n, nparams) = ni in
  let all = nparams + nativeArity n in
  let literal =
    if n == "arrayFromList" and V.len args == all then M.andThen (\a -> listLiteral l a) (V.get args nparams) else None
  in
  match literal with
  | Just items -> atoms l env items (\ps -> Stmt.Cut (Prod.Array ps) k)
  | None ->
      -- one the runtime has no primitive for: a `def` of the program's own
      let helper = if nparams == 1 then nativeHelper l n else None in
      (match helper with
       | Just (s, ps) -> call l env whole s ps args k
       | None ->
           let reps =
             if n == "arrayLen" or n == "arrayPop" then Just [Rep.Ptr]
             else if n == "arrayGet" then Just [Rep.Ptr, Rep.I64]
             else if n == "arrayGetOr" then Just [Rep.Any, Rep.Ptr, Rep.I64]
             else if n == "arraySet" or n == "marraySet" then Just [Rep.Ptr, Rep.I64, Rep.Any]
             else if n == "arrayPush" then Just [Rep.Ptr, Rep.Any]
             else if n == "arraySlice" then Just [Rep.Ptr, Rep.I64, Rep.I64]
             else if n == "arrayConcat" then Just [Rep.Ptr, Rep.Ptr]
             else None
           in
           (match reps with
            | None ->
                let w = err l (n ++ " is not lowered yet") in
                Stmt.Error n
            | Just rs ->
                let params = V.append (V.replicate nparams Param.PSkip) (V.map (\r -> Param.PValue r) rs) in
                -- a mutable array is the runtime's array, used linearly
                let op = if n == "marraySet" then "arraySet" else n in
                if V.len args < all then partial l env whole (Head2.HPrim op) (V.take params (V.len args)) args k
                else
                  let values = V.slice args nparams all in
                  let later = V.drop args all in
                  -- What an array holds comes out as whatever was stored,
                  -- which only a binder can say how it is represented: given
                  -- straight to a continuation, it would be taken for a
                  -- pointer (`docs/CUT.md`).
                  let isBinder = match k with | Cons.MuT _ _ -> True | _ -> False in
                  let stored =
                    if (n == "arrayGet" or n == "arrayGetOr") and V.isEmpty later and not isBinder then
                      (let r = repOf l env whole in if r == Rep.Ptr then None else Just r)
                    else None
                  in
                  atoms
                    l
                    env
                    values
                    (\ps ->
                      match stored with
                      | Just r ->
                          let x = name l "x" in
                          Stmt.Prim op ps [Cons.MuT (Binder.Binder x r) (Stmt.Cut (Prod.Var x) k)]
                      | None ->
                      if V.isEmpty later then Stmt.Prim op ps [k]
                      else
                        let r = name l "r" in
                        let next = applyArgs l env (Prod.Var r) later k in
                        Stmt.Prim op ps [Cons.MuT (Binder.Binder r Rep.Any) next])))

-- The elements of a list written out, `x :: y :: Nil`, if `c` is one.
fun listLiteral (l : L) (c : Core) : Maybe [Core] ! { Mut | e } = listFrom l c []

fun listFrom (l : L) (c : Core) (items : [Core]) : Maybe [Core] ! { Mut | e } =
  let (head, args) = spine c [] in
  match head with
  | Core.Opaque u _ ->
      (match ctorInfo l u with
       | Just (CtorInfo.CtorInfo n _ _ _ _) ->
           if n == "Nil" and V.len args == 1 then Just items
           else if n == "::" and V.len args == 3 then listFrom l (V.getOr Core.Error args 2) (V.pushBack items (V.getOr Core.Error args 1))
           else None
       | None -> None)
  | _ -> None

fun construct (l : L) (env : LEnv) (whole : Core) (u : Int) (info : CtorInfo) (args : [Core]) (k : Cons) : Stmt ! { Mut | e } =
  match info with
  | CtorInfo.CtorInfo nm dt _ nparams nfields ->
      let w = note l.datas dt in
      let s = symbolOr l u nm in
      let reps = match Ty.ctorShape l.tc u with | Just (_, fs) -> V.map (\r -> rep env r) fs | None -> [] in
      let params = V.append (V.replicate nparams Param.PSkip) (V.map (\i -> Param.PValue (V.getOr Rep.Any reps i)) (V.range 0 nfields)) in
      if V.len args < V.len params then partial l env whole (Head2.HCon s) (V.take params (V.len args)) args k
      else atoms l env (V.slice args nparams (nparams + nfields)) (\ps -> Stmt.Cut (Prod.Con s ps) k)

fun performed (l : L) (env : LEnv) (whole : Core) (u : Int) (info : OpInfo) (args : [Core]) (k : Cons) : Stmt ! { Mut | e } =
  match info with
  | OpInfo.OpInfo nm eff _ erased arity _ ->
      let w = note l.effects eff in
      let w2 = note l.performed u in
      let s = symbolOr l u nm in
      let n = erased + arity in
      if V.len args < n then
        let reps = match Ty.opShape l.tc u with | Just (ps, _) -> ps | None -> [] in
        let params = V.append (V.replicate erased Param.PSkip) (V.map (\r -> Param.PValue (rep env r)) reps) in
        partial l env whole (Head2.HPerform s) (V.take params (V.len args)) args k
      else
        let values = V.slice args erased n in
        let later = V.drop args n in
        atoms
          l
          env
          values
          (\ps ->
            if V.isEmpty later then Stmt.Perform s ps k
            else
              let r = name l "r" in
              let next = applyArgs l env (Prod.Var r) later k in
              Stmt.Perform s ps (Cons.MuT (Binder.Binder r Rep.Ptr) next))

fun isBoolAlt (a : CaseAlt) : Bool = match a with | CaseAlt.CaseAlt (Head.BoolLit _) _ _ _ -> True | _ -> False

-- A `case`: on data, a `case` consumer; on a `Bool`, `prim if`. The
-- consumer is named first if it is not a variable, so the arms share it.
fun caseOf (l : L) (env : LEnv) (scrutinee : Core) (alts : [CaseAlt]) (k : Cons) : Stmt ! { Mut | e } =
  match k with
  | Cons.KVar _ -> caseNamed l env scrutinee alts k
  | Cons.Halt -> caseNamed l env scrutinee alts k
  | _ ->
      let j = name l "j" in
      let inner = caseNamed l env scrutinee alts (Cons.KVar j) in
      Stmt.Cut (Prod.Mu j inner) k

fun caseNamed (l : L) (env : LEnv) (scrutinee : Core) (alts : [CaseAlt]) (k : Cons) : Stmt ! { Mut | e } =
  if V.all isBoolAlt alts then
    let arm =
      \b ->
        match V.find (\a -> match a with | CaseAlt.CaseAlt (Head.BoolLit c) _ _ _ -> c == b | _ -> False) alts with
        | Just (CaseAlt.CaseAlt _ _ _ body) -> term l env body k
        | None -> Stmt.Error "no alternative for this"
    in
    let f = arm False in
    let t = arm True in
    let xf = name l "u" in
    let xt = name l "u" in
    atom l env scrutinee (\b -> Stmt.Prim "if" [b] [Cons.MuT (Binder.Binder xf Rep.Unit) f, Cons.MuT (Binder.Binder xt Rep.Unit) t])
  else
    let arms =
      V.concatMap
        (\alt ->
          match alt with
          | CaseAlt.CaseAlt (Head.Con u) _ vars body ->
              let info = ctorInfo l u in
              let w = match info with | Just (CtorInfo.CtorInfo _ dt _ _ _) -> note l.datas dt | None -> () in
              let nparams = match info with | Just (CtorInfo.CtorInfo _ _ _ p _) -> p | None -> 0 in
              let types = Ty.altTypes l.tc (scopeOf env) scrutinee alt in
              let innerScope = Ty.altScope l.tc (scopeOf env) scrutinee alt in
              let (inner, fields) =
                V.foldl
                  (\acc ix ->
                    match (acc, ix) with
                    | ((e, fs), (i, x)) ->
                        if i < nparams then (pushSlot e Slot.SErased, fs)
                        else
                          let v = name l x in
                          let r = match V.get types i with | Just t -> Ty.rep l.tc (scopeOf e) t | None -> TRep.Any in
                          (pushSlot e (Slot.SVar v), V.pushBack fs (Binder.Binder v (rep e r))))
                  (LEnv.LEnv (slotsOf env) innerScope, [])
                  (V.zip (V.range 0 (V.len vars)) vars)
              in
              [Arm.Arm (symbol l u) fields (term l inner body k)]
          | _ -> [])
        alts
    in
    term l env scrutinee (Cons.Case arms)

-- `handle body with clauses`.
fun handled (l : L) (env : LEnv) (body : Core) (ret : Core) (clauses : [OpClause]) (k : Cons) : Stmt ! { Mut | e } =
  let cutClauses =
    V.concatMap
      (\c ->
        match c with
        | OpClause.OpClause op opName erased lam0 ->
            let info = opInfo l op in
            let w = match info with | Just (OpInfo.OpInfo _ eff _ _ _ _) -> note l.effects eff | None -> () in
            let arity = match info with | Just (OpInfo.OpInfo _ _ _ _ a _) -> a | None -> 1 in
            -- the operation's erased arguments, then its arguments, then the
            -- resumption
            let (inner1, lam1) = erasedArgs l env lam0 erased in
            let (inner2, lam2, params) = opArgs l inner1 lam1 arity [] in
            (match lambda lam2 with
             | None ->
                 let w2 = err l (opName ++ "'s clause has no resumption") in
                 []
             | Just (x, _, ty, cbody) ->
                 let r = name l "r" in
                 let scope3 = match ty with | Just t -> Ty.bind l.tc (scopeOf inner2) x t | None -> Ty.bindUnknown (scopeOf inner2) x in
                 let inner3 = pushSlot (withScope inner2 scope3) (Slot.SResume r) in
                 let kc = name l "k" in
                 let s = term l inner3 cbody (Cons.KVar kc) in
                 [Clause.Clause (symbolOr l op opName) params r kc s]))
      clauses
  in
  -- `return x -> ..`
  let (retX, retK, retS) =
    match lambda ret with
    | Just (x, grade, ty, rbody) ->
        let (inner, b, rv) = bindMethodParam l env x grade ty in
        let kc = name l "k" in
        let s = term l inner rbody (Cons.KVar kc) in
        let xb = match b with | Just bb -> bb | None -> Binder.Binder (name l "x") Rep.Unit in
        (xb, kc, s)
    | None ->
        let x = name l "x" in
        let kc = name l "k" in
        (Binder.Binder x Rep.Any, kc, Stmt.Cut (Prod.Var x) (Cons.KVar kc))
  in
  let b = name l "b" in
  let bodyS = term l env body (Cons.KVar b) in
  Stmt.Handle cutClauses retX retK retS b bodyS k

fun erasedArgs (l : L) (env : LEnv) (lam : Core) (n : Int) : (LEnv, Core) ! { Mut | e } =
  if n <= 0 then (env, lam)
  else
    match lambda lam with
    | None -> (env, lam)
    | Just (x, _, ty, body) ->
        let scope2 = match ty with | Just t -> Ty.bind l.tc (scopeOf env) x t | None -> Ty.bindUnknown (scopeOf env) x in
        erasedArgs l (pushSlot (withScope env scope2) (Slot.STypeVar None x)) body (n - 1)

fun opArgs (l : L) (env : LEnv) (lam : Core) (n : Int) (params : [Binder]) : (LEnv, Core, [Binder]) ! { Mut | e } =
  if n <= 0 then (env, lam, params)
  else
    match lambda lam with
    | None -> (env, lam, params)
    | Just (x, grade, ty, body) ->
        let (env2, b, rv) = bindMethodParam l env x grade ty in
        opArgs l env2 body (n - 1) (V.append params (vecOf b))

-- --- the table ---------------------------------------------------------------------------

fun conv (r : TRep) : Rep =
  match r with
  | TRep.I64 -> Rep.I64
  | TRep.Bool -> Rep.Bool
  | TRep.Unit -> Rep.Unit
  | TRep.Erased -> Rep.Unit
  | TRep.Str -> Rep.Str
  | TRep.Ptr -> Rep.Ptr
  | _ -> Rep.Any

fun symLess (a : Sym) (b : Sym) : Bool = S.lessThan (sortKey a) (sortKey b)

-- A symbol as it sorts: by its parts in order.
fun sortKey (s : Sym) : String = match s with | Sym.Sym lang p path -> S.join "\u{0}" (V.append [lang, p] path)

-- The data types, roles, effects and native operations.
fun declarations (l : L) (entry : Maybe Sym) (answer : Bool) : CProgram ! { Mut | e } =
  let ctorsOf =
    \d ->
      let cs = V.filter (\kv -> match snd kv with | CtorInfo.CtorInfo _ dt _ _ _ -> dt == d) (Hm.toVec (getRef l.tc.ctors)) in
      let tag = \kv -> match snd kv with | CtorInfo.CtorInfo _ _ t _ _ -> t in
      V.foldl (\acc c -> V.concat [V.filter (\x -> tag x <= tag c) acc, [c], V.filter (\x -> tag x > tag c) acc]) [] cs
  in
  let datas =
    V.concatMap
      (\d ->
        match symbol l d with
        | None -> []
        | Just s ->
            let (out, repVars) =
              V.foldl
                (\acc kv ->
                  match (acc, kv) with
                  | ((o, rvs), (u, CtorInfo.CtorInfo cn _ _ _ _)) ->
                      let (kinds, fields) = M.unwrapOr ([], []) (Ty.ctorShape l.tc u) in
                      -- a field of a type parameter: that parameter's variable
                      let (fs, rvs2) =
                        V.foldl
                          (\a2 r ->
                            match a2 with
                            | (f, rv) ->
                                (match r with
                                 | TRep.Var i ->
                                     if V.getOr False kinds i then
                                       let av = "a" ++ show i in
                                       (V.pushBack f (Rep.Var av), if V.elem av rv then rv else V.pushBack rv av)
                                     else (V.pushBack f Rep.Any, rv)
                                 | other -> (V.pushBack f (conv other), rv)))
                          ([], rvs)
                          fields
                      in
                      (V.pushBack o (cn, fs), rvs2))
                ([], [])
                (ctorsOf d)
            in
            let sortedVars = V.foldl (\acc x -> V.concat [V.filter (\y -> not (S.lessThan x y)) acc, [x], V.filter (\y -> S.lessThan x y) acc]) [] repVars in
            [CData.CData s sortedVars out])
      (getRef l.datas)
  in
  -- the roles, for the prelude's types the program uses
  let declared = V.map (\d -> match d with | CData.CData s _ _ -> s) datas in
  let rs =
    V.concatMap
      (\rp ->
        match rp with
        | (role, path) ->
            let s = A.idyll "Prelude" path in
            let ty = match s with | Sym.Sym lang p ps -> Sym.Sym lang p (V.take ps (V.len ps - 1)) in
            if V.elem ty declared then [(role, s)] else [])
      roles
  in
  -- the effects, and the world's operations left to the runtime
  let effects =
    V.concatMap
      (\e ->
        match symbol l e with
        | None -> []
        | Just s ->
            let index = \kv -> match snd kv with | OpInfo.OpInfo _ _ i _ _ _ -> i in
            let ops0 = V.filter (\kv -> match snd kv with | OpInfo.OpInfo _ eff _ _ _ _ -> eff == e) (Hm.toVec (getRef l.tc.ops)) in
            let ops = V.foldl (\acc c -> V.concat [V.filter (\x -> index x <= index c) acc, [c], V.filter (\x -> index x > index c) acc]) [] ops0 in
            let out =
              V.map
                (\kv ->
                  match kv with
                  | (u, OpInfo.OpInfo on _ _ _ _ many) ->
                      let (ps, r) = M.unwrapOr ([], TRep.Any) (Ty.opShape l.tc u) in
                      COp.COp on many (V.map conv ps) (conv r))
                ops
            in
            [CEffect.CEffect s out])
      (getRef l.effects)
  in
  let natives0 =
    V.concatMap
      (\u ->
        if getRef l.handledByEntry == Just u then []
        else
          (match Hm.lookup u l.symbols with
           | Just ("Prelude", _) ->
               let on = match opInfo l u with | Just (OpInfo.OpInfo n _ _ _ _ _) -> n | None -> "" in
               (match V.find (\nr -> fst nr == on) nativeOps with
                | Just (_, runtime) -> vecOf (M.map (\s -> (s, runtime)) (symbol l u))
                | None ->
                    let w = err l (on ++ " has no runtime operation of its shape yet: on the shared back end the prelude will define it over the runtime's") in
                    [])
           | _ -> []))
      (getRef l.performed)
  in
  let natives = V.foldl (\acc x -> V.concat [V.filter (\y -> not (symLess (fst x) (fst y))) acc, [x], V.filter (\y -> symLess (fst x) (fst y)) acc]) [] natives0 in
  CProgram.CProgram entry answer datas rs natives effects (getRef l.vals) (getRef l.defs)

-- --- where recursive definitions are ----------------------------------------------------

-- Where each recursive definition inside another is: the level of the
-- top-level scope it is in.
fun owners (program : Core) (lets : Int) (base : Int) recs : HashMap Int Int =
  let (work0, rest) =
    V.foldl
      (\acc i ->
        match acc with
        | (w, c) ->
            (match c with
             | Core.Let _ rhs r -> (V.pushBack w (base + i, rhs), r)
             | _ -> acc))
      ([], program)
      (V.range 0 lets)
  in
  let work1 = V.pushBack work0 (base + lets, rest) in
  -- a top-level recursive definition's scope is its own level
  let work2 = V.append work1 (V.concatMap (\d -> match d with | (_, lv, core, isLocal) -> if isLocal then [] else [(lv, core)]) (Hm.values recs)) in
  ownersFrom work2 recs Hm.empty

fun ownersFrom (work : [(Int, Core)]) recs (out : HashMap Int Int) : HashMap Int Int =
  match V.last work with
  | None -> out
  | Just (top, c) ->
      let rest = V.take work (V.len work - 1) in
      let (_, opaques) = used c 0 0 False (Uses.Uses [] [], []) in
      let (out2, w2) =
        V.foldl
          (\acc u ->
            match acc with
            | (o, w) ->
                (match Hm.lookup u recs with
                 | Just (_, _, core, True) -> if Hm.member u o then acc else (Hm.insert u top o, V.pushBack w (top, core))
                 | _ -> acc))
          (out, rest)
          opaques
      in
      ownersFrom w2 recs out2

fun within (top : Int) (lvl : Int) (x : Int) : Bool = x >= top and x < lvl

-- For each recursive definition inside another: the level of its top-level
-- scope, and the levels between that and its own that it uses, or that a
-- recursive definition it calls does.
fun localFreeLevels recs (owners : HashMap Int Int) : HashMap Int (Int, Uses) =
  let (out0, calls) =
    V.foldl
      (\acc kv ->
        match (acc, kv) with
        | ((o, cs), (u, (_, lvl, core, _))) ->
            (match Hm.lookup u owners with
             | None -> acc
             | Just top ->
                 (match used core lvl 0 False (Uses.Uses [] [], []) with
                  | (Uses.Uses vs als, opaques) ->
                      (Hm.insert u (top, Uses.Uses (V.filter (within top lvl) vs) (V.filter (within top lvl) als)) o, Hm.insert u opaques cs))))
      (Hm.empty, Hm.empty)
      (Hm.toVec recs)
  in
  spread recs calls out0

fun spread recs calls (out : HashMap Int (Int, Uses)) : HashMap Int (Int, Uses) =
  let (out2, changed) =
    V.foldl
      (\acc kv ->
        match (acc, kv) with
        | ((o, ch), (u, callees)) ->
            (match (Hm.lookup u o, Hm.lookup u recs) with
             | (Just (top, Uses.Uses mv ma), Just (_, lvl, _, _)) ->
                 let theirs = V.concatMap (\e -> vecOf (Hm.lookup e o)) callees in
                 let newV = V.foldl (\a t -> match t with | (_, Uses.Uses tv _) -> V.append a (V.filter (\x -> within top lvl x and not (V.elem x mv) and not (V.elem x a)) tv)) [] theirs in
                 let newA = V.foldl (\a t -> match t with | (_, Uses.Uses _ ta) -> V.append a (V.filter (\x -> within top lvl x and not (V.elem x ma) and not (V.elem x a)) ta)) [] theirs in
                 if V.isEmpty newV and V.isEmpty newA then (o, ch)
                 else (Hm.insert u (top, Uses.Uses (V.foldl insertSorted mv newV) (V.foldl insertSorted ma newA)) o, True)
             | _ -> (o, ch)))
      (out, False)
      (Hm.toVec calls)
  in
  if changed then spread recs calls out2 else out2

-- What a term uses (in a context of `at` variables, `depth` binders in;
-- `erased` if it is never computed), and the constants it mentions.
fun used (c : Core) (at : Int) (depth : Int) (erased : Bool) (acc : (Uses, [Int])) : (Uses, [Int]) =
  let go = \x d e a -> used x at d (erased or e) a in
  match c with
  | Core.Var i _ ->
      if i >= depth then
        let lv = at - (i - depth + 1) in
        if lv < 0 then acc
        else
          (match acc with
           | (Uses.Uses vs als, os) -> (Uses.Uses (if erased then vs else insertSorted vs lv) (insertSorted als lv), os))
      else acc
  | Core.Opaque u _ -> (match acc with | (us, os) -> (us, insertSorted os u))
  | Core.Pi _ _ g r d cod -> go cod (depth + 1) True (go d depth True (go r depth True (go g depth True acc)))
  | Core.Lam _ b -> go b (depth + 1) False acc
  | Core.Let _ e b -> go b (depth + 1) False (go e depth False acc)
  | Core.App a b -> go b depth False (go a depth False acc)
  | Core.BoxTy a b -> go b depth True (go a depth True acc)
  | Core.GradeAdd a b -> go b depth True (go a depth True acc)
  | Core.GradeMul a b -> go b depth True (go a depth True acc)
  | Core.GradeRange a b -> go b depth True (go a depth True acc)
  | Core.Comp a b -> go b depth True (go a depth True acc)
  | Core.Runtime Note.Erased a -> go a depth True acc
  | Core.Runtime (Note.Binds _ (Just t)) a -> go a depth False (go t depth True acc)
  | Core.Runtime _ a -> go a depth False acc
  | Core.BoxIntro a -> go a depth False acc
  | Core.Unbox a -> go a depth False acc
  | Core.Case s alts -> V.foldl (\a2 alt -> match alt with | CaseAlt.CaseAlt _ _ vars body -> go body (depth + V.len vars) False a2) (go s depth False acc) alts
  | Core.Handle b r ops -> V.foldl (\a2 op -> match op with | OpClause.OpClause _ _ _ body -> go body depth False a2) (go r depth False (go b depth False acc)) ops
  | Core.Row ls ts -> V.foldl (\a2 x -> go x depth True a2) acc (V.append ls ts)
  | _ -> acc

-- --- the answer, shown ----------------------------------------------------------------
--
-- The runtimes print only strings, so a program whose value is anything
-- else is given code that writes it as the REPL does: a `def` for each data
-- type the answer has in it, named for the type as it is written (`"#show
-- Maybe (Int, Bool)"`), one for when such a type is a field and may need
-- parentheses (`"#atom .."`), one for each array type; an integer by the
-- prelude's `showInt`; a string quoted and escaped as Rust's `{:?}` does
-- (`"#escape"`).

fun named (package : String) (what : String) (key : String) : Sym = Sym.Sym "idyll" package ["#" ++ what ++ " " ++ key]

fun concatTo (parts : [Prod]) (k : Cons) : Stmt = Stmt.Prim concatOp (primArgs concatOp parts) [k]

fun strBinder (x : String) (body : Stmt) : Cons = Cons.MuT (Binder.Binder x Rep.Str) body

fun unitBinder (x : String) (body : Stmt) : Cons = Cons.MuT (Binder.Binder x Rep.Unit) body

-- `prim op(args; μ̃ x: rep. body)`
fun primThen (op : String) (args : [Prod]) (x : String) (r : Rep) (body : Stmt) : Stmt = Stmt.Prim op args [Cons.MuT (Binder.Binder x r) body]

fun testEq (l : L) (a : Prod) (b : Prod) (no : Stmt) (yes : Stmt) : Stmt ! { Mut | e } =
  let u1 = name l "u" in
  let u2 = name l "u" in
  Stmt.Prim "eq" [a, b] [unitBinder u1 no, unitBinder u2 yes]

fun testLt (l : L) (a : Prod) (b : Prod) (no : Stmt) (yes : Stmt) : Stmt ! { Mut | e } =
  let u1 = name l "u" in
  let u2 = name l "u" in
  Stmt.Prim "lt" [a, b] [unitBinder u1 no, unitBinder u2 yes]

-- The entry's consumer, given what computes its value: the value shown, and
-- handed to `k` as a string; none if it has nothing to show.
fun showAnswer (l : L) (s : Ctx) (ty : Value) (k : Cons) : Maybe (Rep, Cons) ! { Mut | e } =
  let v = name l "answer" in
  match showValue l s ty (Prod.Var v) k False with
  | None -> None
  | Just body ->
      let r = flatRep l s ty in
      Just (r, Cons.MuT (Binder.Binder v r) body)

-- A representation for a closed type.
fun flatRep (l : L) (s : Ctx) (ty : Value) : Rep ! { Mut | e } =
  match Ty.rep l.tc s ty with
  | TRep.Var _ -> Rep.Any
  | r -> conv r

fun pushDef (l : L) (sym : Sym) (params : [(String, Rep)]) (k : String) (body : Stmt) =
  setRef l.showDefs (V.pushBack (getRef l.showDefs) (CDef.CDef sym [] [] (V.map (\p -> match p with | (n, r) -> Binder.Binder n r) params) [k] body))

fun pushShow (l : L) (sym : Sym) (x : String) (k : String) (body : Stmt) = pushDef l sym [(x, Rep.Ptr)] k body

-- `x`, of type `ty`, as a string handed to `k`; parenthesised if `isAtom`
-- and it is a constructor with fields.
fun showValue (l : L) (s : Ctx) (ty : Value) (x : Prod) (k : Cons) (isAtom : Bool) : Maybe Stmt ! { Mut | e } =
  match Ty.shown l.tc l.linear s ty with
  | Shown.Int -> M.map (\si -> Stmt.Invoke si [x] [k]) (getRef l.showInt)
  | Shown.Bool ->
      let f = name l "u" in
      let t = name l "u" in
      Just (Stmt.Prim "if" [x] [unitBinder f (Stmt.Cut (Prod.Str "False") k), unitBinder t (Stmt.Cut (Prod.Str "True") k)])
  | Shown.Unit -> Just (Stmt.Cut (Prod.Str "()") k)
  | Shown.Str ->
      let escape = escapeDef l in
      let e = name l "e" in
      Just (Stmt.Invoke escape [x] [strBinder e (concatTo [Prod.Str "\"", Prod.Var e, Prod.Str "\""] k)])
  -- a box is the IR's one-element tuple
  | Shown.Box inner ->
      let v = name l "x" in
      let r = flatRep l s inner in
      let t = name l "s" in
      M.map
        (\body -> Stmt.Cut x (Cons.Case [Arm.Arm None [Binder.Binder v r] body]))
        (showValue l s inner (Prod.Var v) (strBinder t (concatTo [Prod.Str "[", Prod.Var t, Prod.Str "]"] k)) False)
  | Shown.Array elem -> M.map (\sh -> Stmt.Invoke sh [x] [k]) (arrayShow l s ty elem)
  | Shown.Data key ctors ->
      (match dataShow l s key ctors with
       | None -> None
       | Just (ShowDefs.ShowDefs sh at _) ->
           (match (isAtom, at) with
            | (True, Just a) ->
                -- made the first time a field needs it
                let fresh = not (V.elem key (getRef l.atoms)) in
                let w = if fresh then setRef l.atoms (V.pushBack (getRef l.atoms) key) else () in
                let made = if fresh then atomDef l s sh a ctors else Just () in
                M.map (\u -> Stmt.Invoke a [x] [k]) made
            | _ -> Just (Stmt.Invoke sh [x] [k])))
  | Shown.Nothing -> None

-- Several values shown in turn, then `done` with their strings.
fun showAll (l : L) (s : Ctx) (items : [(Value, Prod, Bool)]) (got : [Prod]) done : Maybe Stmt ! { Mut | e } =
  match V.head items with
  | None -> Just (done got)
  | Just (ty, x, isAtom) ->
      let t = name l "s" in
      (match showAll l s (V.drop items 1) (V.pushBack got (Prod.Var t)) done with
       | None -> None
       | Just rest -> showValue l s ty x (strBinder t rest) isAtom)

fun isPrelude (l : L) (u : Int) : Bool = match Hm.lookup u l.symbols with | Just ("Prelude", _) -> True | _ -> False

-- What shows a data type's values, made the first time it is asked for.
fun dataShow (l : L) (s : Ctx) (key : String) (ctors : [(Int, String, [Value])]) : Maybe ShowDefs ! { Mut | e } =
  match Hm.lookup key (getRef l.shows) with
  | Just known -> known
  | None ->
      let tuple =
        V.len ctors == 1
          and (match V.get ctors 0 with | Just (u, n, fs) -> n == "Pair" and V.len fs == 2 and isPrelude l u | None -> False)
      in
      let compound = not tuple and V.any (\c -> match c with | (_, _, fs) -> not (V.isEmpty fs)) ctors in
      let defs =
        ShowDefs.ShowDefs
          (named l.package "show" key)
          (if compound then Just (named l.package "atom" key) else None)
          (if tuple then Just (named l.package "items" key) else None)
      in
      -- known before its body is made: a type may contain itself
      let w = setRef l.shows (Hm.insert key (Just defs) (getRef l.shows)) in
      let made = if tuple then tupleDefs l s defs (V.getOr (0, "", []) ctors 0) else dataDefs l s defs ctors in
      (match made with
       | Just _ -> Just defs
       | None ->
           let w2 = setRef l.shows (Hm.insert key None (getRef l.shows)) in
           None)

-- `Just (Ok 3)`, `x :: xs`: a case on the constructor.
fun dataDefs (l : L) (s : Ctx) (defs : ShowDefs) (ctors : [(Int, String, [Value])]) : Maybe () ! { Mut | e } =
  let x = name l "x" in
  let k = name l "k" in
  let kv = Cons.KVar k in
  let arms =
    V.foldl
      (\acc c ->
        match (acc, c) with
        | (None, _) -> None
        | (Just arms0, (u, cn, ftys)) ->
            let w = match ctorInfo l u with | Just (CtorInfo.CtorInfo _ dt _ _ _) -> note l.datas dt | None -> () in
            (match symbol l u with
             | None -> None
             | Just sym ->
                 let fields = V.map (\t -> Binder.Binder (name l "f") (flatRep l s t)) ftys in
                 let vars = V.map (\b -> match b with | Binder.Binder n _ -> Prod.Var n) fields in
                 let body =
                   if V.isEmpty ftys then Just (Stmt.Cut (Prod.Str cn) kv)
                   -- `x :: xs`, written as it is read
                   else if cn == "::" and V.len ftys == 2 then
                     showAll
                       l
                       s
                       [(V.getOr Value.Error ftys 0, V.getOr Prod.Unit vars 0, True), (V.getOr Value.Error ftys 1, V.getOr Prod.Unit vars 1, False)]
                       []
                       (\ss -> concatTo [V.getOr Prod.Unit ss 0, Prod.Str " :: ", V.getOr Prod.Unit ss 1] kv)
                   else
                     showAll
                       l
                       s
                       (V.map (\tv -> match tv with | (t, v) -> (t, v, True)) (V.zip ftys vars))
                       []
                       (\ss -> concatTo (V.append [Prod.Str cn] (V.concatMap (\p -> [Prod.Str " ", p]) ss)) kv)
                 in
                 M.map (\b -> V.pushBack arms0 (Arm.Arm (Just sym) fields b)) body))
      (Just [])
      ctors
  in
  match (arms, defs) with
  | (Just arms0, ShowDefs.ShowDefs sh _ _) ->
      let w = pushShow l sh x k (Stmt.Cut (Prod.Var x) (Cons.Case arms0)) in
      Just ()
  | _ -> None

-- A data type's values as a field: in parentheses, if its constructor has
-- fields of its own.
fun atomDef (l : L) (s : Ctx) (sh : Sym) (a : Sym) (ctors : [(Int, String, [Value])]) : Maybe () ! { Mut | e } =
  let x = name l "x" in
  let k = name l "k" in
  let arms =
    V.foldl
      (\acc c ->
        match (acc, c) with
        | (None, _) -> None
        | (Just arms0, (u, _, ftys)) ->
            (match symbol l u with
             | None -> None
             | Just sym ->
                 let fields = V.map (\t -> Binder.Binder (name l "f") (flatRep l s t)) ftys in
                 let whole = [Prod.Var x] in
                 let body =
                   if V.isEmpty ftys then Stmt.Invoke sh whole [Cons.KVar k]
                   else
                     let t = name l "s" in
                     Stmt.Invoke sh whole [strBinder t (concatTo [Prod.Str "(", Prod.Var t, Prod.Str ")"] (Cons.KVar k))]
                 in
                 Just (V.pushBack arms0 (Arm.Arm (Just sym) fields body))))
      (Just [])
      ctors
  in
  M.map (\arms0 -> pushShow l a x k (Stmt.Cut (Prod.Var x) (Cons.Case arms0))) arms

-- `(1, True)`, and a pair nested to the right a longer tuple, `(1, 2, 3)`.
fun tupleDefs (l : L) (s : Ctx) (defs : ShowDefs) (pair : (Int, String, [Value])) : Maybe () ! { Mut | e } =
  match (defs, pair) with
  | (ShowDefs.ShowDefs sh _ (Just itemsDef), (u, _, ftys)) ->
      let w = match ctorInfo l u with | Just (CtorInfo.CtorInfo _ dt _ _ _) -> note l.datas dt | None -> () in
      (match symbol l u with
       | None -> None
       | Just sym ->
           let first = V.getOr Value.Error ftys 0 in
           let second = V.getOr Value.Error ftys 1 in
           -- the items: the first, then the rest's items if it is a pair
           let x = name l "x" in
           let k = name l "k" in
           let f1 = name l "f" in
           let fb1 = Binder.Binder f1 (flatRep l s first) in
           let f2 = name l "f" in
           let fb2 = Binder.Binder f2 (flatRep l s second) in
           let restItems =
             match Ty.shown l.tc l.linear s second with
             | Shown.Data key cs ->
                 if V.len cs == 1 and (match V.get cs 0 with | Just (cu, cn, _) -> cn == "Pair" and isPrelude l cu | None -> False) then
                   (match dataShow l s key cs with
                    | Just (ShowDefs.ShowDefs _ _ it) -> Just it
                    | None -> None)
                 else Just None
             | _ -> Just None
           in
           (match restItems with
            | None -> None
            | Just restIt ->
                let kv = Cons.KVar k in
                let ta = name l "s" in
                let tb = name l "s" in
                let joined = concatTo [Prod.Var ta, Prod.Str ", ", Prod.Var tb] kv in
                let rest =
                  match restIt with
                  | Just itemsOf -> Just (Stmt.Invoke itemsOf [Prod.Var f2] [strBinder tb joined])
                  | None -> showValue l s second (Prod.Var f2) (strBinder tb joined) False
                in
                (match M.andThen (\r -> showValue l s first (Prod.Var f1) (strBinder ta r) False) rest with
                 | None -> None
                 | Just body ->
                     let w2 = pushShow l itemsDef x k (Stmt.Cut (Prod.Var x) (Cons.Case [Arm.Arm (Just sym) [fb1, fb2] body])) in
                     -- the whole: in parentheses
                     let x2 = name l "x" in
                     let k2 = name l "k" in
                     let t = name l "s" in
                     let wrap = concatTo [Prod.Str "(", Prod.Var t, Prod.Str ")"] (Cons.KVar k2) in
                     let w3 = pushShow l sh x2 k2 (Stmt.Invoke itemsDef [Prod.Var x2] [strBinder t wrap]) in
                     Just ())))
  | _ -> None

-- `#[1; 2]`, `#[1;]`, `#[;]`: the elements in turn, then the brackets.
fun arrayShow (l : L) (s : Ctx) (array : Value) (elem : Value) : Maybe Sym ! { Mut | e } =
  match Ty.typeKey l.tc l.linear s array with
  | None -> None
  | Just key ->
      (match Hm.lookup key (getRef l.shows) with
       | Just known -> M.map (\d -> match d with | ShowDefs.ShowDefs sh _ _ -> sh) known
       | None ->
           let sh = named l.package "show" key in
           let items = named l.package "items" key in
           let w = setRef l.shows (Hm.insert key (Just (ShowDefs.ShowDefs sh None (Just items))) (getRef l.shows)) in
           -- the items from `i` up to `n`, separated by "; "
           let xs = name l "xs" in
           let i = name l "i" in
           let n = name l "n" in
           let k = name l "k" in
           let e = name l "e" in
           let se = name l "s" in
           let j = name l "j" in
           let rest = name l "s" in
           let r = flatRep l s elem in
           let more = Stmt.Invoke items [Prod.Var xs, Prod.Var j, Prod.Var n] [strBinder rest (concatTo [Prod.Var se, Prod.Str "; ", Prod.Var rest] (Cons.KVar k))] in
           let last = Stmt.Cut (Prod.Var se) (Cons.KVar k) in
           let u1 = name l "u" in
           let u2 = name l "u" in
           let next =
             Stmt.Prim "add" [Prod.Var i, Prod.Int 1] [Cons.MuT (Binder.Binder j Rep.I64) (Stmt.Prim "eq" [Prod.Var j, Prod.Var n] [unitBinder u1 more, unitBinder u2 last])]
           in
           (match showValue l s elem (Prod.Var e) (strBinder se next) False with
            | None ->
                let w2 = setRef l.shows (Hm.insert key None (getRef l.shows)) in
                None
            | Just shownE ->
                let body = Stmt.Prim "arrayGet" [Prod.Var xs, Prod.Var i] [Cons.MuT (Binder.Binder e r) shownE] in
                let w3 = pushDef l items [(xs, Rep.Ptr), (i, Rep.I64), (n, Rep.I64)] k body in
                -- the whole: brackets, and a `;` after one element alone
                let xs2 = name l "xs" in
                let n2 = name l "n" in
                let k2 = name l "k" in
                let t = name l "s" in
                let one = concatTo [Prod.Str "#[", Prod.Var t, Prod.Str ";]"] (Cons.KVar k2) in
                let many = concatTo [Prod.Str "#[", Prod.Var t, Prod.Str "]"] (Cons.KVar k2) in
                let u3 = name l "u" in
                let u4 = name l "u" in
                let bracket = Stmt.Prim "eq" [Prod.Var n2, Prod.Int 1] [unitBinder u3 many, unitBinder u4 one] in
                let nonempty = Stmt.Invoke items [Prod.Var xs2, Prod.Int 0, Prod.Var n2] [strBinder t bracket] in
                let empty = Stmt.Cut (Prod.Str "#[;]") (Cons.KVar k2) in
                let u5 = name l "u" in
                let u6 = name l "u" in
                let whole =
                  Stmt.Prim "arrayLen" [Prod.Var xs2] [Cons.MuT (Binder.Binder n2 Rep.I64) (Stmt.Prim "eq" [Prod.Var n2, Prod.Int 0] [unitBinder u5 nonempty, unitBinder u6 empty])]
                in
                let w4 = pushShow l sh xs2 k2 whole in
                Just sh))

-- What escapes a string as the REPL shows one, made the first time it is
-- wanted: byte by byte, copying the runs between what needs escaping.
fun escapeDef (l : L) : Sym ! { Mut | e } =
  let escape = Sym.Sym "idyll" l.package ["#escape"] in
  let w = if V.elem "#escape" (getRef l.atoms) then () else (let a = setRef l.atoms (V.pushBack (getRef l.atoms) "#escape") in makeEscape l escape) in
  escape

fun makeEscape (l : L) (escape : Sym) =
  let go = A.child escape "go" in
  let byteS = A.child escape "byte" in
  let var = \x -> Prod.Var x in
  let text = \t -> Prod.Str t in
  -- escape(s) = go(s, 0, 0, the length, "")
  let st = name l "s" in
  let n = name l "n" in
  let k = name l "k" in
  let body = primThen "stringByteLength" [var st] n Rep.I64 (Stmt.Invoke go [var st, Prod.Int 0, Prod.Int 0, var n, text ""] [Cons.KVar k]) in
  let w1 = pushDef l escape [(st, Rep.Str)] k body in
  -- go(s, start, i, n, acc): what is escaped of `s` before `start` is
  -- `acc`; the bytes from `start` up to `i` need no escaping
  let st2 = name l "s" in
  let start = name l "start" in
  let i = name l "i" in
  let n2 = name l "n" in
  let acc = name l "acc" in
  let k2 = name l "k" in
  let b = name l "b" in
  let e = name l "e" in
  let len = name l "len" in
  let j = name l "j" in
  let run = name l "run" in
  let acc2 = name l "acc" in
  let last = name l "run" in
  let kv = Cons.KVar k2 in
  let plain = Stmt.Invoke go [var st2, var start, var j, var n2, var acc] [kv] in
  let escaped =
    primThen "stringSlice" [var st2, var start, var i] run Rep.Str (concatTo [var acc, var run, var e] (strBinder acc2 (Stmt.Invoke go [var st2, var j, var j, var n2, var acc2] [kv])))
  in
  let which = primThen "stringByteLength" [var e] len Rep.I64 (testEq l (var len) (Prod.Int 0) escaped plain) in
  let after = primThen "add" [var i, Prod.Int 1] j Rep.I64 which in
  let step = primThen "stringByteAt" [var st2, var i] b Rep.I64 (Stmt.Invoke byteS [var b] [strBinder e after]) in
  let end2 = primThen "stringSlice" [var st2, var start, var n2] last Rep.Str (concatTo [var acc, var last] kv) in
  let body2 = testEq l (var i) (var n2) step end2 in
  let w2 = pushDef l go [(st2, Rep.Str), (start, Rep.I64), (i, Rep.I64), (n2, Rep.I64), (acc, Rep.Str)] k2 body2 in
  -- byte(b): how it is escaped, or "" if it needs none
  let b3 = name l "b" in
  let k3 = name l "k" in
  let kv3 = Cons.KVar k3 in
  let digits = text "0123456789abcdef" in
  let hi = name l "hi" in
  let lo = name l "lo" in
  let h1 = name l "hi" in
  let l1 = name l "lo" in
  let dh = name l "d" in
  let dl = name l "d" in
  -- `\u{1b}`: lower-case hex digits, no leading zero
  let written = testEq l (var hi) (Prod.Int 0) (concatTo [text "\\u{", var dh, var dl, text "}"] kv3) (concatTo [text "\\u{", var dl, text "}"] kv3) in
  let unicode =
    primThen "div" [var b3, Prod.Int 16] hi Rep.I64
      (primThen "mod" [var b3, Prod.Int 16] lo Rep.I64
        (primThen "add" [var hi, Prod.Int 1] h1 Rep.I64
          (primThen "add" [var lo, Prod.Int 1] l1 Rep.I64
            (primThen "stringSlice" [digits, var hi, var h1] dh Rep.Str
              (primThen "stringSlice" [digits, var lo, var l1] dl Rep.Str written)))))
  in
  -- another byte below a space, or DEL; anything else is itself
  let control = testLt l (var b3) (Prod.Int 32) (Stmt.Cut (text "") kv3) unicode in
  let body3 = testEq l (var b3) (Prod.Int 127) control unicode in
  let body4 =
    V.foldl
      (\bd ce -> match ce with | (code, esc) -> testEq l (var b3) (Prod.Int code) bd (Stmt.Cut (text esc) kv3))
      body3
      [(0, "\\0"), (13, "\\r"), (9, "\\t"), (10, "\\n"), (92, "\\\\"), (34, "\\\"")]
  in
  pushDef l byteS [(b3, Rep.I64)] k3 body4

-- --- natives ---------------------------------------------------------------------------
--
-- The natives the runtime has no primitive for, as code of the program's
-- own, made of the array primitives it does have: each a `def` generic in
-- the element type, made the first time a program uses it. A mutable array
-- is the runtime's array, used linearly.

fun nativeHelper (l : L) (n : String) : Maybe (Sym, [Param]) ! { Mut | e } =
  let values =
    if V.elem n ["arrayToList", "arrayFromList", "marrayLen", "marrayFreeze", "marrayThaw"] then Just [Rep.Ptr]
    else if n == "marrayNew" then Just [Rep.I64, Rep.Any]
    else if n == "marrayGet" then Just [Rep.Ptr, Rep.I64]
    else None
  in
  match values with
  | None -> None
  | Just vs ->
      let params = V.append [Param.PDesc] (V.map (\r -> Param.PValue r) vs) in
      let sym = A.idyll l.package ("#" ++ n) in
      let made =
        if V.elem n (getRef l.nativesMade) then Just ()
        else
          let w = setRef l.nativesMade (V.pushBack (getRef l.nativesMade) n) in
          makeNative l n sym
      in
      M.map (\u -> (sym, params)) made

-- A constructor of the prelude's, by name: its symbol, its type declared
-- for the program.
fun preludeCtor (l : L) (cn : String) : Maybe Sym ! { Mut | e } =
  match V.find (\kv -> match kv with | (u, CtorInfo.CtorInfo n _ _ _ _) -> n == cn and isPrelude l u) (Hm.toVec (getRef l.tc.ctors)) with
  | Just (u, CtorInfo.CtorInfo _ dt _ _ _) ->
      let w = note l.datas dt in
      symbol l u
  | None -> None

fun makeNative (l : L) (n : String) (sym : Sym) : Maybe () ! { Mut | e } =
  let d = name l "d" in
  let a = name l "a" in
  let elem = Rep.Var a in
  let k = name l "k" in
  let kv = Cons.KVar k in
  let var = \x -> Prod.Var x in
  let bind = \x r body -> Cons.MuT (Binder.Binder x r) body in
  let mk = \s params kk body -> CDef.CDef s [(a, d)] [] (V.append [Binder.Binder d Rep.Desc] params) [kk] body in
  let push = \df -> setRef l.defs (V.pushBack (getRef l.defs) df) in
  if n == "arrayToList" then
    (match (preludeCtor l "Nil", preludeCtor l "::") with
     | (Just nil, Just cons) ->
         let go = A.child sym "go" in
         let xs = name l "xs" in
         let len = name l "n" in
         let i = name l "i" in
         let body =
           Stmt.Prim "arrayLen" [var xs] [bind len Rep.I64 (Stmt.Prim "sub" [var len, Prod.Int 1] [bind i Rep.I64 (Stmt.Invoke go [var d, var xs, var i, Prod.Con nil []] [kv])])]
         in
         let w = push (mk sym [Binder.Binder xs Rep.Ptr] k body) in
         let k2 = name l "k" in
         let xs2 = name l "xs" in
         let i2 = name l "i" in
         let acc = name l "acc" in
         let e = name l "e" in
         let c = name l "c" in
         let j = name l "j" in
         let u = name l "u" in
         let w2 = name l "u" in
         let step =
           Stmt.Prim "arrayGet" [var xs2, var i2] [bind e elem (Stmt.Cut (Prod.Con cons [var e, var acc]) (bind c Rep.Ptr (Stmt.Prim "sub" [var i2, Prod.Int 1] [bind j Rep.I64 (Stmt.Invoke go [var d, var xs2, var j, var c] [Cons.KVar k2])])))]
         in
         let body2 = Stmt.Prim "lt" [var i2, Prod.Int 0] [bind u Rep.Unit step, bind w2 Rep.Unit (Stmt.Cut (var acc) (Cons.KVar k2))] in
         let w3 = push (mk go [Binder.Binder xs2 Rep.Ptr, Binder.Binder i2 Rep.I64, Binder.Binder acc Rep.Ptr] k2 body2) in
         Just ()
     | _ -> None)
  else if n == "arrayFromList" then
    (match (preludeCtor l "Nil", preludeCtor l "::") with
     | (Just nil, Just cons) ->
         let go = A.child sym "go" in
         let list = name l "list" in
         let body = Stmt.Invoke go [var d, var list, Prod.Array []] [kv] in
         let w = push (mk sym [Binder.Binder list Rep.Ptr] k body) in
         let k2 = name l "k" in
         let lv = name l "l" in
         let acc = name l "acc" in
         let h = name l "h" in
         let t = name l "t" in
         let pushed = name l "a" in
         let arms =
           [
             Arm.Arm (Just nil) [] (Stmt.Cut (var acc) (Cons.KVar k2)),
             Arm.Arm (Just cons) [Binder.Binder h elem, Binder.Binder t Rep.Ptr] (Stmt.Prim "arrayPush" [var acc, var h] [bind pushed Rep.Ptr (Stmt.Invoke go [var d, var t, var pushed] [Cons.KVar k2])])
           ]
         in
         let w2 = push (mk go [Binder.Binder lv Rep.Ptr, Binder.Binder acc Rep.Ptr] k2 (Stmt.Cut (var lv) (Cons.Case arms))) in
         Just ()
     | _ -> None)
  else if n == "marrayNew" then
    let go = A.child sym "go" in
    let count = name l "n" in
    let x = name l "x" in
    let body = Stmt.Invoke go [var d, var count, var x, Prod.Array []] [kv] in
    let w = push (mk sym [Binder.Binder count Rep.I64, Binder.Binder x elem] k body) in
    let k2 = name l "k" in
    let left = name l "n" in
    let x2 = name l "x" in
    let acc = name l "acc" in
    let pushed = name l "a" in
    let fewer = name l "m" in
    let u = name l "u" in
    let w2 = name l "u" in
    let more =
      Stmt.Prim "arrayPush" [var acc, var x2] [bind pushed Rep.Ptr (Stmt.Prim "sub" [var left, Prod.Int 1] [bind fewer Rep.I64 (Stmt.Invoke go [var d, var fewer, var x2, var pushed] [Cons.KVar k2])])]
    in
    let body2 = Stmt.Prim "lt" [Prod.Int 0, var left] [bind u Rep.Unit (Stmt.Cut (var acc) (Cons.KVar k2)), bind w2 Rep.Unit more] in
    let w3 = push (mk go [Binder.Binder left Rep.I64, Binder.Binder x2 elem, Binder.Binder acc Rep.Ptr] k2 body2) in
    Just ()
  -- a read gives back the array, with what it read boxed
  else if n == "marrayLen" then
    M.map
      (\pair ->
        let m = name l "m" in
        let len = name l "n" in
        let answer = Prod.Con pair [Prod.Tuple [var len], var m] in
        push (mk sym [Binder.Binder m Rep.Ptr] k (Stmt.Prim "arrayLen" [var m] [bind len Rep.I64 (Stmt.Cut answer kv)])))
      (preludeCtor l "Pair")
  else if n == "marrayGet" then
    M.map
      (\pair ->
        let m = name l "m" in
        let i = name l "i" in
        let e = name l "e" in
        let answer = Prod.Con pair [Prod.Tuple [var e], var m] in
        push (mk sym [Binder.Binder m Rep.Ptr, Binder.Binder i Rep.I64] k (Stmt.Prim "arrayGet" [var m, var i] [bind e elem (Stmt.Cut answer kv)])))
      (preludeCtor l "Pair")
  -- the same array, under the other type
  else if n == "marrayFreeze" or n == "marrayThaw" then
    let m = name l "m" in
    let w = push (mk sym [Binder.Binder m Rep.Ptr] k (Stmt.Cut (var m) kv)) in
    Just ()
  else None
