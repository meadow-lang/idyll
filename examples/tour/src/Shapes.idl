-- Shapes: a module of the tour. What it marks `@pub` is what `Main` can
-- use; `area'` below is its own business.

-- A sum type. Its constructors live under it: `Shape.Circle`, or bare
-- after `use Shapes.Shape.*`.
@pub
data Shape = Circle Float | Rect Float Float | Triangle Float Float Float

use Shape.*

-- A record with named fields.
@pub
record Point = { x : Float, y : Float }

@pub
area : (s : Shape) -> Float
area s = area' s

area' : (s : Shape) -> Float
area' (Circle r) = 3.14159 * r * r
area' (Rect w h) = w * h
-- Heron's formula.
area' (Triangle a b c) =
  let p = (a + b + c) / 2.0 in
  sqrt (p * (p - a) * (p - b) * (p - c))

-- Newton's method, since there is no `sqrt` primitive to reach for: thirty
-- steps, which `@terminating` vouches end.
sqrt : (x : Float) -> Float
sqrt x = if x <= 0.0 then 0.0 else newton x x 30

@terminating
newton : (x : Float) -> (guess : Float) -> (n : Int) -> Float
newton x guess n = if n == 0 then guess else newton x ((guess + x / guess) / 2.0) (n - 1)

-- `Just` the name of a shape with no area, if it is one.
@pub
degenerate : (s : Shape) -> Maybe String
degenerate s = if area s <= 0.0 then Just (describe s) else Nothing

@pub
describe : (s : Shape) -> String
describe (Circle r) = "a circle"
describe (Rect w h) = if w == h then "a square" else "a rectangle"
describe (Triangle a b c) = "a triangle"

@pub
distance : (p : Point) -> (q : Point) -> Float
distance p q =
  let dx = p.x - q.x in
  let dy = p.y - q.y in
  sqrt (dx * dx + dy * dy)
