-- Problem 1: the sum of all the multiples of 3 or 5 below 1000.

-- What `n` counts for: itself, if 3 or 5 divides it.
counted : (n : Int) -> Int
counted n
  | n % 3 == 0 = n
  | n % 5 == 0 = n
  | otherwise = 0

-- The sum of what counts from `n` up to 1000.
sumFrom : (n : Int) -> Int ! Div
sumFrom n = if n == 1000 then 0 else counted n + sumFrom (n + 1)

answer : Int ! Div
answer = sumFrom 1
