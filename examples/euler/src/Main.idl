-- Project Euler's first ten problems: each a module, `P1` to `P10`, whose
-- `answer` is the problem's.

use Std.Console (printLines)

main : () -> () ! Eff
main () =
  printLines #[
    "1: " ++ showInt P1.answer,
    "2: " ++ showInt P2.answer,
    "3: " ++ showInt P3.answer,
    "4: " ++ showInt P4.answer,
    "5: " ++ showInt P5.answer,
    "6: " ++ showInt P6.answer,
    "7: " ++ showInt P7.answer,
    "8: " ++ showInt P8.answer,
    "9: " ++ showInt P9.answer,
    "10: " ++ showInt P10.answer
  ]
