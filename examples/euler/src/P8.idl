-- Problem 8: the greatest product of thirteen adjacent digits of the
-- 1000-digit number below, written out ten digits at a time (a chunk that
-- starts with zeros is written without them: it still stands for ten).

use Std.Num.Int (max)

chunks : List Int
chunks = #[
  7316717653, 1330624919, 2251196744, 2657474235, 5349194934,
  9698352031, 2774506326, 2395783180, 1698480186, 9478851843,
  8586156078, 9112949495, 4595017379, 5833195285, 3208805511,
  1254069874, 7158523863, 507156932, 9096329522, 7443043557,
  6689664895, 445244523, 1617318564, 309871112, 1722383113,
  6222989342, 3380308135, 3362766142, 8280644448, 6645238749,
  3035890729, 6290491560, 4407723907, 1381051585, 9307960866,
  7017242712, 1883998797, 9087922749, 2190169972, 888093776,
  6572733300, 1053367881, 2202354218, 975125454, 594752243,
  5258490771, 1670556013, 6048395864, 4670632441, 5722155397,
  5369781797, 7846174064, 9551492908, 6256932197, 8468622482,
  8397224137, 5657056057, 4902614079, 7296865241, 4535100474,
  8216637048, 4403199890, 88952434, 5065854122, 7588666881,
  1642717147, 9924442928, 2308634656, 7481391912, 3162824586,
  1786645835, 9124566529, 4765456828, 4891288314, 2607690042,
  2421902267, 1055626321, 1111093705, 4421750694, 1658960408,
  719840385, 962455444, 3629812309, 8787992724, 4284909188,
  8458015616, 6097919133, 8754992005, 2406368991, 2560717606,
  588611646, 7109405077, 5410022569, 8315520005, 5935729725,
  7163626956, 1882670428, 2524836008, 2325753042, 752963450
]

-- The ten digits of a chunk, first to last, before `rest`.
digits : (chunk : Int) -> (count : Int) -> (rest : List Int) -> List Int ! Div
digits chunk count rest = if count == 0 then rest else digits (chunk / 10) (count - 1) (chunk % 10 :: rest)

allDigits : (cs : List Int) -> List Int ! Div
allDigits Nil = Nil
allDigits (c :: rest) = digits c 10 (allDigits rest)

-- The product of the first `n` digits, or 0 if there are fewer.
productOf : (n : Int) -> (ds : List Int) -> Int ! Div
productOf 0 ds = 1
productOf n Nil = 0
productOf n (d :: rest) = d * productOf (n - 1) rest

-- The greatest product of thirteen, starting from each place in turn.
greatest : (ds : List Int) -> (most : Int) -> Int ! Div
greatest Nil most = most
greatest (d :: rest) most = greatest rest (max most (productOf 13 (d :: rest)))

answer : Int ! Div
answer = greatest (allDigits chunks) 0
