-- Project Euler #5: the smallest number divisible by every integer 1..20.
-- 2520 is already lcm 1..10, so only 11..20 need folding in.

gcd : (a : [] Int) -> (b : [] Int) -> Int ! Div
gcd a 0 = a
gcd a b = gcd b (a % b)

lcm : (a : [] Int) -> (b : [] Int) -> Int ! Div
lcm a b = a / gcd a b * b

range : (lo : [] Int) -> (hi : [] Int) -> List Int ! Div
range lo hi
  | hi < lo = Nil
  | otherwise = lo :: range (lo + 1) hi

foldl : (f : [] ((acc : [] Int) -> (x : [] Int) -> Int ! Div)) -> (acc : [] Int) -> (xs : [] List Int) -> Int ! Div
foldl f acc Nil = acc
foldl f acc (x :: xs) = foldl f (f acc x) xs

e5 : Int ! Div
e5 = foldl lcm 2520 (range 11 20)

e5
