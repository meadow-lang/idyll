-- An interpreter for a little functional language (`Syntax`), with
-- closures, recursion and errors (`Eval`). Each program is printed as it
-- would be written, then run: its value and how many steps it took, or
-- what went wrong.

use Std.Console (printLines)
use Std.Exn (Exn, toResult)
use Std.State (runState)
use Syntax (Expr, show)
use Syntax.Expr.*
use Eval (Value, eval, showValue)

-- The factorial: `rec fact n -> if n == 0 then 1 else n * fact (n - 1)`.
factorial : Expr
factorial = Rec (IfZero (Var 0) (Num 1) (Mul (Var 0) (App (Var 1) (Sub (Var 0) (Num 1)))))

-- The Fibonacci numbers, the slow way.
fibonacci : Expr
fibonacci = Rec (IfZero (Var 0) (Num 0) (IfZero (Sub (Var 0) (Num 1)) (Num 1)
  (Add (App (Var 1) (Sub (Var 0) (Num 1))) (App (Var 1) (Sub (Var 0) (Num 2))))))

-- A function that takes a function and applies it twice.
twice : Expr
twice = Lam (Lam (App (Var 1) (App (Var 1) (Var 0))))

programs : List Expr
programs = #[
  Add (Num 1) (Mul (Num 2) (Num 3)),
  App factorial (Num 10),
  App fibonacci (Num 10),
  Let (Lam (Add (Var 0) (Num 10))) (App (App twice (Var 0)) (Num 1)),
  Divide (Num 1) (Sub (Num 2) (Num 2)),
  App (Num 3) (Num 4)
]

-- What running a program came to.
outcome : (r : Result String (Value, Int)) -> String
outcome (Ok (v, steps)) = showValue v ++ ", in " ++ showInt steps ++ " steps"
outcome (Err message) = "error: " ++ message

-- A program run with its steps counted from 0.
counted : (e : [] Expr) -> (u : ()) -> (Value, Int) ! {Exn String, Div}
counted e u = runState 0 (\(w : ()) -> eval Nil e)

-- A program, and what running it came to.
run : (e : [] Expr) -> String ! Div
run e = show 0 e ++ "\n  = " ++ outcome (toResult (counted e))

main : () -> () ! Eff
main () = printLines (Std.Collections.List.map run programs)
