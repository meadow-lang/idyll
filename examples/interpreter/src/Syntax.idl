-- The syntax of a little functional language: numbers, arithmetic,
-- functions of one argument, a test for zero, and recursion. A variable is
-- a number, its de Bruijn index: `Var 0` is the nearest enclosing binder,
-- `Var 1` the one around that, and so on, so no names ever clash.

@pub
data Expr where
  Num : Int -> Expr
  Var : Int -> Expr
  Add : Expr -> Expr -> Expr
  Sub : Expr -> Expr -> Expr
  Mul : Expr -> Expr -> Expr
  Divide : Expr -> Expr -> Expr
  -- a function: its body sees the argument as `Var 0`
  Lam : Expr -> Expr
  App : Expr -> Expr -> Expr
  -- `IfZero c t e`: `t` if `c` is zero, otherwise `e`
  IfZero : Expr -> Expr -> Expr -> Expr
  -- a recursive function: its body sees the argument as `Var 0`, and the
  -- function itself as `Var 1`
  Rec : Expr -> Expr
  -- `Let e body`: `body`, which sees `e` as `Var 0`
  Let : Expr -> Expr -> Expr

use Expr.*

-- The name a variable bound at `depth` binders in is written with.
name : (depth : [] Int) -> String
name depth = "x" ++ showInt depth

-- A program as it would be written, with names for its variables: `depth`
-- is how many binders are around it.
@pub
show : (depth : [] Int) -> (e : Expr) -> String
show depth (Num n) = showInt n
show depth (Var i) = name (depth - 1 - i)
show depth (Add a b) = "(" ++ show depth a ++ " + " ++ show depth b ++ ")"
show depth (Sub a b) = "(" ++ show depth a ++ " - " ++ show depth b ++ ")"
show depth (Mul a b) = "(" ++ show depth a ++ " * " ++ show depth b ++ ")"
show depth (Divide a b) = "(" ++ show depth a ++ " / " ++ show depth b ++ ")"
show depth (Lam body) = "(\\" ++ name depth ++ " -> " ++ show (depth + 1) body ++ ")"
show depth (App f x) = "(" ++ show depth f ++ " " ++ show depth x ++ ")"
show depth (IfZero c t e) = "(if " ++ show depth c ++ " == 0 then " ++ show depth t ++ " else " ++ show depth e ++ ")"
show depth (Rec body) = "(rec " ++ name depth ++ " " ++ name (depth + 1) ++ " -> " ++ show (depth + 2) body ++ ")"
show depth (Let e body) = "(let " ++ name depth ++ " = " ++ show depth e ++ " in " ++ show (depth + 1) body ++ ")"
