-- function defs
map : (a -> b) -> [a] -> [b]
map _ [] = []
map f (x :: xs) = f x :: map f xs

fun map : (a -> b) -> [a] -> [b] =
  | map [] = []
  | map (x :: xs) = f x :: map xs

-- where bindings
fib : Int -> Int
fib = go 0 1
  where
    go a b 0 = a
    go a b n = go b (a + b) (n - 1)

def fib : Int -> Int = 
  go 0 1
  where 
    def rec go a b 0 = a
      | a b n = go b (a + b) (n - 1)
  end

-- guards
fib : Int -> Int
fib n | n <= 1 = n
fib n = fib (n - 1) + fib (n - 2)

fun fib (n : Int) : Int =
  | fib n if n <= 1 = n
  | fib n = fib (n - 1) + fib (n - 2)

binarySearch :: U.Vector Int -> Int -> Int
binarySearch !v !x = go 0 (U.length v - 1)
  where
    go !low !high
      | low > high = high
      | midVal == x = mid
      | midVal < x = go (mid + 1) high
      | otherwise = go low (mid - 1)
      where
        mid = (low + high) `div` 2
        midVal = v U.! mid

def binarySearch (!v : U.Vector Int) (!x : Int) : Int =
  go 0 (U.length v - 1)
  where
    def rec go !low !high = fun
      | low high if low > high = high
      | low high =
          let mid = (low + high) `div` 2 in
          let midVal = v U.! mid in
          if midVal == x then mid
          else if midVal < x then go (mid + 1) high
          else go low (mid - 1)
  end

def binarySearch (!v : U.Vector Int) (!x : Int) : Int =
  let rec go !low !high = match (low, high) with
    | (low, high) if low > high -> high
    | (low, high) ->
        let mid = (low + high) `div` 2 in
        let midVal = v U.! mid in
        if midVal == x then mid
        else if midVal < x then go (mid + 1) high
        else go low (mid - 1)
  in go 0 (U.length v - 1)

-- let expressions
add x y = let sum = x + y in sum

sum : [Int] -> Int
sum = foldl (+) 0

foldl : (b -> a -> b) -> b -> [a] -> b
foldl _ acc [] = acc
foldl f acc (x::xs) = foldl f (f acc x) xs

def rec foldl : (b -> a -> b) -> b -> [a] -> b = fun
  | _ acc [] = acc
  | f acc (x :: xs) = foldl f (f acc x) xs

foldr : (a -> b -> b) -> b -> [a] -> b
foldr _ acc [] = acc
foldr f acc (x::xs) = f x (foldr f acc xs)

sum : [Int] -> Int
sum = go xs 0
  where
    go : [Int] -> Int -> Int
    go [] acc = acc
    go (x :: xs) acc = go xs (acc + x)

def sum (Num a) => (xs : [a]) : a =
  go xs 0
  where
    def rec go = fun
      | [] acc = acc
      | (x :: xs) acc = go xs (acc + x)
  end

-- case expressions
map (a -> b) -> [a] -> [b]
map f xs =
  case xs of
    [] -> []
    x :: xs -> f x :: map f xs

-- if expressions
fun abs (x : Int) : Int =
  if x < 0 then -x else x

-- record defs
record Person {
  name : String,
  age : Int,
}

-- layout-sensitive records
record Point where
  x : Float
  y : Float

-- data defs
data Option a = None | Some a

data List a = [] | a :: List a

-- layout-sensitive data declaration
data List a where
  [] : List a
  (::) : a -> List a -> List a

-- record access
alice = { name = "Alice", age = 30 }
aliceName = alice.name

-- record update
olderAlice = { alice of age = alice.age + 1 }

-- pattern caseing of records
describePerson : Person -> String
describePerson (Person { name, age }) = name ++ " is " ++ Int.toString age ++ " years old"

-- Operators
+ -- addition on a Int, Float, Integer, Rational
- -- subtraction on a Int, Float, Integer, Rational
* -- multiplication on a Int, Float, Integer, Rational
/ -- division on a Int, Float, Integer, Rational
% -- modulo on Int, Integer, Rational
^ -- exponentiation on Int, Integer, Rational

++ -- String concat
. -- function composition
|> -- forward pipe operator
; -- sugar for let-binding of no name
! -- dereference a ref

-- Literals
"hello" -- String
123 -- Int
123.45 -- Float
True, False -- Bool
'a' -- Char
[..] -- range
[1, 2, 3] -- list
#[1, 2, 3] -- vector
$[1, 2, 3] -- array
(1, "a", True) -- tuple
{ name = "Alice", age = 30 } -- record instance

-- row polymorphism
foo : { x : Int | r } -> Int 
foo rec = rec.x + 1



