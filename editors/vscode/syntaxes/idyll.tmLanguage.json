{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Idyll",
  "scopeName": "source.idyll",
  "patterns": [
    { "include": "#comment" },
    { "include": "#attribute" },
    { "include": "#string" },
    { "include": "#char" },
    { "include": "#number" },
    { "include": "#keyword" },
    { "include": "#grade" },
    { "include": "#signature" },
    { "include": "#type" },
    { "include": "#operator" }
  ],
  "repository": {
    "comment": {
      "name": "comment.line.double-dash.idyll",
      "match": "--(?![!#$%&*+./<=>?@\\\\^|~:-]).*$"
    },
    "attribute": {
      "name": "meta.attribute.idyll",
      "match": "@[a-z][A-Za-z0-9_]*",
      "captures": { "0": { "name": "storage.modifier.attribute.idyll" } }
    },
    "string": {
      "name": "string.quoted.double.idyll",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        { "name": "constant.character.escape.idyll", "match": "\\\\(?:[nrt\\\\\"'0]|u\\{[0-9A-Fa-f]+\\})" },
        {
          "name": "meta.interpolation.idyll",
          "begin": "\\$\\{",
          "end": "\\}",
          "beginCaptures": { "0": { "name": "punctuation.section.interpolation.begin.idyll" } },
          "endCaptures": { "0": { "name": "punctuation.section.interpolation.end.idyll" } },
          "patterns": [{ "include": "$self" }]
        }
      ]
    },
    "char": {
      "name": "string.quoted.single.idyll",
      "match": "'(?:\\\\(?:[nrt\\\\\"'0]|u\\{[0-9A-Fa-f]+\\})|[^'\\\\])'"
    },
    "number": {
      "patterns": [
        { "name": "constant.numeric.hex.idyll", "match": "\\b0x[0-9A-Fa-f_]+\\b" },
        { "name": "constant.numeric.octal.idyll", "match": "\\b0o[0-7_]+\\b" },
        { "name": "constant.numeric.binary.idyll", "match": "\\b0b[01_]+\\b" },
        { "name": "constant.numeric.float.idyll", "match": "\\b[0-9][0-9_]*\\.[0-9][0-9_]*(?:[eE][+-]?[0-9]+)?\\b" },
        { "name": "constant.numeric.decimal.idyll", "match": "\\b[0-9][0-9_]*\\b" }
      ]
    },
    "keyword": {
      "patterns": [
        { "name": "keyword.control.idyll", "match": "\\b(case|of|if|then|else|let|in|where|handle|with|do)\\b" },
        { "name": "keyword.other.declaration.idyll", "match": "\\b(data|record|trait|instance|effect|type|module|mod|use|as)\\b" },
        { "name": "constant.language.idyll", "match": "\\b(Type|inf|infinity|True|False)\\b" }
      ]
    },
    "grade": {
      "name": "meta.grade.idyll",
      "match": "\\[\\s*(?:[0-9]+|inf|infinity|[a-z][A-Za-z0-9_']*)?(?:\\s*\\.\\.\\s*(?:[0-9]+|inf|infinity))?\\s*\\]",
      "captures": { "0": { "name": "storage.modifier.grade.idyll" } }
    },
    "signature": {
      "match": "^\\s*([a-z_][A-Za-z0-9_']*)\\s*(?=:(?![:=]))",
      "captures": { "1": { "name": "entity.name.function.idyll" } }
    },
    "type": {
      "name": "entity.name.type.idyll",
      "match": "\\b[A-Z][A-Za-z0-9_']*\\b"
    },
    "operator": {
      "patterns": [
        { "name": "keyword.operator.arrow.idyll", "match": "->|=>|<-" },
        { "name": "keyword.operator.lambda.idyll", "match": "\\\\" },
        { "name": "keyword.operator.idyll", "match": "[!#$%&*+./<=>?@^|~:-]+" }
      ]
    }
  }
}
