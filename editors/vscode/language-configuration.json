{
  "comments": { "lineComment": "--" },
  "brackets": [["{", "}"], ["[", "]"], ["(", ")"]],
  "autoClosingPairs": [
    { "open": "{", "close": "}" },
    { "open": "[", "close": "]" },
    { "open": "(", "close": ")" },
    { "open": "\"", "close": "\"", "notIn": ["string", "comment"] }
  ],
  "surroundingPairs": [["{", "}"], ["[", "]"], ["(", ")"], ["\"", "\""]],
  "indentationRules": {
    "increaseIndentPattern": "(=\\s*$)|(\\b(where|of|let|with|then|else|do)\\s*$)|([([{]\\s*$)|(->\\s*$)",
    "decreaseIndentPattern": "^\\s*([)\\]}]|in\\b)"
  },
  "wordPattern": "[A-Za-z_][A-Za-z0-9_']*"
}
